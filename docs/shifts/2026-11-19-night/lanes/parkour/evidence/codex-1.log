extends RefCounted
## Stations are metres north along the decks. Each later station follows the preceding span.
const WIDTH := 5.0
const DECK_Y := 7.0
const Z_START := 22.0
const FIRST_LIP := 8.0
const BAR_DEPTH := 1.45
const DROP := 7.0
const YARD_Y := -1.25

var root: Node3D
var first_land: float
var chain_lip: float
var chain_land: float
var bar: float
var lip: float
var foot: float
var finish: float
var clearance: float
var angle: float
var checkpoints: Array[float] = []


func build(parent: Node3D, data: Dictionary) -> void:
	root = parent
	for key: String in data:
		if key not in ["first_gap_m", "chain_gap_m", "bar_clearance_m", "chute_degrees"]:
			push_error("Unknown course key '%s'" % key)
	first_land = FIRST_LIP + float(data["first_gap_m"])
	chain_lip = first_land + 10.0
	chain_land = chain_lip + float(data["chain_gap_m"])
	bar = chain_land + 2.1
	lip = bar + BAR_DEPTH + 5.6
	clearance = float(data["bar_clearance_m"])
	angle = deg_to_rad(float(data["chute_degrees"]))
	foot = lip + DROP / tan(angle)
	finish = foot + 5.0
	checkpoints = [first_land + 2.5, bar + BAR_DEPTH + 1.0, finish]

	_place(TLKit.build("ground_patch", {"size_x": 16.0, "size_z": finish + 6.0, "thickness": 0.25, "surface": "dirt"}),
		point(finish / 2, YARD_Y))
	_place(TLKit.build("lumber", {"length": 4.0, "layers": 4}), point(first_land + 3, YARD_Y, -5.1))
	_place(TLKit.build("pallet", {"rows": 2}), point(3.0, YARD_Y, 5.2))
	_place(TLKit.build("barricade", {"width": 2.5}), point(finish + 1, YARD_Y, 3.8))
	_deck(-2, FIRST_LIP, DECK_Y)
	_deck(first_land, chain_lip, DECK_Y)
	_deck(chain_land, lip, DECK_Y)
	_deck(foot, finish + 2, 0)
	# The top face of the tilted kit slab meets both deck tops exactly.
	var slope := _place(TLKit.build("ground_patch", {"size_x": WIDTH, "size_z": DROP / sin(angle),
		"thickness": 0.32, "surface": "concrete"}), point((lip + foot) / 2, DECK_Y - DROP / 2))
	slope.rotation.x = -angle

	# Landing lines, take-off boards and finish stripe use the same painted kit kerb.
	for station: float in [0.0, FIRST_LIP - 0.45, first_land + 0.55, chain_lip - 0.45, chain_land + 0.55, lip - 0.45]:
		_stripe(station, DECK_Y)
	_stripe(finish, 0)
	for station: float in [0.0, first_land + 2.5, finish]:
		var height := 0.0 if station == finish else DECK_Y
		_place(TLKit.build("flag", {"height": 3.0, "color": "flag_a" if station == finish else "flag_b"}), point(station, height, -2.35))

	# A deep striped lintel overhangs each unsupported side by more than half a running jump.
	# Its side piers rise past jump height, right at the two edges of the landing.
	for x: float in [-WIDTH / 2, WIDTH / 2]:
		_place(TLKit.build("ground_patch", {"size_x": 1.0, "size_z": BAR_DEPTH, "thickness": clearance, "surface": "concrete"}),
			point(bar + BAR_DEPTH / 2, DECK_Y + clearance, x))
	_place(TLKit.build("ground_patch", {"size_x": WIDTH + 7.0, "size_z": BAR_DEPTH, "thickness": 0.50, "surface": "wood"}),
		point(bar + BAR_DEPTH / 2, DECK_Y + clearance + 0.50))
	_place(TLKit.build("kerb", {"length": WIDTH + 7.0, "width": BAR_DEPTH, "height": 0.14}),
		point(bar + BAR_DEPTH / 2, DECK_Y + clearance + 0.50, -(WIDTH + 7.0) / 2))
	# Left and right cheeks of the chute make its angle visible from the road.
	for x: float in [-2.45, 2.45]:
		var cheek := _place(TLKit.build("kerb", {"length": DROP / sin(angle), "width": 0.3, "height": 0.18}),
			point(lip, DECK_Y, x))
		cheek.basis = Basis(Vector3.RIGHT, -angle) * Basis(Vector3.UP, PI / 2)


func point(station: float, y: float, x: float = 0.0) -> Vector3:
	return Vector3(x, y, Z_START - station)


func _place(part: Node3D, at: Vector3) -> Node3D:
	part.position = at
	root.add_child(part)
	return part


func _deck(a: float, b: float, y: float) -> void:
	_place(TLKit.build("ground_patch", {"size_x": WIDTH, "size_z": b - a, "thickness": 0.34, "surface": "wood"}), point((a + b) / 2, y))
	if y < 1.0:
		_place(TLKit.build("ground_patch", {"size_x": WIDTH - 0.25, "size_z": b - a - 0.25, "thickness": y - YARD_Y - 0.3,
			"surface": "concrete"}), point((a + b) / 2, y - 0.3))
		return
	# Trestles cross the width of each deck. No trestle or apron bridges a gap.
	for station: float in [a + 1.35, b - 1.35]:
		_place(TLKit.build("scaffold", {"bays": 2, "bay_w": 2.2, "bay_d": 1.1, "levels": 3,
			"level_h": (y - YARD_Y - 1.34) / 3, "decks": [3]}), point(station - 0.55, YARD_Y, -2.2))


func _stripe(station: float, y: float) -> void:
	_place(TLKit.build("kerb", {"length": WIDTH - 0.15, "width": 0.30, "height": 0.03}), point(station, y, -(WIDTH - 0.15) / 2))

extends Node
## The same race runs on stage, headless and on a village plot. TLRules owns time, ordered gates and personal bests.
const ACTIONS := {"left": &"left", "right": &"right", "forward": &"forward", "back": &"back",
	"run": &"run", "jump": &"jump", "slide": &"slide"}
const KILL_Y := -0.8
const SIDE := "runner"

var ctx: TLContext
var venue
var runner: TLBiped
var rules: TLRules
var cam: TLOrbitCam
var hud: TLHud
var spawn_at: Vector3
var falls := 0


func _pack_setup(c: TLContext) -> void:
	ctx = c
	venue = ctx.load_script("scripts/course.gd").new()
	venue.build(ctx.root, ctx.read_json("course.json"))
	spawn_at = venue.point(0, venue.DECK_Y + 0.04)
	runner = TLBiped.create({"feel": &"walker", "position": spawn_at, "name": "Runner",
		"rig_params": {"backpack": false, "expression": "focus", "colors": {"top": "flag_a", "trim": "white"}}})
	ctx.root.add_child(runner)
	rules = TLRules.create({"sides": [SIDE], "checkpoints": venue.checkpoints.size(), "laps_to_win": 1, "time_limit_seconds": 60})
	ctx.root.add_child(rules)
	for key: Array in [[&"forward", [KEY_W, KEY_UP]], [&"back", [KEY_S, KEY_DOWN]], [&"left", [KEY_A, KEY_LEFT]],
			[&"right", [KEY_D, KEY_RIGHT]], [&"jump", [KEY_SPACE]], [&"run", [KEY_SHIFT]], [&"slide", [KEY_C]], [&"restart", [KEY_R]]]:
		ctx.input.declare(key[0], key[1])
	cam = ctx.cameras.orbit(runner, {"distance": 5.5, "pitch": 33, "look_height": 1.1, "fov": 55})
	ctx.cameras.add_view(&"overview", Vector3(3, 48, 0.5), Vector3(0, 2, 0.5), 39)
	_view(&"jump", venue.FIRST_LIP + 1.1, Vector3(7.2, 2.0, 0.8), 1.15)
	_view(&"under_bar", venue.bar + 0.6, Vector3(1.7, 0.90, -5.0), 0.65)
	_view(&"chute", (venue.lip + venue.foot) / 2, Vector3(7.5, 2.0, -4.0), -2.3)
	hud = TLHud.create()
	ctx.root.add_child(hud)
	hud.add_label(&"race", "", &"top_left")
	hud.set_plate(&"race")
	hud.add_label(&"controls", "WASD / arrows  Move     Shift  Run     Space  Jump     C  Slide     R  Restart", &"bottom")
	hud.set_plate(&"controls")


func _view(id: StringName, station: float, offset: Vector3, above: float) -> void:
	var target: Vector3 = venue.point(station, venue.DECK_Y + above)
	ctx.cameras.add_view(id, target + offset, target, 45)


func _pack_start() -> void:
	_restart()


func _restart() -> void:
	spawn_at = venue.point(0, venue.DECK_Y + 0.04)
	runner.place(spawn_at)
	cam.snap()
	falls = 0
	rules.start()
	_update_hud()


func _pack_tick(_frame: int) -> void:
	if ctx.input.just_pressed(&"restart"):
		_restart()
	if rules.is_running():
		var at: float = venue.Z_START - runner.position.z
		# Catch a miss before a trestle underneath a high deck can catch the runner.
		var below_decks: bool = at < venue.lip and runner.position.y < venue.DECK_Y - 1.35
		if runner.position.y < KILL_Y or below_decks:
			falls += 1
			runner.place(spawn_at)
			cam.snap()
		runner.drive_from_input(ctx.input, ACTIONS, cam.yaw_basis())
		var index := int(rules.next_checkpoint[SIDE])
		var station: float = venue.checkpoints[index]
		var height: float = 0.0 if index == venue.checkpoints.size() - 1 else venue.DECK_Y
		var feet := runner.position
		if runner.grounded and absf(feet.y - height) < 0.2 and absf(feet.x) < venue.WIDTH / 2 \
				and at >= station and at < station + 0.6:
			if rules.pass_checkpoint(SIDE, index):
				spawn_at = venue.point(station, height + 0.04)
	else:
		runner.move(Vector3.ZERO)
	_update_hud()


func _update_hud() -> void:
	var best := "â€”"
	if rules.best_lap_frames.has(SIDE):
		best = "%.2f s" % (float(rules.best_lap_frames[SIDE]) / 60)
	var caption := "TIMBER RUN    |    %d / %d" % [int(rules.next_checkpoint[SIDE]), venue.checkpoints.size()]
	var cue: String = ["Run + jump", "Jump, land, then slide", "Down the chute"][int(rules.next_checkpoint[SIDE])]
	caption += "    " + cue
	if rules.is_over():
		caption = "FINISH" if rules.reason == "laps" else "TIME UP"
	hud.set_text(&"race", "%s\n%.2f s     Best  %s" % [caption, rules.seconds_played(), best])


func _pack_state() -> Dictionary:
	var s := rules.snapshot()
	s.merge({"station": venue.Z_START - runner.position.z, "height": runner.position.y, "motion": runner.walker_motion(),
		"speed": runner.speed(), "falls": falls, "checkpoint": int(rules.next_checkpoint[SIDE]),
		"first_lip": venue.FIRST_LIP,
		"first_land": venue.first_land, "chain_lip": venue.chain_lip, "chain_land": venue.chain_land,
		"bar": venue.bar, "bar_depth": venue.BAR_DEPTH, "lip": venue.lip, "foot": venue.foot, "deck_y": venue.DECK_Y,
		"clearance": venue.clearance, "chute_degrees": rad_to_deg(venue.angle), "run_mps": runner.run_speed})
	if rules.best_lap_frames.has(SIDE):
		s["best_frames"] = int(rules.best_lap_frames[SIDE])
	return s

extends Node
## A perfect hand proves the route. Sample actual airborne crossings, clearance and downhill travel.
var ctx: TLContext
var hand: TLHand
var state: Dictionary
var jumped := [false, false]
var airborne_over := [false, false]
var crossed := [false, false]
var previous: StringName = &"ground"
var landing := -1
var slide_start := -1
var under := -1
var slope_frames := 0
var slope_drop := 0.0
var slope_y := 0.0
var jump_frame := -1
var chute_frame := -1


func _bot_setup(c: TLContext) -> void:
	ctx = c
	hand = TLHand.create(ctx, "perfect")


func _bot_tick(frame: int) -> void:
	state = ctx.pack_state()
	var at := float(state.station)
	var motion := StringName(state.motion)
	hand.press(&"forward")
	hand.press(&"run")
	for i: int in 2:
		var edge := float(state.first_lip if i == 0 else state.chain_lip)
		var far_edge := float(state.first_land if i == 0 else state.chain_land)
		if at >= edge - 0.85 and at < edge and motion == &"ground" and not jumped[i]:
			hand.tap(&"jump")
			jumped[i] = true
		if at > edge and at < far_edge and motion == &"air" and state.height > state.deck_y + 0.3:
			airborne_over[i] = true
			if i == 0 and state.height > state.deck_y + 0.9:
				jump_frame = frame
		if airborne_over[i] and previous == &"air" and motion == &"ground" and at >= far_edge:
			crossed[i] = true
	if crossed[1] and previous == &"air" and motion == &"ground" and at >= state.chain_land and landing < 0:
		landing = frame
		hand.tap(&"slide")
	if motion == &"slide" and slide_start < 0:
		slide_start = frame
	if motion == &"slide" and at > state.bar + 0.2 and at < state.bar + state.bar_depth - 0.2:
		under = frame
	if motion == &"slope":
		if slope_frames == 0:
			slope_y = float(state.height)
		slope_frames += 1
		slope_drop = maxf(slope_drop, slope_y - float(state.height))
		if slope_drop < 3.2:
			chute_frame = frame
	previous = motion
	hand.tick()


func _bot_done() -> bool:
	return state.get("state") == "over" or int(state.get("falls", 0)) > 0


func _bot_result() -> Dictionary:
	var ok: bool = state.get("reason") == "laps" and crossed == [true, true] and under >= 0 and landing >= 0 \
		and slide_start > landing and slide_start <= landing + 2 and slope_frames > 4 and slope_drop > 2.0 and state.falls == 0
	var result := {"ok": ok, "summary": "perfect hand, %d frames (%.3f s), gaps %s, chain landed %d / slid %d, under bar %d, chute %d ticks / %.2f m, falls %d" % [
		state.total_frames, float(state.total_frames) / 60, crossed, landing, slide_start, under, slope_frames, slope_drop, state.falls]}
	if jump_frame >= 0:
		result["jump_frame"] = jump_frame
	if under >= 0:
		result["under_bar_frame"] = under
	if chute_frame >= 0:
		result["chute_frame"] = chute_frame
	if state.has("best_frames"):
		result["finish_frames"] = state.best_frames
	return result

extends Node
## Conservative, level-to-level reach: the parity fixture measured 33 airborne samples at full speed.
## This test examines dimensions fed to the kit builders. bot_course independently traverses the colliders.
var ctx: TLContext
var result: Dictionary


func _bot_setup(c: TLContext) -> void:
	ctx = c


func _bot_tick(_frame: int) -> void:
	var s := ctx.pack_state()
	var reach := float(s.run_mps) * 33.0 / 60.0
	var notes: PackedStringArray = []
	var spans := [float(s.first_land) - float(s.first_lip), float(s.chain_land) - float(s.chain_lip)]
	for i: int in spans.size():
		if spans[i] <= 0.0 or spans[i] > reach:
			notes.append("gap %d is %.2f m (running jump reach %.2f m)" % [i + 1, spans[i], reach])
	if s.clearance <= TLBiped.WALKER_SLIDE_HEIGHT or s.clearance >= TLBiped.WALKER_HEIGHT:
		notes.append("bar clearance %.2f m must lie between slide %.2f and standing %.2f m" % [
			s.clearance, TLBiped.WALKER_SLIDE_HEIGHT, TLBiped.WALKER_HEIGHT])
	if s.chute_degrees <= 55 or s.chute_degrees >= 90:
		notes.append("chute %.1f degrees must be steeper than 55 and below vertical" % s.chute_degrees)
	result = {"ok": notes.is_empty(), "summary": "gaps %.2f / %.2f m, reach %.2f m, bar %.2f m, chute %.0f deg%s" % [
		spans[0], spans[1], reach, s.clearance, s.chute_degrees, "" if notes.is_empty() else " | " + ", ".join(notes)]}


func _bot_done() -> bool:
	return not result.is_empty()


func _bot_result() -> Dictionary:
	return result

extends Node
## Negative controls through the same keys: miss both gaps, run into the lintel standing, try jumping, then restart.
var ctx: TLContext
var hand: TLHand
var phase := 0
var first_recovery := false
var second_recovery := false
var blocked_ticks := 0
var furthest := 0.0
var verdict: Dictionary


func _bot_setup(c: TLContext) -> void:
	ctx = c
	hand = TLHand.create(ctx, "perfect")


func _bot_tick(frame: int) -> void:
	var s := ctx.pack_state()
	var at := float(s.station)
	hand.press(&"forward")
	hand.press(&"run")
	match phase:
		0:
			if s.falls == 1:
				first_recovery = s.checkpoint == 0 and absf(at) < 0.2
				phase = 1
		1:
			if at >= s.first_lip - 0.85 and at < s.first_lip:
				hand.tap(&"jump")
				phase = 2
		2:
			if s.falls == 2:
				second_recovery = s.checkpoint == 1 and absf(at - (s.first_land + 2.5)) < 0.2
				phase = 3
		3:
			if at >= s.chain_lip - 0.85 and at < s.chain_lip:
				hand.tap(&"jump")
				phase = 4
		4:
			if at >= s.bar - 0.6:
				furthest = maxf(at, furthest)
				blocked_ticks += 1
				if blocked_ticks == 25:
					hand.tap(&"jump")
				if blocked_ticks == 85:
					hand.tap(&"restart")
					phase = 5
		5:
			verdict = {"ok": first_recovery and second_recovery and s.falls == 0 and s.checkpoint == 0 and at < 0.2
				and s.total_frames <= 1 and furthest < s.bar,
				"summary": "missed gaps respawned at start / checkpoint: %s / %s; with run and jump but no slide, furthest %.2f before bar %.2f in %d ticks; R reset station %.2f and time %d" % [
					first_recovery, second_recovery, furthest, s.bar, blocked_ticks, at, s.total_frames]}
	if frame >= 1000 and verdict.is_empty():
		verdict = {"ok": false, "summary": "failed obstacle probe in phase %d, station %.2f, falls %d" % [phase, at, s.falls]}
	hand.tick()


func _bot_done() -> bool:
	return not verdict.is_empty()


func _bot_result() -> Dictionary:
	return verdict

# Timber Run

Run `node devx/bin/tl.mjs play parkour`. In the village, enter the scaffold course on the south side of the road, west of the walker plot. Beat the 60-second clock and your best time this session.

| Control | Action |
|---|---|
| WASD or arrows | Move relative to the orbit camera |
| Shift | Run |
| Space | Jump |
| C | Slide while running on the ground |
| Right-drag / wheel | Orbit / zoom |
| R | Start another attempt |

Run up to the striped take-off boards. Jump the 3.4 m gap to the first checkpoint. Keep running, jump the 3.8 m gap, and **press C as your feet land**. The striped beam leaves 1.52 m of clearance. A standing runner is 1.80 m tall and slides at 0.84 m. Pass the beam for the second checkpoint, ride the 65-degree concrete chute down, and cross the finish stripe. A fall returns you to your last checkpoint while the clock keeps running. R clears the attempt and keeps the session best.

## Verification

The course layout is the same at every seed. The test hand is `perfect`. A clean run takes 338 race frames (5.633 seconds at 60 Hz). The runner reports 340 frames because the bot observes the finished rules on its following tick.

| Test | What must happen |
|---|---|
| `tests/bot_course.gd` | Jump and land beyond both spans, enter a run slide within two samples of landing the chain, travel under the beam in slide mode, descend at least 2 m in slope mode and finish without a fall. |
| `tests/bot_geometry.gd` | Each positive gap fits the measured 4.95 m airborne reach at 9 m/s. The beam fits only the short capsule. The chute exceeds the 55-degree walk limit. |
| `tests/bot_obstacles.gd` | Running off each lip without jumping returns the runner to its checkpoint. A standing runner pressing forward and trying a jump stays at the near face of the beam. R resets the clock and sends the runner back to the start. |

Run the pack checks from the repository root.

```sh
bash engine/tools/tl.sh lint --pack=engine/packs/parkour
bash engine/tools/tl.sh bot --pack=engine/packs/parkour --test=tests/bot_course.gd --seed=1
node devx/bin/tl.mjs check --tier full --only packs
bash engine/tools/selftest.sh walk.biped_parity
```

To reproduce the negative case, copy the pack to a scratch folder and set `chain_gap_m` to `12.0` in its `data/course.json`. Set the shell variable `bad` to the scratch pack path and run each command below. Both exit 1. The geometry bot identifies gap 2, and the input bot falls after clearing only gap 1.

```sh
bash engine/tools/tl.sh bot --pack="$bad" --test=tests/bot_geometry.gd
bash engine/tools/tl.sh bot --pack="$bad" --test=tests/bot_course.gd
```

The play view is `orbit`. Capture views are `overview`, `jump`, `under_bar` and `chute`. For the moving views pass `--test=tests/bot_course.gd` to the capture verb. Frames 73, 198 and 288 show the jump, bar and descent.


