extends Node
## The same race runs on stage, headless and on a village plot. TLRules owns time, ordered gates and personal bests.
const ACTIONS := {"left": &"left", "right": &"right", "forward": &"forward", "back": &"back",
	"run": &"run", "jump": &"jump", "slide": &"slide"}
const KILL_Y := -0.8
const SIDE := "runner"

var ctx: TLContext
var venue
var runner: TLBiped
var rules: TLRules
var cam: TLOrbitCam
var hud: TLHud
var spawn_at: Vector3
var falls := 0


func _pack_setup(c: TLContext) -> void:
	ctx = c
	venue = ctx.load_script("scripts/course.gd").new()
	TLKit.build_layout(ctx.read_json("yard.json"), ctx.root)
	venue.build(ctx.root, ctx.read_json("course.json"))
	spawn_at = venue.point(0, venue.DECK_Y + 0.04)
	runner = TLBiped.create({"feel": &"walker", "position": spawn_at, "name": "Runner",
		"rig_params": {"backpack": false, "expression": "focus", "colors": {"top": "flag_b", "trim": "white"}}})
	ctx.root.add_child(runner)
	rules = TLRules.create({"sides": [SIDE], "checkpoints": venue.checkpoints.size(), "laps_to_win": 1, "time_limit_seconds": 60})
	ctx.root.add_child(rules)
	for key: Array in [[&"forward", [KEY_W, KEY_UP]], [&"back", [KEY_S, KEY_DOWN]], [&"left", [KEY_A, KEY_LEFT]],
			[&"right", [KEY_D, KEY_RIGHT]], [&"jump", [KEY_SPACE]], [&"run", [KEY_SHIFT]], [&"slide", [KEY_C]], [&"restart", [KEY_R]]]:
		ctx.input.declare(key[0], key[1])
	cam = ctx.cameras.orbit(runner, {"yaw": -90, "distance": 5.5, "pitch": 33, "look_height": 1.1, "fov": 55})
	ctx.cameras.add_view(&"overview", Vector3(-3.5, 27, 37), Vector3(0, 4, 0), 40)
	_view(&"jump", venue.FIRST_LIP + 1.5, Vector3(1.8, 1.15, 6.4), 1.0)
	_view(&"under_bar", venue.bar + 0.3, Vector3(5.6, 2.3, 6.5), 0.85)
	_view(&"chute", (venue.lip + venue.foot) / 2, Vector3(4.0, 1.3, 8.2), -2.4)
	hud = TLHud.create()
	ctx.root.add_child(hud)
	hud.add_label(&"race", "", &"top_left")
	hud.set_plate(&"race")
	hud.add_label(&"controls", "WASD / arrows  Move     Shift  Run     Space  Jump     C  Slide     R  Restart", &"bottom")
	hud.set_plate(&"controls")


func _view(id: StringName, station: float, offset: Vector3, above: float) -> void:
	var target: Vector3 = venue.point(station, venue.DECK_Y + above)
	ctx.cameras.add_view(id, target + offset, target, 45)


func _pack_start() -> void:
	_restart()


func _restart() -> void:
	spawn_at = venue.point(0, venue.DECK_Y + 0.04)
	runner.place(spawn_at)
	cam.snap()
	falls = 0
	rules.start()
	_update_hud()


func _pack_tick(_frame: int) -> void:
	if ctx.input.just_pressed(&"restart"):
		_restart()
	if rules.is_running():
		var at: float = runner.position.x - venue.START_X
		# Catch a miss before a trestle underneath a high deck can catch the runner.
		var below_decks: bool = at < venue.lip and runner.position.y < venue.DECK_Y - 1.35
		var retry := _at_blocked_bar(at) and ctx.input.just_pressed(&"slide")
		if runner.position.y < KILL_Y or below_decks or retry:
			if not retry:
				falls += 1
			runner.place(spawn_at)
			at = spawn_at.x - venue.START_X
			cam.snap()
		runner.drive_from_input(ctx.input, ACTIONS, cam.yaw_basis())
		var index := int(rules.next_checkpoint[SIDE])
		var station: float = venue.checkpoints[index]
		var height: float = 0.0 if index == venue.checkpoints.size() - 1 else venue.DECK_Y
		var feet := runner.position
		# A late jump can land beyond the stripe. The entire approach earns its respawn.
		var end: float = venue.bar if index == 1 else station + 0.6
		# The beam checkpoint is inside the opening. Jumping around a jamb cannot earn it.
		var on_route: bool = index != 2 or (at < venue.bar + venue.BAR_DEPTH and absf(feet.z) < venue.WIDTH / 2 - 0.35)
		if on_route and runner.grounded and absf(feet.y - height) < 0.2 and absf(feet.z) < venue.WIDTH / 2 \
				and at >= station and at < end:
			if rules.pass_checkpoint(SIDE, index):
				var safe_station: float = venue.bar + venue.BAR_DEPTH + 1.0 if index == 2 else station
				spawn_at = venue.point(safe_station, height + 0.04)
	else:
		runner.move(Vector3.ZERO)
	_update_hud()


func _at_blocked_bar(at: float) -> bool:
	return int(rules.next_checkpoint[SIDE]) == 2 and runner.grounded and runner.speed() < 0.5 \
		and at > venue.bar - 0.6 and at < venue.bar


func _update_hud() -> void:
	var best := "â€”"
	if rules.best_lap_frames.has(SIDE):
		best = "%.2f s" % (float(rules.best_lap_frames[SIDE]) / 60)
	var caption := "TIMBER RUN    |    %d / %d" % [int(rules.next_checkpoint[SIDE]), venue.checkpoints.size()]
	var cue: String = ["Run + jump", "Jump the gap", "Slide under the beam", "Down the chute"][int(rules.next_checkpoint[SIDE])]
	if _at_blocked_bar(runner.position.x - venue.START_X):
		cue = "C  Retry from checkpoint"
	caption += "    " + cue
	if rules.is_over():
		caption = "FINISH" if rules.reason == "laps" else "TIME UP"
	hud.set_text(&"race", "%s\n%.2f s     Best  %s" % [caption, rules.seconds_played(), best])


func _pack_state() -> Dictionary:
	var s := rules.snapshot()
	s.merge({"station": runner.position.x - venue.START_X, "height": runner.position.y, "motion": runner.walker_motion(),
		"speed": runner.speed(), "falls": falls, "checkpoint": int(rules.next_checkpoint[SIDE]),
		"first_lip": venue.FIRST_LIP,
		"first_land": venue.first_land, "chain_lip": venue.chain_lip, "chain_land": venue.chain_land,
		"bar": venue.bar, "bar_depth": venue.BAR_DEPTH, "lip": venue.lip, "foot": venue.foot, "deck_y": venue.DECK_Y,
		"clearance": venue.clearance, "chute_degrees": rad_to_deg(venue.angle), "run_mps": runner.run_speed})
	if rules.best_lap_frames.has(SIDE):
		s["best_frames"] = int(rules.best_lap_frames[SIDE])
	return s

# Lane parkour: polish the landed course to the winning look (night of 19 Nov)

Shift `2026-11-19-night`, lane `parkour`. Worktree `.claude/worktrees/n19-parkour` (branch `n19-parkour`). Time box 00:00-06:30.
Route: **Astra alone** for the look (it won the owner's eye in the trial: course D). The Opus agent that runs this lane
launches Codex with this brief verbatim, does NOT direct the art, then verifies the gates, captures the clip and writes
REPORT.md. It may resume Astra by session id with the gate failures it found, and nothing else.

## The owner's words
"Parkour winners - D, with F as close second place, E as close third" ... "Land F, polish later". F's code is on main
(`engine/packs/parkour`). D's and E's code no longer exists; their stills and reports do (`ref/` beside this brief).

## Goal
Course F plays as it does, but LOOKS like D: read `ref/b-*.jpg` (D's course, jump, bar, chute, from the village road) and
`ref/D-report.md`, compare with F's look in the game, and bring F to D's look with house kit parts and the house toon
style (no hand-made materials, lights or environments). Then E's retry room: E moved the bar 3.5 -> 5.5 m into its deck
because "a regular-hand retry had no run-up" (`ref/E-report.md` line 66, `ref/E-bar_slide.jpg`). Give F's bar the same
run-up, so a failed slide can be retried from the checkpoint without walking back.

## Acceptance
- Stills of F after the pass, from the same five views as D's (course, jump, bar, chute, village road), side by side with
  D's in `lanes/parkour/stills/`, plus a contact sheet.
- The bar has a run-up after its checkpoint; a regular-hand bot retry at the bar finishes (`tl ladder` or the pack's bot
  tests; quote the hand and the seed count).
- Every parkour bot test and the impossibility test still pass; `node devx/bin/tl.mjs check --tier full --only packs,world` PASS.
- A clip of at most 20 s of one full run in a window (`engine/tools/look.sh clip`, or Godot `--write-movie` at 1280x720
  then mp4) at `lanes/parkour/clip.mp4`.
- No kernel change. Kit additions only if no existing part fits (say which ones you looked at in `engine/kits/KIT.md`).

## Scope
`engine/packs/parkour/**`, `engine/kits/**` (additions only), `docs/shifts/2026-11-19-night/lanes/parkour/**`.

---

# Lane rules (pasted verbatim into every lane brief)

## Standups: you report, the Director reads
- Keep `docs/shifts/<shift>/lanes/<lane>/STANDUP.md` in YOUR worktree (the Director reads it there and copies it to main
  when the lane lands).
- Append one line at each milestone and at least every 60 minutes of work:
  `HH:MM | state: working|blocked|done|cut | did: <one line> | next: <one line> | gates: <last PASS/FAIL line or ->`
- `blocked` names the question in the same line. Then keep working on whatever the block does not touch.
- When you finish, write `REPORT.md` beside it (below) and set the last standup line to `done`.

## Honesty
- Evidence or it is not done: a gate line, a test count, a still, a video, a repro before and after.
- A stopped run is never a pass. NOT RUN is not PASS. Fewer tests completed than on main is a stopped run.
- Unmeasured is not zero. Never fake a frame, a figure or a hash.
- A behaviour change that moves a test expectation is named, with why. Never loosen a test to make it pass.
- What the player sees or feels is judged as a person meets it (a window, the exported game), not only headless.

## Laws (CLAUDE.md)
- Work only in your worktree. No git that writes (read-only `git diff`/`git status` are fine). The Director lands.
- Never kill a process you did not start. Prefer `--headless`. Build the class cache once: `"$G" --headless --path engine --import`.
- Time is physics frames; determinism (same pack + seed + frames = same state_hash); unknown keys are errors; packs use only
  the TL* API and never declare class_name; kit, rigs, style reference nothing outside themselves.
- Contracts (`contracts/*`) are Director-only: put the question in your report.
- New selftest cases go in your own `engine/tools/selftest.d/NNN-<name>.sh` file.
- A kernel API addition updates `engine/kernel/API.md`; the Director regenerates docs on main (`tl arch --index`).
- Gates before `done`: `node devx/bin/tl.mjs check --tier fast`; when kernel, kits, rigs, style or seeds changed, also
  `node devx/bin/tl.mjs check --tier full` (perf alone if it says NOT RUN).

## REPORT.md
- Outcome against each acceptance criterion: met / not met, with its evidence.
- Gates with PASS/FAIL lines and counts.
- Changed files; behaviour changes; anything the owner should look at, and how.
- Questions for the Director; the next three things this lane would do.


