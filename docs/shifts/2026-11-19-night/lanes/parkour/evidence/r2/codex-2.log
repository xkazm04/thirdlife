from pathlib import Path
from PIL import Image, ImageDraw, ImageFont

lane = Path(__file__).resolve().parent.parent
stills = lane / \"stills-r2\"
out = stills / \"comparisons\"
out.mkdir(exist_ok=True)
paper = \"#172422\"
title_ink = \"#fbf4df\"
muted = \"#bfd1c3\"
accent = \"#eed08b\"

def font(size, bold=False):
    return ImageFont.truetype(\"C:/Windows/Fonts/\" + (\"segoeuib.ttf\" if bold else \"segoeui.ttf\"), size)

def label(draw, xy, value, size=22, color=title_ink, bold=False):
    draw.text(xy, value, fill=color, font=font(size, bold), anchor=\"lt\")

def picture(canvas, file, x, y, w):
    h = w * 9 // 16
    with Image.open(file) as im:
        assert abs(im.width/im.height - 16/9) < .01, (file, im.size)
        canvas.paste(im.convert(\"RGB\").resize((w,h), Image.Resampling.LANCZOS), (x,y))
    return h

views = [(\"course\",\"Course overview\",\"Pack frame 1\"),
         (\"jump\",\"First jump\",\"Pack frame 73\"),
         (\"bar\",\"Under the beam\",\"Pack frame 228\"),
         (\"chute\",\"Chute descent\",\"Pack frame 288\"),
         (\"village-road\",\"Village road\",\"Visitor camera at world tick 103\")]
edges = [(\"02_through-gate\",\"Through the gate\",243),
         (\"03_edge-across-fence\",\"Across the east fence\",485),
         (\"04_edge-along-fence\",\"Along the east fence\",642),
         (\"05_edge-facing-yard\",\"Looking back from the rim\",735)]
colnames = [\"D   /   Reference\",\"F   /   Before\",\"F   /   After\"]
def main_files(key):
    name = \"road/01_village-road.png\" if key==\"village-road\" else f\"F-{key}.png\"
    return [lane/f\"ref/b-{key}.jpg\",stills/\"before\"/name,stills/\"after\"/name]
def edge_files(key):
    return [stills/t/\"walk\"/(key+\".png\") for t in (\"before\",\"after\")]

def compare(key, name, detail, files, columns):
    tile = 960
    border, gutter = 18, 10
    width = 2*border+len(files)*tile+(len(files)-1)*gutter
    im = Image.new(\"RGB\",(width,116+tile*9//16+border),paper)
    d = ImageDraw.Draw(im)
    label(d,(border,18),name,32,bold=True)
    d.text((width-border,25),detail,font=font(23),fill=muted,anchor=\"rt\")
    for i,(filename,col) in enumerate(zip(files,columns)):
        x = border+i*(tile+gutter)
        label(d,(x,76),col,22,accent if i==len(files)-1 else muted)
        picture(im,filename,x,115,tile)
    im.save(out/(key+\".jpg\"),quality=92,subsampling=0,optimize=True)

W = 1800
pad, gap, tile = 24, 9, 578
row_h = 387
edge_tile = 428
edge_h = 324
edge_top = 150 + len(views)*row_h
H = edge_top+76+2*edge_h+pad
sheet = Image.new(\"RGB\",(W,H),paper)
d = ImageDraw.Draw(sheet)
label(d,(pad,24),\"Timber Run\",46,bold=True)
label(d,(pad,85),\"Course framing\",27,muted)
for i,name in enumerate(colnames):
    label(d,(pad+i*(tile+gap),127),name,21,accent if i==2 else muted)
for row,(key,name,detail) in enumerate(views):
    files = main_files(key)
    compare(key,name,detail,files,colnames)
    y = 160+row*row_h
    for i,f in enumerate(files):
        picture(sheet,f,pad+i*(tile+gap),y,tile)
    label(d,(pad,y+tile*9//16+9),name,23,bold=True)
    d.text((W-pad,y+tile*9//16+10),detail.replace(\"Pack frame\",\"F frame\"),font=font(20),fill=muted,anchor=\"rt\")
label(d,(pad,edge_top+6),\"Village plot edge\",35,bold=True)
for i,(key,name,tick) in enumerate(edges):
    files = edge_files(key)
    compare(key.partition(\"_\")[2],name,\"Visitor camera at world tick \"+str(tick),files,[\"F   /   Before\",\"F   /   After\"])
    x = pad+(i%2)*887
    y = edge_top+73+(i//2)*edge_h
    label(d,(x,y),name,24,bold=True)
    d.text((x+2*edge_tile+gap,y+3),\"Tick \"+str(tick),font=font(18),fill=muted,anchor=\"rt\")
    for j,(f,t) in enumerate(zip(files,(\"Before\",\"After\"))):
        cx=x+j*(edge_tile+gap)
        picture(sheet,f,cx,y+36,edge_tile)
        label(d,(cx,y+43+edge_tile*9//16),t,18,accent if j else muted)
sheet.save(stills/\"contact-sheet.jpg\",quality=91,subsampling=0,optimize=True)
