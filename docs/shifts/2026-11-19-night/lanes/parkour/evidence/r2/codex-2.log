## Stations increase eastward so the whole silhouette faces the village road.
const WIDTH := 5.0
const DECK_Y := 7.0
const START_X := -22.0
const FIRST_LIP := 8.0
const BAR_DEPTH := 0.68
const DROP := 7.0
const YARD_Y := -1.25

var root: Node3D
var first_land: float
var chain_lip: float
var chain_land: float
var bar: float
var lip: float
var foot: float
var finish: float
var clearance: float
var angle: float
var checkpoints: Array[float] = []


func build(parent: Node3D, data: Dictionary) -> void:
	root = parent
	for key: String in data:
		if key not in ["first_gap_m", "chain_gap_m", "bar_clearance_m", "chute_degrees"]:
			push_error("Unknown course key '%s'" % key)
	first_land = FIRST_LIP + float(data["first_gap_m"])
	chain_lip = first_land + 10.0
	chain_land = chain_lip + float(data["chain_gap_m"])
	bar = chain_land + 5.5 - BAR_DEPTH / 2
	lip = chain_land + 9.15
	clearance = float(data["bar_clearance_m"])
	angle = deg_to_rad(float(data["chute_degrees"]))
	foot = lip + DROP / tan(angle)
	finish = foot + 5.0
	checkpoints = [first_land + 2.5, chain_land + 0.65, bar + BAR_DEPTH / 2, finish]

	_deck(-2, FIRST_LIP, DECK_Y)
	_deck(first_land, chain_lip, DECK_Y)
	_deck(chain_land, lip, DECK_Y)
	_deck(foot, finish + 2, 0)
	var slope_length := DROP / sin(angle)
	var slope := _part("ground_patch", {"size_x": slope_length, "size_z": WIDTH,
		"thickness": 0.32, "surface": "concrete"}, (lip + foot) / 2, DECK_Y - DROP / 2)
	slope.rotation.z = -angle
	for side: float in [-1.0, 1.0]:
		var cheek := _part("kerb", {"length": slope_length, "width": 0.3, "height": 0.18},
			lip, DECK_Y, side * (WIDTH / 2 - 0.05))
		cheek.rotation.z = -angle
		for station: float in [0.0, checkpoints[0], finish]:
			_part("flag", {"height": 3.0, "color": "flag_a" if station == finish else "flag_b"},
				station, 0.0 if station == finish else DECK_Y, side * (WIDTH / 2 + 0.12))
		# One short red kerb stood on end forms each jamb.
		var jamb := _part("kerb", {"length": clearance, "width": BAR_DEPTH, "height": 0.27},
			bar + BAR_DEPTH / 2, DECK_Y, side * (WIDTH / 2 - 0.2))
		jamb.basis = Basis(Vector3.UP, PI / 2) * Basis(Vector3.BACK, PI / 2)
	var beam := _part("kerb", {"length": WIDTH + 0.4, "width": BAR_DEPTH, "height": 0.48},
		bar + BAR_DEPTH / 2, DECK_Y + clearance, -(WIDTH + 0.4) / 2)
	beam.rotation.y = -PI / 2
	for station: float in [0.0, FIRST_LIP - 0.45, first_land + 0.55, chain_lip - 0.45, checkpoints[1], lip - 0.45]:
		_stripe(station, DECK_Y)
	_stripe(finish, 0)


func point(station: float, y: float, lateral: float = 0.0) -> Vector3:
	return Vector3(START_X + station, y, lateral)


func _part(kind: String, params: Dictionary, station: float, y: float, lateral: float = 0.0) -> Node3D:
	var part := TLKit.build(kind, params)
	part.position = point(station, y, lateral)
	root.add_child(part)
	return part


func _deck(a: float, b: float, y: float) -> void:
	_part("ground_patch", {"size_x": b - a, "size_z": WIDTH, "thickness": 0.34, "surface": "wood"}, (a + b) / 2, y)
	if y < 1.0:
		_part("ground_patch", {"size_x": b - a - 0.25, "size_z": WIDTH - 0.25, "thickness": y - YARD_Y - 0.3,
			"surface": "concrete"}, (a + b) / 2, y - 0.3)
		return
	# Scaffold galleries run along the deck edges. Their top rails stop at each jump.
	var bays := ceili((b - a) / 3.2)
	for lateral: float in [-WIDTH / 2 - 0.65, WIDTH / 2 - 0.15]:
		_part("scaffold", {"bays": bays, "bay_w": (b - a - 0.36) / bays, "bay_d": 0.8,
			"levels": 3, "level_h": (y - YARD_Y - 0.12) / 3, "decks": [2, 3]}, a + 0.18, YARD_Y, lateral)


func _stripe(station: float, y: float) -> void:
	var line := _part("kerb", {"length": WIDTH - 0.15, "width": 0.30, "height": 0.03},
		station, y, -(WIDTH - 0.15) / 2)
	line.rotation.y = -PI / 2

// `tl ladder`: a pack's ladder (H5/H6): every bot_ladder_<level>_<hand>.gd test the pack names, over N seeds, as one table.
// A cell is one test; each seed is one run. A run is completed when the bot finished (tl.verify/1 line, bot.completed true),
// every other check but bot.ok passed (bot.ok false is a lost game, a sample; a script error or a watchdog is not: hunt2 B8)
// and the runner exited 0 or 1 (2 could not run, 3 watchdog).
// Cells found / completed are reported (docs/GATE-HONESTY.md): the command fails when a cell did not complete every seed.
// The manifest has no `ladder` key (contracts/pack.schema.json forbids unknown keys): cells are found by file name.
export const summary = "a pack's difficulty ladder: `tl ladder --pack <dir> [--seeds N] [--cells a,b] [--par N]` (bot_ladder_* tests over N seeds; wins with a 95 % interval)";
import fs from "node:fs";
import path from "node:path";
import { spawn } from "node:child_process";
import * as realCtx from "../ctx.mjs";
import { usage, couldNotRun } from "../verdict.mjs";

const USAGE = "usage: tl ladder --pack <dir> [--seeds N] [--cells <level_hand>[,..]] [--par N]";

export function parseArgs(args) {
  const o = { pack: null, seeds: 20, cells: null, par: 6 };
  for (let i = 0; i < args.length; i++) {
    const a = args[i], val = () => { const v = args[++i]; if (v === undefined) throw new Error(`${a} needs a value`); return v; };
    const [k, inline] = a.includes("=") ? [a.slice(0, a.indexOf("=")), a.slice(a.indexOf("=") + 1)] : [a, undefined];
    const v = () => (inline !== undefined ? inline : val());
    if (k === "--pack") o.pack = v();
    else if (k === "--seeds") o.seeds = Number(v());
    else if (k === "--cells") o.cells = v().split(",").filter(Boolean);
    else if (k === "--par") o.par = Number(v());
    else throw new Error(`unknown option ${a}`);
  }
  if (!o.pack) throw new Error("--pack is required");
  if (!(o.seeds >= 1)) throw new Error("--seeds must be at least 1");
  if (!(o.par >= 1)) throw new Error("--par must be at least 1");
  return o;
}

/** The ladder cells a pack names: tests/bot_ladder_<level>_<hand>.gd. -> [{cell, test, level, hand}] */
export function findCells(packDir, only = null) {
  const man = JSON.parse(fs.readFileSync(path.join(packDir, "pack.json"), "utf8"));
  return (man.tests ?? []).map((t) => path.basename(t, ".gd")).filter((b) => b.startsWith("bot_ladder_")).map((b) => {
    const cell = b.slice("bot_ladder_".length), cut = cell.lastIndexOf("_");
    return { cell, test: `tests/${b}.gd`, level: cut > 0 ? cell.slice(0, cut) : cell, hand: cut > 0 ? cell.slice(cut + 1) : "?" };
  }).filter((c) => !only || only.includes(c.cell));
}

/** One run's report -> {done, rejected, won, gf, ga, frames, period, passes, reached, down, hash} or null when there is no verify line.
 *  `code`: the runner's exit code when known. */
export function readRun(stdout, code = null) {
  const line = String(stdout).split(/\r?\n/).filter((l) => l.startsWith("{")).reverse().find((l) => { try { return JSON.parse(l).schema === "tl.verify/1"; } catch { return false; } });
  if (!line) return null;
  const v = JSON.parse(line), b = v.bot?.result ?? {};
  const rejected = (v.checks ?? []).filter((c) => c.ok !== true && c.id !== "bot.ok" && c.id !== "bot.completed").map((c) => c.id);
  if (code !== null && code !== 0 && code !== 1) rejected.push(`exit ${code}`);
  const done = (v.checks ?? []).some((c) => c.id === "bot.completed" && c.ok === true) && rejected.length === 0;
  return { done, rejected, won: b.won === true, gf: Number(b.goals) || 0, ga: Number(b.against) || 0, frames: Number(b.frames) || 0, period: Number(b.period_reached) || 0,
    passes: Number(b.passes) || 0, reached: Number(b.passes_reached) || 0, down: Number(b.down_frames) || 0, taps: Number(b.taps_lost) || 0, shots: Number(b.shots) || 0, hash: v.metrics?.state_hash?.slice(0, 16) };
}

/** Wins of n with a 95 % interval (normal approximation), in whole percent. */
export function interval(w, n) {
  const p = n ? w / n : 0, h = n ? 1.96 * Math.sqrt(p * (1 - p) / n) : 0;
  return { pct: Math.round(p * 100), lo: Math.round(Math.max(0, p - h) * 100), hi: Math.round(Math.min(1, p + h) * 100) };
}

/** Pure core: cells x seeds through runBot(cell, seed) -> Promise<stdout>. -> rows */
export async function ladder(cells, seeds, par, runBot) {
  const jobs = [];
  for (const c of cells) for (let s = 1; s <= seeds; s++) jobs.push({ c, s });
  const got = new Map(cells.map((c) => [c.cell, []]));
  let i = 0;
  await Promise.all(Array.from({ length: Math.min(par, jobs.length) }, async () => {
    while (i < jobs.length) {
      const j = jobs[i++], got1 = await runBot(j.c, j.s);   // a string (stdout) or {stdout, code}
      got.get(j.c.cell).push({ seed: j.s, r: typeof got1 === "string" ? readRun(got1) : readRun(got1?.stdout ?? "", got1?.code ?? null) });
    }
  }));
  return cells.map((c) => {
    const runs = got.get(c.cell).sort((a, b) => a.seed - b.seed), ok = runs.filter((x) => x.r && x.r.done).map((x) => x.r);
    const n = ok.length, sum = (k) => ok.reduce((a, r) => a + r[k], 0), w = ok.filter((r) => r.won).length;
    return { ...c, found: seeds, completed: n, wins: w, ...interval(w, n), gf: n ? +(sum("gf") / n).toFixed(2) : 0, ga: n ? +(sum("ga") / n).toFixed(2) : 0,
      frames: n ? Math.round(sum("frames") / n) : 0, draws: ok.filter((r) => r.gf === r.ga).length, taps_lost: sum("taps"), shots: sum("shots"), period2: ok.filter((r) => r.period >= 2).length, passes: sum("passes"), reached: sum("reached"),
      down_pct: +(100 * sum("down") / Math.max(1, sum("frames"))).toFixed(2), missing: runs.filter((x) => !x.r || !x.r.done).map((x) => x.seed),
      rejected: runs.filter((x) => x.r && x.r.rejected.length).map((x) => `${x.seed}: ${x.r.rejected.join("+")}`) };
  });
}

function realRunBot(ctx, packDir) {
  const sh = process.platform === "win32" && fs.existsSync("C:/Program Files/Git/bin/bash.exe") ? "C:/Program Files/Git/bin/bash.exe" : "bash";
  const godot = ctx.resolveGodot();
  return (c, seed) => new Promise((res) => {
    const p = spawn(sh, [path.join(ctx.ENGINE, "tools", "tl.sh"), "bot", `--pack=${packDir}`, `--test=${c.test}`, `--seed=${seed}`],
      { cwd: ctx.REPO, env: { ...process.env, TL_QUIET: "1", ...(godot ? { TL_GODOT: godot } : {}) } });
    let out = "";
    p.stdout.on("data", (d) => (out += d));
    p.stderr.on("data", () => {});
    p.on("error", () => res({ stdout: "", code: 2 }));
    p.on("close", (code) => res({ stdout: out, code }));
  });
}

/** deps = {ctx, runBot}: the test seam. Returns the exit code. */
export async function execute(args, deps = {}) {
  const ctx = deps.ctx ?? realCtx;
  let o;
  try { o = parseArgs(args); } catch (e) { return usage("ladder", `tl ladder: ${e.message}\n${USAGE}`); }
  const packDir = path.resolve(ctx.REPO, o.pack);
  if (!fs.existsSync(path.join(packDir, "pack.json"))) return couldNotRun("ladder", `tl ladder: no pack.json in ${packDir}`);
  const cells = findCells(packDir, o.cells);
  if (!deps.runBot && !ctx.resolveGodot()) return couldNotRun("ladder", "tl ladder: Godot not found (tl doctor)");
  const t0 = Date.now();
  const rows = cells.length ? await ladder(cells, o.seeds, o.par, deps.runBot ?? realRunBot(ctx, packDir)) : [];
  console.log(`level      hand      wins          win % (95 %)   goals for:against  frames  period 2  passes reached  down %  draws  taps lost  his shots`);
  for (const r of rows) console.log(`${r.level.padEnd(10)} ${r.hand.padEnd(9)} ${String(r.wins).padStart(3)} of ${String(r.completed).padEnd(4)}  ${String(r.pct).padStart(3)} (${r.lo}..${r.hi})`.padEnd(54) +
    `${r.gf.toFixed(2)} : ${r.ga.toFixed(2)}`.padEnd(19) + `${String(r.frames).padStart(6)}  ${String(r.period2).padStart(3)}/${r.completed}   ${r.reached}/${r.passes}`.padEnd(30) + `${String(r.down_pct).padEnd(7)}${String(r.draws).padEnd(7)}${String(r.taps_lost).padEnd(11)}${r.shots}`);
  const steps = rows.map((r) => ({ id: `ladder:${r.cell}`, ok: r.completed === r.found, ms: 0, found: r.found, completed: r.completed,
    detail: `${r.wins} of ${r.completed} won (${r.pct} %, ${r.lo}..${r.hi}) through the ${r.hand} hand${r.missing.length ? `; seeds not completed: ${r.missing.join(",")}` : ""}${r.rejected.length ? ` (rejected by the verifier: ${r.rejected.join("; ")})` : ""}` }));
  if (!steps.length) steps.push({ id: "ladder", ok: false, ms: 0, found: 0, completed: 0, detail: `no bot_ladder_* test in ${path.join(o.pack, "pack.json")}: found 0 cells` });
  const cellsDone = rows.filter((r) => r.completed === r.found).length;
  return ctx.printVerdict("ladder", steps, { pack: o.pack, seeds: o.seeds, cells_found: rows.length, cells_completed: cellsDone, ms: Date.now() - t0,
    cells: rows.map(({ missing, rejected, test, ...r }) => r) });
}

export async function run(args, ctx) { return execute(args, { ctx }); }

# D3 arm B | Roofline Relay

All four acceptance lines are met. Play with `node devx/bin/tl.mjs play parkour`, or enter the blue-flagged plot south of the village road, west of the walker yard, centred at **(-192, 3, -48)**. Scripted keyboard play finished in **5.92 s** both alone and after walking in from the road.

1. **Gates â€” met.** `check --tier fast --changed` exited 0 with 15/15 selected units. `check --tier full` exited 0 with **944/944 units, 14/14 steps** on the third run. Parkour passed lint with zero bypasses, 3,600-frame smoke, all three bots and invariants. All eight games matched in the world. Parkourâ€™s world and standalone hashes were both `8313175e5eedce9d` at frame 357.
2. **Stills â€” met.** Five 1920 Ă— 1080 captures show the [course from above](stills/b-course.png), [jump at frame 69](stills/b-jump.png), [slide under the bar at frame 197](stills/b-bar.png), [chute descent at frame 295](stills/b-chute.png) and [plot from the village road](stills/b-village-road.png).
3. **Completion and impossibility â€” met.** The perfect-hand bot finished **20/20 seeds in 355 timed ticks (5.917 s)** with zero falls. Widening only the first gap from 3.2 m to 12 m made the same bot exit 1 after two falls before the first checkpoint. A recovery run finished in 436 ticks and kept its best time across R. An upright runner holding forward and run stopped 0.60 m before the barâ€™s centre for 30 ticks.
4. **Walker reuse â€” met.** Kernel API **1.7** exposes the village mover through `TLWalker`. It queries the packâ€™s physics space and lowers the capsule to 0.85 m during a run slide. On a flat test deck, pack and village both jumped **0.943 m in 33 airborne ticks**, reached walk and run speed in eight ticks each, and slid for 54 ticks over 5.31 m. A live-entry test also exposed held bot inputs carrying into player control. The handoff now releases them.

**Files changed.** Added `engine/packs/parkour/` and its three bots. Updated the house-game README, both boot manifests, the kernel API reference, walker collision and movement code, and runner manifest, lint and visit code. Regenerated `API-INDEX.md`, `API-V1.json` and `REPORTS.md`. The report and five PNGs are under `docs/reports/astra-trial/d3/`.

**Next.** Playtest the second landing with a regular hand to measure how often players reach the slide in time.

**Cost.** 82 min 54 s wall time, from 14:26:28 to 15:49:22 CET. Token usage was unavailable. The first full run had two failing checks and a busy-machine performance result. The second passed 942 counted units but could not judge performance. The third passed both performance scenarios at 33% machine use.

