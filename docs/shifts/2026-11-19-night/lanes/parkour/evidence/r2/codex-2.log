def bot(path,test,seed):
    p=subprocess.run([sh,'engine/tools/tl.sh','bot','--pack='+Path(path).resolve().as_posix(),'--test=tests/'+test+'.gd',f'--seed={seed}'],capture_output=True)
    return p.returncode,json.loads(p.stdout.splitlines()[-1])
src=Path('engine/packs/parkour')
def sample(seed):
    code,v=bot(src,'bot_ladder_retry_newcomer',seed)
    return {'seed':seed,'exit':code,'completed':next(c['ok'] for c in v['checks'] if c['id']=='bot.completed'),'result':v['bot']['result'],'state_hash':v['metrics']['state_hash']}
with ThreadPoolExecutor(max_workers=2) as pool:
    runs=list(pool.map(sample,range(1,21)))
assert len(runs)==20 and all(row['completed'] for row in runs)
(e/'newcomer-seeds.json').write_text(json.dumps(runs,indent=2)+'\\n')
