+extends "bot_ladder_retry_regular.gd"
+## Measure the same retry through a slower hand. Only a witnessed block, retry, slide and finish wins.
+
+
+func _init() -> void:
+	hand_profile = "newcomer"
+
+
+func _bot_result() -> Dictionary:
+	var result := super._bot_result()
+	# A full race timeout is a measured loss. Partial runs and finishes that bypass the retry fail the probe.
+	result.ok = result.won or (state.reason == "time" and state.total_frames == 3600 and hand.stats().presses > 0)
+	return result
