			match str(e):
				"jump":
					_clip(&"jump")
				"land":
					if mode != "slope":
						_clip(&"land")
				"slide":
					_clip(&"slide")
				"slope":
					_clip(&"slope_slide")
				"end_slide":
					# a slide started this very tick ends here too (pressed on the edge tick, D19)
					if was == "slide" or was == "slope" or (res["events"] as Array).has("slide"):
						_clip(&"")
		rig.call("tick", frame)


static func add_cabin(mk: TLMesh, o: Vector3, yaw: float = 0.0) -> void:
	mk.push_at(o, Vector3(0, yaw, 0))
	for sx: float in [-2.6, 2.6]:
