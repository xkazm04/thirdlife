{
  "id": "game.three_against_three_hockey",
  "version": "0.1.24",
  "kernelApi": "1.31",
  "title": "Three against three hockey on a harbour rink at dusk with power-ups on the ice",
  "capabilities": [
    "audio",
    "input",
    "camera",
    "kit",
    "style",
    "ui",
    "physics",
    "vfx"
  ],
  "entry": "scripts/main.gd",
  "assets": [
    "gen/tj_rink.gd"
  ],
  "tests": [
    "tests/bot_match_hand.gd",
    "tests/bot_first_match.gd",
    "tests/bot_skin.gd",
    "tests/bot_toys.gd",
    "tests/bot_harbour.gd",
    "tests/bot_meteor_blind.gd",
    "tests/bot_s4.gd"
  ],
  "cameras": [
    "follow",
    "top"
  ],
  "base": "rink_game",
  "params": [
    {
      "name": "bubble_size",
      "file": "data/tuning.json",
      "path": "harbour.bubble_r_m",
      "min": 0.8,
      "max": 1.6,
      "step": 0.05,
      "label": "Bubble size"
    },
    {
      "name": "bubble_recoil",
      "file": "data/tuning.json",
      "path": "harbour.recoil_m",
      "min": 0.1,
      "max": 0.8,
      "step": 0.05,
      "label": "Bounce recoil"
    },
    {
      "name": "arrow_flash",
      "file": "data/tuning.json",
      "path": "harbour.arrow_flash_f",
      "min": 8,
      "max": 60,
      "step": 2,
      "label": "Arrow flash time"
    },
    {
      "name": "goal_shake",
      "file": "data/tuning.json",
      "path": "harbour.shake_m",
      "min": 0,
      "max": 0.4,
      "step": 0.02,
      "label": "Camera shake"
    }
  ],
  "subject": "Skater"
}
