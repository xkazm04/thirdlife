 266 func look_angles(target_world: Vector3, eye_local: Vector3) -> Vector2:
 267 	# yaw (+ = left) and pitch (+ = up) in degrees from the rig's forward (-Z) to a world point
 268 	var d: Vector3 = to_local(target_world) - eye_local if is_inside_tree() else target_world - eye_local
 269 	if d.length() < 0.001:
 270 		return Vector2.ZERO
 271 	return Vector2(rad_to_deg(atan2(-d.x, -d.z)), rad_to_deg(atan2(d.y, Vector2(d.x, d.z).length())))
