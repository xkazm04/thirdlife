  21 const ACTIONS: Array = [[&"forward", KEY_W], [&"back", KEY_S], [&"left", KEY_A], [&"right", KEY_D], [&"run", KEY_SHIFT],
  22 	[&"enter", KEY_E], [&"leave", KEY_Q], [&"quit", KEY_ESCAPE], [&"jump", KEY_SPACE], [&"slide", KEY_C]]
  23 const LOOK_DEG_PER_PX: float = 0.15     # 600 px of mouse = 90 degrees
