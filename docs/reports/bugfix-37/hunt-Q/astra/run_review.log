 383 ## A pack comes back from its plot record: a new holder, built from the seed; the pack's own saved data, if any.
 384 func _rebuild(i: int, rec: Dictionary) -> void:
 385 	var old: Node = packs[i]
 386 	for c: Node in old.get_children():
 387 		c.free()
 388 	old.call("release_space")
 389 	old.free()
 390 	var def: Dictionary = plot_defs[i]
 391 	def["ticks_before"] = int(rec.get("ticks", 0))
 392 	def["data"] = rec.get("data", null)
 393 	if jobs != null: def["on_stage"] = int(sched.get("stage")) == i
 394 	packs[i] = _spawn_plot(i)
 395 	ledger.erase(i)
 396 	plot_event.emit(i, "rebuilt", {})
