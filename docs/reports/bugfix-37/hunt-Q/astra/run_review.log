  63 ## Plot `i` must be in memory. `again`: also when it is (a next round, a reload): the pack there stays until the new
  64 ## one is attached. `rec`: {ticks, data} of the plot (its record in the ledger, or what the old pack leaves).
  65 func want(i: int, again: bool = false, rec: Dictionary = {}) -> void:
  66 	var p: Node = (world.get("packs") as Array)[i]
  67 	var def: Dictionary = (world.get("plot_defs") as Array)[i]
  68 	if (world.get("_dead") as PackedStringArray).has(str(i)) or (p.get("manifest") as Dictionary).is_empty():
  69 		return
  70 	_mutex.lock()
  71 	var job: Variant = _jobs.get(i, null)
  72 	if job != null:
  73 		(job as Dictionary)["cancelled"] = false
  74 		if again:
  75 			(job as Dictionary)["rec"] = rec
  76 		_mutex.unlock()
  77 		return
  78 	_mutex.unlock()
  79 	if bool(p.get("loaded")) and not bool(p.get("ledgered")) and not again:
  80 		return
  81 	if rec.is_empty():
  82 		var kept: Dictionary = (world.get("ledger") as Dictionary).get(i, {})
  83 		rec = {"ticks": int(kept.get("ticks", def.get("ticks_before", 0))), "data": kept.get("data", def.get("data", null))}
  84 	var j: Dictionary = {"i": i, "dir": str(p.get("pack_dir")), "manifest": p.get("manifest"), "state": "queued", "keys": [],
  85 		"prio": 0.0, "rec": rec, "cancelled": false, "prep_ms": 0.0, "asked_usec": Time.get_ticks_usec()}
  86 	_mutex.lock()
  87 	_jobs[i] = j
  88 	_mutex.unlock()
  89 	if mode != "step":
