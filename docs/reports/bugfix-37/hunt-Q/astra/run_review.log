 310 func _run() -> void:
 311 	while true:
 312 		_sem.wait()
 313 		_mutex.lock()
 314 		if _quit:
 315 			_mutex.unlock()
 316 			return
 317 		var job: Dictionary = {}
 318 		for i: int in _jobs:
 319 			var j: Dictionary = _jobs[i]
 320 			if str(j["state"]) == "queued" and not bool(j["cancelled"]) and (job.is_empty() or float(j["prio"]) < float(job["prio"])):
