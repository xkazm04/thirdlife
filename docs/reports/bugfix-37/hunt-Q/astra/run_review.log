  49 func setup(world_node: Node, load_cfg: Dictionary, resolved_mode: String, scenery_: String, edit_list: Variant) -> void:
  50 	world = world_node
  51 	mode = resolved_mode
  52 	budget_us = int(float(load_cfg.get("budget_ms", 4.0)) * 1000.0)
  53 	scenery = scenery_
  54 	_t0 = Time.get_ticks_usec()
  55 	if typeof(edit_list) == TYPE_ARRAY:
  56 		for e: Variant in edit_list:
  57 			if typeof(e) == TYPE_ARRAY and (e as Array).size() == 3:
  58 				edits.append([int((e as Array)[0]), str((e as Array)[1]), str((e as Array)[2])])
  59 	_thread = Thread.new()
  60 	_thread.start(_run)
