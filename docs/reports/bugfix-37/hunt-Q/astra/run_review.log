engine/kernel/world/terrain/world_space.gd:334:
engine/kernel/world/terrain/world_space.gd:335:## Moves the body from `from` (feet) by the horizontal `delta`. Slides along what it meets, steps up small steps,
engine/kernel/world/terrain/world_space.gd:336:## follows the ground down; a move that would end on a slope steeper than `max_slope_deg` is refused (he stays).
engine/kernel/world/terrain/world_space.gd:337:## Returns the new feet position. `blocked` says whether anything held him back this tick.
engine/kernel/world/terrain/world_space.gd:338:func walk(from: Vector3, delta: Vector3) -> Dictionary:
engine/kernel/world/terrain/world_space.gd:339:	var pos: Vector3 = from
engine/kernel/world/terrain/world_space.gd:340:	last_hit = {}
engine/kernel/world/terrain/world_space.gd:341:	var rest: Vector3 = Vector3(delta.x, 0.0, delta.z)
engine/kernel/world/terrain/world_space.gd:342:	var hit: bool = false
engine/kernel/world/terrain/world_space.gd:343:	# lift by the step height, move horizontally (slide up to three times), then drop to the ground
engine/kernel/world/terrain/world_space.gd:344:	var up: Vector3 = Vector3(0.0, step_up, 0.0)
engine/kernel/world/terrain/world_space.gd:345:	if _test(Transform3D(Basis(), pos), up):
engine/kernel/world/terrain/world_space.gd:346:		up = _res.get_travel()
engine/kernel/world/terrain/world_space.gd:347:	pos += up
engine/kernel/world/terrain/world_space.gd:348:	for it: int in 3:
engine/kernel/world/terrain/world_space.gd:349:		if rest.length() < 0.0005:
engine/kernel/world/terrain/world_space.gd:350:			break
engine/kernel/world/terrain/world_space.gd:351:		if _test(Transform3D(Basis(), pos), rest):
engine/kernel/world/terrain/world_space.gd:352:			hit = true
engine/kernel/world/terrain/world_space.gd:353:			last_hit = {"tag": _tags.get(_res.get_collider_rid(0), "?"), "at": _res.get_collision_point(0), "n": _res.get_collision_normal(0), "from": pos}
engine/kernel/world/terrain/world_space.gd:354:			var travel: Vector3 = _res.get_travel()
engine/kernel/world/terrain/world_space.gd:355:			pos += travel
engine/kernel/world/terrain/world_space.gd:356:			var rem: Vector3 = _res.get_remainder()
engine/kernel/world/terrain/world_space.gd:357:			var nrm: Vector3 = _res.get_collision_normal(0)
engine/kernel/world/terrain/world_space.gd:358:			nrm.y = 0.0
engine/kernel/world/terrain/world_space.gd:359:			rest = rem - nrm.normalized() * rem.dot(nrm.normalized()) if nrm.length() > 0.001 else Vector3.ZERO
engine/kernel/world/terrain/world_space.gd:360:		else:
engine/kernel/world/terrain/world_space.gd:361:			pos += rest
engine/kernel/world/terrain/world_space.gd:362:			rest = Vector3.ZERO
engine/kernel/world/terrain/world_space.gd:363:	var drop: float = up.y + 0.9
engine/kernel/world/terrain/world_space.gd:364:	var grounded: bool = false
engine/kernel/world/terrain/world_space.gd:365:	var ground_n: Vector3 = Vector3.UP
engine/kernel/world/terrain/world_space.gd:366:	if _test(Transform3D(Basis(), pos), Vector3(0.0, -drop, 0.0)):
engine/kernel/world/terrain/world_space.gd:367:		pos += _res.get_travel()
engine/kernel/world/terrain/world_space.gd:368:		ground_n = _res.get_collision_normal(0)
engine/kernel/world/terrain/world_space.gd:369:		grounded = true
engine/kernel/world/terrain/world_space.gd:370:	else:
engine/kernel/world/terrain/world_space.gd:371:		pos.y -= drop                               # nothing under him within reach: a ledge; he steps down by the reach
engine/kernel/world/terrain/world_space.gd:372:	var slope_ok: bool = not grounded or ground_n.y >= cos(deg_to_rad(max_slope_deg))
engine/kernel/world/terrain/world_space.gd:373:	if not slope_ok:
engine/kernel/world/terrain/world_space.gd:374:		# refuse: the move ends on something too steep to stand on; stay where he was
engine/kernel/world/terrain/world_space.gd:375:		hit = true
engine/kernel/world/terrain/world_space.gd:376:		pos = from
engine/kernel/world/terrain/world_space.gd:377:		if _test(Transform3D(Basis(), pos), Vector3(0.0, -0.6, 0.0)):
engine/kernel/world/terrain/world_space.gd:378:			pos += _res.get_travel()
engine/kernel/world/terrain/world_space.gd:379:	if hit:
engine/kernel/world/terrain/world_space.gd:380:		blocked_ticks += 1
engine/kernel/world/terrain/world_space.gd:381:	place(pos)
engine/kernel/world/terrain/world_space.gd:382:	return {"pos": pos, "blocked": hit, "grounded": grounded}
