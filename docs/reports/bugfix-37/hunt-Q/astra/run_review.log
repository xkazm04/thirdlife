 105 func _prioritise() -> void:
 106 	var sched: RefCounted = world.get("sched")
 107 	var plots: Array = sched.get("plots")
 108 	var pos: Vector3 = world.get("player_pos")
 109 	_mutex.lock()
 110 	for i: int in _jobs:
 111 		var pl: Dictionary = plots[i]
 112 		var rank: int = maxi(0, (["stage", "sideline", "backdrop"] as Array).find(str(pl["tier"])))
 113 		(_jobs[i] as Dictionary)["prio"] = float(rank) * 100000.0 + float(sched.call("distance", pl, pos))
