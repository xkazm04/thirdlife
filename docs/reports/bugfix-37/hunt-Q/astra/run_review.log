 416 ## Landing (one shot, 0.45 s): the gait's own legs, feet where they stand, under a crouch that takes the fall. Soft from
 417 ## 4 m/s of fall, hard (deep, slow to rise, arms out) at 14 m/s; the fall speed is the last vertical speed seen in the air.
 418 func _land(t: float) -> Dictionary:
 419 	var k: float = smoothstep(4.0, 14.0, _impact)
 420 	var c: float = smoothstep(0.0, 0.06, t) * (1.0 - smoothstep(0.10, lerpf(0.28, 0.45, k), t))
 421 	_crouch_x = lerpf(0.12, 0.40, k) * c
 422 	var out: Dictionary = _gait_pose(float(frame) * DT)
 423 	_crouch_x = 0.0
 424 	return add_pose(out, {"Chest": Vector3(-6.0 * c, 0, 0), "Head": Vector3(lerpf(6.0, 16.0, k) * c, 0, 0),
 425 		"LeftUpperArm": Vector3(lerpf(14.0, 30.0, k) * c, 0, -lerpf(18.0, 46.0, k) * c), "RightUpperArm": Vector3(lerpf(14.0, 30.0, k) * c, 0, lerpf(18.0, 46.0, k) * c)})
