  82 ## P12 (PATCHES-P9 entry 2, the world.gd half). In an exported game a pack name is also looked for in the folder
  83 ## `games` beside the executable (`<exe folder>/games/<name>`); `p` itself when it is not there, or in the editor.
  84 ## P14. Where the world's caches live (the rims, the far pictures, the rig recipes; every key is a pack directory's
  85 ## content): `<user dir>/tl_cache`, or TL_CACHE_DIR (export.sh fills the cache a build ships with it).
  86 static func cache_dir() -> String:
  87 	var env: String = OS.get_environment("TL_CACHE_DIR").replace("\\", "/").trim_suffix("/")
  88 	return env if not env.is_empty() else OS.get_user_data_dir().replace("\\", "/") + "/tl_cache"
  89 
  90 
  91 ## P14. A build ships the caches export.sh computed for its games in `cache` beside the exe: each file that is not in
  92 ## the user's cache yet is copied there (a changed game has other keys, so it is never served a stale one).
  93 ## Returns how many files were copied.
  94 static func seed_cache(from: String, to: String = "") -> int:
  95 	if to.is_empty():
  96 		to = cache_dir()
  97 	if not DirAccess.dir_exists_absolute(from):
  98 		return 0
  99 	var files: PackedStringArray = PackedStringArray()
 100 	list_files(from, "", files)
 101 	var n: int = 0
 102 	for rel: String in files:
 103 		if not FileAccess.file_exists(to + "/" + rel):
 104 			DirAccess.make_dir_recursive_absolute((to + "/" + rel).get_base_dir())
 105 			if DirAccess.copy_absolute(from + "/" + rel, to + "/" + rel) == OK:
 106 				n += 1
 107 	return n
