 104 ## Axis locks from the `lock` option: a paddle that only slides along z is ["x", "y", "rx", "ry", "rz"].
 105 static func _lock(rb: RigidBody3D, axes: Variant) -> void:
 106 	if not (axes is Array or axes is PackedStringArray):
 107 		push_error("TLBodies: `lock` is a list of axes (x, y, z, rx, ry, rz)")
 108 		return
 109 	for a: Variant in axes:
 110 		match str(a):
 111 			"x": rb.axis_lock_linear_x = true
 112 			"y": rb.axis_lock_linear_y = true
 113 			"z": rb.axis_lock_linear_z = true
 114 			"rx": rb.axis_lock_angular_x = true
 115 			"ry": rb.axis_lock_angular_y = true
 116 			"rz": rb.axis_lock_angular_z = true
 117 			_: push_error("TLBodies: unknown lock axis '%s' (x, y, z, rx, ry, rz)" % str(a))
