 244 ## Euler-space mix of two pose dictionaries (small angles; the frame blend in tick() is quaternion based).
 245 static func _mixe(a: Dictionary, b: Dictionary, k: float) -> Dictionary:
 246 	if k <= 0.0:
 247 		return a
 248 	if k >= 1.0:
 249 		return b
 250 	var out: Dictionary = {}
 251 	for key: String in a:
 252 		out[key] = (a[key] as Vector3).lerp(b.get(key, Vector3.ZERO), k)
 253 	for key: String in b:
 254 		if not a.has(key):
 255 			out[key] = Vector3.ZERO.lerp(b[key], k)
 256 	return out
