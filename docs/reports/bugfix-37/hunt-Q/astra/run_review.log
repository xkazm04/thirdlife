 278 func _add_pack_walk(n: Node, holder: Node3D, inv: Transform3D, plot: Transform3D, radius: float, rim: float, band: float) -> void:
 279 	if n is StaticBody3D and (n as StaticBody3D).get_child_count() > 0:
