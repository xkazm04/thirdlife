   2 ## Primitive example: biped controller, input actions, triggers, rules, orbit camera.
   3 ## A walker crosses a concrete room through two checkpoints (pushing a crate out of the way); the rules end the
   4 ## "game" when the lap is complete. Beside the room a skater on an ice lane shows the skate mode: thrust, then a
   5 ## long glide when the input is released.
   6 
   7 var ctx
   8 var walker: TLBiped
   9 var skater: TLBiped
  10 var crate: RigidBody3D
  11 var rules: TLRules
  12 var cam: TLOrbitCam
  13 var crate_pushes: int = 0
  14 var walker_top_speed: float = 0.0
  15 var skater_top_speed: float = 0.0
  16 
  17 
  18 func _pack_setup(c) -> void:
  19 	ctx = c
  20 	# the room: concrete floor and four walls
  21 	ctx.root.add_child(TLBodies.ground(Vector2(12, 32), "concrete", 0.0, Vector3(0, 0, 4)))
  22 	for wall: Array in [[Vector3(12, 3, 0.4), Vector3(0, 1.5, 20)], [Vector3(12, 3, 0.4), Vector3(0, 1.5, -12)],
  23 			[Vector3(0.4, 3, 32), Vector3(6, 1.5, 4)], [Vector3(0.4, 3, 32), Vector3(-6, 1.5, 4)]]:
  24 		ctx.root.add_child(TLBodies.make(&"box", wall[0], "concrete", {"position": wall[1]}))
  25 	# the ice lane beside it
  26 	ctx.root.add_child(TLBodies.ground(Vector2(6, 80), "ice", 0.0, Vector3(12, 0, -20)))
  27 	walker = TLBiped.create({"position": Vector3(0, 0.05, 10), "name": "Walker"})
  28 	skater = TLBiped.create({"position": Vector3(12, 0.05, 10), "mode": "skate", "name": "Skater"})
  29 	ctx.root.add_child(walker)
  30 	ctx.root.add_child(skater)
  31 	# an empty crate: without "mass" a solid wooden block of this size would weigh 333 kg (density x volume)
  32 	crate = TLBodies.make(&"box", Vector3(0.8, 0.8, 0.8), "wood", {"dynamic": true, "mass": 15.0, "position": Vector3(0, 0.4, 4), "name": "Crate"})
  33 	ctx.root.add_child(crate)
  34 	walker.pushed.connect(_on_pushed)
  35 	rules = TLRules.create(ctx.read_json("rules.json"))
  36 	ctx.root.add_child(rules)
  37 	var gates: Array = [Vector3(0, 1, 0), Vector3(0, 1, -9)]
  38 	for i: int in gates.size():
  39 		var gate: TLTrigger = TLBodies.trigger(&"box", Vector3(11, 2, 0.5), {"position": gates[i], "name": "Gate%d" % i})
  40 		ctx.root.add_child(gate)
  41 		gate.entered.connect(_on_gate.bind(i))
  42 	for action: Array in [[&"forward", KEY_W], [&"back", KEY_S], [&"left", KEY_A], [&"right", KEY_D], [&"run", KEY_SHIFT],
  43 			[&"skate", KEY_UP], [&"look_left", KEY_Q], [&"look_right", KEY_E]]:
  44 		ctx.input.declare(action[0], [action[1]])
  45 	cam = ctx.cameras.orbit(walker, {"distance": 7.0, "pitch": 40.0})
  46 	cam.bind_actions(ctx.input, {"yaw_left": &"look_left", "yaw_right": &"look_right"})
  47 	ctx.cameras.add_view(&"top", Vector3(4, 30, 0), Vector3(4, 0, -1), 60.0)
  48 
  49 
  50 func _on_pushed(_body: RigidBody3D, _impulse: float) -> void:
  51 	crate_pushes += 1
  52 
  53 
  54 func _on_gate(body: Node3D, index: int) -> void:
  55 	if body == walker:
  56 		rules.pass_checkpoint("walker", index)
  57 
  58 
  59 func _pack_start() -> void:
  60 	rules.start()
  61 
  62 
  63 func _pack_tick(_frame: int) -> void:
  64 	walker.drive_from_input(ctx.input, {"left": &"left", "right": &"right", "forward": &"forward", "back": &"back", "run": &"run"},
  65 		cam.yaw_basis())
  66 	skater.move(Vector3(0, 0, -1) * ctx.input.strength(&"skate"))
  67 	walker_top_speed = maxf(walker_top_speed, walker.speed())
  68 	skater_top_speed = maxf(skater_top_speed, skater.speed())
  69 
  70 
  71 func _pack_state() -> Dictionary:
  72 	var s: Dictionary = rules.snapshot()
