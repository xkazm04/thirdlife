 177 ## {BoneName: Vector3 degrees, "_hips": Vector3} -> {"q": {bone index: Quaternion}, "h": Vector3}
 178 func to_q(pose: Dictionary) -> Dictionary:
 179 	var q: Dictionary = {}
 180 	var h: Vector3 = Vector3.ZERO
 181 	for key: String in pose:
 182 		if key == "_hips":
 183 			h = pose[key]
 184 			continue
 185 		var bi: int = _sk.find_bone(key)
 186 		if bi < 0:
 187 			continue
 188 		var e: Vector3 = pose[key]
 189 		q[bi] = Quaternion.from_euler(Vector3(deg_to_rad(e.x), deg_to_rad(e.y), deg_to_rad(e.z)))
 190 	return {"q": q, "h": h}
