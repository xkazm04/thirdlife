 155 ## P12. A game that is needed is there: in queue mode a plot on `stage` (the visitor entered it, a walk event put it
 156 ## there) that is not built yet jumps the queue and is built now, and on the walk's last tick every game still
 157 ## wanted is built (it arrives with no tick of its own, which the proof accepts). The main thread blocks for it:
 158 ## counted in `forced` and `forced_ms`. Each is an ordinary `built` event, so a replay does the same.
 159 func _force_needed(tick: int, sched: RefCounted) -> void:
 160 	var last: bool = tick >= int(world.get("walk_ticks")) - 1
 161 	var plots: Array = sched.get("plots")
 162 	var need: Array = []
 163 	_mutex.lock()
 164 	for i: int in _jobs:
 165 		var j: Dictionary = _jobs[i]
 166 		if not bool(j["cancelled"]) and (last or str((plots[i] as Dictionary)["tier"]) == "stage"):
 167 			need.append(i)
 168 	_mutex.unlock()
 169 	need.sort()
 170 	for i: int in need:
 171 		var t: int = Time.get_ticks_usec()
 172 		world.call("_on_event", sched.call("mark_built", tick, i))
 173 		forced.append([str(((world.get("plot_defs") as Array)[i] as Dictionary)["id"]), tick, snappedf(float(Time.get_ticks_usec() - t) / 1000.0, 0.1), "end" if last else "stage"])
