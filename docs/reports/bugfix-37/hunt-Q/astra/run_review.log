 233 func attach_skinned(model: Node3D, sk: Skeleton3D, mk: TLMesh, mesh_name: String) -> MeshInstance3D:
 234 	_sk = sk
 235 	_root_bone = sk.find_bone("Hips")
 236 	_root_rest = sk.get_bone_rest(_root_bone).origin
 237 	if sk.get_parent() == null:
 238 		model.add_child(sk)
 239 	var mi: MeshInstance3D = sk.get_node_or_null("Mesh")
 240 	if mi == null:
 241 		mi = MeshInstance3D.new()
 242 		mi.name = "Mesh"
 243 		sk.add_child(mi)
 244 		mi.skin = sk.create_skin_from_rest_transforms()
 245 		mi.skeleton = NodePath("..")
 246 		mi.extra_cull_margin = 2.0
 247 	mi.mesh = mk.build(mesh_name)
 248 	return mi
