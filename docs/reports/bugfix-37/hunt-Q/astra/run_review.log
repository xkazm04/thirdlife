 128 ## Once per world tick of a live run, after the scheduler's decisions: attaches what the mode allows. Each arrival is
 129 ## the event `built` (world.gd then calls `attach`).
 130 func pump(tick: int) -> void:
 131 	for e: Array in edits:
 132 		if int(e[0]) == tick:
 133 			DirAccess.copy_absolute(str(e[2]), str(e[1]))
 134 	for i: int in _early.duplicate():
 135 		world.call("_on_event", (world.get("sched") as RefCounted).call("mark_built", tick, i))
 136 	if _jobs.is_empty():
 137 		return
 138 	_prioritise()
 139 	_sweep()
 140 	var sched: RefCounted = world.get("sched")
 141 	if mode == "queue":
 142 		_force_needed(tick, sched)
 143 	var used: int = 0
 144 	while used < budget_us:
 145 		var job: Dictionary = _best(["ready"] if mode == "queue" else ["ready", "queued", "preparing"])
 146 		if job.is_empty():
 147 			break
 148 		var t: int = Time.get_ticks_usec()
 149 		world.call("_on_event", sched.call("mark_built", tick, int(job["i"])))
 150 		used += Time.get_ticks_usec() - t
 151 		if mode != "queue":
 152 			break
