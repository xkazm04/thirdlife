 370 			plot_event.emit(i, "tier", ev)
 371 		"leave":
 372 			if str(ev.get("on_leave", "")) == "end" and not bool(p.get("finished")):
 373 				p.call("finish", tick)
 374 		"restart", "reload":                   # reload (P5): a fresh copy of the same directory; what the pack saved itself is handed on
 375 			var rec: Dictionary = {"ticks": int(p.get("ticks_before")) + int(p.get("frames_done"))}
 376 			if str(ev["e"]) == "reload" and bool(p.get("loaded")) and p.call("saved_data") != null: rec["data"] = p.call("saved_data")
 377 			if jobs != null: jobs.call("want", i, true, rec)
 378 			else: _rebuild(i, rec)
 379 		"built":
 380 			if jobs != null: jobs.call("attach", i, tick)
