 192 ## The main-thread half, at the tick boundary of the `built` event: waits for the worker when it is not done (a
 193 ## replay, step mode), then builds the holder. What was built ahead and not asked for by the pack is freed.
 194 func attach(i: int, tick: int) -> void:
 195 	if _early.has(i):
 196 		_early.erase(i)                     # it is there already (`now`): this is only its event
 197 		return
 198 	if not _jobs.has(i):
 199 		want(i, true)                       # a log says it arrives here: build it whatever this run thinks of it
 200 	if not _jobs.has(i):
 201 		return
 202 	var job: Dictionary = _jobs[i]
 203 	var w0: int = Time.get_ticks_usec()
 204 	while true:
 205 		_mutex.lock()
 206 		var st: String = str(job["state"])
 207 		job["cancelled"] = false
 208 		if st == "queued" and mode == "wait":
 209 			job["prio"] = -1.0              # the worker takes it next
 210 		elif st == "queued":
 211 			job["state"] = "ready"          # the worker has not begun it: it is built here, whole, as before P5
 212 			st = "ready"
 213 		_mutex.unlock()
 214 		if st == "ready":
 215 			break
 216 		# The worker's calls into the rendering and physics servers that return a value wait for THIS thread to run
 217 		# them (the servers' command queues): a main thread that only sleeps here would wait for ever.
 218 		RenderingServer.force_sync()
 219 		PhysicsServer3D.get_process_info(PhysicsServer3D.INFO_ACTIVE_OBJECTS)
 220 		OS.delay_usec(200)
 221 	_waited_ms += float(Time.get_ticks_usec() - w0) / 1000.0
 222 	var t: int = Time.get_ticks_usec()
 223 	var def: Dictionary = (world.get("plot_defs") as Array)[i]
 224 	def["go"] = true
 225 	TLRigs._record_rigs(true)
 226 	TLKit._record_parts(true)
 227 	world.call("_rebuild", i, job["rec"])
 228 	remember_rigs(str(job["dir"]), TLRigs._record_rigs(false), TLKit._record_parts(false))
 229 	def.erase("go")
 230 	var left: int = 0
 231 	for k: String in job["keys"]:
 232 		if drop_ahead(k):
 233 			left += 1
 234 	_mutex.lock()
 235 	_jobs.erase(i)
 236 	_mutex.unlock()
 237 	var now: int = Time.get_ticks_usec()
 238 	if mode != "queue" or bool(world.get("is_replay")):
 239 		_spent_usec += now - w0
 240 		_step_usec += now - w0
 241 	built.append([str(def["id"]), tick, snappedf(float(now - _t0) / 1000.0, 0.1), job["prep_ms"], snappedf(float(now - t) / 1000.0, 0.01), left])
