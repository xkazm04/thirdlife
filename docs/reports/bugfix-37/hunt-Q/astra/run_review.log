 111 	var holes: Array = all.duplicate()
 112 	var k: int = 0
 113 	for i: int in has_ground.size():
 114 		if float(radii[i]) > 0.0 and bool(has_ground[i]) and k < 32:
 115 			if i < shut.size() and bool(shut[i]):
 116 				holes[k] = Vector4((all[k] as Vector4).x, (all[k] as Vector4).y, 0.0, 0.0)
 117 			k += 1
 118 	(gm as ShaderMaterial).set_shader_parameter(&"tl_holes", holes)

