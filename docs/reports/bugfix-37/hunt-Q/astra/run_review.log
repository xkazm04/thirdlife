 137 ## P11. Puts him at `at` (feet, x and z; the ground decides y) facing `yaw`, the camera behind him.
 138 func put(at: Vector3, yaw: float) -> void:
 139 	if space != null:
 140 		var g: float = space.call("ground_at", at.x, at.z, 200.0)
 141 		at.y = g if not is_nan(g) else feet.y
 142 		space.call("place", at)
 143 	feet = at
 144 	_last = at
 145 	position = at
 146 	_yaw = yaw
 147 	look_yaw = yaw
 148 	face_yaw = yaw
 149 	rotation.y = yaw
 150 	if space != null:
 151 		space.call("rest")
 152 	vel = Vector3.ZERO
 153 	mode = "ground"
 154 	if rig != null:
 155 		rig.rotation.y = 0.0
 156 	reset_physics_interpolation()
 157 	snap()
