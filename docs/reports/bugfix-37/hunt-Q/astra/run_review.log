 251 func add_socket(sname: String, bone: String, offset: Vector3, euler_deg: Vector3 = Vector3.ZERO) -> Node3D:
 252 	var ba: BoneAttachment3D = BoneAttachment3D.new()
 253 	ba.name = "At_" + sname
 254 	_sk.add_child(ba)
 255 	ba.bone_name = bone
 256 	var s: Node3D = Node3D.new()
 257 	s.name = sname
 258 	# the attachment sits at the bone's joint: `offset` is given in model space at rest, so subtract the joint position
 259 	s.position = offset - _sk.get_bone_global_rest(_sk.find_bone(bone)).origin
 260 	s.rotation_degrees = euler_deg
 261 	ba.add_child(s)
 262 	_sockets[sname] = s
 263 	return s
