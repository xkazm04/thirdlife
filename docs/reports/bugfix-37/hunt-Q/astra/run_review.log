 117 func _best(states: Array) -> Dictionary:
 118 	var best: Dictionary = {}
 119 	_mutex.lock()
 120 	for i: int in _jobs:
 121 		var j: Dictionary = _jobs[i]
 122 		if states.has(str(j["state"])) and not bool(j["cancelled"]) and (best.is_empty() or float(j["prio"]) < float(best["prio"])):
 123 			best = j
 124 	_mutex.unlock()
