  58 func setup(at: Vector3, facing: Vector3 = Vector3.FORWARD, cam_opts: Dictionary = {}) -> void:
  59 	name = "TLVisitor"
  60 	var land: Node = get_parent()
  61 	if land != null and land.has_meta(&"tl_space"):
  62 		space = land.get_meta(&"tl_space")
  63 	var view: Node = land.get_parent() if land != null else null
  64 	_world = view.get("world") if view != null else null
  65 	if space != null:
  66 		var g: float = space.call("ground_at", at.x, at.z, at.y + 80.0)
  67 		if not is_nan(g):
  68 			at.y = g
  69 		space.call("place", at)
  70 	feet = at
  71 	position = at
  72 	_last = at
  73 	if space != null and _world != null:
  74 		var walk: Dictionary = _world.get("walk")
  75 		if typeof(walk.get("visitor_probe")) == TYPE_ARRAY:
  76 			_run_probes(walk["visitor_probe"], land.get_meta(&"tl_probe", {}), at)
  77 	if facing.length() > 0.001:
  78 		_yaw = atan2(-facing.x, -facing.z)
  79 	rotation.y = _yaw
  80 	rig = TLRigs.build("biped", {})
  81 	if rig != null:
  82 		add_child(rig)
  83 	cam = TLChaseCam.new()
  84 	cam.name = "VisitorCam"
  85 	get_parent().add_child(cam)
  86 	var o: Dictionary = {"distance": 8.5, "height": 3.6, "look_height": 1.7, "stiffness": 0.05, "fov": 60.0}
  87 	o.merge(cam_opts, true)
  88 	cam.setup(self, o)
  89 	if space != null:
  90 		cam.avoid_space = space.get("space")
  91 		cam.avoid_mask = 1 | 4                 # the ground and solid things, and the trees' crowns (world_space CANOPY)
  92 		cam.near = 0.05
  93 	_cam_dist = Vector2(float(o["distance"]), float(o["height"]) - float(o["look_height"])).length()
  94 	_cam_look_h = float(o["look_height"])
  95 	look_pitch = atan2(float(o["height"]) - float(o["look_height"]), float(o["distance"]))
  96 	look_yaw = _yaw
  97 	face_yaw = _yaw
  98 	if space != null:
