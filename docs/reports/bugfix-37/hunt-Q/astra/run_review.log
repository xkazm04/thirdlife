engine/kernel/world/terrain/world_space.gd:202:func _list_static(n: Node, inv: Transform3D, radius: float, items: Array) -> void:
engine/kernel/world/terrain/world_space.gd:203:	if n is StaticBody3D:
engine/kernel/world/terrain/world_space.gd:204:		for ch: Node in n.get_children():
engine/kernel/world/terrain/world_space.gd:205:			if ch is CollisionShape3D and not (ch as CollisionShape3D).disabled and (ch as CollisionShape3D).shape != null:
engine/kernel/world/terrain/world_space.gd:206:				var local: Transform3D = inv * (ch as CollisionShape3D).global_transform
engine/kernel/world/terrain/world_space.gd:207:				var sh: Shape3D = (ch as CollisionShape3D).shape
engine/kernel/world/terrain/world_space.gd:208:				if sh is ConcavePolygonShape3D or radius <= 0.0 or Vector2(local.origin.x, local.origin.z).length() <= radius + 2.0:
engine/kernel/world/terrain/world_space.gd:209:					items.append([sh, local])
engine/kernel/world/terrain/world_space.gd:210:	for c: Node in n.get_children():
engine/kernel/world/terrain/world_space.gd:211:		_list_static(c, inv, radius, items)
