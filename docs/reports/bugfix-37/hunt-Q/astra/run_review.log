 328 		var keys: Array = prepare(str(job["dir"]), job["manifest"], scenery)
 329 		_mutex.lock()
 330 		job["keys"] = keys
 331 		job["prep_ms"] = snappedf(float(Time.get_ticks_usec() - t) / 1000.0, 0.1)
 332 		job["state"] = "ready"
 333 		_mutex.unlock()
