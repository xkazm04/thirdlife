 336 ## Everything of a pack's build that needs no scene tree and no pack on the stack. Returns the keys of the layouts
 337 ## built ahead. Runs on the worker thread; static so that a measurement can call it anywhere.
 338 static func prepare(dir: String, m: Dictionary, scenery_: String) -> Array:
 339 	var files: PackedStringArray = PackedStringArray()
 340 	PlotFile.call("list_files", dir, "", files)
 341 	_recipe_file(dir)                           # P14: the directory's content hash, here on the worker, not at the attach
 342 	for rel: String in files:
 343 		if rel.get_extension() == "gd":
 344 			TLContext._load_fresh(dir + "/" + rel)   # compiled here; `_pack_setup` and `ctx.load_script` find it (P12: as it is on disk now)
 345 	var keys: Array = []
 346 	var probe: TLContext = TLContext.new()      # reads a data file exactly as the pack's own `ctx.read_json` will
 347 	probe.pack_dir = dir
 348 	probe.manifest = m
 349 	probe.scenery = scenery_
 350 	for rel: String in files:
 351 		if not rel.begins_with("data/") or rel.get_extension() != "json":
 352 			continue
 353 		if not FileAccess.get_file_as_string(dir + "/" + rel).contains("\"tl.layout/"):
 354 			continue
 355 		var v: Variant = probe.read_json(rel)
 356 		if typeof(v) == TYPE_DICTIONARY and str((v as Dictionary).get("schema", "")).begins_with("tl.layout/"):
 357 			var key: String = TLKit.build_layout_ahead(v)
 358 			if not key.is_empty():
 359 				keys.append(key)
 360 	for rc: Array in rigs_of(dir):              # P12: the rigs and parts this pack built the last time it was built
 361 		var part: bool = (rc as Array).size() == 3
 362 		var rk: String = TLKit._part_ahead(str(rc[0]), rc[1]) if part else TLRigs._rig_ahead(str(rc[0]), rc[1])
 363 		if not rk.is_empty():
 364 			keys.append(("part:" if part else "rig:") + rk)
 365 	return keys
 366 
 367 
 368 # ------------------------------------------------------------------- P12: rigs built ahead from the pack's last build
 369 ## Which rigs a pack builds is known only by building it: each attach records its `TLRigs.build` calls, kept in this
 370 ## process and in `<cache>/rigs/<content hash of the directory>.txt` (P14: the directory's content, not its path, so
 371 ## a changed game is never served a stale recipe and a build can ship the recipes of its games; PlotFile.cache_dir),
 372 ## and the next preparation of the same directory builds them ahead on the worker. A recipe that no longer fits only
 373 ## costs the worker time: a rig built ahead whose call does not come is freed after the attach. Static, so a
 374 ## measurement can call it anywhere.
 375 static var _recipes: Dictionary = {}
 376 static var _recipes_lock: Mutex = Mutex.new()
 377 static var _dir_keys: Dictionary = {}    # P14: pack directory -> its content hash (read once per process, on the worker)
 378 
 379 
 380 ## P14. The recipe file of a pack directory. The content hash is read on the worker (`prepare`); a pack attached with
 381 ## no preparation (step mode, `now`) reads it on the main thread once.
 382 static func _recipe_file(dir: String) -> String:
 383 	_recipes_lock.lock()
 384 	var k: Variant = _dir_keys.get(dir, null)
 385 	_recipes_lock.unlock()
 386 	if k == null:
 387 		k = str(PlotFile.call("dir_hash", dir))
 388 		_recipes_lock.lock()
 389 		_dir_keys[dir] = k
 390 		_recipes_lock.unlock()
 391 	return str(PlotFile.call("cache_dir")) + "/rigs/" + str(k) + ".txt"
 392 
 393 
 394 static func rigs_of(dir: String) -> Array:
 395 	_recipes_lock.lock()
 396 	var got: Variant = _recipes.get(dir, null)
 397 	_recipes_lock.unlock()
 398 	if got != null:
 399 		return got
 400 	var f: String = _recipe_file(dir)
 401 	if not FileAccess.file_exists(f):
 402 		return []
 403 	var v: Variant = str_to_var(FileAccess.get_file_as_string(f))
 404 	var out: Array = []
 405 	if typeof(v) == TYPE_ARRAY:
 406 		for c: Variant in v:
 407 			if typeof(c) == TYPE_ARRAY and (c as Array).size() in [2, 3] and typeof((c as Array)[1]) == TYPE_DICTIONARY:
 408 				out.append(c)
 409 	_recipes_lock.lock()
 410 	_recipes[dir] = out
 411 	_recipes_lock.unlock()
 412 	return out
 413 
 414 
 415 ## `rigs`: TLRigs.record's [family, params] calls; `parts`: TLKit.record's [kind, params] calls (kept as [kind, params, "part"]).
 416 static func remember_rigs(dir: String, rigs: Array, parts: Array = []) -> void:
 417 	var calls: Array = rigs.duplicate()
 418 	for pc: Array in parts:
 419 		calls.append([pc[0], pc[1], "part"])
 420 	_recipes_lock.lock()
 421 	var same: bool = _recipes.has(dir) and var_to_str(_recipes[dir]) == var_to_str(calls)
 422 	_recipes[dir] = calls
 423 	_recipes_lock.unlock()
 424 	if same:
 425 		return
 426 	var path: String = _recipe_file(dir)
 427 	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
 428 	var f: FileAccess = FileAccess.open(path, FileAccess.WRITE)
 429 	if f != null:
 430 		f.store_string(var_to_str(calls))
 431 		f.close()
 432 
 433 
 434 ## Frees one thing built ahead (a layout, a rig: key "rig:<key>", a part: "part:<key>"). Main thread. True when there was one.
 435 static func drop_ahead(k: String) -> bool:
 436 	if k.begins_with("rig:"):
 437 		return TLRigs._drop_rig(k.substr(4))
 438 	if k.begins_with("part:"):
 439 		return TLKit._drop_part(k.substr(5))
 440 	return TLKit.drop_layout_ahead(k)

