  85 ## footprint keeps the walk's radius (what its scripts build cannot be known before it is built). A job that has
  86 ## promoted nothing yet keeps the walk's radius too. Returns [radius, what decided it].
  87 const FIT_MARGIN: float = 4.0
  88 const FIT_MIN: float = 12.0
  89 static func fit_radius(dir: String, lot_r: float) -> Array:
  90 	var lg: RefCounted = SiteLog.new()
