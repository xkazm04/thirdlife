 179 ## The height of a pack's own ground where its plot ends: the median height of its terrain sheets in a ring around
 180 ## `radius` (the shader bends the ring to exactly this height). The viewer lifts the plot by minus this, so the rim of the pack's ground meets the world's ground.
 181 ## NAN when the pack has no terrain sheet that reaches the ring.
 182 static func edge_height(holder: Node3D, radius: float) -> float:
 183 	if radius <= 0.0:
 184 		return NAN
 185 	var wide: Array = []
 186 	_wide_meshes(holder, maxf(30.0, radius), wide)
 187 	var ys: PackedFloat32Array = PackedFloat32Array()
 188 	var r_in: float = (radius - 3.0) * (radius - 3.0)
 189 	var r_out: float = (radius + 4.0) * (radius + 4.0)
 190 	for m: MeshInstance3D in wide:
 191 		var xf: Transform3D = holder.global_transform.affine_inverse() * m.global_transform
 192 		for s: int in m.mesh.get_surface_count():
 193 			var verts: PackedVector3Array = xf * (m.mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX] as PackedVector3Array)
 194 			for v: Vector3 in verts:
 195 				var d2: float = v.x * v.x + v.z * v.z
 196 				if d2 >= r_in and d2 <= r_out:
 197 					ys.append(v.y)
 198 	if ys.is_empty():
 199 		return NAN         # no ground of its own at the plot edge: the world's ground runs through under it
 200 	if OS.get_environment("TL_GROUND_COVER") != "off" and ground_cover(holder, radius, wide) < COVER_MIN:
 201 		return NAN         # walker-feel T: some wide boxes touch the ring but leave most of the plot open: no hole
 202 	ys.sort()          # the median: a skirt under the far sheet or the foot of a cliff must not decide
 203 	return ys[ys.size() / 2]
