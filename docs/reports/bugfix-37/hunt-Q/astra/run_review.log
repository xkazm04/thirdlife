 103 ## P11. A person's controls: from now on he faces `look_yaw` and the camera sits behind him at `look_pitch`, at once
 104 ## (no smoothing: the view follows the mouse tick by tick).
 105 func steer_on() -> void:
 106 	steer = true
 107 	cam.stiffness = 1.0
 108 	cam.follow = 1.0
 109 	cam.aim = 1.0
 110 	cam.anchor_follow = CAM_ANCHOR
 111 	cam.anchor_follow_y = CAM_ANCHOR_Y
 112 	_place_cam()
 113 	cam.snap()
