  21 var space: RefCounted = null            # the world's space (terrain/world_space.gd), null when there is no landscape
  22 var feet: Vector3 = Vector3.ZERO        # where the body stands
  23 var max_dev: float = 0.0
  24 var end_dev: float = 0.0
  25 var ticks: int = 0
  26 var catch_up_m: float = 0.5             # metres per tick the body may close on a scripted position it has fallen behind
  27 var _last: Vector3 = Vector3.ZERO
