 359 func _decide_visits(tick: int, inside: int, stage_margin: float) -> void:
 360 	var asks: Array = _requests
 361 	_requests = []
 362 	for v: Dictionary in _visits:
 363 		if int(v["t"]) == tick:
 364 			asks.append(v)
 365 	for a: Dictionary in asks:
 366 		if str(a["e"]) == "leave":
 367 			if stage < 0:
 368 				_emit({"t": tick, "e": "refused", "ask": "leave", "why": "no game is on stage"})
 369 				continue
 370 			var pc: Dictionary = plots[stage]
 371 			_emit({"t": tick, "e": "tier", "plot": pc["id"], "from": "stage", "to": "sideline", "why": "leave"})
 372 			_emit({"t": tick, "e": "leave", "plot": pc["id"], "on_leave": pc["on_leave"]})
 373 		else:
 374 			var target: int = int(a["plot"]) if int(a["plot"]) >= 0 else inside
 375 			if stage >= 0 or target < 0 or float((plots[target] as Dictionary)["dist"]) > stage_margin:
 376 				_emit({"t": tick, "e": "refused", "ask": "enter", "plot": str((plots[target] as Dictionary)["id"]) if target >= 0 else "",
 377 					"why": "a game is on stage already" if stage >= 0 else ("the visitor stands in no plot" if target < 0 else "the visitor is outside that plot")})
 378 				continue
 379 			var pn: Dictionary = plots[target]
 380 			if bool(pn["held"]):
 381 				_emit({"t": tick, "e": "return", "plot": pn["id"]})
 382 			if bool(pn["over"]):
 383 				_emit({"t": tick, "e": "restart", "plot": pn["id"], "why": "enter"})
 384 			_emit({"t": tick, "e": "tier", "plot": pn["id"], "from": pn["tier"], "to": "stage", "why": "enter"})
 385 	var pause: int = int(cfg.get("restart_pause_ticks", 0))
 386 	if pause > 0:
 387 		for i: int in plots.size():
 388 			var p: Dictionary = plots[i]
 389 			if i != stage and bool(p["over"]) and not bool(p["held"]) and str(p["on_leave"]) != "end" and str(p["tier"]) != "ledger" 					and tick - int(p.get("over_at", tick)) >= pause:
 390 				_emit({"t": tick, "e": "restart", "plot": p["id"], "why": "next_round"})
