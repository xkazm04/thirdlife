engine/kernel/world/terrain/world_space.gd:214:func step_pack(job: Dictionary, budget_usec: int) -> bool:
engine/kernel/world/terrain/world_space.gd:215:	var t0: int = Time.get_ticks_usec()
engine/kernel/world/terrain/world_space.gd:216:	var items: Array = job["items"]
engine/kernel/world/terrain/world_space.gd:217:	var plot: Transform3D = job["plot"]
engine/kernel/world/terrain/world_space.gd:218:	var radius: float = float(job["radius"])
engine/kernel/world/terrain/world_space.gd:219:	var rim: float = float(job["rim"])
engine/kernel/world/terrain/world_space.gd:220:	var band: float = float(job["band"])
engine/kernel/world/terrain/world_space.gd:221:	tag = str(job["tag"])
engine/kernel/world/terrain/world_space.gd:222:	while int(job["at"]) < items.size():
engine/kernel/world/terrain/world_space.gd:223:		var it: Array = items[int(job["at"])]
engine/kernel/world/terrain/world_space.gd:224:		var sh: Shape3D = it[0]
engine/kernel/world/terrain/world_space.gd:225:		var local: Transform3D = it[1]
engine/kernel/world/terrain/world_space.gd:226:		if sh is ConcavePolygonShape3D:
engine/kernel/world/terrain/world_space.gd:227:			if int(job["tri"]) == 0 and (job["src"] as PackedVector3Array).is_empty():
engine/kernel/world/terrain/world_space.gd:228:				job["src"] = (sh as ConcavePolygonShape3D).get_faces()
engine/kernel/world/terrain/world_space.gd:229:				job["out"] = PackedVector3Array()
engine/kernel/world/terrain/world_space.gd:230:			var src: PackedVector3Array = job["src"]
engine/kernel/world/terrain/world_space.gd:231:			var out: PackedVector3Array = job["out"]
engine/kernel/world/terrain/world_space.gd:232:			var r2: float = (radius + 4.0) * (radius + 4.0)
engine/kernel/world/terrain/world_space.gd:233:			var t: int = int(job["tri"])
engine/kernel/world/terrain/world_space.gd:234:			while t + 2 < src.size():
