 176 ## Jobs that were cancelled and are not on the worker any more: what was built ahead for them is freed.
 177 func _sweep() -> void:
 178 	var gone: Array = []
 179 	_mutex.lock()
 180 	for i: int in _jobs:
 181 		var j: Dictionary = _jobs[i]
 182 		if bool(j["cancelled"]) and str(j["state"]) != "preparing":
 183 			gone.append(j)
 184 	for j: Dictionary in gone:
 185 		_jobs.erase(int(j["i"]))
 186 	_mutex.unlock()
 187 	for j: Dictionary in gone:
 188 		for k: String in j["keys"]:
 189 			drop_ahead(k)
