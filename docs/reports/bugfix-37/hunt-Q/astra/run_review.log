   2 # A world of N plots on a square grid 60 m apart (footprints 40 x 40 m), packs in the order
   3 # seed_paddle, seed_drive, seed_wall, w_pile (alternately 60 boxes KEPT AWAKE, a busy scene, and 60 boxes left alone,
   4 # which settle and fall asleep); the seeds are played by their bots. "scenery": "plot": no far terrain, no forest.
   5 # The player stands still in the middle of an inner plot.
   6 #   bench_all_N.json  everything every world tick: the stage plot and N-1 sideline (sideline_m and the budgets are set
   7 #                     out of reach, so the valve does nothing).
   8 #   bench_mix_N.json  the realistic mix: 1 stage, the 4 plots across a road at sideline (sideline_m 50), the rest
   9 #                     backdrop; budgets as in tiers.json; costs MEASURED, so the slice is what this machine needs.
  10 import json, math, os
  11 
  12 HERE = os.path.dirname(os.path.abspath(__file__))
  13 PACKS = [("seed_paddle", 1), ("seed_drive", 1), ("seed_wall", 1), ("w_pile", 60),
  14          ("seed_paddle", 1), ("seed_drive", 1), ("seed_wall", 1), ("w_pile", 10060)]
  15 
  16 
  17 def world(n, kind):
  18     cols = int(math.ceil(math.sqrt(n)))
  19     plots = []
  20     for i in range(n):
  21         pack, seed = PACKS[i % len(PACKS)]
  22         plot = {"id": "p%02d" % i, "pack": pack, "origin": [60 * (i % cols), 0, 60 * (i // cols)], "seed": seed}
  23         if pack == "w_pile":
  24             plot["mode"] = "smoke"      # its bot ends the game after 600 ticks; left alone it just lies there
  25         plots.append(plot)
  26     home = plots[cols + 1]["origin"]
  27     doc = {"schema": "tl.walk/1", "name": "bench_%s_%d" % (kind, n), "ticks": 600 if kind == "all" else 1200, "mode": "bot",
  28            "scenery": "plot",
  29            "plots": plots, "player": [[0, home]]}
  30     if kind == "all":
  31         doc["tiers"] = {"sideline_m": 100000, "budget_ms": {"front": 100000, "backdrop": 100000}}
  32     else:
  33         doc["tiers"] = {"sideline_m": 50, "cost": "measured"}
  34     with open(os.path.join(HERE, "bench_%s_%d.json" % (kind, n)), "w", newline="\n") as f:
  35         json.dump(doc, f, indent=1)
  36         f.write("\n")
  37 
  38 
  39 for n in (12, 30, 60):
  40     world(n, "all")
  41     world(n, "mix")
  42 print("wrote 6 walks")

