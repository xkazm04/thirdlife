 350 		var who: Node3D = Node3D.new()
 351 		holder.add_child(who)
 352 		who.position = Vector3(-40, 0, 0)
 353 		who.rotation.y = deg_to_rad(-90.0)        # looking along +x
 354 		var cam: TLChaseCam = TLChaseCam.new()
 355 		holder.add_child(cam)
 356 		cam.setup(who, {"distance": 8.5, "height": 3.6, "look_height": 1.7, "stiffness": 1.0, "follow": 1.0, "aim": 1.0, "anchor_follow": 0.45, "anchor_follow_y": 0.18,
 357 			"avoid_space": sp.get("space"), "avoid_mask": mask})
 358 		cam.make_current()
 359 		var blocked: int = 0
 360 		var inside: int = 0
 361 		var nearest: float = INF
 362 		for i: int in 360:
 363 			who.position.x += 9.0 / 60.0
 364 			await physics_frame
 365 			var c: Vector3 = cam.global_position
 366 			var look: Vector3 = who.global_position + Vector3.UP * 1.7
 367 			var st: PhysicsDirectSpaceState3D = PhysicsServer3D.space_get_direct_state(sp.get("space"))
 368 			if not st.intersect_ray(PhysicsRayQueryParameters3D.create(look, c, 4)).is_empty():
