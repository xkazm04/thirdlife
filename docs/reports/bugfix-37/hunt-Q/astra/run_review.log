 205 func _apply(pose: Dictionary) -> void:
 206 	var q: Dictionary = pose["q"]
 207 	for bi: int in q:
 208 		_sk.set_bone_pose_rotation(bi, q[bi])
 209 	if _root_bone >= 0:
 210 		_sk.set_bone_pose_position(_root_bone, _root_rest + (pose["h"] as Vector3))
