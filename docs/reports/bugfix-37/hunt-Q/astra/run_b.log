--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_pad_lift.gd
@@ -0,0 +1,58 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_pad_lift.gd"
+extends SceneTree
+
+const Landscape = preload("res://kernel/world/landscape.gd")
+const DrawBase = preload("res://kernel/world/draw/draw_base.gd")
+
+class World extends Node:
+	var packs := []
+
+class Viewer extends Node:
+	var world := World.new()
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false)
+	var view := Viewer.new()
+	root.add_child(view)
+	view.add_child(view.world)
+	var holder := Node3D.new()
+	view.world.add_child(holder)
+	view.world.packs.append(holder)
+	var floor_mesh := MeshInstance3D.new()
+	var sheet := PlaneMesh.new()
+	sheet.size = Vector2(100, 100)
+	sheet.subdivide_width = 49
+	sheet.subdivide_depth = 49
+	floor_mesh.mesh = sheet
+	floor_mesh.position.y = 5
+	holder.add_child(floor_mesh)
+	var body := StaticBody3D.new()
+	floor_mesh.add_child(body)
+	var collision := CollisionShape3D.new()
+	collision.shape = sheet.create_trimesh_shape()
+	body.add_child(collision)
+	var rim := DrawBase.edge_height(holder, 40)
+	# Same placement as view.gd:184-186 for an authored plot at y=0.
+	var plot := Transform3D(Basis.IDENTITY, Vector3(0, -rim, 0))
+	for explicit_height: bool in [true, false]:
+		var land := Node3D.new()
+		view.add_child(land)
+		var cfg := {"relief": 0, "edges_now": true, "fence": false, "trees": 0,
+			"broadleaf": 0, "rocks": 0, "bushes": 0, "mesas": 0, "belt": 0,
+			"soft_patches": 0, "plain_clumps": 0}
+		if explicit_height:
+			cfg.pad_h = [0]
+		Landscape.build(land, [plot], [40], [true], cfg)
+		var terrain: RefCounted = land.get_meta(&"tl_terrain")
+		var sp: RefCounted = land.get_meta(&"tl_space")
+		var pad: float = terrain.gy(45, 0)
+		var support: float = sp.ground_at(39, 0, 20)
+		var drawn := plot.origin.y + rim
+		print("REPRO pad_lift: %s explicit_pad=%s pack_rim_y=%.2f pad_y=%.2f collider_y_at_r39=%.2f" % [
+			"FAIL" if absf(pad - drawn) > 0.01 else "control", str(explicit_height), drawn, pad, support])
+		land.free()
+	view.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_plain_edge.gd b/docs/reports/astra-trial/d5/repro/b_plain_edge.gd
new file mode 100644
index 0000000000000000000000000000000000000000..10c396869effce9dce2cb8746a6e8d8468fc2d9b
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_plain_edge.gd
@@ -0,0 +1,40 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_plain_edge.gd"
+extends SceneTree
+
+const Landscape = preload("res://kernel/world/landscape.gd")
+
+class Viewer extends Node:
+	var world: Node
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false)
+	var view := Viewer.new()
+	root.add_child(view)
+	var land := Node3D.new()
+	view.add_child(land)
+	Landscape.build(land, [Transform3D.IDENTITY], [12], [false], {
+		"relief": 0, "trees": 0, "broadleaf": 0, "rocks": 0, "bushes": 0, "belt": 0,
+		"mesas": 0, "plain_clumps": 0, "soft_patches": 0, "edges_now": true})
+	var sp: RefCounted = land.get_meta(&"tl_space")
+	var edge: float = land.get_meta(&"tl_terrain").x1()
+	var feet := Vector3(edge - 2, sp.ground_at(edge - 2, 0, 10), 0)
+	sp.place(feet)
+	sp.rest()
+	for tick in 120:
+		feet = sp.drive(feet, Vector3(4.5, 0, 0), false, false).pos
+	var drawn := false
+	for mi in land.get_children():
+		if mi is MeshInstance3D and mi.name == "WorldFarGround":
+			var faces: PackedVector3Array = mi.mesh.get_faces()
+			for i in range(0, faces.size(), 3):
+				var hit = Geometry3D.ray_intersects_triangle(Vector3(feet.x, 10, feet.z), Vector3.DOWN, faces[i], faces[i+1], faces[i+2])
+				if hit != null and absf(hit.y) < 0.01:
+					drawn = true
+					break
+	print("REPRO plain_edge: %s edge_x=%.1f feet_x=%.1f drawn_floor_at_y0=%s support_y=%s feet_y=%.2f" % [
+		"FAIL" if drawn and feet.y < -5 else "other", edge, feet.x, str(drawn), str(sp.ground_at(feet.x, feet.z, 10)), feet.y])
+	view.free()
+	quit()
