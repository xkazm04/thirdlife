diff --git a/docs/reports/astra-trial/d5/repro/b_plain_edge.gd b/docs/reports/astra-trial/d5/repro/b_plain_edge.gd
new file mode 100644
index 0000000000000000000000000000000000000000..10c396869effce9dce2cb8746a6e8d8468fc2d9b
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_plain_edge.gd
@@ -0,0 +1,40 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_plain_edge.gd"
+extends SceneTree
+
+const Landscape = preload("res://kernel/world/landscape.gd")
+
+class Viewer extends Node:
+	var world: Node
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false)
+	var view := Viewer.new()
+	root.add_child(view)
+	var land := Node3D.new()
+	view.add_child(land)
+	Landscape.build(land, [Transform3D.IDENTITY], [12], [false], {
+		"relief": 0, "trees": 0, "broadleaf": 0, "rocks": 0, "bushes": 0, "belt": 0,
+		"mesas": 0, "plain_clumps": 0, "soft_patches": 0, "edges_now": true})
+	var sp: RefCounted = land.get_meta(&"tl_space")
+	var edge: float = land.get_meta(&"tl_terrain").x1()
+	var feet := Vector3(edge - 2, sp.ground_at(edge - 2, 0, 10), 0)
+	sp.place(feet)
+	sp.rest()
+	for tick in 120:
+		feet = sp.drive(feet, Vector3(4.5, 0, 0), false, false).pos
+	var drawn := false
+	for mi in land.get_children():
+		if mi is MeshInstance3D and mi.name == "WorldFarGround":
+			var faces: PackedVector3Array = mi.mesh.get_faces()
+			for i in range(0, faces.size(), 3):
+				var hit = Geometry3D.ray_intersects_triangle(Vector3(feet.x, 10, feet.z), Vector3.DOWN, faces[i], faces[i+1], faces[i+2])
+				if hit != null and absf(hit.y) < 0.01:
+					drawn = true
+					break
+	print("REPRO plain_edge: %s edge_x=%.1f feet_x=%.1f drawn_floor_at_y0=%s support_y=%s feet_y=%.2f" % [
+		"FAIL" if drawn and feet.y < -5 else "other", edge, feet.x, str(drawn), str(sp.ground_at(feet.x, feet.z, 10)), feet.y])
+	view.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd b/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd
new file mode 100644
index 0000000000000000000000000000000000000000..9f5bc560d5f8eafe3f9a42ae0f1fe4a7b9960ce5
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd
@@ -0,0 +1,37 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd"
+extends SceneTree
+
+const DrawBase = preload("res://kernel/world/draw/draw_base.gd")
+const Landscape = preload("res://kernel/world/landscape.gd")
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false) # Exercise the normal ground material on the headless display.
+	var holder := Node3D.new()
+	root.add_child(holder)
+	var deck := MeshInstance3D.new()
+	var plane := PlaneMesh.new()
+	plane.size = Vector2(40, 90)
+	plane.subdivide_depth = 17
+	plane.subdivide_width = 7
+	deck.mesh = plane
+	holder.add_child(deck)
+	for yaw in [0, 45]:
+		deck.rotation_degrees.y = yaw
+		var measured := DrawBase.ground_cover(holder, 40, [deck])
+		var real_hits := 0
+		for radius in [38.0, 42.0]:
+			for k in 72:
+				var angle := TAU * k / 72.0
+				var local := deck.to_local(Vector3(radius * cos(angle), 0, radius * sin(angle)))
+				if absf(local.x) <= 20 and absf(local.z) <= 45:
+					real_hits += 1
+		var owns := not is_nan(DrawBase.edge_height(holder, 40))
+		var mat := Landscape._ground_material([Transform3D.IDENTITY], [40], [owns])
+		var hole: Vector4 = mat.get_shader_parameter(&"tl_holes")[0]
+		print("REPRO rotated_ground: %s yaw=%d physical_coverage=%d/144 reported=%.3f hole_radius=%.1f" % [
+			"FAIL" if owns and real_hits < 0.95 * 144 else "control", yaw, real_hits, measured, hole.z])
+	holder.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_stale_slide.gd b/docs/reports/astra-trial/d5/repro/b_stale_slide.gd
new file mode 100644
index 0000000000000000000000000000000000000000..71629737449f5be394f98730a00612a7a3a6ef62
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_stale_slide.gd
@@ -0,0 +1,30 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_stale_slide.gd"
+extends SceneTree
+
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+const WalkCase = preload("res://kernel/world/walks/walk_case.gd")
+
+func _initialize() -> void:
+	var sp := Space.new()
+	WalkCase.flat(sp, 0.0, -10, 10, -40, 0)
+	WalkCase.flat(sp, -3.0, -10, 10, 0, 40)
+	var feet := Vector3(0, 0, -25)
+	sp.place(feet)
+	sp.rest()
+	var starts := 0
+	var ends := 0
+	var previous_mode := "ground"
+	for tick in 360:
+		var wish := Vector3(0, 0, 9) if tick < 30 or tick >= 140 else Vector3.ZERO
+		var result := sp.drive(feet, wish, false, tick == 30)
+		feet = result.pos
+		starts += result.events.count("slide")
+		ends += result.events.count("end_slide")
+		if result.mode == "air":
+			print("REPRO stale_slide: %s tick=%d transition=%s->air events=%s slide_starts=%d slide_ends=%d" % [
+				"FAIL" if previous_mode == "ground" and ends > starts else "other",
+				tick, previous_mode, str(result.events), starts, ends])
+			break
+		previous_mode = result.mode
+	sp.free_all()
+	quit()
