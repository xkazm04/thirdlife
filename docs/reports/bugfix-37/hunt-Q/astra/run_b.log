41:static func rims_path() -> String:
42:	return str(PlotFile.call("cache_dir")) + "/rims.json"          # P14: TL_CACHE_DIR or the user directory
43:
44:
45:static func save_rims(v: Node) -> void:
46:	if int(v.get("_rims_new")) == 0:
47:		return
48:	DirAccess.make_dir_recursive_absolute(rims_path().get_base_dir())
49:	var f: FileAccess = FileAccess.open(rims_path(), FileAccess.WRITE)
50:	if f != null:
51:		f.store_string(JSON.stringify(v.get("_rims"), "", true))
52:		f.close()
