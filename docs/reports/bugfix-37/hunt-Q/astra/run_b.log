1:extends SceneTree
2:## Selftest cases `walk.*` (tools/selftest.sh; lane M, walker-feel, 18 Nov 2026): the visitor's body with weight
3:## (terrain/world_space.gd `drive()`) on ground built for the case, headless, counted in ticks. One line per case:
4:## `WALKCASE <name> ok|fail <figures>`, then `WALKCASE done <n ok> <n>`.
5:##   <godot> --headless --path engine --script res://kernel/world/walks/walk_case.gd [-- <name filter>]
6:## Cases: idle_bank (600 ticks idle on walkable banks of 20, 35, 50 degrees, and after walking onto one: drift < 1 cm),
7:## jump (height 0.9..1.1 m, air ticks), ledge (walking off 3 m falls with gravity: no tick drops more than
8:## 0.75 m, the fall takes more than 12 ticks), steep (on a 65 degree bank he slides to its foot and stops on the flat),
9:## pace (W held reaches 4.5 m/s, Shift 9.0, in ticks; a 6-tick tap moves 0.3..1.0 m; release stops), slide (a run slide
10:## carries him further than stopping and ends), camera (TLChaseCam with `avoid_space`: walking along a bank with the
11:## view pitched low, the camera is never closer to the ground than its margin; without it, it is under the ground).
12:
13:const Space: GDScript = preload("res://kernel/world/terrain/world_space.gd")
14:const DT: float = 1.0 / 60.0
15:
16:var _ok: int = 0
17:var _n: int = 0
18:var _filter: String = ""
19:
20:
21:func _say(name: String, ok: bool, figs: String) -> void:
22:	_n += 1
23:	if ok:
24:		_ok += 1
25:	print("WALKCASE %s %s %s" % [name, "ok" if ok else "fail", figs])
26:
27:
28:func _want(name: String) -> bool:
29:	return _filter.is_empty() or name.contains(_filter)
30:
31:
32:## A plane through the origin rising toward -z at `deg` (60 m square), with a flat floor at its foot from z = foot_z.
33:static func bank(sp: RefCounted, deg: float, half: float = 30.0) -> void:
34:	var t: float = tan(deg_to_rad(deg))
35:	var p: Array = [Vector3(-half, -half * t, half), Vector3(half, -half * t, half), Vector3(half, half * t, -half), Vector3(-half, half * t, -half)]
36:	sp.call("add_faces", PackedVector3Array([p[0], p[1], p[2], p[0], p[2], p[3]]))
37:
38:
39:static func flat(sp: RefCounted, y: float, x0: float, x1: float, z0: float, z1: float) -> void:
40:	sp.call("add_faces", PackedVector3Array([Vector3(x0, y, z0), Vector3(x1, y, z0), Vector3(x1, y, z1), Vector3(x0, y, z0), Vector3(x1, y, z1), Vector3(x0, y, z1)]))
41:
42:
43:func _drive(sp: RefCounted, feet: Vector3, wish: Vector3, jump: bool = false, slide: bool = false) -> Dictionary:
44:	return sp.call("drive", feet, wish, jump, slide)
45:
46:
47:func _initialize() -> void:
48:	var args: PackedStringArray = OS.get_cmdline_user_args()
49:	_filter = args[0] if args.size() > 0 else ""
50:	if _want("idle_bank"):
51:		_idle_bank()
52:	if _want("jump"):
53:		_jump()
54:	if _want("ledge"):
55:		_ledge()
56:	if _want("steep"):
57:		_steep()
58:	if _want("pace"):
59:		_pace()
60:	if _want("slide"):
61:		_slide()
62:	if _want("camera"):
63:		await _camera()
64:	if _want("canopy"):
65:		await _canopy()
66:	print("WALKCASE done %d %d" % [_ok, _n])
67:	quit(0 if _ok == _n else 1)
68:
69:
70:func _idle_bank() -> void:
71:	var worst: float = 0.0
72:	var figs: Array = []
73:	for deg: float in [20.0, 35.0, 50.0]:
74:		var sp: RefCounted = Space.new()
75:		bank(sp, deg)
76:		var feet: Vector3 = Vector3(0.0, sp.call("ground_at", 0.0, 0.0, 50.0), 0.0)
77:		sp.call("place", feet)
78:		sp.call("rest")
79:		var start: Vector3 = feet
80:		for i: int in 600:
81:			feet = _drive(sp, feet, Vector3.ZERO)["pos"]
82:		var d: float = feet.distance_to(start)
83:		# walk across the bank for a second, let go, then 600 ticks idle
84:		for i: int in 60:
85:			feet = _drive(sp, feet, Vector3(4.5, 0.0, 0.0))["pos"]
86:		for i: int in 30:
87:			feet = _drive(sp, feet, Vector3.ZERO)["pos"]
88:		var at: Vector3 = feet
89:		for i: int in 600:
90:			feet = _drive(sp, feet, Vector3.ZERO)["pos"]
91:		var d2: float = feet.distance_to(at)
92:		worst = maxf(worst, maxf(d, d2))
93:		figs.append("%d deg: %.4f / %.4f m" % [int(deg), d, d2])
94:		sp.call("free_all")
95:	_say("walk.idle_bank", worst < 0.01, "drift placed / after a walk, 600 ticks: %s" % ", ".join(figs))
96:
97:
98:func _jump() -> void:
99:	var sp: RefCounted = Space.new()
100:	flat(sp, 0.0, -20, 20, -20, 20)
101:	var feet: Vector3 = Vector3.ZERO
102:	sp.call("place", feet)
103:	sp.call("rest")
104:	var top: float = 0.0
105:	var air: int = 0
106:	var landed: int = -1
107:	var ev: Array = []
108:	for i: int in 120:
109:		var r: Dictionary = _drive(sp, feet, Vector3.ZERO, i == 5)
110:		feet = r["pos"]
111:		top = maxf(top, feet.y)
112:		if not bool(r["grounded"]):
113:			air += 1
114:		ev.append_array(r["events"])
115:		if (r["events"] as Array).has("land") and landed < 0:
116:			landed = i
117:	# coyote: walking off a 1 m step, the jump pressed 4 ticks after leaving still jumps; 12 ticks after: not
118:	var sp2: RefCounted = Space.new()
119:	flat(sp2, 1.0, -20, 20, -20, 0)
120:	flat(sp2, 0.0, -20, 20, 0, 20)
121:	var coy: Array = []
122:	for late: int in [4, 12]:
123:		var f: Vector3 = Vector3(0, 1.0, -2.0)
124:		sp2.call("place", f)
125:		sp2.call("rest")
126:		var left: int = -1
127:		var jumped: bool = false
128:		var down: bool = false
129:		for i: int in 120:
130:			var r2: Dictionary = _drive(sp2, f, Vector3(0, 0, 4.5), left >= 0 and i == left + late)
131:			f = r2["pos"]
132:			if left < 0 and str(r2["mode"]) == "air":
133:				left = i
134:			if (r2["events"] as Array).has("land"):
135:				down = true
136:			if (r2["events"] as Array).has("jump") and not down:
137:				jumped = true                     # a jump in the air off the edge (a later one is the buffer, on landing)
138:		coy.append(jumped)
139:	# buffer: pressed 5 ticks before landing still jumps
140:	sp.call("place", Vector3.ZERO)
141:	sp.call("rest")
142:	feet = Vector3.ZERO
143:	var jumps: int = 0
144:	var land_at: int = 5 + landed - 5
145:	for i: int in 160:
146:		var r3: Dictionary = _drive(sp, feet, Vector3.ZERO, i == 5 or i == land_at - 4)
147:		feet = r3["pos"]
148:		if (r3["events"] as Array).has("jump"):
149:			jumps += 1
150:	var ok: bool = top > 0.9 and top < 1.1 and air >= 30 and air <= 40 and coy == [true, false] and jumps == 2 and ev.has("jump") and ev.has("land")
151:	_say("walk.jump", ok, "height %.3f m, %d ticks in the air, jump in the air pressed 4 / 12 ticks after walking off a 1 m step: %s, buffered press 4 ticks before landing jumps again: %s" % [top, air, coy, jumps == 2])
152:	sp.call("free_all")
153:	sp2.call("free_all")
154:
