80:## Walker-feel T (blink B2): every 10 frames, a plot with a ground of its own whose game has not arrived and that has
81:## no picture to show keeps its hole in the world's ground shut (`close_holes` below): the pad shows, not the
82:## sky. Called from the viewer's `_process`; changes the material only when the set changes. TL_SHUT_HOLES=off: as before.
83:static func shut_holes(v: Node) -> void:
84:	var land: Node3D = v.get("landscape")
85:	var draw: Node = v.get("draw")
86:	if land == null or draw == null or not land.has_meta(&"tl_ground_mat") or OS.get_environment("TL_SHUT_HOLES") == "off":
87:		return
88:	if Engine.get_process_frames() % 10 != 0 and land.has_meta(&"tl_shut"):
89:		return
90:	var has_ground: Array = v.get("has_ground")
91:	var arrived: Dictionary = v.get("_arrived")
92:	var entries: Array = draw.get("entries")
93:	var shut: Array = []
94:	for i: int in has_ground.size():
95:		var empty: bool = i < entries.size() and ((entries[i] as Dictionary)["pics"] as Dictionary).is_empty()
96:		shut.append(bool(has_ground[i]) and not arrived.has(i) and empty)
97:	if shut != land.get_meta(&"tl_shut", []):
98:		land.set_meta(&"tl_shut", shut)
99:		close_holes(land, has_ground, v.get("radii"), shut)
