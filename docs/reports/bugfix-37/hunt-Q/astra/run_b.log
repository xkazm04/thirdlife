347:				draw.call("set_tier", i, to)                 # P5: a plot whose pack has not arrived has nothing to make a stand-in of
348:				_note("tier p%d %s" % [i, to], tt)
349:			if to == "stage":
350:				_set_stage(i)
351:		"rebuilt":
