162:## A wall of thin quads along a polyline of ground points: `height` metres tall from each point's own y. `closed`: the
163:## last point joins the first. Gaps are made by calling this once per stretch.
164:func add_wall(pts: PackedVector3Array, height: float) -> void:
165:	var faces: PackedVector3Array = PackedVector3Array()
166:	for i: int in pts.size() - 1:
167:		var a: Vector3 = pts[i]
168:		var b: Vector3 = pts[i + 1]
169:		var a2: Vector3 = a + Vector3(0.0, height, 0.0)
170:		var b2: Vector3 = b + Vector3(0.0, height, 0.0)
171:		faces.append_array(PackedVector3Array([a, b, b2, a, b2, a2]))
172:	if faces.size() > 0:
173:		var sh: ConcavePolygonShape3D = ConcavePolygonShape3D.new()
174:		sh.backface_collision = true
175:		sh.set_faces(faces)
176:		_keep.append(sh)
177:		_static(sh, Transform3D.IDENTITY)
178:		stats["boxes"] = int(stats["boxes"]) + 1
