66:## The clip parameter of a pack (toon.gdshader `tl_clip`): radius, rim height, width of the bent band.
67:func _clip_v4(e: Dictionary, g: Node) -> Vector4:
68:	if not e.has("sheets"):
69:		var wide: Array = []
70:		_wide_meshes(e["holder"], maxf(30.0, float(e["radius"])), wide)
71:		e["sheets"] = wide
72:	var w: float = (1.0 if (e["sheets"] as Array).has(g) else 0.0) + (2.0 if reaches_in(e["holder"], g, float(e["radius"])) else 0.0)
73:	return Vector4(float(e["radius"]), float(e["rim"]), _band(e), w)
