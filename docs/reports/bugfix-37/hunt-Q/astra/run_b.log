58:		return "mid"
59:	var d: float = cam.global_position.distance_to((e["rel"] as Transform3D).origin) - float(e["radius"])
60:	if str(e["kind"]) == "far":
61:		return "far" if d > picture_far_m - picture_margin_m else "mid"
62:	return "far" if d > picture_far_m + picture_margin_m else "mid"
