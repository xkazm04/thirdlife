1:extends RefCounted
2:## N7 / P4. The world's own landscape: everything between the plots. Drawn once, owned by the world, never by a pack.
3:##
4:##   var stats: Dictionary = Landscape.build(parent, plots, radii, has_ground, cfg)
5:##
6:## P4: the ground has height (terrain/village_terrain.gd: rolling land, a ring of hills, a bluff, a valley with a river
7:## and two ponds). Every plot stands on a flat pad of its own height (`pad_h`, the walk's plot origin y) with a bank
8:## round it, a kerb at its lip and a spur road that climbs to the gate; the main road follows the land and crosses the
9:## river on a bridge; trees, rocks and bushes follow the land (tree lines on ridges, rocks on banks, none on a road,
10:## none inside a plot). The visitor's collider (terrain/world_space.gd) is built from the same things and stored on
11:## `parent` as the meta `tl_space`.
12:## `plots`: Transform3D per plot (world coordinates, lift included), `radii`: metres, `has_ground`: the pack has terrain
13:## of its own at its edge (the world's ground is cut open for it). `cfg` (the walk script's `landscape` block, all
14:## optional): road, road_half_m, spurs, fence, gates, lots ([{"at": [x, z], "radius": m, "h": pad height}]; S: a lot with
15:## `job` and `replay` is a construction site, kernel/world/site.gd: when its log is found it is a plot, drawn by site/draw.gd), pad_h (per
16:## plot: the height of its pad, default the plot's own y), river ({"path": [[x, z], ...], "half_m", "pond_m"}), trees,
17:## broadleaf, rocks, bushes, tufts, belt, mesas, seed, ground_key, spread_m, cell_m, rim_band.
18:## Cost is in the returned stats (`build_ms`, `terrain_ms`, instance counts); kernel/world/WORLD.md has the figures.
19:
20:const VillageTerrain: GDScript = preload("res://kernel/world/terrain/village_terrain.gd")
21:const WorldSpace: GDScript = preload("res://kernel/world/terrain/world_space.gd")
22:const Parts: GDScript = preload("res://kernel/world/terrain/village_parts.gd")
23:const SiteDraw: GDScript = preload("res://kernel/world/site/draw.gd")    # S: a construction site's look
24:
25:const GROUND_Y: float = 0.0              # the terrain and the far plain: a pack's rim and the ground meet at the same height
26:const FLAT_GROUND_Y: float = -0.06      # the flat ground of single shots (`ground()`), as in N7
27:const PAD_EXTRA: float = 10.5            # the flat of a pad reaches this far beyond the plot's radius (ring and fence stand on it)
28:
29:
30:## The private material of the world's ground: the palette's shader and lookup, with the plots that carry a ground of
31:## their own cut open (toon.gdshader `tl_holes`).
32:static func _ground_material(plots: Array, radii: Array, has_ground: Array) -> ShaderMaterial:
33:	var pal: ShaderMaterial = TLStyle.material(&"white") as ShaderMaterial
34:	if pal == null or pal.shader == null:
35:		return null
36:	var gm: ShaderMaterial = ShaderMaterial.new()
37:	gm.shader = pal.shader
38:	gm.set_shader_parameter(&"pal_lut", pal.get_shader_parameter(&"pal_lut"))
39:	var holes: Array = []
40:	for i: int in plots.size():
41:		if float(radii[i]) > 0.0 and bool(has_ground[i]) and holes.size() < 32:
42:			holes.append(Vector4((plots[i] as Transform3D).origin.x, (plots[i] as Transform3D).origin.z, float(radii[i]) + 2.5, 0.0))
43:	var n: int = holes.size()
44:	while holes.size() < 32:
45:		holes.append(Vector4.ZERO)
46:	gm.set_shader_parameter(&"tl_holes", holes)
47:	gm.set_shader_parameter(&"tl_hole_n", n)
48:	gm.set_meta(&"tl_holes_all", holes.duplicate())      # walker-feel T: every hole as cut, for draw/view_seam.gd `close_holes`
49:	return gm
50:
51:
52:## The flat ground of N7 (used when the landscape is off: `--landscape=off`, single shots).
53:static func ground(parent: Node3D, plots: Array, radii: Array, has_ground: Array, key: String = "") -> MeshInstance3D:
54:	var g: MeshInstance3D = TLStyle.ground(FLAT_GROUND_Y, key, 3000.0)
55:	parent.add_child(g)
56:	var gm: ShaderMaterial = _ground_material(plots, radii, has_ground)
57:	if gm != null:
58:		g.material_override = gm
59:	return g
