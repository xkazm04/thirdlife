30:			dense.append(_cr(p0, p1, p2, p3, t))
31:	if not closed:
32:		dense.append(cps[n - 1])
33:	# even resample
34:	var acc: float = 0.0
35:	var out: PackedVector2Array = PackedVector2Array()
36:	out.append(dense[0])
37:	var m: int = dense.size() + (1 if closed else 0)
38:	for i: int in range(1, m):
39:		var a: Vector2 = dense[(i - 1) % dense.size()]
40:		var b: Vector2 = dense[i % dense.size()]
