263:func _slide() -> void:
264:	var sp: RefCounted = Space.new()
265:	flat(sp, 0.0, -200, 200, -200, 200)
266:	var feet: Vector3 = Vector3.ZERO
267:	sp.call("place", feet)
268:	sp.call("rest")
269:	for i: int in 60:
270:		feet = _drive(sp, feet, Vector3(0, 0, -9.0))["pos"]
271:	var at: Vector3 = feet
272:	var ticks: int = 0
273:	var ended: int = -1
274:	var ev: Array = []
275:	for i: int in 120:
276:		var r: Dictionary = _drive(sp, feet, Vector3.ZERO, false, i == 0)
277:		feet = r["pos"]
278:		ev.append_array(r["events"])
279:		if str(r["mode"]) == "slide":
280:			ticks += 1
281:		elif ended < 0 and i > 0:
282:			ended = i
283:	var slid: float = feet.distance_to(at)
284:	# into a run: the slide ends while W + Shift are held, he is running again
285:	sp.call("rest")
286:	for i: int in 60:
287:		feet = _drive(sp, feet, Vector3(0, 0, -9.0))["pos"]
288:	var v_end: float = 0.0
289:	for i: int in 120:
290:		var r2: Dictionary = _drive(sp, feet, Vector3(0, 0, -9.0), false, i == 0)
291:		feet = r2["pos"]
292:		v_end = (r2["vel"] as Vector3).length()
293:	var ok: bool = ev.has("slide") and ev.has("end_slide") and ticks >= 20 and slid > 4.0 and v_end > 8.9
294:	_say("walk.slide", ok, "a run slide from 9 m/s: %d ticks low, %.2f m to a stop (a stop without it: 0.97 m), ends into a run at %.2f m/s when W stays held" % [ticks, slid, v_end])
295:	sp.call("free_all")
