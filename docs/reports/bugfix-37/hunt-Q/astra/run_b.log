1:extends RefCounted
2:## P4. The world's ground has height. One heightfield for the village (a few hundred metres across), built once:
3:## rolling land, a ring of hills, a bluff with a cliff face behind the northern venues, a low valley with a river,
4:## a flat pad under every plot (a bank all round it, steep where the pad is cut into the land or filled up), and
5:## roads that follow the land.
6:##
7:##   var t = VillageTerrain.new(seed, Rect2(x0, z0, w, d), cell_m)
8:##   t.pads / t.roads / t.river / t.ponds are filled by the caller (landscape.gd), then
9:##   t.build_grid()           the heights (stamps for roads and river: no per-vertex path queries)
10:##   t.build_mesh(material)   one MeshInstance3D, indexed, smooth normals, vertex colours from slope / height / noise
11:##   t.gy(x, z)               the drawn ground height at (x, z), consistent with the mesh triangles
12:##
13:## Visual by itself. The visitor's collider (terrain faces) is `collision_faces()`; nothing here ticks.
14:## Colour and strata are the style's: the palette key "terrain" (class ground: tufts, strata on steep faces).
15:
16:const GROUND_Y: float = 0.0
17:
18:var x0: float = 0.0
19:var z0: float = 0.0
20:var cell: float = 3.0
21:var nx: int = 0                      # cells in x
22:var nz: int = 0
23:var heights: PackedFloat32Array = PackedFloat32Array()
24:var centre: Vector2 = Vector2(5.0, -20.0)
25:var pads: Array = []                 # {c: Vector2, r: float (flat radius), h: float, own: bool, rp: plot radius}
26:const SINK: float = 0.06              # walker-feel T: the pad under a plot without ground of its own lies this much lower
27:const SINK_BAND: float = 3.5          # ... over the plot's radius, rising to the pad's height in this band beyond it (the plot cut ends at r + 3)
28:var roads: Array = []                # {pts: PackedVector2Array, ys: PackedFloat32Array, half: float}
29:var river: Dictionary = {}           # {pts, ys (water level), half}
30:var ponds: Array = []                # {c: Vector2, r: float, y: float}
31:var road_d: PackedFloat32Array = PackedFloat32Array()      # per grid vertex: distance to the nearest road sample
32:var river_d: PackedFloat32Array = PackedFloat32Array()
33:var build_ms: int = 0
34:var skip_near: PackedVector3Array = PackedVector3Array()     # P13: (x, z, radius) of plots `collision_faces` may skip
35:var relief: float = 1.0              # P6: scale of the land's own height (0 = a flat study ground; pads, roads and river still stamp)
36:var _nl: FastNoiseLite = FastNoiseLite.new()
37:var _nm: FastNoiseLite = FastNoiseLite.new()
38:var _nh: FastNoiseLite = FastNoiseLite.new()
39:var _nr: FastNoiseLite = FastNoiseLite.new()
40:var _np: FastNoiseLite = FastNoiseLite.new()
41:var _nd: FastNoiseLite = FastNoiseLite.new()
42:var _c: Dictionary = {}
43:
44:
45:func _init(seed_: int, box: Rect2, cell_m: float = 3.0) -> void:
46:	x0 = box.position.x
47:	z0 = box.position.y
48:	cell = cell_m
49:	nx = int(round(box.size.x / cell))
50:	nz = int(round(box.size.y / cell))
51:	_nl.seed = seed_
52:	_nl.frequency = 0.0075
53:	_nl.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
54:	_nm.seed = seed_ + 1
55:	_nm.frequency = 0.026
56:	_nm.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
57:	_nh.seed = seed_ + 2
58:	_nh.frequency = 0.09
59:	_nh.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
60:	_nr.seed = seed_ + 3
61:	_nr.frequency = 0.006
62:	_nr.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
63:	_np.seed = seed_ + 4
64:	_np.frequency = 0.017
65:	_np.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
66:	_nd.seed = seed_ + 5
67:	_nd.frequency = 0.05
68:	_nd.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
69:	for k: String in ["grass", "grass_dry", "grass_dark", "dirt", "sand", "rock", "rock_dark", "rock_warm", "cliff"]:
70:		_c[k] = TLStyle.color(k)
71:
72:
73:func x1() -> float:
74:	return x0 + float(nx) * cell
75:
76:
77:func z1() -> float:
78:	return z0 + float(nz) * cell
79:
80:
81:## The land before any pad, road or river: rolling ground, the ring of hills, the bluff behind the northern venues.
82:func base_h(x: float, z: float) -> float:
83:	var h: float = 4.2 * _nl.get_noise_2d(x, z) + 1.2 * _nm.get_noise_2d(x, z) + 0.12 * _nh.get_noise_2d(x, z)
84:	var e: Vector2 = Vector2((x - centre.x) / 300.0, (z - centre.y) / 200.0)
85:	var rid: float = 0.55 + 0.45 * (_nr.get_noise_2d(x, z) * 0.5 + 0.5)
86:	h += 24.0 * smoothstep(0.80, 1.28, e.length()) * rid
87:	var zc: float = -205.0 + 16.0 * _nl.get_noise_2d(x * 0.45, 40.0)
88:	var ledge: float = smoothstep(-3.0, 3.0, zc - z) * smoothstep(-300.0, -255.0, z) * smoothstep(-205.0, -120.0, x) * (1.0 - smoothstep(170.0, 260.0, x))
89:	h += 9.5 * ledge
90:	var m: float = smoothstep(0.0, 60.0, minf(minf(x - x0, x1() - x), minf(z - z0, z1() - z)))
91:	return h * m * relief
92:
93:
94:func _v(i: int, j: int) -> int:
95:	return clampi(j, 0, nz) * (nx + 1) + clampi(i, 0, nx)
96:
97:
98:## Builds the heights. Roads and river are stamped (every sample marks the vertices around it).
99:func build_grid() -> void:
100:	var t0: int = Time.get_ticks_msec()
101:	var w: int = nx + 1
102:	var count: int = w * (nz + 1)
103:	heights.resize(count)
104:	road_d.resize(count)
105:	river_d.resize(count)
106:	road_d.fill(1e9)
107:	river_d.fill(1e9)
108:	var road_y: PackedFloat32Array = PackedFloat32Array()
109:	road_y.resize(count)
110:	var river_y: PackedFloat32Array = PackedFloat32Array()
111:	river_y.resize(count)
112:	# 1. the land and the pads. P13: in bands of rows on workers (each band its own array, joined in order: the same
113:	# numbers as one loop); it was a third of the time to the first frame of a village of thirty games.
114:	var bands: int = clampi(OS.get_processor_count() - 1, 1, 8)
115:	var per: int = int(ceil(float(nz + 1) / float(bands)))
116:	var out: Array = []
117:	for b: int in bands:
118:		out.append(PackedFloat32Array())
119:	var task: int = WorkerThreadPool.add_group_task(func(b: int) -> void: out[b] = _land_rows(b * per, mini((b + 1) * per, nz + 1)), bands)
120:	WorkerThreadPool.wait_for_group_task_completion(task)
121:	var joined: PackedFloat32Array = PackedFloat32Array()
122:	for b: int in bands:
123:		joined.append_array(out[b])
124:	heights = joined
125:	# 2. stamps
126:	for rd: Dictionary in roads:
127:		_stamp(rd["pts"], rd["ys"], float(rd["half"]) + 10.0, road_d, road_y)
128:	if not river.is_empty():
129:		_stamp(river["pts"], river["ys"], 40.0, river_d, river_y)
130:	# 3. roads grade the land along them, then the river digs its valley and channel
131:	var rhalf: float = 3.0
132:	if not roads.is_empty():
133:		rhalf = float((roads[0] as Dictionary)["half"])
134:	var rv_half: float = float(river.get("half", 6.0))
135:	for k: int in count:
136:		var h: float = heights[k]
137:		var d: float = road_d[k]
138:		if d < 1e8:
139:			var ph: float = road_y[k]
140:			h = lerpf(h, ph - 0.02, 1.0 - smoothstep(rhalf + 1.6, rhalf + 9.0, d))
141:		var dr: float = river_d[k]
142:		if dr < 1e8:
143:			var lvl: float = river_y[k]
144:			var wv: float = 1.0 - smoothstep(5.0, 36.0, dr)
145:			h = minf(h, lerpf(h, lvl + 0.6, wv))
146:			h = lerpf(h, lvl - 1.0, 1.0 - smoothstep(rv_half * 0.55, rv_half + 5.0, dr))
147:		heights[k] = h
148:	for pn: Dictionary in ponds:
149:		var c: Vector2 = pn["c"]
150:		var pr: float = float(pn["r"])
151:		for j: int in nz + 1:
152:			var z: float = z0 + float(j) * cell
153:			if absf(z - c.y) > pr + 14.0:
154:				continue
155:			for i: int in w:
156:				var x: float = x0 + float(i) * cell
157:				var d2: float = Vector2(x, z).distance_to(c)
158:				if d2 < pr + 14.0:
159:					var k2: int = j * w + i
160:					heights[k2] = lerpf(heights[k2], float(pn["y"]) - 1.2, 1.0 - smoothstep(pr * 0.7, pr + 7.0, d2))
161:	build_ms = Time.get_ticks_msec() - t0
162:
163:
164:## Heights of the land and the pads for rows j0 .. j1 - 1 (runs on a worker: reads only).
165:func _land_rows(j0: int, j1: int) -> PackedFloat32Array:
166:	var w: int = nx + 1
167:	var rows: PackedFloat32Array = PackedFloat32Array()
168:	rows.resize(maxi(0, j1 - j0) * w)
169:	for j: int in range(j0, j1):
170:		var z: float = z0 + float(j) * cell
171:		for i: int in w:
172:			var x: float = x0 + float(i) * cell
173:			var h: float = base_h(x, z)
174:			for pd: Dictionary in pads:
175:				var c: Vector2 = pd["c"]
176:				var dx: float = x - c.x
177:				var dz: float = z - c.y
178:				var r: float = float(pd["r"])
179:				var lim: float = r + 24.0
180:				if absf(dx) > lim or absf(dz) > lim:
181:					continue
182:				var d: float = sqrt(dx * dx + dz * dz)
183:				if d <= r:
184:					h = float(pd["h"])
185:					if not bool(pd["own"]) and d < float(pd.get("rp", 0.0)) + SINK_BAND:
186:						# walker-feel T: a game with no ground of its own lays its floor at the pad's height: the pad
187:						# sinks under it, or the two fight for the same depth (TAA's jitter shows it as flicker)
188:						h -= SINK * (1.0 - smoothstep(float(pd["rp"]), float(pd["rp"]) + SINK_BAND, d))
189:				elif d < lim:
190:					var ph: float = float(pd["h"])
191:					var bw: float = clampf(absf(ph - h) * (0.7 if ph < h else 1.1), 3.5, 22.0)
192:					if d < r + bw:
193:						h = lerpf(ph, h, smoothstep(0.0, 1.0, (d - r) / bw))
194:			rows[(j - j0) * w + i] = h
195:	return rows
196:
197:
198:func _stamp(pts: PackedVector2Array, ys: PackedFloat32Array, reach: float, dist: PackedFloat32Array, yy: PackedFloat32Array) -> void:
199:	var w: int = nx + 1
200:	var rc: int = int(ceil(reach / cell))
201:	for s: int in pts.size():
202:		var p: Vector2 = pts[s]
203:		var ci: int = int(round((p.x - x0) / cell))
204:		var cj: int = int(round((p.y - z0) / cell))
205:		for j: int in range(maxi(cj - rc, 0), mini(cj + rc, nz) + 1):
206:			var z: float = z0 + float(j) * cell
207:			for i: int in range(maxi(ci - rc, 0), mini(ci + rc, nx) + 1):
208:				var dx: float = x0 + float(i) * cell - p.x
209:				var dz: float = z - p.y
210:				var d: float = sqrt(dx * dx + dz * dz)
211:				var k: int = j * w + i
212:				if d < dist[k]:
213:					dist[k] = d
214:					yy[k] = ys[s]
215:
216:
217:## The height at (x, z), consistent with the mesh triangles (the same diagonal rule as the kit's terrain).
218:func h(x: float, z: float) -> float:
219:	var fx: float = clampf((x - x0) / cell, 0.0, float(nx) - 0.0001)
220:	var fz: float = clampf((z - z0) / cell, 0.0, float(nz) - 0.0001)
221:	var i: int = int(fx)
222:	var j: int = int(fz)
223:	var u: float = fx - float(i)
224:	var v: float = fz - float(j)
225:	var a: float = heights[_v(i, j)]
226:	var b: float = heights[_v(i + 1, j)]
227:	var c: float = heights[_v(i + 1, j + 1)]
228:	var d: float = heights[_v(i, j + 1)]
229:	if (i + j) % 2 == 0:
230:		if u >= v:
231:			return a + (b - a) * u + (c - b) * v
232:		return a + (c - d) * u + (d - a) * v
233:	if u + v <= 1.0:
234:		return a + (b - a) * u + (d - a) * v
235:	return c + (d - c) * (1.0 - u) + (b - c) * (1.0 - v)
236:
237:
238:## The drawn ground (the mesh is the heightfield itself: a pack's ground and the world's ground meet at the same height).
239:func gy(x: float, z: float) -> float:
240:	return h(x, z) + GROUND_Y
241:
242:
243:## Slope as 1 - normal.y (0 flat, 0.29 at 45 degrees, 0.5 at 60).
244:func slope(x: float, z: float) -> float:
245:	var e: float = cell * 0.5
246:	var dx: float = h(x + e, z) - h(x - e, z)
247:	var dz: float = h(x, z + e) - h(x, z - e)
248:	return 1.0 - 2.0 * e / sqrt(dx * dx + dz * dz + 4.0 * e * e)
249:
250:
251:func inside(x: float, z: float, margin: float = 0.0) -> bool:
252:	return x >= x0 + margin and x <= x1() - margin and z >= z0 + margin and z <= z1() - margin
253:
254:
255:func river_dist(x: float, z: float) -> float:
256:	if not inside(x, z):
257:		return 1e9
258:	return river_d[_v(int(round((x - x0) / cell)), int(round((z - z0) / cell)))]
259:
260:
261:func road_dist(x: float, z: float) -> float:
262:	if not inside(x, z):
263:		return 1e9
264:	return road_d[_v(int(round((x - x0) / cell)), int(round((z - z0) / cell)))]
265:
266:
267:# ------------------------------------------------------------------------------------------------ colour and mesh
268:func _col(x: float, y: float, z: float, n: Vector3, rd: float, rvd: float) -> Color:
269:	var slope_: float = 1.0 - n.y
270:	var np: float = _np.get_noise_2d(x, z) * 0.5 + 0.5
271:	var base: Color = (_c["grass_dark"] as Color).lerp(_c["grass"], 0.5 + 0.5 * smoothstep(0.2, 0.8, np))
272:	var dry: float = smoothstep(0.55, 0.85, _nd.get_noise_2d(x * 0.4, z * 0.4) * 0.5 + 0.5) * 0.3 + smoothstep(-4.0, 6.0, y) * 0.12
273:	base = base.lerp(_c["grass_dry"], clampf(dry, 0.0, 0.85))
274:	base = base.lerp(_c["rock_warm"], smoothstep(14.0, 34.0, y) * 0.55)
275:	var rk: float = smoothstep(0.17, 0.34, slope_)
276:	var rock: Color = (_c["rock"] as Color).lerp(_c["cliff"], smoothstep(0.3, 0.7, np)).lerp(_c["rock_warm"], smoothstep(0.55, 0.85, _nd.get_noise_2d(x, z + 5.0) * 0.5 + 0.5) * 0.6)
277:	base = base.lerp(rock, rk)
278:	if rd < 30.0:
279:		base = base.lerp((_c["grass_dark"] as Color).lerp(_c["dirt"], 0.35), (1.0 - smoothstep(3.5, 12.0, rd)) * 0.5 * (1.0 - rk))
280:	if rvd < 40.0:
281:		base = base.lerp(_c["sand"], (1.0 - smoothstep(float(river.get("half", 6.0)) * 0.6, float(river.get("half", 6.0)) + 7.0, rvd)) * 0.7 * (1.0 - rk * 0.6))
282:	return base.srgb_to_linear()
283:
284:
285:func build_mesh(mat: Material, name_: String = "WorldTerrain") -> MeshInstance3D:
286:	var t0: int = Time.get_ticks_msec()
287:	var w: int = nx + 1
288:	var count: int = w * (nz + 1)
289:	var vs: PackedVector3Array = PackedVector3Array()
290:	var ns: PackedVector3Array = PackedVector3Array()
291:	var cs: PackedColorArray = PackedColorArray()
292:	var uv: PackedVector2Array = PackedVector2Array()
293:	var cu: PackedFloat32Array = PackedFloat32Array()
294:	vs.resize(count)
295:	ns.resize(count)
296:	cs.resize(count)
297:	uv.resize(count)
298:	cu.resize(count * 4)
299:	var code: float = 1.0 + 16.0 * float(TLStyle.index("terrain"))
300:	for j: int in nz + 1:
301:		var z: float = z0 + float(j) * cell
302:		for i: int in w:
303:			var k: int = j * w + i
304:			var x: float = x0 + float(i) * cell
305:			var y: float = heights[k] + GROUND_Y
306:			var nrm: Vector3 = Vector3(heights[_v(i - 1, j)] - heights[_v(i + 1, j)], 2.0 * cell, heights[_v(i, j - 1)] - heights[_v(i, j + 1)]).normalized()
307:			vs[k] = Vector3(x, y, z)
308:			ns[k] = nrm
309:			cs[k] = _col(x, y, z, nrm, road_d[k], river_d[k])
310:			cu[k * 4] = x
311:			cu[k * 4 + 1] = y
312:			cu[k * 4 + 2] = z
313:			cu[k * 4 + 3] = code
314:	var ix: PackedInt32Array = PackedInt32Array()
315:	ix.resize(nx * nz * 6)
316:	var q: int = 0
317:	for j: int in nz:
318:		for i: int in nx:
319:			var a: int = j * w + i
320:			var b: int = a + 1
321:			var d: int = a + w
322:			var c: int = d + 1
323:			# the faces look up (+y): Godot winds front faces clockwise seen from outside
324:			if (i + j) % 2 == 0:
325:				ix[q] = a; ix[q + 1] = b; ix[q + 2] = c
326:				ix[q + 3] = a; ix[q + 4] = c; ix[q + 5] = d
327:			else:
328:				ix[q] = a; ix[q + 1] = b; ix[q + 2] = d
329:				ix[q + 3] = b; ix[q + 4] = c; ix[q + 5] = d
330:			q += 6
331:	var arr: Array = []
332:	arr.resize(Mesh.ARRAY_MAX)
333:	arr[Mesh.ARRAY_VERTEX] = vs
334:	arr[Mesh.ARRAY_NORMAL] = ns
335:	arr[Mesh.ARRAY_COLOR] = cs
336:	arr[Mesh.ARRAY_TEX_UV] = uv
337:	arr[Mesh.ARRAY_CUSTOM0] = cu
338:	arr[Mesh.ARRAY_INDEX] = ix
339:	var mesh: ArrayMesh = ArrayMesh.new()
340:	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr, [], {}, Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM0_SHIFT)
341:	mesh.surface_set_material(0, mat)
342:	var mi: MeshInstance3D = MeshInstance3D.new()
343:	mi.name = name_
344:	mi.mesh = mesh
345:	mi.material_override = mat
346:	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
347:	build_ms += Time.get_ticks_msec() - t0
348:	return mi
349:
350:
351:## Triangles of the heightfield for the visitor's collider (world coordinates, GROUND_Y included). `skip` is a Callable
352:## (centre x, centre z) -> bool: true leaves the triangle out (a plot whose own ground carries the visitor there).
353:func collision_faces(skip: Callable) -> PackedVector3Array:
354:	# P13: the same triangles in the same order as P4's loop, without an Array per cell, and `skip` asked only for
355:	# cells near a plot whose own ground carries the visitor (`skip_near`: centres and radii; empty = ask everywhere)
356:	var faces: PackedVector3Array = PackedVector3Array()
357:	faces.resize(nx * nz * 6)
358:	var n: int = 0
359:	var near: bool = not skip_near.is_empty()
360:	for j: int in nz:
361:		var za: float = z0 + float(j) * cell
362:		for i: int in nx:
363:			var xa: float = x0 + float(i) * cell
364:			var a: Vector3 = Vector3(xa, heights[_v(i, j)] + GROUND_Y, za)
365:			var b: Vector3 = Vector3(xa + cell, heights[_v(i + 1, j)] + GROUND_Y, za)
366:			var c: Vector3 = Vector3(xa + cell, heights[_v(i + 1, j + 1)] + GROUND_Y, za + cell)
367:			var d: Vector3 = Vector3(xa, heights[_v(i, j + 1)] + GROUND_Y, za + cell)
368:			var ask: bool = true
369:			if near:
370:				ask = false
371:				for q: Vector3 in skip_near:
372:					if absf(xa + cell * 0.5 - q.x) < q.z + cell and absf(za + cell * 0.5 - q.y) < q.z + cell:
373:						ask = true
374:						break
375:			var even: bool = (i + j) % 2 == 0
376:			var t0a: Vector3 = a
377:			var t0b: Vector3 = b
378:			var t0c: Vector3 = c if even else d
379:			var t1a: Vector3 = a if even else b
380:			var t1b: Vector3 = c
381:			var t1c: Vector3 = d
382:			if not ask or not bool(skip.call((t0a.x + t0b.x + t0c.x) / 3.0, (t0a.z + t0b.z + t0c.z) / 3.0)):
383:				faces[n] = t0a
384:				faces[n + 1] = t0c
385:				faces[n + 2] = t0b
386:				n += 3
387:			if not ask or not bool(skip.call((t1a.x + t1b.x + t1c.x) / 3.0, (t1a.z + t1b.z + t1c.z) / 3.0)):
388:				faces[n] = t1a
389:				faces[n + 1] = t1c
390:				faces[n + 2] = t1b
391:				n += 3
392:	faces.resize(n)
393:	return faces

