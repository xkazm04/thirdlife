65:func _show(e: Dictionary) -> void:
66:	var far: bool = bool(e["far"])
67:	var pics: Dictionary = e["pics"]
68:	var kind: String = _kind_for(e) if far else ""
69:	if far and not pics.has(kind):
70:		for k: String in ["mid", "far", "still"]:
71:			if pics.has(k):
72:				kind = k
73:				break
74:	e["kind"] = kind
75:	for k: String in pics:
76:		(pics[k] as Node3D).visible = k == kind
77:	var life: Dictionary = e["life"]
78:	var alive: bool = far and kind != "still"
79:	for mm: Variant in life.get("mms", []):
80:		(mm as Node3D).visible = alive
81:		life["dirty"] = true
82:	for s: Variant in life.get("smoke", []):
83:		(s as Node3D).visible = alive
84:	for rid: RID in life.get("lights", []):
85:		RenderingServer.instance_set_visible(rid, far and kind == "mid")
86:	for b: Dictionary in (e["boards"] as Dictionary).get("list", []):
87:		(b["node"] as Node3D).visible = kind != "still"          # near, mid and far: one score at every distance
