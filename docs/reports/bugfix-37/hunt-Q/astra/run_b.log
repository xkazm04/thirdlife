156:func _ledge() -> void:
157:	var sp: RefCounted = Space.new()
158:	flat(sp, 3.0, -20, 20, -20, 0)
159:	flat(sp, 0.0, -20, 20, 0, 20)
160:	var feet: Vector3 = Vector3(0, 3.0, -1.0)
161:	sp.call("place", feet)
162:	sp.call("rest")
163:	var ys: Array = []
164:	var biggest: float = 0.0
165:	var fall: int = 0
166:	var landed: bool = false
167:	for i: int in 90:
168:		var r: Dictionary = _drive(sp, feet, Vector3(0, 0, 4.5))
169:		var ny: float = (r["pos"] as Vector3).y
170:		biggest = maxf(biggest, feet.y - ny)
171:		if str(r["mode"]) == "air":
172:			fall += 1
173:		if (r["events"] as Array).has("land"):
174:			landed = true
175:		feet = r["pos"]
176:		ys.append(snappedf(feet.y, 0.01))
177:	var ok: bool = biggest < 0.75 and fall > 12 and landed and absf(feet.y) < 0.02
178:	_say("walk.ledge", ok, "3 m ledge at 4.5 m/s: %d ticks falling, largest drop in one tick %.3f m, landed %s, feet y %s" % [fall, biggest, landed, ys.slice(10, 40)])
179:	sp.call("free_all")
180:
181:
182:func _steep() -> void:
183:	var sp: RefCounted = Space.new()
184:	# a 65 degree bank from y 8 at z -3.7 down to y 0 at z 0, flat ground below and above
185:	var t: float = tan(deg_to_rad(65.0))
186:	var top_z: float = -8.0 / t
187:	sp.call("add_faces", PackedVector3Array([Vector3(-20, 8, top_z), Vector3(20, 8, top_z), Vector3(20, 0, 0), Vector3(-20, 8, top_z), Vector3(20, 0, 0), Vector3(-20, 0, 0)]))
188:	flat(sp, 0.0, -20, 20, 0, 30)
189:	flat(sp, 8.0, -20, 20, -20, top_z)
190:	# 1. walking off the top edge onto it: he slides down to its foot and stops on the flat
191:	var feet: Vector3 = Vector3(0, 8.0, top_z - 1.0)
192:	sp.call("place", feet)
193:	sp.call("rest")
194:	var modes: Dictionary = {}
195:	var top_speed: float = 0.0
196:	var stop_tick: int = -1
197:	for i: int in 240:
198:		var r: Dictionary = _drive(sp, feet, Vector3(0, 0, 4.5) if i < 20 else Vector3.ZERO)
199:		feet = r["pos"]
200:		modes[str(r["mode"])] = int(modes.get(str(r["mode"]), 0)) + 1
201:		top_speed = maxf(top_speed, (r["vel"] as Vector3).length())
202:		if stop_tick < 0 and i > 20 and str(r["mode"]) == "ground" and (r["vel"] as Vector3).length() < 0.01:
203:			stop_tick = i
204:	var ok1: bool = modes.has("slope") and absf(feet.y) < 0.05 and feet.z > 0.0 and stop_tick > 0
205:	# 2. walking up into it from below: refused (a wall), he does not climb
206:	var f2: Vector3 = Vector3(0, 0, 2.0)
207:	sp.call("place", f2)
208:	sp.call("rest")
209:	for i: int in 120:
210:		f2 = _drive(sp, f2, Vector3(0, 0, -4.5))["pos"]
211:	var ok2: bool = f2.y < 0.6
212:	_say("walk.steep", ok1 and ok2, "65 deg bank 8 m: walked off the top, %d ticks sliding, top speed %.2f m/s, stopped at tick %d at z %.2f y %.3f (foot at z 0); walking up into it from below ends at y %.2f" % [int(modes.get("slope", 0)), top_speed, stop_tick, feet.z, feet.y, f2.y])
213:	sp.call("free_all")
214:
