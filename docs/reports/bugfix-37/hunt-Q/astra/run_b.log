319:		pos.y += float(pd["dy"])
320:		ground_n = n
321:		return {"pos": pos, "blocked": hit, "state": "ground"}
322:	var landed: Vector3 = pos + Vector3(0.0, float(pd["dy"]), 0.0)
323:	var sn: Vector3 = _steep_n(landed)
324:	if sn == Vector3.ZERO:
325:		pos.y -= up.y                                # the round foot met an edge, not a slope: he walks off it and falls
326:		return {"pos": pos, "blocked": hit, "state": "air"}
327:	var downhill: Vector3 = Vector3(sn.x, 0.0, sn.z)
