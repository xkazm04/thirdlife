210:## Points on two circles (radius - 2 and radius + 2, 72 each) count as covered when a wide mesh that the plot cut
211:## keeps (its origin inside the radius) spans them in x and z. TL_GROUND_COVER=off: the rule before (the before
212:## pictures; the rim cache then uses the key without "|cover").
213:const COVER_MIN: float = 0.95
214:
215:
216:static func ground_cover(holder: Node3D, radius: float, wide: Array) -> float:
217:	var boxes: Array = []
218:	for m: MeshInstance3D in wide:
219:		var xf: Transform3D = holder.global_transform.affine_inverse() * m.global_transform
220:		if Vector2(xf.origin.x, xf.origin.z).length() > radius:
221:			continue                                  # toon.gdshader drops an instance whose origin is outside the plot
222:		var bb: AABB = xf * m.mesh.get_aabb()
223:		boxes.append(Rect2(bb.position.x, bb.position.z, bb.size.x, bb.size.z))
224:	var hit: int = 0
225:	var n: int = 0
226:	for rr: float in [radius - 2.0, radius + 2.0]:
227:		for k: int in 72:
228:			var a: float = TAU * float(k) / 72.0
229:			var p: Vector2 = Vector2(cos(a), sin(a)) * rr
230:			n += 1
231:			for b: Rect2 in boxes:
232:				if b.has_point(p):
233:					hit += 1
234:					break
235:	return float(hit) / float(n)
236:
237:
238:## Meshes at least `width` metres wide both ways and flat-ish (wider than tall): the terrain sheets of a pack.
239:static func _wide_meshes(n: Node, width: float, out: Array) -> void:
240:	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null and (n as MeshInstance3D).visible:
241:		var bb: AABB = (n as MeshInstance3D).mesh.get_aabb()
242:		if minf(bb.size.x, bb.size.z) >= width and bb.size.y < minf(bb.size.x, bb.size.z):
243:			out.append(n)
244:	for c: Node in n.get_children():
245:		_wide_meshes(c, width, out)

