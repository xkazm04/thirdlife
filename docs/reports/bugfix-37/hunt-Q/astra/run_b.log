166:
167:## P13, the picture cache: `<cache>/pictures/<key>_<kind>.res` (P14: PlotFile.cache_dir), the key being the hash of the pack's directory
168:## (plotfile.gd `dir_hash`: its files' content), the plot's radius and rim and the picture rules. A plot whose pack is
169:## not built yet shows its last known picture from it; a pack that changed has another key. Written on a worker.
170:func _cache_key(e: Dictionary) -> String:
171:	if not is_instance_valid(e["holder"]):
172:		return ""
173:	var dir: String = str((e["holder"] as Node).get("pack_dir"))
174:	if dir.is_empty() or dir == "<null>" or OS.get_environment("TL_PICTURE_CACHE") == "off":
175:		return ""
176:	if not _dir_hashes.has(dir):
177:		_hash_dir_async(dir)
178:		return ""
179:	var slot: Array = _dir_hashes[dir]
180:	if not WorkerThreadPool.is_task_completed(int(slot[0])) or slot.size() < 2:
181:		return ""                      # its hash is still being read on a worker: no cache this time
182:	var rules: String = "%s|%s|%s|%s|%s|%s|%s|%s|%s" % [PIC_VERSION, mid_min, far_min, far_cell, far_flat, far_thin, far_small, standin_min, rim_band]
183:	return ("%s|%s|%s|%s|%s" % [slot[1], snappedf(float(e["radius"]), 0.01), snappedf(float(e["rim"]), 0.01), rules, _band(e)]).md5_text()
184:
185:
186:## The content hash of a pack directory reads every file of it (60 to 100 ms for the seeds): on a worker, never in a
187:## frame. `_dir_hashes[dir]` = [task] while it runs, [task, hash] when it is done (waited for in `clear`).
188:func _hash_dir_async(dir: String) -> void:
189:	if dir.is_empty() or _dir_hashes.has(dir):
190:		return
191:	var slot: Array = []
192:	slot.append(WorkerThreadPool.add_task(func() -> void: slot.append(str(PlotFile.call("dir_hash", dir)))))
193:	_dir_hashes[dir] = slot
194:
195:
196:func _cache_path(key: String, kind: String) -> String:
197:	return "%s/pictures/%s_%s.res" % [str(PlotFile.call("cache_dir")), key, kind]     # P14: TL_CACHE_DIR or the user directory
198:
199:
200:func _cache_save(e: Dictionary, kind: String, mesh: ArrayMesh) -> void:
201:	var key: String = _cache_key(e)
202:	if key.is_empty() or FileAccess.file_exists(_cache_path(key, kind)):
203:		return
204:	# no material is written (a material in the file is a new material and costs a shader compile on loading): each
205:	# surface notes "pal" or the colour and metal of its flat toon material, made again by TLStyle on loading
206:	var copy: ArrayMesh = mesh.duplicate(false) as ArrayMesh
207:	var mats: Array = []
208:	for s: int in copy.get_surface_count():
209:		var m: Material = copy.surface_get_material(s)
210:		var lut: Variant = (m as ShaderMaterial).get_shader_parameter(&"pal_lut") if m is ShaderMaterial and m != _pal else null
211:		if m == _pal:
212:			mats.append("pal")
213:		elif lut is Texture2D and (lut as Texture2D).get_image() != null:
214:			var img: Image = (lut as Texture2D).get_image()
215:			var c: Color = img.get_pixel(0, 0).linear_to_srgb()
216:			mats.append([c.r, c.g, c.b, img.get_pixel(0, 1).r])
217:		else:
218:			return                     # a material that cannot be made again: this picture is not cached
219:		copy.surface_set_material(s, null)
220:	copy.set_meta(&"tl_mats", mats)
221:	DirAccess.make_dir_recursive_absolute(_cache_path(key, kind).get_base_dir())
222:	_cache_tasks.append(WorkerThreadPool.add_task(func() -> void: ResourceSaver.save(copy, _cache_path(key, kind))))
223:
224:
225:## The cached pictures of a pack, made into this layer's pictures; false when one is missing.
226:func _cache_load(e: Dictionary, kinds: Array) -> bool:
227:	var key: String = _cache_key(e)
228:	if key.is_empty():
229:		return false
230:	for k: String in kinds:
231:		if not FileAccess.file_exists(_cache_path(key, k)):
232:			return false
233:	var t0: int = Time.get_ticks_usec()
234:	for k: String in kinds:
235:		var mesh: ArrayMesh = ResourceLoader.load(_cache_path(key, k), "", ResourceLoader.CACHE_MODE_IGNORE) as ArrayMesh
236:		if mesh == null:
237:			return false
238:		var mats: Array = mesh.get_meta(&"tl_mats", [])
239:		for s: int in mini(mats.size(), mesh.get_surface_count()):
240:			var f: Variant = mats[s]
241:			mesh.surface_set_material(s, _pal if typeof(f) == TYPE_STRING else TLStyle.flat_material(Color(float(f[0]), float(f[1]), float(f[2])), float(f[3])))
242:		var mi: MeshInstance3D = MeshInstance3D.new()
243:		mi.name = "Picture_%s_cached" % k
244:		mi.mesh = mesh
245:		mi.visible = false
246:		_place_standin(e, mi)
247:		add_child(mi)
248:		(e["pics"] as Dictionary)[k] = mi
249:		var tris: int = 0
250:		for s: int in mesh.get_surface_count():
251:			tris += mesh.surface_get_array_index_len(s) / 3
252:		(e["standin_info"] as Dictionary)[k] = {"kind": k, "tris": tris, "from": "cache", "main_ms": snappedf(float(Time.get_ticks_usec() - t0) / 1000.0, 0.01)}
253:	stats["pictures_from_cache"] = int(stats.get("pictures_from_cache", 0)) + 1
254:	_note("pic_cache", t0)
255:	return true
256:
257:
258:## A stand-in is drawn like the pack it stands for: the node stays at the origin and the shader moves it (candidate A),
259:## so the plot cut and the bent rim, which work in the pack's own coordinates, are the same as on the full pack.
260:func _place_standin(e: Dictionary, mi: MeshInstance3D) -> void:
261:	mi.transform = Transform3D.IDENTITY
262:	mi.set_instance_shader_parameter(PLOT, _plot_v4(e["rel"]))
263:	if float(e["radius"]) > 0.0:
264:		mi.set_instance_shader_parameter(CLIP, Vector4(float(e["radius"]), float(e["rim"]), 0.0, 0.0))    # cut, not bent: the bend is baked
265:	if mi.mesh != null:
266:		mi.custom_aabb = (e["rel"] as Transform3D) * mi.mesh.get_aabb().grow(4.0)
267:
268:
269:func _collect_standin(n: Node, holder: Node3D, accs: Array, jobs: Array) -> void:
270:	if n is Node3D and not (n as Node3D).visible:
271:		return
272:	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
273:		var m: MeshInstance3D = n
274:		var moving: bool = _under_moving_body(m, holder) or m.get_skin_reference() != null
275:		var longest: float = m.mesh.get_aabb().size[m.mesh.get_aabb().get_longest_axis_index()] * m.global_basis.get_scale().x
276:		var xf: Transform3D = holder.global_transform.affine_inverse() * m.global_transform
277:		var arrays: Dictionary = {}          # surface -> arrays, read once for all pictures
278:		for acc: Acc in accs:
279:			var sheet: bool = acc.sheets.has(m)
280:			if moving:
281:				acc.dropped_moving += 1
282:			elif longest < acc.min_size:
283:				acc.dropped_small += 1
284:			elif acc.radius > 0.0 and Vector2(m.global_position.x, m.global_position.z).length() > acc.radius and not reaches_in(holder, m, acc.radius):        # walker-feel T2: a long slab that reaches in is cut, not dropped
285:				acc.dropped_outside += 1
286:			else:
287:				for s: int in m.mesh.get_surface_count():
288:					var target: Acc = _target(acc, m.get_active_material(s))
289:					if target != null and _is_triangles(m.mesh, s):
290:						# only the kit's terrain is re-meshed for the far picture: a wide merged mesh of track and buildings
291:						# is a "sheet" for the rim too, and a grid would eat it (seen: the drive seed lost its track)
292:						jobs.append([target, m.mesh, xf, sheet, sheet and String(m.name).begins_with("Terrain"), acc, s])
293:						acc.kept += 1
294:					else:
295:						acc.dropped_other += 1
296:	elif n is MultiMeshInstance3D and (n as MultiMeshInstance3D).multimesh != null and (n as MultiMeshInstance3D).multimesh.mesh != null:
297:		var mmi: MultiMeshInstance3D = n
298:		var mm: MultiMesh = mmi.multimesh
299:		var base: Transform3D = holder.global_transform.affine_inverse() * mmi.global_transform
300:		var count: int = mm.visible_instance_count if mm.visible_instance_count >= 0 else mm.instance_count
301:		for s: int in mm.mesh.get_surface_count():
302:			var mat: Material = mmi.material_override if mmi.material_override != null else mm.mesh.surface_get_material(s)
303:			if mat != _pal or not _is_triangles(mm.mesh, s):
304:				for acc: Acc in accs:
305:					acc.dropped_other += 1
306:				continue
307:			var mlongest: float = mm.mesh.get_aabb().size[mm.mesh.get_aabb().get_longest_axis_index()]
308:			for i: int in count:
309:				var it: Transform3D = mm.get_instance_transform(i)
310:				var size: float = mlongest * it.basis.get_scale().y
311:				var io: Vector3 = (base * it).origin
312:				for acc: Acc in accs:
313:					if size < acc.min_size or acc.kept > 20000:
314:						acc.dropped_small += 1
315:					elif acc.radius > 0.0 and Vector2(io.x, io.z).length() > acc.radius:
316:						acc.dropped_outside += 1
317:					else:
318:						jobs.append([acc, mm.mesh, base * it, false, false, acc, s])
319:						acc.kept += 1
320:	for c: Node in n.get_children():
321:		_collect_standin(c, holder, accs, jobs)
322:
