1:extends RefCounted
2:## Walker-feel (lane M, 18 Nov 2026): the body of a person's visitor, with weight. It moves the world's kinematic
3:## capsule (terrain/world_space.gd, `sp`) by VELOCITY, one `drive()` per world tick (60 Hz; every number below is per
4:## second or counted in ticks). `world_space.gd walk()` stays for the probes and a scripted walk.
5:##   ground   the horizontal velocity eases toward the wish: ACCEL m/s^2 while the wish has a direction, DECEL while it
6:##            is let go; standing still on walkable ground is not a move at all (no test, no creep).
7:##   air      gravity GRAVITY, falls at most FALL_MAX; a little steering (AIR_ACCEL); lands on walkable ground.
8:##   jump     JUMP_V up (h = JUMP_V^2 / 2g = 1.0 m, about 35 ticks in the air on flat ground); allowed COYOTE ticks
9:##            after walking off an edge; a press is kept BUFFER ticks, so a press just before landing still jumps.
10:##   slope    ground steeper than `max_slope_deg`: he slides down it, gaining speed along it (gravity projected on the
11:##            slope, SLOPE_FRICTION against it, at most SLOPE_MAX), steerable a little (SLOPE_STEER), until he stands on
12:##            walkable ground again. Walking UP into such ground is refused as before (a wall); walking DOWN onto it
13:##            starts the slide.
14:##   slide    a run slide (`slide` asked while grounded and faster than SLIDE_MIN): the speed he has is kept and decays
15:##            by SLIDE_DECEL; a little steering; ends below SLIDE_END or after SLIDE_MAX ticks.
16:
17:var _w: WeakRef = null                 # the world's space (world_space.gd), weakly: it holds this body
18:var sp: Variant:
19:	get:
20:		return _w.get_ref()
21:
22:
23:func _init(space_: RefCounted) -> void:
24:	_w = weakref(space_)
25:
26:const GRAVITY: float = 24.0
27:const JUMP_V: float = 6.93
28:const FALL_MAX: float = 40.0
29:const COYOTE: int = 6
30:const BUFFER: int = 8
31:const ACCEL: float = 34.0
32:const DECEL: float = 42.0
33:const AIR_ACCEL: float = 9.0
34:const SNAP_DOWN: float = 0.35
35:const SLOPE_FRICTION: float = 3.0
36:const SLOPE_MAX: float = 14.0
37:const SLOPE_STEER: float = 4.0
38:const SLIDE_MIN: float = 6.0
39:const SLIDE_DECEL: float = 7.0
40:const SLIDE_END: float = 2.6
41:const SLIDE_MAX: int = 70
42:const SLIDE_STEER: float = 3.0
43:const STEP_TICKS: int = 9            # a wish that starts from rest is kept at least this long: a tapped key is a step
44:
45:var vel: Vector3 = Vector3.ZERO       # m/s
46:var grounded: bool = true
47:var mode: String = "ground"           # ground | air | slope | slide
48:var ground_n: Vector3 = Vector3.UP
49:var air_ticks: int = 0                # ticks since he last stood on walkable ground
50:var _buffer: int = 0
51:var _jumped: bool = false             # this airtime began with a jump (no coyote jump after it)
52:var _slide_t: int = 0
53:var _step_t: int = 0
54:var _step_wish: Vector3 = Vector3.ZERO
55:
56:
57:## Starts the body at rest, standing (after a teleport: `put`, entering, leaving).
58:func rest() -> void:
59:	vel = Vector3.ZERO
60:	grounded = true
61:	mode = "ground"
62:	air_ticks = 0
63:	_buffer = 0
64:	_jumped = false
65:	_slide_t = 0
66:	_step_t = 0
67:
68:
69:func _walkable(n: Vector3) -> bool:
70:	return n.y >= cos(deg_to_rad(sp.max_slope_deg)) - 0.0001
71:
72:
73:## True when the ground straight under the feet (a ray from the capsule's middle, at most 1.2 m under the feet) is
74:## steeper than `sp.max_slope_deg`: a slope. The capsule's round foot touching an EDGE also reports a steep normal; under
75:## an edge the ray finds the lower ground (walkable) or nothing.
76:func _steep_under(pos: Vector3) -> bool:
77:	return _steep_n(pos) != Vector3.ZERO
78:
79:
80:## The normal of the steep ground straight under the feet (see `_steep_under`), or ZERO.
81:func _steep_n(pos: Vector3) -> Vector3:
82:	var q: PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(pos + Vector3(0.0, 0.5, 0.0), pos + Vector3(0.0, -1.2, 0.0), 1)
83:	var h: Dictionary = PhysicsServer3D.space_get_direct_state(sp.space).intersect_ray(q)
84:	return h["normal"] if not h.is_empty() and not _walkable(h["normal"]) else Vector3.ZERO
85:
86:
87:## Down from `pos` by `reach`: {"hit", "dy", "n"}; only the vertical part of the engine's travel is kept (its
88:## depenetration push has a sideways part on a slope: that was the creep).
89:func _probe_down(pos: Vector3, reach: float) -> Dictionary:
90:	if sp._test(Transform3D(Basis(), pos), Vector3(0.0, -reach, 0.0)):
91:		return {"hit": true, "dy": sp._res.get_travel().y, "n": sp._res.get_collision_normal(0)}
92:	return {"hit": false, "dy": -reach, "n": Vector3.UP}
93:
94:
95:## Moves by `motion` sliding along what it meets (three times at most); a hit with walkable ground while falling is a
96:## landing. Returns {"pos", "hit", "land", "n"}; `vel` loses its part into every surface met.
97:func _slide_move(pos: Vector3, motion: Vector3) -> Dictionary:
98:	var rest_m: Vector3 = motion
99:	var out: Dictionary = {"hit": false, "land": false, "n": Vector3.UP}
100:	for it: int in 3:
101:		if rest_m.length() < 0.0005:
102:			break
103:		if sp._test(Transform3D(Basis(), pos), rest_m):
104:			out["hit"] = true
105:			var n: Vector3 = sp._res.get_collision_normal(0)
106:			sp.last_hit = {"tag": sp._tags.get(sp._res.get_collider_rid(0), "?"), "at": sp._res.get_collision_point(0), "n": n, "from": pos}
107:			pos += sp._res.get_travel()
108:			var rem: Vector3 = sp._res.get_remainder()
109:			if _walkable(n) and vel.y <= 0.0:
110:				out["land"] = true
111:				out["n"] = n
112:				rem.y = 0.0
113:				vel.y = 0.0
114:				rest_m = rem
115:				continue
116:			if vel.dot(n) < 0.0:
117:				vel -= n * vel.dot(n)
118:			rest_m = rem - n * rem.dot(n)
119:		else:
120:			pos += rest_m
121:			rest_m = Vector3.ZERO
122:	out["pos"] = pos
123:	return out
124:
