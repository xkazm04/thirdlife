201:					vel = Vector3.ZERO                 # refused by a steep slope ahead: he stops there
202:			if str(r["state"]) == "air":
203:				mode = "air"
204:				grounded = false
205:				_jumped = false
206:				air_ticks = 0
207:				if ev.has("slide") or _slide_t > 0:
208:					ev.append("end_slide")
209:			elif str(r["state"]) == "slope":
