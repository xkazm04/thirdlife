138:func _mat_ok(m: Material) -> bool:
139:	if not (m is ShaderMaterial) or (m as ShaderMaterial).shader == null:
140:		return false
141:	var sh: Shader = (m as ShaderMaterial).shader
142:	if not _shader_ok.has(sh):
143:		_shader_ok[sh] = sh.code.contains("instance uniform vec4 tl_plot")
144:	return _shader_ok[sh]
