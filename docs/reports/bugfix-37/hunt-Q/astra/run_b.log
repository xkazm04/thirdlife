6:const DrawScript: GDScript = preload("res://kernel/world/draw/draw.gd")
7:const PlotFile: GDScript = preload("res://kernel/world/plotfile.gd")
8:const COPY_US: int = 2000               # what the copy may take of a frame
9:const COPY_NEAR_M: float = 10.0         # a plot whose edge is nearer than this to the visitor is copied whole at once
10:
11:static var _hashes: Dictionary = {}     # pack directory -> content hash, once per process (PATCHES-P13 entry 4)
12:
13:
14:## P5. The rim of plot `i` (draw.gd `edge_height`). A plot whose pack is not built yet takes it from the rim cache, a
15:## file in the user directory keyed by the pack directory's content, the radius and the scenery; when it is not there
16:## the pack is built now, before the first frame, and the cache learns it (the first visit of a world on a machine).
17:## P14: a directory's content is hashed once per process, not once per plot (thirty plots of walk30 share nine).
18:static func rim_of(v: Node, i: int, r: float) -> float:
19:	var world: Node = v.get("world")
20:	var h: Node = (world.get("packs") as Array)[i]
21:	if bool(h.get("loaded")) or world.get("jobs") == null or (h.get("manifest") as Dictionary).is_empty():
22:		return float(DrawScript.call("edge_height", h, r))
23:	var rims: Dictionary = v.get("_rims")
24:	if rims.is_empty() and FileAccess.file_exists(rims_path()):
25:		var j: Variant = JSON.parse_string(FileAccess.get_file_as_string(rims_path()))
26:		if typeof(j) == TYPE_DICTIONARY:
27:			rims.merge(j)
28:	var dir: String = str(h.get("pack_dir"))
29:	if not _hashes.has(dir):
30:		_hashes[dir] = str(PlotFile.call("dir_hash", dir))
31:	var opts: Dictionary = v.get("opts")
32:	var key: String = ("%s|%s|%s" if OS.get_environment("TL_GROUND_COVER") == "off" else "%s|%s|%s|cover") % [str(_hashes[dir]), str(r), str(opts.get("scenery", (world.get("walk") as Dictionary).get("scenery", "plot")))]
33:	if not rims.has(key) or OS.get_environment("TL_RIM_CACHE") == "off":
34:		(world.get("jobs") as RefCounted).call("now", i)
35:		var e: float = float(DrawScript.call("edge_height", (world.get("packs") as Array)[i], r))
36:		rims[key] = "none" if is_nan(e) else e
37:		v.set("_rims_new", int(v.get("_rims_new")) + 1)
38:	return NAN if typeof(rims[key]) == TYPE_STRING else float(rims[key])
