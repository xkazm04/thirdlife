67:## between its first and last key a camera of this layer is the current one, moved every drawn frame along the keys
68:## (linear, world coordinates). Drawing only: nothing of a pack or of the world host reads it.
69:func _motion_setup() -> void:
70:	var path: String = OS.get_environment("TL_DRAW_CAMERA")
71:	if path.is_empty() or not FileAccess.file_exists(path):
72:		return
73:	var j: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
74:	if typeof(j) != TYPE_DICTIONARY or typeof((j as Dictionary).get("keys")) != TYPE_ARRAY:
75:		return
76:	_motion = (j as Dictionary)["keys"]
77:	_motion_cam = Camera3D.new()
78:	_motion_cam.name = "MotionStudy"
79:	_motion_cam.fov = 50.0
80:	_motion_cam.far = 4000.0
81:	add_child(_motion_cam)
82:
83:
84:func _motion_step() -> void:
85:	var t: float = float(world.get("tick")) if world != null else 0.0
86:	if t < float((_motion[0] as Array)[0]) or t > float((_motion[_motion.size() - 1] as Array)[0]):
87:		return
88:	var k: int = 0
89:	while k < _motion.size() - 2 and t > float((_motion[k + 1] as Array)[0]):
90:		k += 1
91:	var a: Array = _motion[k]
92:	var b: Array = _motion[mini(k + 1, _motion.size() - 1)]
93:	var span: float = maxf(1.0, float(b[0]) - float(a[0]))
94:	var f: float = clampf((t - float(a[0])) / span, 0.0, 1.0)
95:	var from: Vector3 = _v(a[1]).lerp(_v(b[1]), f)
96:	var to: Vector3 = _v(a[2]).lerp(_v(b[2]), f)
97:	_motion_cam.global_transform = Transform3D(Basis.looking_at(to - from, Vector3.UP), from)
98:	if not _motion_cam.current:
99:		_motion_cam.make_current()
100:		print("[draw] motion first tick %d frame %d" % [int(t), Engine.get_frames_drawn()])
101:
102:
103:func _v(a: Variant) -> Vector3:
104:	return Vector3(float((a as Array)[0]), float((a as Array)[1]), float((a as Array)[2]))
105:
106:
107:## Re-bases the world on another stage pack: once, not per tick. N7: `-1` = nobody is on stage (the visitor walks):
108:## every pack is drawn at its plot, in world coordinates.
109:func set_stage(index: int) -> void:
110:	stage = clampi(index, -1, entries.size() - 1)
111:	var inv: Transform3D = (entries[stage]["plot"] as Transform3D).affine_inverse() if stage >= 0 else Transform3D.IDENTITY
112:	for i: int in entries.size():
113:		var e: Dictionary = entries[i]
114:		_unplace(e)
115:		e["rel"] = inv * (e["plot"] as Transform3D)
116:		var hn: Variant = e["holder"]
117:		var ctx: TLContext = (hn as Node).get("ctx") if is_instance_valid(hn) else null      # M2-PATCHES 1: a freed holder
118:		if ctx != null:
119:			ctx.on_stage = i == stage
120:			for h: Variant in ctx.huds:
121:				if is_instance_valid(h):
122:					(h as CanvasLayer).visible = i == stage
123:		_place_own(e)
124:		if not is_instance_valid(hn):
125:			pass                              # its pack is being rebuilt: replace_holder places the new one
126:		elif i != stage:
127:			_place(e)
128:		elif float(e["radius"]) > 0.0:
129:			_clip_walk(e, e["holder"])        # the stage pack is cut to its plot too; nothing else of it is touched
130:		_set_far(e, _wants_far(e) and i != stage, true)
131:
132:
133:func _wants_far(e: Dictionary) -> bool:
134:	return bool(e["tier_far"]) if e.get("tier_far", null) != null else far_mode == "all"
135:
136:
137:## N7. The scheduler's tier decides how plot `i` is drawn: in full (`stage`, `sideline`) or as its stand-in
138:## (`backdrop`, `ledger`). Called at a tick boundary; the stand-in is built the first time it is needed.
139:func set_tier(i: int, tier: String) -> void:
140:	if i < 0 or i >= entries.size():
141:		return
142:	var e: Dictionary = entries[i]
143:	e["tier"] = tier
144:	e["tier_far"] = tier == "backdrop" or tier == "ledger"
145:	_set_far(e, bool(e["tier_far"]) and i != stage, false)
146:
147:
148:## N7. Plot `i` lost its pack's nodes (`ledger`): only the stand-in is left to draw.
149:func forget_nodes(i: int) -> void:
150:	if i >= 0 and i < entries.size():
151:		_unplace(entries[i])
152:		(entries[i] as Dictionary).erase("sheets")
153:		_drop_life(entries[i], false)         # the marks stay where they were: a still picture of a game that is not in memory
154:
155:
156:## N7. The pack of plot `i` was built again from its seed (next round, back from the ledger): a new holder with new
157:## nodes. The stand-in is kept: it is a still picture of the same venue.
158:func replace_holder(i: int, holder: Node) -> void:
159:	if i < 0 or i >= entries.size():
160:		return
161:	var e: Dictionary = entries[i]
162:	_unplace(e)                       # the old nodes are gone: this frees the mirrors and forgets the rest
163:	e["holder"] = holder
164:	e.erase("sheets")
165:	e["far"] = false                  # a new holder is visible
166:	_drop_life(e, true)               # new nodes: marks, smoke, lights and boards are found again when needed
167:	var ctx: TLContext = holder.get("ctx")
168:	if ctx != null:
169:		for h: Variant in ctx.huds:
170:			if is_instance_valid(h):
171:				(h as CanvasLayer).visible = i == stage
172:	if i != stage:
173:		_place(e)
174:	elif float(e["radius"]) > 0.0:
175:		_clip_walk(e, holder)
176:	_set_far(e, _wants_far(e) and i != stage, true)
177:	(holder as Node3D).reset_physics_interpolation()   # walker-feel T: new nodes start where they are, not half way from 0
178:
179:
180:# ------------------------------------------------------------------------------------------------ placing a pack
181:func _place(e: Dictionary) -> void:
182:	e["placed"] = true
183:	_walk(e, e["holder"])
184:
185:
186:func _clip_walk(e: Dictionary, n: Node) -> void:
187:	if n is GeometryInstance3D:
188:		_clip(e, n)
189:	for c: Node in n.get_children():
190:		_clip_walk(e, c)
191:
192:
193:func _clip(e: Dictionary, g: GeometryInstance3D) -> void:
194:	if float(e["radius"]) > 0.0 and not g.has_meta(&"tl_clip"):
195:		g.set_meta(&"tl_clip", true)
196:		g.set_instance_shader_parameter(CLIP, _clip_v4(e, g))
197:		(e["clipped"] as Array).append(g)
198:
199:
200:func _walk(e: Dictionary, n: Node) -> void:
201:	if n is GeometryInstance3D:
202:		_clip(e, n)
203:	if n is VisualInstance3D:
204:		_adopt(e, n)
205:	for c: Node in n.get_children():
206:		_walk(e, c)
207:
208:
209:func _adopt(e: Dictionary, n: VisualInstance3D) -> void:
210:	if n.has_meta(&"tl_draw"):
211:		return
212:	var rel: Transform3D = e["rel"]
213:	if mech == "a" and n is GeometryInstance3D:
214:		var verdict: int = _style_only(n)
215:		if verdict == 1:
216:			var g: GeometryInstance3D = n
217:			n.set_meta(&"tl_draw", 1)
218:			g.set_instance_shader_parameter(PLOT, _plot_v4(rel))
219:			var rec: Dictionary = {"node": g, "margin": g.extra_cull_margin, "aabb": g.custom_aabb, "t": Transform3D(Basis(), Vector3(INF, 0, 0))}
220:			if cull == "margin" or (cull == "auto" and (g is CPUParticles3D or g is GPUParticles3D or _under_moving_body(g, e["holder"]))):
221:				g.extra_cull_margin = NEVER
222:				rec["never"] = true
223:			else:
224:				_refresh_aabb(rec, rel)
225:			(e["a"] as Array).append(rec)
226:			stats["a_instances"] = int(stats["a_instances"]) + 1
227:			return
228:		if verdict == 0:
229:			stats["foreign"] = int(stats["foreign"]) + 1
230:			if (stats["foreign_names"] as Array).size() < 12:
231:				(stats["foreign_names"] as Array).append(String(n.get_path()).get_slice("/", 3) + "/.../" + String(n.name))
232:	_mirror(e, n)
233:
234:
235:func _mirror(e: Dictionary, n: VisualInstance3D) -> void:
236:	n.set_meta(&"tl_draw", 2)
237:	var rid: RID = RenderingServer.instance_create2(n.get_base(), scenario)
238:	RenderingServer.instance_set_layer_mask(rid, n.layers)
239:	if n is GeometryInstance3D:
240:		var g: GeometryInstance3D = n
241:		RenderingServer.instance_geometry_set_cast_shadows_setting(rid, g.cast_shadow as RenderingServer.ShadowCastingSetting)
242:		if g.material_override != null:
243:			RenderingServer.instance_geometry_set_material_override(rid, g.material_override.get_rid())
244:		if g.material_overlay != null:
245:			RenderingServer.instance_geometry_set_material_overlay(rid, g.material_overlay.get_rid())
246:		# a mirror is drawn with the plot inside its model matrix, so the shader's cut (which works in the pack's own
247:		# coordinates) cannot be used on it: candidate B draws the whole pack, far scenery included
248:		RenderingServer.instance_geometry_set_shader_parameter(rid, CLIP, Vector4.ZERO)
249:		var b: Variant = g.get_instance_shader_parameter(&"build")
250:		if b != null:
251:			RenderingServer.instance_geometry_set_shader_parameter(rid, &"build", b)
252:		if g is MeshInstance3D:
253:			var mi: MeshInstance3D = g
254:			for s: int in mi.get_surface_override_material_count():
255:				var om: Material = mi.get_surface_override_material(s)
256:				if om != null:
257:					RenderingServer.instance_set_surface_override_material(rid, s, om.get_rid())
258:			var sr: SkinReference = mi.get_skin_reference()
259:			if sr != null:
260:				RenderingServer.instance_attach_skeleton(rid, sr.get_skeleton())
261:		stats["mirrors"] = int(stats["mirrors"]) + 1
262:	else:
263:		stats["light_mirrors"] = int(stats["light_mirrors"]) + 1
264:	var vis: bool = n.is_visible_in_tree()
265:	var t: Transform3D = n.global_transform
266:	RenderingServer.instance_set_transform(rid, (e["rel"] as Transform3D) * t)
267:	RenderingServer.instance_set_visible(rid, vis)
268:	RenderingServer.instance_set_visible(n.get_instance(), false)      # server side only: the node's `visible` is untouched
269:	(e["mirrors"] as Array).append({"node": n, "rid": rid, "t": t, "vis": vis, "base": n.get_base()})
270:
271:
272:func _unplace(e: Dictionary) -> void:
273:	for rec: Dictionary in e["a"]:
274:		var g: Variant = rec["node"]
275:		if is_instance_valid(g):
276:			(g as GeometryInstance3D).set_instance_shader_parameter(PLOT, null)
277:			(g as GeometryInstance3D).extra_cull_margin = rec["margin"]
278:			(g as GeometryInstance3D).custom_aabb = rec["aabb"]
279:			(g as Node).remove_meta(&"tl_draw")
280:	(e["a"] as Array).clear()
281:	for m: Dictionary in e["mirrors"]:
282:		RenderingServer.free_rid(m["rid"])
283:		var n: Variant = m["node"]
284:		if is_instance_valid(n):
285:			(n as Node).remove_meta(&"tl_draw")
286:			RenderingServer.instance_set_visible((n as VisualInstance3D).get_instance(), (n as VisualInstance3D).is_visible_in_tree())
287:	(e["mirrors"] as Array).clear()
288:	for g: Variant in e["clipped"]:
289:		if is_instance_valid(g):
290:			(g as GeometryInstance3D).set_instance_shader_parameter(CLIP, null)
291:			(g as Node).remove_meta(&"tl_clip")
292:	(e["clipped"] as Array).clear()
293:	e["placed"] = false
294:
295:
296:func _on_node_added(n: Node) -> void:
297:	if n is VisualInstance3D and world != null and world.is_ancestor_of(n):
298:		_pending.append(n)
