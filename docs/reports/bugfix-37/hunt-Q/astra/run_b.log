88:## S2: frees every body that was made under the tag `t` (a construction site's scaffold, when its game arrives: the
89:## only thing in this space that goes). Returns how many. Their shapes stay in `_keep` until the space is freed.
90:func remove_tag(t: String) -> int:
91:	var n: int = 0
92:	for b: Variant in _bodies.duplicate():
93:		if str(_tags.get(b, "")) == t:
94:			PhysicsServer3D.free_rid(b as RID)
95:			_bodies.erase(b)
96:			_tags.erase(b)
97:			n += 1
98:	stats["bodies"] = int(stats["bodies"]) - n
99:	return n
