62:static func _multi(parent: Node3D, mk: TLMesh, xs: Array, mname: String) -> void:
63:	if xs.is_empty():
64:		return
65:	var mm: MultiMesh = MultiMesh.new()
66:	mm.transform_format = MultiMesh.TRANSFORM_3D
67:	mm.use_colors = true
68:	mm.mesh = mk.build(mname.to_snake_case())
69:	mm.instance_count = xs.size()
70:	for i: int in xs.size():
71:		mm.set_instance_transform(i, xs[i])
72:		mm.set_instance_color(i, Color.WHITE)
73:	var mmi: MultiMeshInstance3D = MultiMeshInstance3D.new()
74:	mmi.name = mname
75:	mmi.multimesh = mm
76:	parent.add_child(mmi)
