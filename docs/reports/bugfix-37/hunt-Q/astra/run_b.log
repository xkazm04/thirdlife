121:## A trunk: a cylinder standing on `foot`.
122:func add_trunk(foot: Vector3, radius: float, height: float = 4.0) -> void:
123:	var key: String = "%.2f_%.1f" % [radius, height]
124:	if not _cyl.has(key):
125:		var c: CylinderShape3D = CylinderShape3D.new()
126:		c.radius = radius
127:		c.height = height
128:		_cyl[key] = c
129:	_static(_cyl[key] as Shape3D, Transform3D(Basis(), foot + Vector3(0.0, height * 0.5, 0.0)))
130:	stats["trunks"] = int(stats["trunks"]) + 1
131:	if tag == "tree" and height == 4.0:
132:		add_canopy(foot, radius / 0.46)
133:
134:
135:## Walker-feel round 2: a tree's crown, for the CAMERA only (layer CANOPY: the body, the probes and `ground_at` ask
136:## layer 1 and walk through it). `s` is the tree's scale (its trunk radius / 0.46: the landscape's pines have 0.42 x
137:## scale, its broadleaf trees 0.5 x scale). The crown's core: a cylinder of 1.9 s from 2.2 s to 8.0 s over the foot
138:## (kit pines: crown radius 2.1-2.7 from 0.16 h up, h 8.5-12.5; broadleaf: about 0.45 h round 0.7 h, h 6.5-7.5).
139:const CANOPY: int = 4
140:func add_canopy(foot: Vector3, s: float) -> void:
141:	var key: String = "crown_%.2f" % s
142:	if not _cyl.has(key):
143:		var c: CylinderShape3D = CylinderShape3D.new()
144:		c.radius = 1.9 * s
145:		c.height = 5.8 * s
146:		_cyl[key] = c
147:	_static(_cyl[key] as Shape3D, Transform3D(Basis(), foot + Vector3(0.0, 5.1 * s, 0.0)))
148:	PhysicsServer3D.body_set_collision_layer(_bodies[_bodies.size() - 1] as RID, CANOPY)
149:	stats["canopies"] = int(stats.get("canopies", 0)) + 1
