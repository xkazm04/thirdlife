168:func _under_moving_body(n: Node, top: Node) -> bool:
169:	var up: Node = n.get_parent()
170:	while up != null and up != top:
171:		if up is PhysicsBody3D and not (up is StaticBody3D) and not (up is RigidBody3D and (up as RigidBody3D).freeze):
172:			return true
173:		if up is Skeleton3D:
