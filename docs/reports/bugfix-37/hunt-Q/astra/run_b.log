147:## Candidate A culling: the engine culls (camera and every shadow cascade) with the instance's box, which stands where
148:## the pack is simulated. `custom_aabb` is in the node's own space: T^-1 * rel * T * box. With no yaw it depends on
149:## the node's rotation only, so a node that only slides never needs a refresh.
150:func _refresh_aabb(rec: Dictionary, rel: Transform3D) -> void:
151:	var g: GeometryInstance3D = rec["node"]
152:	var t: Transform3D = g.global_transform
153:	rec["t"] = t
154:	var box: AABB = g.get_aabb()
155:	if box.size == Vector3.ZERO:
156:		box = AABB(Vector3(-0.5, -0.5, -0.5), Vector3.ONE)
157:	if g is CPUParticles3D:
158:		box = box.grow(6.0)
159:	g.custom_aabb = t.affine_inverse() * (rel * (t * box))
