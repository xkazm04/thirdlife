412:# ------------------------------------------------------------------------------------------------ far stand-ins
413:## P13: a far pack whose pictures are still being merged on a worker is drawn in full until they are there
414:## (`far_pending`); a holder with no pack yet shows its cached picture, or nothing of its own, and is never made far
415:## with nothing to show.
416:func _set_far(e: Dictionary, far: bool, force: bool) -> void:
417:	e["far_pending"] = false
418:	if is_instance_valid(e["holder"]) and not bool((e["holder"] as Node).get("loaded")):
419:		if (e["pics"] as Dictionary).is_empty() and not e.has("cache_tried"):
420:			e["cache_tried"] = true
421:			_ensure_pictures(e)
422:			if not (e["pics"] as Dictionary).is_empty():
423:				_place_own(e)
424:		far = not (e["pics"] as Dictionary).is_empty()      # its last known picture, or the empty pad: never an empty far tier
425:	if far == bool(e["far"]) and not force:
426:		return
427:	if not is_instance_valid(e["holder"]):
428:		e["far"] = far
429:		_show(e)
430:		return
431:	var holder: Node3D = e["holder"]
432:	if far:
433:		_ensure_pictures(e)
434:		if (e["pics"] as Dictionary).is_empty():
435:			e["far_pending"] = e.has("build")
436:			far = false
437:	e["far"] = far
438:	_show(e)
