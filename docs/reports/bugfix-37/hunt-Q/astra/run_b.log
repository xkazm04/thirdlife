311:			pos += rest_m
312:			rest_m = Vector3.ZERO
313:	var pd: Dictionary = _probe_down(pos, up.y + SNAP_DOWN)
314:	if not bool(pd["hit"]):
315:		pos.y -= up.y                                # nothing within a step: he walked off an edge and falls from here
316:		return {"pos": pos, "blocked": hit, "state": "air"}
317:	var n: Vector3 = pd["n"]
