102:func add_faces(faces: PackedVector3Array) -> void:
103:	if faces.size() < 3:
104:		return
105:	var sh: ConcavePolygonShape3D = ConcavePolygonShape3D.new()
106:	sh.backface_collision = true
107:	sh.set_faces(faces)
108:	_keep.append(sh)
109:	_static(sh, Transform3D.IDENTITY)
110:	stats["faces"] = int(stats["faces"]) + faces.size() / 3
