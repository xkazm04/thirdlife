58:## Called when everything static is in: the space holds no moving body, so it need not be stepped (queries still work).
59:func finish() -> void:
60:	PhysicsServer3D.space_set_active(space, false)
61:
62:
63:func free_all() -> void:
64:	for b: Variant in _bodies:
65:		PhysicsServer3D.free_rid(b as RID)
66:	_bodies.clear()
67:	if body.is_valid():
68:		PhysicsServer3D.free_rid(body)
69:		body = RID()
70:	if space.is_valid():
71:		PhysicsServer3D.free_rid(space)
72:		space = RID()
73:	_keep.clear()
