41:func _init() -> void:
42:	space = PhysicsServer3D.space_create()
43:	PhysicsServer3D.space_set_active(space, true)
44:	_cap = CapsuleShape3D.new()
45:	_cap.radius = RADIUS
46:	_cap.height = HEIGHT
47:	body = PhysicsServer3D.body_create()
48:	PhysicsServer3D.body_set_mode(body, PhysicsServer3D.BODY_MODE_KINEMATIC)
49:	PhysicsServer3D.body_set_space(body, space)
50:	PhysicsServer3D.body_add_shape(body, _cap.get_rid(), Transform3D(Basis(), Vector3(0.0, HEIGHT * 0.5, 0.0)))
51:	PhysicsServer3D.body_set_collision_layer(body, 2)          # the visitor is layer 2; the static things are layer 1
52:	PhysicsServer3D.body_set_collision_mask(body, 1)
53:	_params.margin = 0.03
54:	_params.max_collisions = 4
55:	_params.recovery_as_collision = false
