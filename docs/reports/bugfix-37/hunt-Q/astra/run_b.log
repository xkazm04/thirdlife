283:## The ground part of drive(): lift by the step, move `delta` (horizontal) sliding along what it meets, then put him
284:## down by at most step + SNAP_DOWN. Returns {"pos", "blocked", "state": "ground" | "air" | "slope"}. Only the
285:## vertical part of the drop's travel is kept.
286:func _ground_move(from: Vector3, delta: Vector3) -> Dictionary:
287:	var pos: Vector3 = from
288:	var rest_m: Vector3 = Vector3(delta.x, 0.0, delta.z)
289:	var hit: bool = false
290:	var up: Vector3 = Vector3(0.0, sp.step_up, 0.0)
291:	if sp._test(Transform3D(Basis(), pos), up):
292:		up = sp._res.get_travel()
293:		up.x = 0.0
294:		up.z = 0.0
295:	pos += up
296:	for it: int in 3:
297:		if rest_m.length() < 0.0005:
298:			break
299:		if sp._test(Transform3D(Basis(), pos), rest_m):
300:			hit = true
301:			sp.last_hit = {"tag": sp._tags.get(sp._res.get_collider_rid(0), "?"), "at": sp._res.get_collision_point(0), "n": sp._res.get_collision_normal(0), "from": pos}
302:			var travel: Vector3 = sp._res.get_travel()
303:			travel.y = 0.0
304:			pos += travel
305:			var rem: Vector3 = sp._res.get_remainder()
306:			var nrm: Vector3 = sp._res.get_collision_normal(0)
307:			nrm.y = 0.0
308:			rest_m = rem - nrm.normalized() * rem.dot(nrm.normalized()) if nrm.length() > 0.001 else Vector3.ZERO
