2:## The draw layer of a world, layer 2 of 4: the merged pictures of a far pack ("still", "mid", "far"), built in one
3:## walk over the pack's nodes (`_build_pictures`). draw/FAR.md says what each picture keeps and why.
4:
5:
6:## One merged mesh from the pack's static style geometry: palette columns, vertex colours and part-local coordinates
7:## kept (so it is drawn by the same palette material, with the same drawn surface detail and the same ink lines);
8:## instances smaller than `standin_min`, anything under a moving body or a skeleton, particles, glass and foreign
9:## materials dropped.
10:## What a stand-in is merged into (a class, not a Dictionary: packed arrays inside a Dictionary are copied on access).
11:class Acc:
12:	var v: PackedVector3Array = PackedVector3Array()
13:	var n: PackedVector3Array = PackedVector3Array()
14:	var c: PackedColorArray = PackedColorArray()
15:	var uv: PackedVector2Array = PackedVector2Array()
16:	var cu: PackedFloat32Array = PackedFloat32Array()
17:	var ix: PackedInt32Array = PackedInt32Array()
18:	var sheets: Array = []
19:	var extra: Dictionary = {}          # Material -> Acc: one more surface per flat-colour toon material (kernel-made boxes)
20:	var radius: float = 0.0
21:	var rim: float = 0.0
22:	var band: float = 0.0
23:	var kept: int = 0
24:	var dropped_small: int = 0
25:	var dropped_moving: int = 0
26:	var dropped_other: int = 0
27:	var dropped_outside: int = 0
28:	var src_tris: int = 0
29:	var kind: String = "still"          # P6: which picture this is ("still" | "mid" | "far")
30:	var min_size: float = 1.2
31:	var cell: float = 0.0               # > 0: terrain sheets are re-meshed on a grid of this size
32:	var cells: Dictionary = {}          # Vector2i -> vertex index (the sheets' shared grid)
33:	var thin: float = 0.0               # > 0: triangles narrower than this are dropped (not on the terrain)
34:	var small: float = 0.0              # > 0: triangles whose longest edge is shorter are dropped (not on the terrain)
35:	var dropped_tris: int = 0
36:	var sheet_tris: int = 0
37:
38:
39:## Builds the missing pictures of a pack in ONE walk over its nodes (each instance is appended to every picture that
40:## keeps it). P13: the walk on the main thread only lists what goes where (`_collect_standin`: transforms, materials,
41:## the surface arrays); the merging (`_append`, the long part) runs on a worker; `_poll_pictures` makes the meshes
42:## when it is done, in a later frame. `pic_worker` false = all of it now, in this frame (as P6 did).
43:func _build_pictures(e: Dictionary, kinds: Array) -> void:
44:	var t0: int = Time.get_ticks_usec()
45:	var holder: Node3D = e["holder"]
46:	_clip_v4(e, holder)                       # makes sure e["sheets"] is there
47:	var accs: Array = _new_accs(e, kinds)
48:	var jobs: Array = []
49:	_collect_standin(holder, holder, accs, jobs)
50:	_note("pic_collect", t0)
51:	if pic_worker:
52:		e["build"] = {"task": WorkerThreadPool.add_task(_run_jobs.bind(jobs)), "accs": accs, "jobs": jobs, "t0": t0,
53:			"main_us": Time.get_ticks_usec() - t0}
54:		return
55:	_run_jobs(jobs)
56:	_finish_pictures(e, accs, t0, Time.get_ticks_usec() - t0)
57:
58:
59:## Once per frame for a pack whose pictures are being merged on a worker: when the worker is done, the meshes are made
60:## and the pack's far state is applied again (it was drawn in full meanwhile). Returns true when it finished now.
61:func _poll_pictures(e: Dictionary) -> bool:
62:	var b: Dictionary = e["build"]
63:	if not WorkerThreadPool.is_task_completed(int(b["task"])):
64:		return false
65:	WorkerThreadPool.wait_for_task_completion(int(b["task"]))
66:	e.erase("build")
67:	_finish_pictures(e, b["accs"], int(b["t0"]), int(b["main_us"]))
68:	return true
69:
70:
71:## The merging of a picture (on a worker): a job is [picture, mesh, transform, sheet, terrain, picture counted, surface];
72:## each mesh surface's arrays are read once, here, off the main thread (reading them was most of the main thread's share).
73:func _run_jobs(jobs: Array) -> void:
74:	var arrays: Dictionary = {}
75:	for j: Array in jobs:
76:		var target: Acc = j[0]
77:		var before: int = target.ix.size()
78:		var key: Array = [j[1], int(j[6])]
79:		if not arrays.has(key):
80:			arrays[key] = (j[1] as Mesh).surface_get_arrays(int(j[6]))
81:		_append(target, arrays[key], j[2], bool(j[3]), bool(j[4]))
82:		if bool(j[3]):
83:			(j[5] as Acc).sheet_tris += (target.ix.size() - before) / 3
84:
85:
86:func _new_accs(e: Dictionary, kinds: Array) -> Array:
87:	var accs: Array = []
88:	for k: String in kinds:
89:		var acc: Acc = Acc.new()
90:		acc.kind = k
91:		acc.radius = float(e["radius"])
92:		acc.rim = float(e["rim"])
93:		acc.band = _band(e)
94:		acc.sheets = e["sheets"]
95:		acc.min_size = standin_min if k == "still" else (mid_min if k == "mid" else far_min)
96:		acc.cell = far_cell if k == "far" else 0.0
97:		acc.thin = far_thin if k == "far" else 0.0
98:		acc.small = far_small if k == "far" else 0.0
99:		accs.append(acc)
100:	return accs
