161:		_slide_t = 0
162:		ev.append("slide")
163:	match mode:
164:		"ground", "slide":
165:			if mode == "ground":
166:				var rate: float = ACCEL if wish.length() > 0.01 and wish.dot(hv) >= -0.01 else DECEL
167:				hv = hv.move_toward(wish, rate * dt)
168:			else:
169:				_slide_t += 1
170:				var spd: float = maxf(0.0, hv.length() - SLIDE_DECEL * dt)
171:				var dir: Vector3 = hv.normalized() if hv.length() > 0.01 else Vector3.ZERO
172:				if wish.length() > 0.01 and dir != Vector3.ZERO:
173:					dir = (dir + wish.normalized() * SLIDE_STEER * dt / maxf(spd, 1.0)).normalized()
174:				hv = dir * spd
175:				if spd < SLIDE_END or _slide_t >= SLIDE_MAX:
176:					mode = "ground"
177:					ev.append("end_slide")
