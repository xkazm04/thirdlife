index 0000000000000000000000000000000000000000..1da8b6f2bbbc334ebdb319a0afa837658462b6d7
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_crossing_faces.gd
@@ -0,0 +1,39 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_crossing_faces.gd"
+extends SceneTree
+
+const Draw = preload("res://kernel/world/draw/draw.gd")
+
+class Holder extends Node3D:
+	var loaded := true
+	var pack_dir := ""
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	var draw := Draw.new()
+	root.add_child(draw)
+	draw.set_process(false)
+	draw.pic_worker = false
+	draw._pal = TLStyle.material(&"white")
+	for subdivisions in [0, 3]:
+		var holder := Holder.new()
+		root.add_child(holder)
+		var ground := MeshInstance3D.new()
+		var mesh := PlaneMesh.new()
+		mesh.size = Vector2(100, 100)
+		mesh.subdivide_depth = subdivisions
+		mesh.subdivide_width = subdivisions
+		ground.mesh = mesh
+		ground.material_override = draw._pal
+		holder.add_child(ground)
+		var entry := {"holder": holder, "radius": 40.0, "rim": 0.0, "ground": false,
+			"rel": Transform3D.IDENTITY, "pics": {}, "standin_info": {}}
+		draw._build_pictures(entry, ["mid", "far"])
+		var mid: int = entry.standin_info.mid.tris
+		var far: int = entry.standin_info.far.tris
+		print("REPRO crossing_faces: %s subdivisions=%d source_covers_plot=true mid_triangles=%d far_triangles=%d" % [
+			"FAIL" if mid == 0 and far == 0 else "control", subdivisions, mid, far])
+		holder.free()
+	draw.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd b/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd
new file mode 100644
index 0000000000000000000000000000000000000000..c7fddca8b9d104af9285524a0fb1b4e4ee8b9c1f
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd
@@ -0,0 +1,37 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd"
+extends SceneTree
+
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	for sliced: bool in [false, true]:
+		var holder := Node3D.new()
+		root.add_child(holder)
+		var platform := StaticBody3D.new()
+		holder.add_child(platform)
+		var collision := CollisionShape3D.new()
+		collision.shape = BoxShape3D.new()
+		collision.shape.size = Vector3(6, 1, 6)
+		platform.add_child(collision)
+		var sp := Space.new()
+		if sliced:
+			var job := sp.begin_pack(holder, Transform3D.IDENTITY, 10, 0, 0)
+			while not sp.step_pack(job, 2000):
+				pass
+			job.clear()
+		else:
+			sp.add_pack(holder, Transform3D.IDENTITY, 10, 0, 0)
+		sp.finish()
+		var before := sp.ground_at(0, 0, 4)
+		holder.free()
+		await physics_frame
+		await physics_frame
+		var after := sp.ground_at(0, 0, 4)
+		print("REPRO ledger_collider %s: %s before=%.2f expected_after=0.50 actual_after=%s" % [
+			"sliced" if sliced else "immediate",
+			"FAIL" if is_equal_approx(before, 0.5) and is_nan(after) else "other", before, str(after)])
+		sp.free_all()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_plain_edge.gd b/docs/reports/astra-trial/d5/repro/b_plain_edge.gd
new file mode 100644
index 0000000000000000000000000000000000000000..10c396869effce9dce2cb8746a6e8d8468fc2d9b
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_plain_edge.gd
@@ -0,0 +1,40 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_plain_edge.gd"
+extends SceneTree
+
+const Landscape = preload("res://kernel/world/landscape.gd")
+
+class Viewer extends Node:
+	var world: Node
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false)
+	var view := Viewer.new()
+	root.add_child(view)
+	var land := Node3D.new()
+	view.add_child(land)
+	Landscape.build(land, [Transform3D.IDENTITY], [12], [false], {
+		"relief": 0, "trees": 0, "broadleaf": 0, "rocks": 0, "bushes": 0, "belt": 0,
+		"mesas": 0, "plain_clumps": 0, "soft_patches": 0, "edges_now": true})
+	var sp: RefCounted = land.get_meta(&"tl_space")
+	var edge: float = land.get_meta(&"tl_terrain").x1()
+	var feet := Vector3(edge - 2, sp.ground_at(edge - 2, 0, 10), 0)
+	sp.place(feet)
+	sp.rest()
+	for tick in 120:
+		feet = sp.drive(feet, Vector3(4.5, 0, 0), false, false).pos
+	var drawn := false
+	for mi in land.get_children():
+		if mi is MeshInstance3D and mi.name == "WorldFarGround":
+			var faces: PackedVector3Array = mi.mesh.get_faces()
+			for i in range(0, faces.size(), 3):
+				var hit = Geometry3D.ray_intersects_triangle(Vector3(feet.x, 10, feet.z), Vector3.DOWN, faces[i], faces[i+1], faces[i+2])
+				if hit != null and absf(hit.y) < 0.01:
+					drawn = true
+					break
+	print("REPRO plain_edge: %s edge_x=%.1f feet_x=%.1f drawn_floor_at_y0=%s support_y=%s feet_y=%.2f" % [
+		"FAIL" if drawn and feet.y < -5 else "other", edge, feet.x, str(drawn), str(sp.ground_at(feet.x, feet.z, 10)), feet.y])
+	view.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd b/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd
new file mode 100644
index 0000000000000000000000000000000000000000..9f5bc560d5f8eafe3f9a42ae0f1fe4a7b9960ce5
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd
@@ -0,0 +1,37 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_rotated_ground.gd"
+extends SceneTree
+
+const DrawBase = preload("res://kernel/world/draw/draw_base.gd")
+const Landscape = preload("res://kernel/world/landscape.gd")
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false) # Exercise the normal ground material on the headless display.
+	var holder := Node3D.new()
+	root.add_child(holder)
+	var deck := MeshInstance3D.new()
+	var plane := PlaneMesh.new()
+	plane.size = Vector2(40, 90)
+	plane.subdivide_depth = 17
+	plane.subdivide_width = 7
+	deck.mesh = plane
+	holder.add_child(deck)
+	for yaw in [0, 45]:
+		deck.rotation_degrees.y = yaw
+		var measured := DrawBase.ground_cover(holder, 40, [deck])
+		var real_hits := 0
+		for radius in [38.0, 42.0]:
+			for k in 72:
+				var angle := TAU * k / 72.0
+				var local := deck.to_local(Vector3(radius * cos(angle), 0, radius * sin(angle)))
+				if absf(local.x) <= 20 and absf(local.z) <= 45:
+					real_hits += 1
+		var owns := not is_nan(DrawBase.edge_height(holder, 40))
+		var mat := Landscape._ground_material([Transform3D.IDENTITY], [40], [owns])
+		var hole: Vector4 = mat.get_shader_parameter(&"tl_holes")[0]
+		print("REPRO rotated_ground: %s yaw=%d physical_coverage=%d/144 reported=%.3f hole_radius=%.1f" % [
+			"FAIL" if owns and real_hits < 0.95 * 144 else "control", yaw, real_hits, measured, hole.z])
+	holder.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_stale_slide.gd b/docs/reports/astra-trial/d5/repro/b_stale_slide.gd
new file mode 100644
index 0000000000000000000000000000000000000000..71629737449f5be394f98730a00612a7a3a6ef62
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_stale_slide.gd
@@ -0,0 +1,30 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_stale_slide.gd"
+extends SceneTree
+
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+const WalkCase = preload("res://kernel/world/walks/walk_case.gd")
+
+func _initialize() -> void:
+	var sp := Space.new()
+	WalkCase.flat(sp, 0.0, -10, 10, -40, 0)
+	WalkCase.flat(sp, -3.0, -10, 10, 0, 40)
+	var feet := Vector3(0, 0, -25)
+	sp.place(feet)
+	sp.rest()
+	var starts := 0
+	var ends := 0
+	var previous_mode := "ground"
+	for tick in 360:
+		var wish := Vector3(0, 0, 9) if tick < 30 or tick >= 140 else Vector3.ZERO
+		var result := sp.drive(feet, wish, false, tick == 30)
+		feet = result.pos
+		starts += result.events.count("slide")
+		ends += result.events.count("end_slide")
+		if result.mode == "air":
+			print("REPRO stale_slide: %s tick=%d transition=%s->air events=%s slide_starts=%d slide_ends=%d" % [
+				"FAIL" if previous_mode == "ground" and ends > starts else "other",
+				tick, previous_mode, str(result.events), starts, ends])
+			break
+		previous_mode = result.mode
+	sp.free_all()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_steep_rest.gd b/docs/reports/astra-trial/d5/repro/b_steep_rest.gd
new file mode 100644
index 0000000000000000000000000000000000000000..d147dd870b71f7488f5799cefb4ff39c6c71db7a
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_steep_rest.gd
@@ -0,0 +1,23 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_steep_rest.gd"
+extends SceneTree
+
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+const WalkCase = preload("res://kernel/world/walks/walk_case.gd")
+
+func _initialize() -> void:
+	var sp := Space.new()
+	WalkCase.bank(sp, 65.0)
+	var start := Vector3(0, sp.ground_at(0, 0, 50), 0)
+	sp.place(start)
+	sp.rest()
+	var feet := start
+	var ground_ticks := 0
+	for tick in 120:
+		var frame := sp.drive(feet, Vector3.ZERO, false, false)
+		feet = frame.pos
+		ground_ticks += int(frame.grounded)
+	print("REPRO steep_rest: %s slope=65 limit=%.0f grounded_ticks=%d/120 downhill_metres=%.3f" % [
+		"FAIL" if ground_ticks == 120 and feet.is_equal_approx(start) else "other",
+		sp.max_slope_deg, ground_ticks, feet.z - start.z])
+	sp.free_all()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_unloaded_pad.gd b/docs/reports/astra-trial/d5/repro/b_unloaded_pad.gd
new file mode 100644
index 0000000000000000000000000000000000000000..fb635a70fbff158dd4c474036eb81ec841db629c
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_unloaded_pad.gd
@@ -0,0 +1,45 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_unloaded_pad.gd"
+extends SceneTree
+
+const Landscape = preload("res://kernel/world/landscape.gd")
+const Draw = preload("res://kernel/world/draw/draw.gd")
+const Seam = preload("res://kernel/world/draw/view_seam.gd")
+
+class Viewer extends Node:
+	var world: Node
+	var draw: Node
+	var landscape := Node3D.new()
+	var has_ground := [true]
+	var radii := [25.0]
+	var _arrived := {}
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false) # Build the same landscape as the viewer, on the headless display.
+	var view := Viewer.new()
+	root.add_child(view)
+	view.add_child(view.landscape)
+	view.draw = Draw.new()
+	view.draw.entries.append({"pics": {}})
+	Landscape.build(view.landscape, [Transform3D.IDENTITY], view.radii, view.has_ground, {
+		"relief": 0, "trees": 0, "broadleaf": 0, "rocks": 0, "bushes": 0, "belt": 0,
+		"mesas": 0, "soft_patches": 0, "plain_clumps": 0, "edges_now": true})
+	Seam.shut_holes(view)
+	var material: ShaderMaterial = view.landscape.get_meta(&"tl_ground_mat")
+	var hole: Vector4 = material.get_shader_parameter(&"tl_holes")[0]
+	var sp: RefCounted = view.landscape.get_meta(&"tl_space")
+	var visible_y: float = view.landscape.get_meta(&"tl_terrain").gy(0, 0)
+	var support: float = sp.ground_at(0, 0, 10)
+	var feet := Vector3(0, visible_y, 0)
+	sp.place(feet)
+	sp.rest()
+	for tick in 60:
+		feet = sp.drive(feet, Vector3.ZERO, false, false).pos
+	print("REPRO unloaded_pad: %s hole_radius=%.1f visible_pad_y=%.2f support_y=%s feet_y_after_60=%.2f" % [
+		"FAIL" if hole.z == 0 and is_nan(support) and feet.y < -5 else "other",
+		hole.z, visible_y, str(support), feet.y])
+	view.draw.free()
+	view.free()
+	quit()

