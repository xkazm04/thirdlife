55:## The rule: before the visitor takes a step, every plot whose edge is within COPY_NEAR_M of him has all its
56:## colliders (copied whole now if it must); of the rest the nearest is copied for COPY_US a frame. Running (9 m/s) he
57:## covers 10 m in 66 ticks; a seed's copy (5 ms whole) takes three slices. Returns the microseconds it took.
58:static func copy_colliders(copies: Array, ws: Object, plots: Array, radii: Array, at: Vector3) -> int:
59:	var tc: int = Time.get_ticks_usec()
60:	var best: int = -1
61:	var best_d: float = INF
62:	for k: int in range(copies.size() - 1, -1, -1):
63:		var i: int = int((copies[k] as Dictionary)["i"])
64:		var o: Vector3 = (plots[i] as Transform3D).origin
65:		var d: float = Vector2(at.x - o.x, at.z - o.z).length() - float(radii[i])
66:		if d < COPY_NEAR_M:
67:			ws.call("step_pack", (copies[k] as Dictionary)["job"], 1 << 30)
68:			copies.remove_at(k)
69:			if best > k:
70:				best -= 1
71:		elif d < best_d:
72:			best_d = d
73:			best = k
74:	if best >= 0 and Time.get_ticks_usec() - tc < COPY_US:
75:		if bool(ws.call("step_pack", (copies[best] as Dictionary)["job"], COPY_US - (Time.get_ticks_usec() - tc))):
76:			copies.remove_at(best)
77:	return Time.get_ticks_usec() - tc
