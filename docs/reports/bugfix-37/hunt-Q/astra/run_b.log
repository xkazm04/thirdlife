@@ -0,0 +1,48 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_freed_visuals.gd"
+extends SceneTree
+
+const Draw = preload("res://kernel/world/draw/draw.gd")
+
+class Holder extends Node3D:
+	var loaded := true
+	var frames_done := 0
+	var ctx: TLContext
+	var pack_dir := ""
+
+class World extends Node:
+	var cfg := {}
+	var packs := []
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	TLStyle.set_headless(false)
+	var world := World.new()
+	root.add_child(world)
+	var holder := Holder.new()
+	world.add_child(holder)
+	world.packs.append(holder)
+	var draw := Draw.new()
+	root.add_child(draw)
+	draw.set_process(false)
+	draw.setup(world, [Transform3D.IDENTITY], [40], [0], -1)
+	draw.set_stage(-1)
+	var mesh := BoxMesh.new()
+	mesh.material = TLStyle.material(&"white")
+	for batch in 2:
+		for count in 256:
+			var prop := MeshInstance3D.new()
+			prop.mesh = mesh
+			holder.add_child(prop)
+			draw._process(0) # The node_added queue adopts this live visual.
+			prop.free()
+		for frame in 300:
+			draw._process(0)
+		var entry: Dictionary = draw.entries[0]
+		print("REPRO freed_visuals: %s freed=%d live_children=%d reported_live=%d clip_records=%d" % [
+			"FAIL" if draw.report().a_instances_live > 0 else "pass",
+			(batch + 1) * 256, holder.get_child_count(), draw.report().a_instances_live, entry.clipped.size()])
+	draw.free()
+	world.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd b/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd
new file mode 100644
index 0000000000000000000000000000000000000000..c7fddca8b9d104af9285524a0fb1b4e4ee8b9c1f
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd
@@ -0,0 +1,37 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/b_ledger_collider.gd"
+extends SceneTree
+
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func _run() -> void:
+	for sliced: bool in [false, true]:
+		var holder := Node3D.new()
+		root.add_child(holder)
+		var platform := StaticBody3D.new()
+		holder.add_child(platform)
+		var collision := CollisionShape3D.new()
+		collision.shape = BoxShape3D.new()
+		collision.shape.size = Vector3(6, 1, 6)
+		platform.add_child(collision)
+		var sp := Space.new()
+		if sliced:
+			var job := sp.begin_pack(holder, Transform3D.IDENTITY, 10, 0, 0)
+			while not sp.step_pack(job, 2000):
+				pass
+			job.clear()
+		else:
+			sp.add_pack(holder, Transform3D.IDENTITY, 10, 0, 0)
+		sp.finish()
+		var before := sp.ground_at(0, 0, 4)
+		holder.free()
+		await physics_frame
+		await physics_frame
+		var after := sp.ground_at(0, 0, 4)
+		print("REPRO ledger_collider %s: %s before=%.2f expected_after=0.50 actual_after=%s" % [
+			"sliced" if sliced else "immediate",
+			"FAIL" if is_equal_approx(before, 0.5) and is_nan(after) else "other", before, str(after)])
+		sp.free_all()
+	quit()
