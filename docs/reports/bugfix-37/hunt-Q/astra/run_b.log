401:## The ground height under (x, z), looking down from `from_y`: NAN when there is none within 400 m.
402:func ground_at(x: float, z: float, from_y: float) -> float:
403:	var q: PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(Vector3(x, from_y, z), Vector3(x, from_y - 400.0, z), 1)
404:	var hit: Dictionary = PhysicsServer3D.space_get_direct_state(space).intersect_ray(q)
405:	return float((hit["position"] as Vector3).y) if not hit.is_empty() else NAN

