75:
76:func _static(shape: Shape3D, xf: Transform3D) -> void:
77:	var b: RID = PhysicsServer3D.body_create()
78:	PhysicsServer3D.body_set_mode(b, PhysicsServer3D.BODY_MODE_STATIC)
79:	PhysicsServer3D.body_set_space(b, space)
80:	PhysicsServer3D.body_add_shape(b, shape.get_rid(), xf)
81:	PhysicsServer3D.body_set_collision_layer(b, 1)
82:	PhysicsServer3D.body_set_collision_mask(b, 0)
83:	_bodies.append(b)
84:	_tags[b] = tag
85:	stats["bodies"] = int(stats["bodies"]) + 1
