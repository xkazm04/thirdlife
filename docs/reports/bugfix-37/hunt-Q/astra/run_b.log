238:## Meshes at least `width` metres wide both ways and flat-ish (wider than tall): the terrain sheets of a pack.
239:static func _wide_meshes(n: Node, width: float, out: Array) -> void:
240:	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null and (n as MeshInstance3D).visible:
241:		var bb: AABB = (n as MeshInstance3D).mesh.get_aabb()
242:		if minf(bb.size.x, bb.size.z) >= width and bb.size.y < minf(bb.size.x, bb.size.z):
243:			out.append(n)
244:	for c: Node in n.get_children():
245:		_wide_meshes(c, width, out)

