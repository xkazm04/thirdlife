152:func add_boulder(centre: Vector3, radius: float) -> void:
153:	var key: String = "%.2f" % radius
154:	if not _spheres.has(key):
155:		var s: SphereShape3D = SphereShape3D.new()
156:		s.radius = radius
157:		_spheres[key] = s
158:	_static(_spheres[key] as Shape3D, Transform3D(Basis(), centre))
159:	stats["boulders"] = int(stats["boulders"]) + 1
