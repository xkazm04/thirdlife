102:## Walker-feel T (blink B2): a plot whose ground is cut open but that draws nothing yet (its game has not arrived and
103:## no picture of it is cached: the first visit on a machine) shows the sky through the world's ground. `shut[i]` true
104:## closes plot i's hole (the world's pad shows there) until it has something to show. Plot order as in landscape.gd `build`; the
105:## material is landscape.gd's, stored as the meta `tl_ground_mat` on the landscape node.
106:static func close_holes(parent: Node3D, has_ground: Array, radii: Array, shut: Array) -> void:
107:	var gm: Variant = parent.get_meta(&"tl_ground_mat", null)
108:	if gm == null:
109:		return
110:	var all: Array = (gm as ShaderMaterial).get_meta(&"tl_holes_all", [])
111:	var holes: Array = all.duplicate()
112:	var k: int = 0
113:	for i: int in has_ground.size():
114:		if float(radii[i]) > 0.0 and bool(has_ground[i]) and k < 32:
115:			if i < shut.size() and bool(shut[i]):
