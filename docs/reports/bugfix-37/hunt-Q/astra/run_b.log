126:## One tick of a person's body. `wish`: the horizontal velocity he asks for (m/s, world axes); `jump`, `slide`: the
127:## key went down this tick. Returns {"pos", "grounded", "mode", "vel", "events": ["jump" | "land" | "slide" |
128:## "slope" | "end_slide"], "blocked"}.
129:func drive(from: Vector3, wish: Vector3, jump: bool, slide: bool) -> Dictionary:
130:	var dt: float = 1.0 / 60.0
131:	var pos: Vector3 = from
132:	var ev: Array = []
133:	var hit: bool = false
134:	wish.y = 0.0
135:	sp.last_hit = {}
136:	# a tapped key is a step: a wish that starts from rest is kept STEP_TICKS ticks
137:	var hv: Vector3 = Vector3(vel.x, 0.0, vel.z)
138:	if wish.length() > 0.01 and hv.length() < 0.3 and _step_t <= 0 and mode == "ground":
139:		_step_t = STEP_TICKS
140:		_step_wish = wish
141:	if _step_t > 0:
142:		_step_t -= 1
143:		if wish.length() < 0.01:
144:			wish = _step_wish
145:	if jump:
146:		_buffer = BUFFER
147:	elif _buffer > 0:
148:		_buffer -= 1
149:	var can_jump: bool = mode == "ground" or mode == "slide" or (mode == "air" and not _jumped and air_ticks <= COYOTE)
150:	if _buffer > 0 and can_jump:
151:		if mode == "slide":
152:			ev.append("end_slide")
153:		_buffer = 0
154:		_jumped = true
155:		vel.y = JUMP_V
156:		mode = "air"
157:		grounded = false
158:		ev.append("jump")
159:	if slide and mode == "ground" and hv.length() >= SLIDE_MIN:
