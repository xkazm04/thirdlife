216:func _pace() -> void:
217:	var sp: RefCounted = Space.new()
218:	flat(sp, 0.0, -200, 200, -200, 200)
219:	var feet: Vector3 = Vector3.ZERO
220:	sp.call("place", feet)
221:	sp.call("rest")
222:	var t_walk: int = -1
223:	var t_run: int = -1
224:	var t_stop: int = -1
225:	for i: int in 120:
226:		var r: Dictionary = _drive(sp, feet, Vector3(0, 0, -4.5))
227:		feet = r["pos"]
228:		if t_walk < 0 and (r["vel"] as Vector3).length() >= 4.49:
229:			t_walk = i + 1
230:	var a: Vector3 = feet
231:	for i: int in 60:
232:		feet = _drive(sp, feet, Vector3(0, 0, -4.5))["pos"]
233:	var walk_mps: float = feet.distance_to(a)
234:	for i: int in 120:
235:		var r: Dictionary = _drive(sp, feet, Vector3(0, 0, -9.0))
236:		feet = r["pos"]
237:		if t_run < 0 and (r["vel"] as Vector3).length() >= 8.99:
238:			t_run = i + 1
239:	var stop_from: Vector3 = feet
240:	for i: int in 60:
241:		var r: Dictionary = _drive(sp, feet, Vector3.ZERO)
242:		feet = r["pos"]
243:		if t_stop < 0 and (r["vel"] as Vector3).length() < 0.001:
244:			t_stop = i + 1
245:	var stop_m: float = feet.distance_to(stop_from)
246:	# a tap: 6 ticks of W from rest
247:	var b: Vector3 = feet
248:	for i: int in 60:
249:		feet = _drive(sp, feet, Vector3(0, 0, -4.5) if i < 6 else Vector3.ZERO)["pos"]
250:	var tap: float = feet.distance_to(b)
251:	# 180 ticks of W from rest (P11's figure was 13.50 m at once-full speed)
252:	var c: Vector3 = feet
253:	for i: int in 180:
254:		feet = _drive(sp, feet, Vector3(4.5, 0, 0))["pos"]
255:	var w180: float = feet.distance_to(c)
256:	for i: int in 30:
257:		feet = _drive(sp, feet, Vector3.ZERO)["pos"]
258:	var ok: bool = t_walk > 0 and t_walk <= 15 and absf(walk_mps - 4.5) < 0.01 and t_run > 0 and t_run <= 25 and t_stop > 0 and t_stop <= 15 and tap >= 0.3 and tap <= 1.0
259:	_say("walk.pace", ok, "rest to 4.5 m/s in %d ticks (then %.3f m in 60 ticks), 4.5 to 9.0 in %d ticks, 9.0 to rest in %d ticks over %.2f m, a 6-tick tap moves %.2f m, W 180 ticks from rest %.2f m" % [t_walk, walk_mps, t_run, t_stop, stop_m, tap, w180])
260:	sp.call("free_all")
261:
