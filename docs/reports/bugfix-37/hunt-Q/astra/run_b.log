54:	s.resize(cnt)
55:	ys.resize(cnt)
56:	var cum: float = 0.0
57:	for i: int in cnt:
58:		var a: Vector2 = pts[(i - 1 + cnt) % cnt] if (closed or i > 0) else pts[0]
59:		var b: Vector2 = pts[(i + 1) % cnt] if (closed or i < cnt - 1) else pts[cnt - 1]
