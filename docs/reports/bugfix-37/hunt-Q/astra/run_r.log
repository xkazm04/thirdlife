+	var control: Skeleton3D = other.get_node("Model/Skeleton3D")
+	var delta := rad_to_deg(sk.get_bone_pose_rotation(shoulder).angle_to(control.get_bone_pose_rotation(shoulder)))
+	print("REPRO pose: %s expected identical idle shoulders after 120 ticks, difference=%.1f degrees" % ["FAIL" if delta > 0.1 else "PASS", delta])
+	rig.free()
+	other.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/r_slide.gd b/docs/reports/astra-trial/d5/repro/r_slide.gd
new file mode 100644
index 0000000000000000000000000000000000000000..3503158ddc55b54d64d8415129a5b6492fdd8a16
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_slide.gd
@@ -0,0 +1,27 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_slide.gd"
+extends SceneTree
+
+func _initialize() -> void:
+	run.call_deferred()
+
+func run() -> void:
+	var rig = TLRigs.build("biped")
+	root.add_child(rig)
+	rig.play(&"slide")
+	for f in range(1, 61):
+		rig.tick(f)
+	var sk: Skeleton3D = rig.get_node("Model/Skeleton3D")
+	# Read the real generator's rigid weights; headless rendering need not retain mesh arrays.
+	var geometry := TLRigBipedMesh.build_mesh(sk, TLRigBipedMesh.LOOK, true, false)
+	var hand := sk.find_bone("LeftHand")
+	var skin := sk.get_bone_global_pose(hand) * sk.get_bone_global_rest(hand).affine_inverse()
+	var lowest := INF
+	var count := 0
+	for surface in geometry.surfs.values():
+		for i in surface.v.size():
+			if surface.b[4 * i] == hand:
+				count += 1
+				lowest = minf(lowest, (skin * Vector3(surface.v[i])).y)
+	print("REPRO slide: %s held slide at tick 60, floor y=0, lowest of %d left-hand vertices y=%.3f m" % ["FAIL" if count > 0 and lowest > 0.05 else "PASS", count, lowest])
+	rig.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/r_spawn_face.gd b/docs/reports/astra-trial/d5/repro/r_spawn_face.gd
new file mode 100644
