+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_team.gd" -- --mode=skate --team=red
+extends SceneTree
+
+func _initialize() -> void:
+	run.call_deferred()
+
+func run() -> void:
+	var scene = preload("res://rigs/review/review.gd").new()
+	root.add_child(scene)
+	var rig: TLRigNode = scene.rig
+	var top: String = rig.params.colors.top
+	print("REPRO team: %s --mode=skate --team=red expected car_red jersey, got %s" % ["FAIL" if top != "car_red" else "PASS", top])
+	scene.free()
+	quit()

