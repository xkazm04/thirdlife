 194 
 195 ## mood 0 = focused (flat mouth, low brows) .. 1 = happy; blink 0 = open .. 1 = closed. Face bones are not touched by clips.
 196 func _face(mood: float, blink: float) -> void:
 197 	var bl: float = clampf(blink, 0.0, 1.0)
 198 	var open: float = lerpf(1.0, 0.07, bl) * lerpf(0.8, 1.0, mood)
 199 	for n: String in ["LeftEye", "RightEye"]:
 200 		_sk.set_bone_pose_scale(_sk.find_bone(n), Vector3(lerpf(1.0, 1.12, bl), open, 1.0))
 201 	_sk.set_bone_pose_scale(_sk.find_bone("Glints"), Vector3(1.0, clampf(1.0 - bl / 0.45, 0.0, 1.0) * lerpf(0.8, 1.0, mood), 1.0))
 202 	var bi: int = _sk.find_bone("Brows")
 203 	_sk.set_bone_pose_position(bi, _sk.get_bone_rest(bi).origin + Vector3(0, lerpf(-0.02, 0.006, mood), 0))
 204 	var mi: int = _sk.find_bone("MouthCorners")
 205 	_sk.set_bone_pose_position(mi, _sk.get_bone_rest(mi).origin + Vector3(0, lerpf(-0.012, 0.004, mood), 0))
 206 	_sk.set_bone_pose_scale(mi, Vector3(lerpf(0.6, 1.0, mood), lerpf(0.32, 1.0, mood), 1.0))
