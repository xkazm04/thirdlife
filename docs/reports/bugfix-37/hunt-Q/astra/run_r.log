 278 # ------------------------------------------------------------------ the walking gait (biped/tl_rig_biped_gait.gd)
 279 ## The locomotion pose on the ground: idle, walk, jog, run and sprint are one gait read at the speed.
 280 func _gait_pose(t: float) -> Dictionary:
 281 	var gt: TLRigBipedGait = _gait
 282 	var v: float = gt.v
 283 	var d: float = gt.d
 284 	var ph: float = gt.phase
 285 	var still: float = 1.0 - smoothstep(0.1, 0.7, v)
 286 	var run_w: float = smoothstep(2.0, 3.4, v)
 287 	var amp: float = clampf(gt.ls / 0.6, 0.0, 1.2)
 288 	var s: float = cos(TAU * (ph - (d - 0.5) * 0.5)) * amp        # + = the left leg is ahead
 289 	var lean: float = clampf(float(params.get("lean", 0.0)), -1.0, 1.0)
 290 	var pitch: float = lerpf(-(1.5 + 2.4 * minf(v, 6.5)), 3.0, gt.back_w * (1.0 - still)) - 46.0 * _crouch_x
 291 	var yaw: float = rad_to_deg(gt.psi) - lerpf(4.0, 7.0, run_w) * s
 292 	var b: float = sin(TAU * t / 4.0)
 293 	var y_style: float = -_crouch_x - gt.crouch() - gt.bounce() * cos(2.0 * TAU * (ph - d * 0.5)) + (-0.012 + 0.006 * b) * still
 294 	var sway: float = -lerpf(0.022, 0.008, run_w) * cos(TAU * (ph - d * 0.5)) * minf(amp, 1.0)
 295 	var out: Dictionary = gt.legs_pose(Vector3(pitch, yaw, -16.0 * lean), y_style, Vector3(sway, 0.0, 0.0))
 296 	var bounce: float = cos(2.0 * TAU * (ph - d * 0.5) - 1.0) * minf(amp, 1.0)
 297 	var tw: float = lerpf(5.0, 9.0, run_w) * s        # the shoulders turn against the pelvis
 298 	var sw: float = lerpf(24.0, 44.0, run_w) * s * lerpf(1.0, 0.6, gt.back_w)
 299 	var elbow: float = lerpf(16.0, 80.0, run_w)
 300 	var up: Dictionary = {
 301 		"Spine": Vector3(lerpf(-2.0, -4.0, run_w), -0.5 * yaw + 0.5 * tw, -5.0 * lean), "Chest": Vector3(lerpf(-2.0, -4.0, run_w), -0.5 * yaw + 0.5 * tw, 0),
 302 		"Neck": Vector3(lerpf(2.0, 7.0, run_w), -0.5 * tw, 0), "Head": Vector3(lerpf(3.0, 7.0, run_w) - 0.25 * pitch * run_w, -0.5 * tw, 0),
 303 		"Backpack": Vector3(lerpf(3.5, 7.0, run_w) * bounce, 0, 2.0 * s), "Hair": Vector3(lerpf(4.0, 9.0, run_w) * cos(2.0 * TAU * (ph - d * 0.5) - 1.4) * minf(amp, 1.0), 0, 0),
 304 		"LeftUpperArm": Vector3(lerpf(5.0, 14.0, run_w) - sw, 0, lerpf(-6.0, -8.0, run_w)), "LeftLowerArm": Vector3(elbow + lerpf(14.0, 12.0, run_w) * maxf(0.0, -s), 0, 0), "LeftHand": Vector3(0, 0, 0),
 305 		"RightUpperArm": Vector3(lerpf(5.0, 14.0, run_w) + sw, 0, lerpf(6.0, 8.0, run_w)), "RightLowerArm": Vector3(elbow + lerpf(14.0, 12.0, run_w) * maxf(0.0, s), 0, 0), "RightHand": Vector3(0, 0, 0),
 306 	}
 307 	if _stick_on:
 308 		up.merge(_stick_arms(pitch - 5.0, -4.0 * (1.0 - run_w)), true)
 309 	if still > 0.0:
 310 		var idle: Dictionary = _idle(t)
 311 		var iu: Dictionary = {}
 312 		for key: String in idle:
 313 			if UPPER.has(key):
 314 				iu[key] = idle[key]
 315 		up = _mixe(up, iu, still)
 316 	out.merge(up, true)
 317 	return out
