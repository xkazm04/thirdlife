 227 func _place_cam(snap: bool) -> void:
 228 	var target: Vector3 = pos + Vector3(0, 0.9 if what != "car" else 0.5, 0)
 229 	if view == "face":
 230 		target = pos + Vector3(0, 1.74, 0)
 231 	cam_pos = target if snap else cam_pos.lerp(target, 0.25)
 232 	if view == "behind" or view == "vclose" or view == "vfront":
 233 		# the visitor's camera (kernel/world/visitor.gd): behind the facing, looking at 1.7 m; rigid, as with steer on
 234 		var f: Vector3 = Vector3(cos(face), 0, sin(face))
 235 		var back: float = 8.5 if view == "behind" else 2.6 if view == "vclose" else -4.2
 236 		var up: float = 3.6 if view == "behind" else 2.0
 237 		cam.fov = 60.0 if view == "behind" else 45.0
 238 		cam.position = Vector3(pos.x, 0.0, pos.z) - f * back + Vector3(0, up, 0)
 239 		cam.look_at(Vector3(pos.x, 1.7 if view == "behind" else 1.25, pos.z), Vector3.UP)
 240 		return
 241 	var off: Vector3
 242 	match view:
 243 		"three": off = Vector3(-4.2, 2.2, 5.8)
 244 		"front": off = Vector3(5.5, 1.6, 1.8)
 245 		"high": off = Vector3(-6.0, 5.5, 6.5)
 246 		"close": off = Vector3(-1.9, 0.8, 3.0)
 247 		"face": off = Vector3(1.7, 0.05, 0.75)
 248 		"top": off = Vector3(0.0, 11.0, 0.9)
 249 		_: off = Vector3(0, 0.9, 7.0)
 250 	if what == "car":
 251 		off *= 1.8
 252 	cam.position = cam_pos + off
 253 	cam.look_at(cam_pos, Vector3.UP)
