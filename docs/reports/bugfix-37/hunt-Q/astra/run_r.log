 214 static func make_skeleton(bones: Array) -> Skeleton3D:
 215 	# bones: [name, parent name or "", global rest position]; identity rest rotations
 216 	var sk: Skeleton3D = Skeleton3D.new()
 217 	sk.name = "Skeleton3D"
 218 	var gpos: Dictionary = {}
 219 	for b: Array in bones:
 220 		var i: int = sk.add_bone(String(b[0]))
 221 		var parent: String = String(b[1])
 222 		var p: Vector3 = b[2]
 223 		gpos[b[0]] = p
 224 		if parent != "":
 225 			sk.set_bone_parent(i, sk.find_bone(parent))
 226 			sk.set_bone_rest(i, Transform3D(Basis.IDENTITY, p - (gpos[parent] as Vector3)))
 227 		else:
 228 			sk.set_bone_rest(i, Transform3D(Basis.IDENTITY, p))
 229 	sk.reset_bone_poses()
 230 	return sk
