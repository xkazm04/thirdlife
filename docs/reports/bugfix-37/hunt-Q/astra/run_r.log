diff --git a/docs/reports/astra-trial/d5/repro/r_boil.py b/docs/reports/astra-trial/d5/repro/r_boil.py
new file mode 100644
index 0000000000000000000000000000000000000000..61d6f9cf4f16c4e07a48cfcea2ad4ba9212365f1
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_boil.py
@@ -0,0 +1,22 @@
+# python docs/reports/astra-trial/d5/repro/r_boil.py
+"""Measure a lossless, static horizontal stripe pattern at look.sh's default clip resolution."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+with tempfile.TemporaryDirectory(prefix="r_boil_", dir=Path(__file__).parent) as workspace:
+    clip = Path(workspace) / "still.mkv"
+    subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-f", "lavfi", "-i",
+                    "nullsrc=size=1280x720,geq=lum='if(mod(Y,2),220,30)':cb=128:cr=128",
+                    "-frames:v", "12", "-pix_fmt", "yuv420p", "-c:v", "ffv1", str(clip)], check=True)
+    meter = [sys.executable, "engine/rigs/review/boil.py", str(clip), "0", "11"]
+    control = subprocess.run(meter + ["0", "1080"], capture_output=True, text=True, check=True)
+    assert "frames=12" in control.stdout and "mean=0.000 flips_pct=0.000" in control.stdout
+    print(control.stdout.strip())
+    result = subprocess.run(meter,
+                            capture_output=True, text=True, check=True)
+    print(result.stdout.strip())
+    expected = "frames=12" in result.stdout and "mean=0.000 flips_pct=0.000" in result.stdout
+    print("REPRO boil: %s expected 12 identical frames, zero mean change and zero flips" %
+          ("PASS" if expected else "FAIL"))
diff --git a/docs/reports/astra-trial/d5/repro/r_clip_input.sh b/docs/reports/astra-trial/d5/repro/r_clip_input.sh
new file mode 100644
index 0000000000000000000000000000000000000000..492433d68c2f3332a47a22a62e4f9a15cffb5063
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_clip_input.sh
@@ -0,0 +1,14 @@
+# bash docs/reports/astra-trial/d5/repro/r_clip_input.sh
+set -eu
+scratch=$(mktemp -d docs/reports/astra-trial/d5/repro/r_clip_XXXXXX)
+trap 'rm -f "$scratch/film.avi"; rmdir "$scratch"' EXIT
+# Stand-in for an existing source movie. The invalid kind should reject the
+# command before running Godot, FFmpeg, or touching neighboring files.
+echo "existing source movie" > "$scratch/film.avi"
+code=0
+bash engine/tools/look.sh clip rig:typo "$scratch/film.mp4" || code=$?
+if [ "$code" -eq 2 ] && [ ! -e "$scratch/film.avi" ]; then
+  echo "REPRO clip_input: FAIL invalid kind exited 2 and deleted the pre-existing film.avi beside the requested film.mp4"
+else
+  echo "REPRO clip_input: exit=$code existing AVI present=$(test -e "$scratch/film.avi" && echo yes || echo no)"
+fi
