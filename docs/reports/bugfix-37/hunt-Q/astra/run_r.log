	float wo = base_px * k * noise * mix(1.0, outer_far, smoothstep(thin_near, thin_far, d0)) * mix(1.0, body_k, body);
	float wi = inner_px * k * mix(0.8 + 0.4 * wn, 1.0, even);
	vec3 n0 = texture(nr_tex, juv).rgb * 2.0 - 1.0;
