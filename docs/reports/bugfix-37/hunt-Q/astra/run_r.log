 256 ## Foot slide: at every frame at least one foot is on the floor; the grounded foot with the lowest ground speed should stand
 257 ## still on the floor (relative to it). `along` is that foot's speed along the travel direction in m/s: 0 = planted,
 258 ## +v = the foot rides along with the body (a skate's glide counts as a pass for a skater, since blades slide).
 259 func _log_feet(dir: Vector3, v: float) -> void:
 260 	if not rig.has_method("socket"):
 261 		return
 262 	var fl: Node3D = rig.call("socket", &"foot_l")
 263 	var fr: Node3D = rig.call("socket", &"foot_r")
 264 	if fl == null or fr == null:
 265 		return
 266 	var feet: Array = [fl.global_position, fr.global_position]
 267 	if prev_feet.size() == 2 and v > 0.05 and frame > 40:
 268 		# stance = a foot on the floor that is moving backwards relative to the body; its ground speed should be 0
 269 		var best_s: float = 1e9
 270 		var best_signed: float = 0.0
 271 		for k: int in 2:
 272 			if (feet[k] as Vector3).y < 0.03:
 273 				var d: Vector3 = (feet[k] as Vector3) - (prev_feet[k] as Vector3)
 274 				d.y = 0
 275 				var gs: float = d.dot(dir) * 60.0
 276 				if gs - v < -0.25 * v and absf(gs) < best_s:
 277 					best_s = absf(gs)
 278 					best_signed = gs
 279 		if best_s < 1e8:
 280 			slip_log.append([best_s, v])
 281 			signed_log.append(best_signed)
 282 	prev_feet = feet
 283 	if frame == int(args.get("frames", "300")) and args.has("slip"):
 284 		_print_contact()
 285 		var sum: float = 0.0
 286 		var worst: float = 0.0
 287 		for e: Array in slip_log:
 288 			var s: float = absf(float(e[0]))
 289 			sum += s
 290 			worst = maxf(worst, s)
 291 		var ss: float = 0.0
 292 		for x: float in signed_log:
 293 			ss += x
 294 		print("[review] slip speed=%.2f k=%s planted_samples=%d mean_ms=%.3f max_ms=%.3f signed_mean=%.3f (foot on the floor: ground speed along travel, m/s)" % [speed, str(args.get("k", "1")), slip_log.size(), sum / maxf(1.0, float(slip_log.size())), worst, ss / maxf(1.0, float(signed_log.size()))])
