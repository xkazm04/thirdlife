 138 static func _build_rig(family: String, params: Dictionary) -> Node3D:
 139 	var errs: PackedStringArray = validate(family, params)
 140 	if errs.size() > 0:
 141 		push_error("TLRigs.build: " + "; ".join(errs))
 142 		return null
 143 	var p: Dictionary = TLKit.with_defaults(FAMILIES[family][3], params)
 144 	var rig: TLRigNode
 145 	match family:
 146 		"biped": rig = TLRigBiped.new()
 147 		"vehicle": rig = TLRigVehicle.new()
 148 		_: rig = TLRigBot.new()
 149 	rig.set_meta("tl_kind", "rig." + family)
 150 	rig.set_meta("tl_params", p)
 151 	rig.call("setup", p)
 152 	# walker-feel: a rig moves. Its meshes carry their mottle and hatching with them, and a biped or a bot casts its shadow from
 153 	# further down the sun's rays, so that no part of it shadows another (style/shaders/toon.gdshader, `tl_body`): shading
 154 	# anchored to the world or to shadow-map texels crawls over a moving figure.
 155 	_mark_body(rig, Vector2(1.0, 0.0 if family == "vehicle" else 0.6 * float(p.get("scale", 1.0))))
 156 	return rig
 157 
