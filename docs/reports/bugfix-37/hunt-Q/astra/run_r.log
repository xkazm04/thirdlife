 209 # ------------------------------------------------------------------ locomotion
 210 func _speed() -> float:
 211 	return Vector2(_vel.x, _vel.z).length()
 212 
 213 
 214 func _advance() -> void:
 215 	if String(params.get("mode", "walk")) == "skate":
 216 		_phase = fposmod(_phase + clampf(0.55 + 0.07 * _speed(), 0.55, 1.25) * stride_k * DT, 1.0)
 217 		return
 218 	var vm: Vector2 = Vector2(_vel.x, _vel.z) / float(params["scale"]) if _loco_on else Vector2.ZERO
 219 	if _grounded or not _loco_on:
 220 		if _was_air:
 221 			_gait.land(vm)
 222 		_gait.step(vm, stride_k, global_transform.basis.get_euler().y if is_inside_tree() else NAN)
 223 	_was_air = _loco_on and not _grounded
 224 	_air_w = move_toward(_air_w, 1.0 if _was_air else 0.0, 0.2 if _was_air else 0.34)
 225 
 226 
 227 func _loco_pose() -> Dictionary:
 228 	var t: float = float(frame) * DT
 229 	var v: float = _speed() if _loco_on else 0.0
 230 	var out: Dictionary
 231 	if String(params.get("mode", "walk")) == "skate":
 232 		var glide: Dictionary = _skate_pose(_phase, 0.12)
 233 		out = _mixe(glide, _skate_pose(_phase, 1.0), smoothstep(0.3, 2.5, v))
 234 	elif _air_w >= 1.0:
 235 		out = _air(t)
 236 	else:      # the side lean is part of the gait: the feet stay where they stand
 237 		return _gait_pose(t) if _air_w <= 0.0 else _mixe(_gait_pose(t), _air(t), _air_w * _air_w * (3.0 - 2.0 * _air_w))
 238 	var lean: float = clampf(float(params.get("lean", 0.0)), -1.0, 1.0)
 239 	if lean != 0.0:
 240 		out = add_pose(out, {"Hips": Vector3(0, 0, -16.0 * lean), "Spine": Vector3(0, 0, -5.0 * lean)})
 241 	return out
 242 
 243 
 244 ## Euler-space mix of two pose dictionaries (small angles; the frame blend in tick() is quaternion based).
 245 static func _mixe(a: Dictionary, b: Dictionary, k: float) -> Dictionary:
 246 	if k <= 0.0:
 247 		return a
 248 	if k >= 1.0:
 249 		return b
 250 	var out: Dictionary = {}
 251 	for key: String in a:
 252 		out[key] = (a[key] as Vector3).lerp(b.get(key, Vector3.ZERO), k)
 253 	for key: String in b:
 254 		if not a.has(key):
 255 			out[key] = Vector3.ZERO.lerp(b[key], k)
 256 	return out
 257 
 258 
 259 func _post_pose() -> void:
 260 	# blink: closed for 6 frames every 204 frames, unless the expression holds the eyes shut
 261 	if String(params.get("expression", "happy")) != "blink":
 262 		var ph: int = frame % 204
 263 		if ph < 6:
 264 			_face(0.0 if String(params.get("expression", "happy")) == "focus" else 1.0, 1.0 if ph < 4 else 0.5)
 265 		elif ph == 6:
 266 			_expr()
 267 	var la: Variant = params.get("look_at", null)
 268 	if la is Vector3:
 269 		var a: Vector2 = look_angles(la, Vector3(0, 1.75 * float(params["scale"]), 0))
 270 		var yaw: float = clampf(a.x, -70.0, 70.0)
 271 		var pitch: float = clampf(a.y, -30.0, 35.0)
 272 		for b: Array in [["Neck", 0.4], ["Head", 0.6]]:
 273 			var bi: int = _sk.find_bone(b[0])
 274 			var extra: Quaternion = Quaternion.from_euler(Vector3(deg_to_rad(pitch * float(b[1])), deg_to_rad(yaw * float(b[1])), 0))
 275 			_sk.set_bone_pose_rotation(bi, extra * _sk.get_bone_pose_rotation(bi))
