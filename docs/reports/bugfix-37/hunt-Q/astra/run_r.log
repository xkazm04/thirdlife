  62 static func build(family: String, params: Dictionary = {}) -> Node3D:
  63 	var main: bool = OS.get_thread_caller_id() == OS.get_main_thread_id()
  64 	var rig: Node3D = null
  65 	if main:
  66 		if _recording:
  67 			_record.append([family, params.duplicate(true)])
  68 		if _ahead_count > 0:
  69 			rig = _take_ahead(_key_of(family, params))
  70 	if rig == null:
  71 		rig = _build_rig(family, params)
  72 	return rig
  73 
  74 
  75 # ---- P12: a rig built ahead of the `build` call that will ask for it (as TLKit's layouts, P5) ---------------------
  76 # A rig references nothing outside rigs/kit/style and is built off the scene tree, so it may be built on a worker
  77 # thread. `_rig_ahead(family, params)` builds exactly what `build` builds and keeps it; the next `build` of the same
  78 # family and EQUAL params on the main thread takes it instead of building. One result serves one call. The kernel's
  79 # loader learns which rigs a pack builds by recording a build of it (`record`), and builds those ahead next time.
  80 static var _ahead: Dictionary = {}       # key -> Array of rigs
  81 static var _ahead_count: int = 0
  82 static var _ahead_lock: Mutex = Mutex.new()
  83 static var _recording: bool = false
  84 static var _record: Array = []
  85 
  86 
  87 ## The identity of a call: family and params (equal params give the same key).
  88 static func _key_of(family: String, params: Dictionary) -> String:
  89 	return family + "|" + var_to_str(params)
  90 
  91 
  92 ## Builds a rig ahead (any thread). Returns its key ("" when the params are not valid).
  93 static func _rig_ahead(family: String, params: Dictionary) -> String:
  94 	if validate(family, params).size() > 0:
  95 		return ""
  96 	var rig: Node3D = _build_rig(family, params)
  97 	var key: String = _key_of(family, params)
  98 	_ahead_lock.lock()
  99 	if not _ahead.has(key):
 100 		_ahead[key] = []
 101 	(_ahead[key] as Array).append(rig)
 102 	_ahead_count += 1
 103 	_ahead_lock.unlock()
 104 	return key
 105 
 106 
 107 static func _take_ahead(key: String) -> Node3D:
 108 	var rig: Node3D = null
 109 	_ahead_lock.lock()
 110 	if _ahead.has(key):
 111 		var list: Array = _ahead[key]
 112 		rig = list.pop_front()
 113 		_ahead_count -= 1
 114 		if list.is_empty():
 115 			_ahead.erase(key)
 116 	_ahead_lock.unlock()
 117 	return rig
 118 
 119 
 120 ## Frees one rig built ahead that no `build` asked for (main thread). True when there was one.
 121 static func _drop_rig(key: String) -> bool:
 122 	var rig: Node3D = _take_ahead(key)
 123 	if rig == null:
 124 		return false
 125 	rig.free()
 126 	return true
 127 
 128 
 129 ## Main thread. `_record_rigs(true)` starts noting every `build` call; `_record_rigs(false)` stops and returns the calls as
 130 ## [[family, params], ...] in call order.
 131 static func _record_rigs(on: bool) -> Array:
 132 	_recording = on
 133 	var out: Array = _record
 134 	_record = []
 135 	return out
