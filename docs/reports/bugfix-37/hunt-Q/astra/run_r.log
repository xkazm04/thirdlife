diff --git a/docs/reports/astra-trial/d5/repro/r_land_turn.gd b/docs/reports/astra-trial/d5/repro/r_land_turn.gd
new file mode 100644
index 0000000000000000000000000000000000000000..427511d6a00eea60e5193623703a9d249f60b817
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_land_turn.gd
@@ -0,0 +1,27 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_land_turn.gd"
+extends SceneTree
+
+func _initialize() -> void:
+	run.call_deferred()
+
+func run() -> void:
+	var rig = TLRigs.build("biped")
+	root.add_child(rig)
+	rig.set_locomotion(Vector3.ZERO, true)
+	rig.tick(1)
+	for f in range(2, 32):
+		rig.rotation.y = deg_to_rad(f - 1.0)
+		rig.set_locomotion(Vector3(0, 7 - 0.4 * (f - 2), 0), false)
+		rig.tick(f)
+	# A purely vertical jump. With no ground contact in these 30 ticks, there is no old
+	# stance anchor to preserve across the turn. land() sets the two new headings to psi.
+	rig.set_locomotion(Vector3.ZERO, true)
+	rig.play(&"land", 0.0)
+	rig.tick(32)
+	var gt: TLRigBipedGait = rig._gait
+	var sk: Skeleton3D = rig.get_node("Model/Skeleton3D")
+	var bi := sk.find_bone("LeftFoot")
+	var actual := rad_to_deg(sk.get_bone_global_pose(bi).basis.get_euler().y)
+	print("REPRO land_turn: %s new stance heading relative to body: expected %.1f degrees, left boot %.1f degrees" % ["FAIL" if absf(actual - rad_to_deg(gt.psi)) > 1 else "PASS", rad_to_deg(gt.psi), actual])
+	rig.free()
+	quit()
