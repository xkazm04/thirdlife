 219 ## Two-bone leg. `rp` = the pelvis rotation, `hip` and `ankle` in model space, `foot` = the boot's rotation in model
 220 ## space. Returns the euler degrees of the upper leg, the lower leg and the foot.
 221 static func _leg_ik(rp: Basis, hip: Vector3, ankle: Vector3, foot: Basis) -> Array:
 222 	var t: Vector3 = rp.inverse() * (ankle - hip)
 223 	var dist: float = clampf(t.length(), 0.22, 2.0 * LEG * 0.9995)
 224 	var th: Vector3 = t.normalized() if t.length() > 0.0001 else Vector3.DOWN
 225 	var a: float = acos(clampf(dist / (2.0 * LEG), -1.0, 1.0))          # the knee's half angle
 226 	var zu: float = asin(clampf(th.x / maxf(cos(a), 0.05), -1.0, 1.0))
 227 	var xu: float = wrapf(atan2(th.z, th.y) - atan2(sin(a), -cos(a) * cos(zu)), -PI, PI)
 228 	var ru: Basis = Basis.from_euler(Vector3(xu, 0.0, zu))
 229 	var rl: Basis = Basis.from_euler(Vector3(-2.0 * a, 0.0, 0.0))
 230 	var fe: Vector3 = ((rp * ru * rl).inverse() * foot).get_euler()
 231 	return [Vector3(rad_to_deg(xu), 0.0, rad_to_deg(zu)), Vector3(rad_to_deg(-2.0 * a), 0.0, 0.0), Vector3(rad_to_deg(fe.x), rad_to_deg(fe.y), rad_to_deg(fe.z))]
