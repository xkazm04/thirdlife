 499 		stop.merge(_stick_arms(pitch - 12.0, 0.0), true)
 500 	else:
 501 		stop.merge({"LeftUpperArm": Vector3(20.0, 0, -52.0), "LeftLowerArm": Vector3(30.0, 0, 0), "RightUpperArm": Vector3(24.0, 0, 46.0), "RightLowerArm": Vector3(34.0, 0, 0)}, true)
 502 	return _mixe(_skate_pose(0.0, 0.12), stop, k)
