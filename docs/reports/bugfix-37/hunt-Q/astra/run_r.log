 193 static func mix(a: Dictionary, b: Dictionary, k: float) -> Dictionary:
 194 	var q: Dictionary = {}
 195 	var aq: Dictionary = a["q"]
 196 	var bq: Dictionary = b["q"]
 197 	for bi: int in bq:
 198 		q[bi] = (aq.get(bi, Quaternion.IDENTITY) as Quaternion).slerp(bq[bi], k)
 199 	for bi: int in aq:
 200 		if not bq.has(bi):
 201 			q[bi] = (aq[bi] as Quaternion).slerp(Quaternion.IDENTITY, k)
 202 	return {"q": q, "h": (a["h"] as Vector3).lerp(b["h"], k)}
