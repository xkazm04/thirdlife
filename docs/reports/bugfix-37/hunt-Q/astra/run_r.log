 504 
 505 ## The hockey stance the shot and the pass start from and return to.
 506 func _stance(pitch: float = -30.0) -> Dictionary:
 507 	var a: float = 34.0
 508 	var lg: Array = _leg(a, pitch)
 509 	var out: Dictionary = {
 510 		"_hips": Vector3(0, -CROUCH * (1.0 - cos(deg_to_rad(a))), 0), "Hips": Vector3(pitch, 0, 0),
 511 		"Spine": Vector3(-6.0, 0, 0), "Chest": Vector3(-5.0, 0, 0), "UpperChest": Vector3(0, 0, 0), "Neck": Vector3(16.0, 0, 0), "Head": Vector3(18.0, 0, 0),
 512 		"LeftUpperLeg": Vector3(float(lg[0]), 0, -9.0), "LeftLowerLeg": Vector3(float(lg[1]), 0, 0), "LeftFoot": Vector3(float(lg[2]), 6.0, 9.0),
 513 		"RightUpperLeg": Vector3(float(lg[0]), 0, 9.0), "RightLowerLeg": Vector3(float(lg[1]), 0, 0), "RightFoot": Vector3(float(lg[2]), -6.0, -9.0),
 514 	}
 515 	out.merge(_stick_arms(pitch - 11.0, 0.0), true)
 516 	return out
 517 
 518 
 519 ## Slap shot, one-shot (0.85 s): wind-up (stick back and up, chest turned to the stick side) 0..0.30, swing through
 520 ## the puck 0.30..0.42, follow-through high with the back leg lifting 0.42..0.6, recover.
 521 func _shoot(t: float) -> Dictionary:
 522 	var base: Dictionary = _stance()
 523 	var wind: Dictionary = add_pose(base, {
 524 		"Hips": Vector3(4.0, -22.0, 0), "Chest": Vector3(0, -30.0, 0), "UpperChest": Vector3(0, -14.0, 0), "Head": Vector3(0, 46.0, 0),
 525 		"RightUpperArm": Vector3(-98.0, 0, 30.0), "RightLowerArm": Vector3(-8.0, 0, 0), "RightHand": Vector3(-62.0, 0, 0),
 526 		"LeftUpperArm": Vector3(-14.0, 0, 16.0), "LeftLowerArm": Vector3(14.0, 0, 0),
 527 		"_hips": Vector3(0.05, 0.02, 0.03), "RightUpperLeg": Vector3(-6.0, 0, 6.0), "LeftUpperLeg": Vector3(6.0, 0, 0)})
 528 	var hit: Dictionary = add_pose(base, {
 529 		"Hips": Vector3(-4.0, 8.0, 0), "Chest": Vector3(-4.0, 8.0, 0), "Head": Vector3(-6.0, -6.0, 0),
 530 		"RightUpperArm": Vector3(10.0, 0, 0), "RightHand": Vector3(8.0, 0, 0), "LeftUpperArm": Vector3(8.0, 0, 0),
 531 		"_hips": Vector3(-0.05, -0.04, -0.05)})
 532 	var follow: Dictionary = add_pose(base, {
 533 		"Hips": Vector3(-6.0, 30.0, 0), "Chest": Vector3(2.0, 34.0, 0), "UpperChest": Vector3(0, 12.0, 0), "Head": Vector3(2.0, -40.0, 0),
 534 		"RightUpperArm": Vector3(74.0, 0, -10.0), "RightLowerArm": Vector3(6.0, 0, 0), "RightHand": Vector3(26.0, 0, 0),
 535 		"LeftUpperArm": Vector3(44.0, 0, 10.0), "LeftLowerArm": Vector3(-20.0, 0, 0),
 536 		"_hips": Vector3(-0.08, 0.02, -0.08), "RightUpperLeg": Vector3(-44.0, 0, 8.0), "RightLowerLeg": Vector3(8.0, 0, 0), "RightFoot": Vector3(30.0, 0, 0),
 537 		"LeftUpperLeg": Vector3(4.0, 0, 0)})
 538 	return _keys(t, [[0.0, base], [0.30, wind], [0.42, hit], [0.56, follow], [0.66, follow], [0.85, base]])
 539 
 540 
 541 ## Pass, one-shot (0.55 s): a short low sweep, the blade stays on the ice, no leg lift.
 542 func _pass(t: float) -> Dictionary:
 543 	var base: Dictionary = _stance(-26.0)
 544 	var back: Dictionary = add_pose(base, {
 545 		"Hips": Vector3(0, -8.0, 0), "Chest": Vector3(0, -16.0, 0), "Head": Vector3(0, 22.0, 0),
 546 		"RightUpperArm": Vector3(-24.0, 0, 8.0), "LeftUpperArm": Vector3(-10.0, 0, 4.0), "RightHand": Vector3(-8.0, 0, 0), "_hips": Vector3(0.03, 0, 0.02)})
 547 	var push: Dictionary = add_pose(base, {
 548 		"Hips": Vector3(-5.0, 14.0, 0), "Chest": Vector3(-3.0, 26.0, 0), "Head": Vector3(4.0, -30.0, 0),
 549 		"RightUpperArm": Vector3(15.0, 0, -8.0), "RightLowerArm": Vector3(-8.0, 0, 0), "LeftUpperArm": Vector3(12.0, 0, 6.0), "RightHand": Vector3(-6.0, 0, 0), "_hips": Vector3(-0.04, -0.04, -0.05)})
 550 	return _keys(t, [[0.0, base], [0.16, back], [0.30, push], [0.38, push], [0.55, base]])
 551 
 552 
 553 func _cheer(t: float) -> Dictionary:
 554 	var p: float = TAU * t / 1.2
 555 	var hop: float = maxf(0.0, sin(2.0 * p))
 556 	var land: float = maxf(0.0, -sin(2.0 * p))
 557 	var a: float = 8.0 + 22.0 * land
 558 	var lg: Array = _leg(a, 4.0)
 559 	var w: float = sin(p)
 560 	return {
 561 		"_hips": Vector3(0, 0.14 * hop - CROUCH * (1.0 - cos(deg_to_rad(a))), 0), "Hips": Vector3(4.0, 0, 3.0 * w),
 562 		"Spine": Vector3(4.0, 0, 0), "Chest": Vector3(5.0, 0, 0), "Neck": Vector3(8.0, 0, 0), "Head": Vector3(12.0, 8.0 * w, 0),
 563 		"LeftShoulder": Vector3(0, 0, -12.0), "RightShoulder": Vector3(0, 0, 12.0),
 564 		"LeftUpperArm": Vector3(170.0 + 8.0 * w, 0, -34.0 - 8.0 * hop), "LeftLowerArm": Vector3(8.0 + 14.0 * hop, 0, 0), "LeftHand": Vector3(0, 0, 0),
 565 		"RightUpperArm": Vector3(170.0 - 8.0 * w, 0, 34.0 + 8.0 * hop), "RightLowerArm": Vector3(8.0 + 14.0 * hop, 0, 0), "RightHand": Vector3(-50.0 if _stick_on else 0.0, 0, 0),
 566 		"LeftUpperLeg": Vector3(float(lg[0]), 0, -5.0), "LeftLowerLeg": Vector3(float(lg[1]), 0, 0), "LeftFoot": Vector3(float(lg[2]) - 14.0 * hop, 0, 0),
 567 		"RightUpperLeg": Vector3(float(lg[0]), 0, 5.0), "RightLowerLeg": Vector3(float(lg[1]), 0, 0), "RightFoot": Vector3(float(lg[2]) - 14.0 * hop, 0, 0),
 568 		"Backpack": Vector3(-8.0 * hop, 0, 0), "Hair": Vector3(-8.0 * hop, 0, 0),
 569 	}
 570 
 571 
 572 func _carry(t: float) -> Dictionary:
 573 	if String(params.get("mode", "walk")) == "walk" and _loco_on:
 574 		# walker-feel: under a load the legs are the gait's (planted, at the real speed and direction); the arms hold the load
 575 		var g: Dictionary = _gait_pose(t)
 576 		var q: float = TAU * _gait.phase
 577 		g.merge({
 578 			"Spine": Vector3(3.0, 0, 0) + Vector3(0, (g["Spine"] as Vector3).y, 0), "Chest": Vector3(3.0, 0, 0) + Vector3(0, (g["Chest"] as Vector3).y, 0), "Head": Vector3(2.0, 0, 0),
 579 			"LeftUpperArm": Vector3(34.0 + 2.0 * cos(2.0 * q), 0, 10.0), "LeftLowerArm": Vector3(62.0, 0, 0), "LeftHand": Vector3(0, 0, -20.0),
 580 			"RightUpperArm": Vector3(34.0 + 2.0 * cos(2.0 * q), 0, -10.0), "RightLowerArm": Vector3(62.0, 0, 0), "RightHand": Vector3(0, 0, 20.0),
 581 		}, true)
 582 		return g
 583 	var out: Dictionary = _walk(t)
 584 	var p: float = TAU * t / 0.9
 585 	out.merge({
 586 		"Hips": Vector3(2.0, 3.0 * sin(p), 0), "Spine": Vector3(3.0, 0, 0), "Chest": Vector3(3.0, 0, 0), "Head": Vector3(2.0, 0, 0),
 587 		"LeftUpperArm": Vector3(34.0 + 2.0 * cos(2.0 * p), 0, 10.0), "LeftLowerArm": Vector3(62.0, 0, 0), "LeftHand": Vector3(0, 0, -20.0),
 588 		"RightUpperArm": Vector3(34.0 + 2.0 * cos(2.0 * p), 0, -10.0), "RightLowerArm": Vector3(62.0, 0, 0), "RightHand": Vector3(0, 0, 20.0),
 589 	}, true)
 590 	for k: String in ["LeftUpperLeg", "RightUpperLeg"]:
 591 		out[k] = (out[k] as Vector3) * Vector3(0.75, 1, 1)
 592 	return out

