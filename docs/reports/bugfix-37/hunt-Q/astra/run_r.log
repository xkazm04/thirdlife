 159 static func _mark_body(n: Node, body: Vector2) -> void:
 160 	if n is GeometryInstance3D:
 161 		(n as GeometryInstance3D).set_instance_shader_parameter(&"tl_body", body)
 162 	for c: Node in n.get_children():
 163 		_mark_body(c, body)

