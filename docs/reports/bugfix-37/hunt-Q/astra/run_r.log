  77 func _rebuild_mesh(sk: Skeleton3D) -> void:
  78 	var look: Dictionary = TLRigBipedMesh.LOOK.duplicate()
  79 	look.merge(params.get("colors", {}), true)
  80 	_helmet_built = _helmet()
  81 	var mk: TLMesh = TLRigBipedMesh.build_mesh(sk, look, bool(params["backpack"]), _helmet_built)
  82 	attach_skinned(_model, sk, mk, "biped")
  83 	_metrics["triangles"] = mk.tri_count + _tri_extra
  84 
  85 
  86 ## headgear "auto" = a team helmet (and the hockey kit) in skate mode, nothing in walk mode.
  87 func _helmet() -> bool:
  88 	var h: String = String(params.get("headgear", "auto"))
  89 	return h == "helmet" or (h == "auto" and String(params.get("mode", "walk")) == "skate")
  90 
  91 
  92 ## prop "auto" = the stick in skate mode; `stick = true` still forces it; "hammer" goes with the `work` clip.
  93 func _prop() -> String:
  94 	var pr: String = String(params.get("prop", "auto"))
  95 	if bool(params.get("stick", false)) and pr in ["auto", "stick"]:
  96 		return "stick"
  97 	if pr == "auto":
  98 		return "stick" if String(params.get("mode", "walk")) == "skate" else "none"
  99 	return pr
