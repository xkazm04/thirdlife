diff --git a/docs/reports/astra-trial/d5/repro/r_stale_case.sh b/docs/reports/astra-trial/d5/repro/r_stale_case.sh
new file mode 100644
index 0000000000000000000000000000000000000000..94c470a7d938f10bad183760708e936e29251b2e
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_stale_case.sh
@@ -0,0 +1,17 @@
+# bash docs/reports/astra-trial/d5/repro/r_stale_case.sh
+set -eu
+scratch=$(mktemp -d docs/reports/astra-trial/d5/repro/r_selftest_XXXXXX)
+trap 'rm -f "$scratch/kit.bot.json"; rmdir "$scratch"' EXIT
+export TL_SELFTEST_DIR="$scratch"
+case_name=rig.vehicle_drives
+clean=0
+bash engine/tools/selftest.sh "$case_name" || clean=$?
+# A retained claim from an earlier invocation in the configured reports directory.
+echo '{"rig_vehicle_ok":true,"car_top_speed":99,"steer_wheel_yaw":0.25}' > "$scratch/kit.bot.json"
+stale=0
+bash engine/tools/selftest.sh "$case_name" || stale=$?
+if [ "$clean" -ne 0 ] && [ "$stale" -eq 0 ]; then
+  echo "REPRO stale_case: FAIL identical selected case, empty report directory exit 1, retained result exit 0"
+else
+  echo "REPRO stale_case: control statuses clean=$clean stale=$stale"
+fi
diff --git a/docs/reports/astra-trial/d5/repro/r_stance.gd b/docs/reports/astra-trial/d5/repro/r_stance.gd
new file mode 100644
index 0000000000000000000000000000000000000000..304f829d3408d9642b06d378312ce32ecd4ca0da
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_stance.gd
@@ -0,0 +1,43 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_stance.gd"
+extends SceneTree
+
+func _initialize() -> void:
+	run.call_deferred()
+
+func run() -> void:
+	for scale_k in [1.0, 0.5]:
+		for schedule in ["regular", "reverse", "slow_cadence", "turn", "brake", "restart"]:
+			var rig = TLRigs.build("biped", {"scale": scale_k})
+			root.add_child(rig)
+			var sk: Skeleton3D = rig.get_node("Model/Skeleton3D")
+			var worst := 0.0
+			var at_frame := -1
+			var side := -1
+			var length_error := 0.0
+			for f in range(1, 241):
+				var vel := Vector3.FORWARD * 9
+				match schedule:
+					"reverse": vel *= 1.0 if f < 121 else -1.0
+					"slow_cadence": rig.stride_k = 0.65
+					"turn": rig.rotation.y += deg_to_rad(3.0)
+					"brake": vel *= clampf(1.0 - (f - 120) * 0.08, 0.0, 1.0)
+					"restart": vel *= 0.0 if f >= 120 and f < 150 else 1.0
+				rig.position += rig.basis * vel / 60.0
+				rig.set_locomotion(vel, true)
+				rig.tick(f)
+				if f < 60:
+					continue
+				for i in 2:
+					var foot: Dictionary = rig._gait.feet[i]
+					if not foot.st:
+						continue
+					var bi := sk.find_bone("LeftFoot" if i == 0 else "RightFoot")
+					var error := sk.get_bone_global_pose(bi).origin.distance_to(foot.pos) * float(scale_k)
+					if error > worst:
+						worst = error
+						at_frame = f
+						side = i
+						length_error = sk.get_bone_global_pose(bi).origin.y - float(foot.pos.y)
+			print("stance: scale=", scale_k, " schedule=", schedule, " worst=", worst, " tick=", at_frame, " side=", side, " y error=", length_error)
+			rig.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/r_stopped_world.sh b/docs/reports/astra-trial/d5/repro/r_stopped_world.sh
new file mode 100644
index 0000000000000000000000000000000000000000..26bb462d6dac202695738fbf72bdac38fe1bb730
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_stopped_world.sh
@@ -0,0 +1,19 @@
+# bash docs/reports/astra-trial/d5/repro/r_stopped_world.sh
+# When Bash sources this file during startup of the nested world test, stop that
+# specific child before its first verdict. The parent selftest runs normally.
+if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
+  if [[ "$0" == */world.sh && "$1" == same ]]; then
+    kill -TERM "$BASHPID"
+  fi
+  return
+fi
+
+set -eu
+result=0
+TL_SELFTEST_DIR=docs/reports/astra-trial/d5/repro BASH_ENV="$PWD/${BASH_SOURCE[0]}" \
+  bash engine/tools/selftest.sh world.same || result=$?
+if [ "$result" -eq 0 ]; then
+  echo "REPRO stopped_world: FAIL world.same returned success after the world.sh child stopped before its first hash"
+else
+  echo "REPRO stopped_world: PASS exit=$result"
+fi
