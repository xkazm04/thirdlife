 199 ## After a jump or a fall: both feet are put down under the body, the one ahead first.
 200 func land(vm: Vector2) -> void:
 201 	if feet.is_empty():
 202 		reset()
 203 	var sp: float = vm.length()
 204 	var that: Vector2 = vm / sp if sp > 0.001 else Vector2(0.0, -1.0)
 205 	var reach: float = minf(ls, 0.5)
 206 	for i: int in 2:
 207 		var ft: Dictionary = feet[i]
 208 		ft["st"] = true
 209 		ft["a"] = _foot_centre(i, 0.11) + that * reach * (0.3 if i == 0 else -0.2)
 210 		ft["yaw"] = psi
 211 		ft["hs"] = 0.0
 212 		ft["pitch"] = 0.0
 213 		ft["toes"] = 0.0
 214 		ft["pos"] = Vector3((ft["a"] as Vector2).x, ANKLE_H, (ft["a"] as Vector2).y)
 215 		ft["u"] = 0.5 * float(i)
 216 	phase = 0.0
