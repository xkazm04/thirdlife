@@ -0,0 +1,14 @@
+# bash docs/reports/astra-trial/d5/repro/r_clip_input.sh
+set -eu
+scratch=$(mktemp -d docs/reports/astra-trial/d5/repro/r_clip_XXXXXX)
+trap 'rm -f "$scratch/film.avi"; rmdir "$scratch"' EXIT
+# Stand-in for an existing source movie. The invalid kind should reject the
+# command before running Godot, FFmpeg, or touching neighboring files.
+echo "existing source movie" > "$scratch/film.avi"
+code=0
+bash engine/tools/look.sh clip rig:typo "$scratch/film.mp4" || code=$?
+if [ "$code" -eq 2 ] && [ ! -e "$scratch/film.avi" ]; then
+  echo "REPRO clip_input: FAIL invalid kind exited 2 and deleted the pre-existing film.avi beside the requested film.mp4"
+else
+  echo "REPRO clip_input: exit=$code existing AVI present=$(test -e "$scratch/film.avi" && echo yes || echo no)"
+fi
diff --git a/docs/reports/astra-trial/d5/repro/r_color.gd b/docs/reports/astra-trial/d5/repro/r_color.gd
new file mode 100644
index 0000000000000000000000000000000000000000..35d648cb982f4098a01d991e8426f7676b5b78fd
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_color.gd
@@ -0,0 +1,19 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_color.gd"
+extends SceneTree
+
+func stick_hash(rig: Node3D) -> String:
+	var mi: MeshInstance3D = rig.find_child("StickMesh", true, false)
+	return mi.mesh.get_meta("tl_hash")
+
+func _initialize() -> void:
+	var colors := {"stick": "car_red"}
+	var changed = TLRigs.build("biped", {"mode": "skate"})
+	var built = TLRigs.build("biped", {"mode": "skate", "colors": colors})
+	var old := stick_hash(changed)
+	changed.set_param(&"colors", colors)
+	var after := stick_hash(changed)
+	var reference := stick_hash(built)
+	print("REPRO color: %s stick mesh: distinct build colors=%s, runtime recolor kept old mesh hash=%s, matches requested color=%s" % ["FAIL" if old != reference and after != reference else "PASS", old != reference, after == old, after == reference])
+	changed.free()
+	built.free()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/r_direction.gd b/docs/reports/astra-trial/d5/repro/r_direction.gd
new file mode 100644
index 0000000000000000000000000000000000000000..f52b681e692b9cd3d6cfcc6f432664fdbe5a0b6e
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_direction.gd
@@ -0,0 +1,35 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_direction.gd"
+extends SceneTree
+
+func _initialize() -> void:
+	run.call_deferred()
+
+func run() -> void:
+	var rig = TLRigs.build("biped", {"scale": 0.5})
+	root.add_child(rig)
+	var sk: Skeleton3D = rig.get_node("Model/Skeleton3D")
+	for lean in [0.0, 1.0]:
+		rig.set_param(&"lean", lean)
+		for speed in [4.5, 9.0]:
+			var max_dist := 0.0
+			var where := ""
+			var continuous := 0.0
+			for a in range(0, 360, 10):
+				var v := Vector3.FORWARD.rotated(Vector3.UP, deg_to_rad(a)) * float(speed)
+				for f in 100:
+					rig.set_locomotion(v, true)
+					rig.tick(100 * a + f)
+					for i in 2:
+						var foot: Dictionary = rig._gait.feet[i]
+						if not foot.st:
+							continue
+						var bi := sk.find_bone("LeftFoot" if i == 0 else "RightFoot")
+						var dist := sk.get_bone_global_pose(bi).origin.distance_to(foot.pos) * 0.5
+						if dist > max_dist:
+							max_dist = dist
+							where = "%d:%d" % [a,f]
+						if f > 50:
+							continuous = maxf(continuous, dist)
+			print("lean=", lean, " speed=", speed, " worst_m=", max_dist, " where=", where, " steady=", continuous)
+	rig.free()
+	quit()
