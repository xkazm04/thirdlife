 146 func _physics_process(_dt: float) -> void:
 147 	frame += 1
 148 	if what == "fx":
 149 		_fx_tick()
 150 		return
 151 	var dt: float = 1.0 / 60.0
 152 	var v: float = speed
 153 	if what == "biped" and frame < 30:
 154 		v = 0.0                                      # stand for half a second, then go
 155 	elif what == "biped" and args.has("accel"):
 156 		v = speed * clampf(float(frame - 30) / maxf(1.0, float(args["accel"])), 0.0, 1.0)
 157 	if what == "biped" and args.has("stop-at") and frame >= int(args["stop-at"]):
 158 		v = 0.0
 159 	if what == "car":
 160 		v = speed * smoothstep(0.0, 120.0, float(frame))
 161 	if args.has("dir2") and frame >= int(args.get("dir-at", "150")):
 162 		dir_deg = float(args["dir2"])
 163 	heading += deg_to_rad(turn) * dt * (1.0 if frame > 30 else 0.0)
 164 	face = heading
 165 	var fwd: Vector3 = Vector3(cos(face), 0, sin(face))
 166 	var right: Vector3 = Vector3(-sin(face), 0, cos(face))
 167 	var da: float = deg_to_rad(dir_deg)
 168 	var dir: Vector3 = fwd * cos(da) + right * sin(da)
 169 	pos += dir * v * dt
 170 	# a jump: ballistic, off the floor until it comes back
 171 	if what == "biped" and args.has("jump-at") and frame == int(args["jump-at"]):
 172 		vy = float(args.get("jump-v", "8.0"))
 173 		airborne = true
 174 		if (rig.call("clips") as PackedStringArray).has("jump"):
 175 			rig.call("play", &"jump")
