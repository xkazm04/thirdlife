 320 # ------------------------------------------------------------------ pose helpers
 321 ## A leg with knee half-angle a under a pelvis pitched by `pitch` (the foot stays flat): returns [upper, lower, foot] x angles.
 322 static func _leg(a: float, pitch: float, swing: float = 0.0) -> Array:
 323 	return [a - pitch + swing, -2.0 * a, a - swing]
 324 
 325 
 326 static func _sm(t: float, t0: float, t1: float) -> float:
 327 	return smoothstep(t0, t1, t)
