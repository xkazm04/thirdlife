 234 ## Pelvis and legs for the feet as they stand now: the pelvis pose (euler degrees), where the style wants its height
 235 ## (`y_style`, metres against the rest height) and a side shift; the height is cut to what both legs can reach.
 236 func legs_pose(hips_deg: Vector3, y_style: float, shift: Vector3) -> Dictionary:
 237 	if feet.is_empty():
 238 		reset()
 239 	var rp: Basis = Basis.from_euler(Vector3(deg_to_rad(hips_deg.x), deg_to_rad(hips_deg.y), deg_to_rad(hips_deg.z)))
 240 	var k: float = 0.012
 241 	var acc: float = exp(-y_style / k)
 242 	var joints: Array = []
 243 	for i: int in 2:
 244 		var ft: Dictionary = feet[i]
 245 		var p: Vector3 = ft["pos"]
 246 		var jo: Vector3 = rp * Vector3(-0.11 if i == 0 else 0.11, -0.04, 0.0)
 247 		joints.append(jo)
 248 		var r2: float = Vector2(shift.x + jo.x - p.x, shift.z + jo.z - p.z).length_squared()
 249 		var allowed: float = p.y + sqrt(maxf(LEG_MAX * LEG_MAX - r2, 0.04)) - jo.y - 0.98
 250 		if not bool(ft["st"]):
 251 			var w: float = float(ft["w"])
 252 			allowed += 0.5 * (smoothstep(0.0, 0.15, w) - smoothstep(0.85, 1.0, w))
 253 		acc += exp(-clampf(allowed, -0.6, 0.6) / k)
 254 	var y: float = -k * log(acc)
 255 	var out: Dictionary = {"_hips": Vector3(shift.x, y + shift.y, shift.z), "Hips": hips_deg}
 256 	for i: int in 2:
 257 		var ft: Dictionary = feet[i]
 258 		var side: String = "Left" if i == 0 else "Right"
 259 		var hip: Vector3 = Vector3(shift.x, 0.98 + y + shift.y, shift.z) + (joints[i] as Vector3)
 260 		var lg: Array = _leg_ik(rp, hip, ft["pos"], Basis.from_euler(Vector3(-float(ft["pitch"]), float(ft["yaw"]), 0.0)))
 261 		out[side + "UpperLeg"] = lg[0]
 262 		out[side + "LowerLeg"] = lg[1]
 263 		out[side + "Foot"] = lg[2]
 264 		out[side + "Toes"] = Vector3(rad_to_deg(float(ft["toes"])), 0.0, 0.0)
 265 	return out
