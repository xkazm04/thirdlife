 137 ## Advances the animation by one physics frame. `frame_no` is the kernel's frame counter (kept for frame-keyed
 138 ## details such as blinking and flame flicker); every call is one step of 1/60 s.
 139 func tick(frame_no: int) -> void:
 140 	frame = frame_no
 141 	_advance()
 142 	if _sk == null:
 143 		return
 144 	var target: Dictionary
 145 	if String(clip) != "":
 146 		var c: Dictionary = _clips[String(clip)]
