 444 ## The skating stride. phase in cycles; amp 0 = a still glide in the hockey stance, 1 = full push and recover.
 445 func _skate_pose(phase: float, amp: float) -> Dictionary:
 446 	var p: float = TAU * phase
 447 	var s: float = sin(p)
 448 	var push_l: float = pow(maxf(0.0, s), 0.8) * amp
 449 	var push_r: float = pow(maxf(0.0, -s), 0.8) * amp
 450 	var pitch: float = -30.0 - 6.0 * amp
 451 	var a: float = 36.0
 452 	var out: Dictionary = {
 453 		"_hips": Vector3(0.07 * s * amp, -CROUCH * (1.0 - cos(deg_to_rad(a))) + 0.03 * absf(s) * amp, 0),
 454 		"Hips": Vector3(pitch, 7.0 * s * amp, -5.0 * s * amp),
 455 		"Spine": Vector3(-6.0, -6.0 * s * amp, 0), "Chest": Vector3(-5.0, -8.0 * s * amp, 0), "UpperChest": Vector3(0, 0, 0),
 456 		"Neck": Vector3(16.0, 5.0 * s * amp, 0), "Head": Vector3(20.0, 0, 0),
 457 		"Backpack": Vector3(3.0 * cos(p), 0, 0), "Hair": Vector3(-6.0 - 3.0 * cos(p), 0, 0),
 458 	}
 459 	var tp: float = pitch - 11.0   # torso pitch seen by the arms
 460 	for side: Array in [["Left", push_l, -1.0], ["Right", push_r, 1.0]]:
 461 		var push: float = side[1]
 462 		var sx: float = side[2]
 463 		var aa: float = a * (1.0 - 0.72 * push)                 # the pushing leg straightens
 464 		var world: float = lerpf(aa, -16.0, push)               # ... and trails back
 465 		var upper: float = world - pitch
 466 		var lower: float = -2.0 * aa
 467 		out[String(side[0]) + "UpperLeg"] = Vector3(upper, 0, sx * (4.0 + 24.0 * push))   # out to the side
 468 		out[String(side[0]) + "LowerLeg"] = Vector3(lower, 0, 0)
 469 		out[String(side[0]) + "Foot"] = Vector3(-(pitch + upper + lower) - 10.0 * push, -sx * 28.0 * push, -sx * 10.0 * push)
 470 		out[String(side[0]) + "Toes"] = Vector3(0, 0, 0)
 471 	if _stick_on:
 472 		out.merge(_stick_arms(tp, 6.0 * s * amp), true)
 473 	else:
 474 		out["LeftUpperArm"] = Vector3(-tp * 0.75 + 38.0 * s * amp, 0, -14.0 - 14.0 * push_r)
 475 		out["LeftLowerArm"] = Vector3(34.0, 0, 0)
 476 		out["RightUpperArm"] = Vector3(-tp * 0.75 - 38.0 * s * amp, 0, 14.0 + 14.0 * push_l)
 477 		out["RightLowerArm"] = Vector3(34.0, 0, 0)
 478 		out["LeftHand"] = Vector3(0, 0, 0)
 479 		out["RightHand"] = Vector3(0, 0, 0)
 480 	return out
