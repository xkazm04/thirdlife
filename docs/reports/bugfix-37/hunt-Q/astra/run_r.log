@@ -0,0 +1,17 @@
+# bash docs/reports/astra-trial/d5/repro/r_stale_case.sh
+set -eu
+scratch=$(mktemp -d docs/reports/astra-trial/d5/repro/r_selftest_XXXXXX)
+trap 'rm -f "$scratch/kit.bot.json"; rmdir "$scratch"' EXIT
+export TL_SELFTEST_DIR="$scratch"
+case_name=rig.vehicle_drives
+clean=0
+bash engine/tools/selftest.sh "$case_name" || clean=$?
+# A retained claim from an earlier invocation in the configured reports directory.
+echo '{"rig_vehicle_ok":true,"car_top_speed":99,"steer_wheel_yaw":0.25}' > "$scratch/kit.bot.json"
+stale=0
+bash engine/tools/selftest.sh "$case_name" || stale=$?
+if [ "$clean" -ne 0 ] && [ "$stale" -eq 0 ]; then
+  echo "REPRO stale_case: FAIL identical selected case, empty report directory exit 1, retained result exit 0"
+else
+  echo "REPRO stale_case: control statuses clean=$clean stale=$stale"
+fi
diff --git a/docs/reports/astra-trial/d5/repro/r_stopped_world.sh b/docs/reports/astra-trial/d5/repro/r_stopped_world.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7e8ce94410fd339dc00bac9c4be01afdccdbbe1f
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_stopped_world.sh
@@ -0,0 +1,24 @@
+# bash docs/reports/astra-trial/d5/repro/r_stopped_world.sh
+# When Bash sources this file during startup of the nested world test, stop that
+# specific child before its first verdict. The parent selftest runs normally.
+if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
+  if [[ "$0" == */world.sh && "$1" == same ]]; then
+    kill -TERM "$BASHPID"
+  fi
+  return
+fi
+
+set -eu
+export BASH_ENV="$PWD/${BASH_SOURCE[0]}"
+child_status=0
+bash engine/tools/world.sh same --packs=pack_min || child_status=$?
+echo "Stopped world.sh control exit=$child_status"
+[ "$child_status" -eq 143 ] || exit 1
+result=0
+TL_SELFTEST_DIR=docs/reports/astra-trial/d5/repro \
+  bash engine/tools/selftest.sh world.same || result=$?
+if [ "$result" -eq 0 ]; then
+  echo "REPRO stopped_world: FAIL world.same returned success after the world.sh child stopped before its first hash"
+else
+  echo "REPRO stopped_world: PASS exit=$result"
+fi
