+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_direction.gd"
+extends SceneTree
+
+func _initialize() -> void:
+	run.call_deferred()
+
+func run() -> void:
+	var rig = TLRigs.build("biped", {"scale": 0.5})
+	root.add_child(rig)
+	var sk: Skeleton3D = rig.get_node("Model/Skeleton3D")
+	for lean in [0.0, 1.0]:
+		rig.set_param(&"lean", lean)
+		for speed in [4.5, 9.0]:
+			var max_dist := 0.0
+			var where := ""
+			var continuous := 0.0
