 305 func _log_contact(v: float) -> void:
 306 	var sk: Skeleton3D = rig.get_node_or_null("Model/Skeleton3D")
 307 	if sk == null:
 308 		return
 309 	var now: Dictionary = {}
 310 	var worst: float = -1.0
 311 	var lowest: float = 1e9
 312 	for i: int in SOLE.size():
 313 		var bi: int = sk.find_bone(String(SOLE[i][0]))
 314 		var p: Vector3 = sk.global_transform * (sk.get_bone_global_pose(bi) * (sk.get_bone_global_rest(bi).affine_inverse() * (SOLE[i][1] as Vector3)))
 315 		lowest = minf(lowest, p.y - rig.position.y)
 316 		if p.y - rig.position.y < 0.015 and not airborne:
 317 			now[i] = p
 318 			if c_prev.has(i):
 319 				var d: Vector3 = p - (c_prev[i] as Vector3)
 320 				d.y = 0.0
 321 				worst = maxf(worst, d.length() * 60.0)
 322 	c_prev = now
 323 	if v > 0.05 and frame > 60 and not airborne:
 324 		c_frames += 1
 325 		c_low = minf(c_low, lowest)
 326 		if worst >= 0.0:
 327 			c_log.append(worst)
 328 		elif now.is_empty():
 329 			c_none += 1
