diff --git a/docs/reports/astra-trial/d5/repro/r_boil.py b/docs/reports/astra-trial/d5/repro/r_boil.py
new file mode 100644
index 0000000000000000000000000000000000000000..8e5aa7a505b2bbc8652487d66847c83339c2278c
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_boil.py
@@ -0,0 +1,18 @@
+# python docs/reports/astra-trial/d5/repro/r_boil.py
+"""Measure a lossless, static horizontal stripe pattern at look.sh's default clip resolution."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+with tempfile.TemporaryDirectory(prefix="r_boil_", dir=Path(__file__).parent) as workspace:
+    clip = Path(workspace) / "still.mkv"
+    subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-f", "lavfi", "-i",
+                    "nullsrc=size=1280x720,geq=lum='if(mod(Y,2),220,30)':cb=128:cr=128",
+                    "-frames:v", "12", "-pix_fmt", "yuv420p", "-c:v", "ffv1", str(clip)], check=True)
+    result = subprocess.run([sys.executable, "engine/rigs/review/boil.py", str(clip), "0", "11"],
+                            capture_output=True, text=True, check=True)
+    print(result.stdout.strip())
+    expected = "frames=12" in result.stdout and "mean=0.000 flips_pct=0.000" in result.stdout
+    print("REPRO boil: %s expected 12 identical frames, zero mean change and zero flips" %
+          ("PASS" if expected else "FAIL"))
diff --git a/docs/reports/astra-trial/d5/repro/r_color.gd b/docs/reports/astra-trial/d5/repro/r_color.gd
new file mode 100644
index 0000000000000000000000000000000000000000..35d648cb982f4098a01d991e8426f7676b5b78fd
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/r_color.gd
@@ -0,0 +1,19 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/r_color.gd"
+extends SceneTree
+
+func stick_hash(rig: Node3D) -> String:
+	var mi: MeshInstance3D = rig.find_child("StickMesh", true, false)
+	return mi.mesh.get_meta("tl_hash")
+
+func _initialize() -> void:
+	var colors := {"stick": "car_red"}
+	var changed = TLRigs.build("biped", {"mode": "skate"})
+	var built = TLRigs.build("biped", {"mode": "skate", "colors": colors})
+	var old := stick_hash(changed)
+	changed.set_param(&"colors", colors)
+	var after := stick_hash(changed)
+	var reference := stick_hash(built)
+	print("REPRO color: %s stick mesh: distinct build colors=%s, runtime recolor kept old mesh hash=%s, matches requested color=%s" % ["FAIL" if old != reference and after != reference else "PASS", old != reference, after == old, after == reference])
+	changed.free()
+	built.free()
+	quit()
