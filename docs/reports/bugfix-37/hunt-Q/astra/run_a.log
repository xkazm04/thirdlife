124:## Turns the view: `dx` radians to the right (the mouse moved right), `dy` radians down; the pitch stays in its limits.
125:func turn(dx: float, dy: float, pitch_min: float, pitch_max: float) -> void:
126:	look_yaw = wrapf(look_yaw - dx, -PI, PI)
127:	look_pitch = clampf(look_pitch + dy, pitch_min, pitch_max)
128:	_place_cam()
