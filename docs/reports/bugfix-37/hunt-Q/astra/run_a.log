332:func _process(_delta: float) -> void:
333:	var now: int = Time.get_ticks_usec()
334:	if trace_frames > 0:
335:		trace_frames -= 1
336:		var f: Vector3 = get_global_transform_interpolated().origin
337:		var c: Vector3 = cam.get_global_transform_interpolated().origin if cam != null else Vector3.ZERO
338:		print(JSON.stringify({"schema": "tl.view/1", "kind": "visitor_frame", "tick": int(_world.get("tick")) if _world != null else -1,
339:			"physics_frames": Engine.get_physics_frames(), "usec": now, "fraction": snappedf(Engine.get_physics_interpolation_fraction(), 0.001),
340:			"figure": [snappedf(f.x, 0.0001), snappedf(f.y, 0.0001), snappedf(f.z, 0.0001)], "cam": [snappedf(c.x, 0.0001), snappedf(c.y, 0.0001), snappedf(c.z, 0.0001)]}, "", false))
341:	if _frame_last > 0:
342:		_frame_usec.append(now - _frame_last)
343:	_frame_last = now
