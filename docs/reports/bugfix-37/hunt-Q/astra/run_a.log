346:func _frame_ms(p: float) -> float:
347:	if _frame_usec.is_empty():
348:		return 0.0
349:	var sorted: PackedInt64Array = _frame_usec.duplicate()
350:	sorted.sort()
351:	return snappedf(float(sorted[clampi(int(ceil(p * float(sorted.size()))) - 1, 0, sorted.size() - 1)]) / 1000.0, 0.001)
