156:## Exact key set of an object inside an optional field; every difference is one error.
157:static func _keys(d: Dictionary, required: Array, allowed: Array, where: String, line: int, errors: Array) -> bool:
158:	var ok: bool = true
159:	for k: String in required:
160:		if not d.has(k):
161:			errors.append({"kind": "schema", "file": "pack.json", "line": line, "message": "%s: missing key '%s'" % [where, k]})
162:			ok = false
163:	for k: Variant in d.keys():
164:		if not allowed.has(k):
165:			errors.append({"kind": "schema", "file": "pack.json", "line": line, "message": "%s: unknown key '%s'" % [where, str(k)]})
166:			ok = false
167:	return ok
