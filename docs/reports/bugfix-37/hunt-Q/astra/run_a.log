@@ -0,0 +1,28 @@
+# python -B docs/reports/astra-trial/d5/repro/a_capture_resize.py
+import json
+import subprocess
+import sys
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+
+def main():
+    with TemporaryDirectory(prefix="a_resize_", dir=Path(__file__).parent) as folder:
+        frames = Path(folder)
+        rows = []
+        for n, width in enumerate((960, 960, 800)):
+            (frames / f"f{n:05}.raw").write_bytes(bytes(width * 540 * 3))
+            rows.append({"n": n, "frame": n + 1, "size": [width, 540],
+                         "look": [0, 0, -1], "fov": 60})
+        (frames / "frames.jsonl").write_text("".join(json.dumps(row) + "\n" for row in rows))
+        result = subprocess.run([sys.executable, "-B", "engine/kernel/world/walks/blink_detect.py",
+                                 str(frames), "--json"], capture_output=True, text=True, check=False)
+        if result.stderr:
+            print(result.stderr.splitlines()[-1])
+        reported = any('"report": "blinks"' in line for line in result.stdout.splitlines())
+        print(f"REPRO capture_resize: {'PASS' if reported else 'FAIL'} 3 indexed RGB8 frames, "
+              f"exit={result.returncode}, totals printed={reported}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd b/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd
new file mode 100644
index 0000000000000000000000000000000000000000..d319e7cb890024723bfc60a63cd24563d754fdcf
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd
@@ -0,0 +1,22 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	cam.setup(who, {"use_velocity": true, "distance": 7.0, "follow": 1.0})
+	# Start in the setup heading (-Z), then travel the opposite way (+Z).
+	for tick in 360:
+		var direction := Vector3.FORWARD if tick < 60 else Vector3.BACK
+		who.position += direction * 0.1
+		cam._physics_process(1.0 / 60.0)
+	var ahead: float = (cam.global_position - who.global_position).dot(Vector3.BACK)
+	print("REPRO reverse_camera: %s after 300 reverse ticks, expected 7.0 m behind travel, camera %.1f m ahead" % ["PASS" if ahead < 0.0 else "FAIL", ahead])
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_snap_heading.gd b/docs/reports/astra-trial/d5/repro/a_snap_heading.gd
new file mode 100644
index 0000000000000000000000000000000000000000..ecd2951ee502e65096b8a6fdeefa970ab51e1923
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_snap_heading.gd
@@ -0,0 +1,22 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_snap_heading.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	cam.setup(who, {"distance": 8.0, "stiffness": 1.0})
+	who.position = Vector3(15, 0, 10)
+	who.rotation.y = PI / 2
+	cam.snap()
+	var behind := who.global_basis.z
+	var offset: Vector3 = cam.global_position - who.global_position
+	var back_m := offset.dot(behind)
+	print("REPRO snap_heading: %s expected 8.0 m behind the teleported target immediately, got %.1f m" % ["PASS" if is_equal_approx(back_m, 8.0) else "FAIL", absf(back_m)])
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_stage_input.gd b/docs/reports/astra-trial/d5/repro/a_stage_input.gd
