diff --git a/docs/reports/astra-trial/d5/repro/a_camera_wall.gd b/docs/reports/astra-trial/d5/repro/a_camera_wall.gd
new file mode 100644
index 0000000000000000000000000000000000000000..3e7e3cdcf9bfee9e45719591b2ac2fd6cc1b2b8d
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_camera_wall.gd
@@ -0,0 +1,34 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_camera_wall.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var sp = Space.new()
+	# Solid wall covers z=0.2..10.2. Both look points are outside.
+	sp.add_box(Transform3D(Basis(), Vector3(0, 2, 5.2)), Vector3(20, 4, 10))
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	who.position.z = -1.0
+	cam.setup(who, {"distance": 7.0, "look_height": 1.0, "height": 1.0,
+			"avoid_margin": 0.3, "avoid_space": sp.space})
+	var st := PhysicsServer3D.space_get_direct_state(sp.space)
+	var query := PhysicsPointQueryParameters3D.new()
+	query.collision_mask = 1
+	query.position = cam.global_position
+	var control := not st.intersect_point(query).is_empty()
+	who.position.z = 0.0
+	cam.snap()
+	query.position = cam.global_position
+	var inside := not st.intersect_point(query).is_empty()
+	print("REPRO camera_wall: %s expected camera outside wall, inside at 1.2 m clearance=%s, inside at 0.2 m clearance=%s, camera z=%.2f" % ["FAIL" if inside and not control else "PASS", control, inside, cam.global_position.z])
+	cam.free()
+	who.free()
+	sp.free_all()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd b/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd
new file mode 100644
index 0000000000000000000000000000000000000000..d319e7cb890024723bfc60a63cd24563d754fdcf
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd
@@ -0,0 +1,22 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	cam.setup(who, {"use_velocity": true, "distance": 7.0, "follow": 1.0})
+	# Start in the setup heading (-Z), then travel the opposite way (+Z).
+	for tick in 360:
+		var direction := Vector3.FORWARD if tick < 60 else Vector3.BACK
+		who.position += direction * 0.1
+		cam._physics_process(1.0 / 60.0)
+	var ahead: float = (cam.global_position - who.global_position).dot(Vector3.BACK)
+	print("REPRO reverse_camera: %s after 300 reverse ticks, expected 7.0 m behind travel, camera %.1f m ahead" % ["PASS" if ahead < 0.0 else "FAIL", ahead])
+	quit()
