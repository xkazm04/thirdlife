131:## "" when a pack built against API `v` runs on this kernel; otherwise the reason, for the manifest error.
132:static func api_reason(v: String) -> String:
133:	var a: PackedStringArray = str(LEGACY_API.get(v, v)).split(".")
134:	var b: PackedStringArray = KERNEL_API.split(".")
135:	if a.size() != 2 or not a[0].is_valid_int() or not a[1].is_valid_int():
136:		return "kernelApi is written major.minor"
137:	if int(a[0]) != int(b[0]):
138:		return "the pack was built for major version %d and this kernel is major version %d (a new major removes or changes signatures)" % [int(a[0]), int(b[0])]
139:	if int(a[1]) > int(b[1]):
140:		return "the pack needs minor version %d and this kernel has %d (the pack uses additions this kernel does not have yet)" % [int(a[1]), int(b[1])]
141:	return ""
