117:						"message": "'%s': duplicate item '%s'" % [key, item]})
118:				seen[item] = true
119:				_check_string(key + "[]", item, rule, line, errors)
120:	if errors.is_empty() and not api_compatible(str(m["kernelApi"])):
121:		errors.append({"kind": "schema", "file": "pack.json", "line": _line_of(text, "kernelApi"),
122:			"message": "kernelApi '%s' cannot run on this kernel, which offers API %s: %s" % [str(m["kernelApi"]), KERNEL_API, api_reason(str(m["kernelApi"]))]})
123:	return {"ok": errors.is_empty(), "manifest": m, "errors": errors}
