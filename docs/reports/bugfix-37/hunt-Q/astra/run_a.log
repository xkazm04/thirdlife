diff --git a/docs/reports/astra-trial/d5/repro/a_blink_erosion.py b/docs/reports/astra-trial/d5/repro/a_blink_erosion.py
new file mode 100644
index 0000000000000000000000000000000000000000..0535325a71c7b4bf6c4fbbc053039a95b6889589
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_blink_erosion.py
@@ -0,0 +1,23 @@
+# python -B docs/reports/astra-trial/d5/repro/a_blink_erosion.py
+from pathlib import Path
+from runpy import run_path
+
+import numpy as np
+
+
+def main():
+    detector = run_path("engine/kernel/world/walks/blink_detect.py")
+    mask = np.zeros((20, 50), dtype=bool)
+    for y in (5, 12):
+        for x in range(4, 41, 6):
+            mask[y - 1:y + 2, x] = True
+            mask[y, x - 1:x + 2] = True
+    full_blocks = np.lib.stride_tricks.sliding_window_view(mask, (3, 3)).all(axis=(-2, -1))
+    survivors = int(detector["erode"](mask).sum())
+    print(f"full 3x3 foreground neighbourhoods={int(full_blocks.sum())}")
+    verdict = "FAIL" if survivors != int(full_blocks.sum()) else "PASS"
+    print(f"REPRO blink_erosion: {verdict} expected 0 surviving pixels, got {survivors} (default event threshold 12)")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/docs/reports/astra-trial/d5/repro/a_camera_cut_wall.gd b/docs/reports/astra-trial/d5/repro/a_camera_cut_wall.gd
new file mode 100644
index 0000000000000000000000000000000000000000..f169f1c0cddad7436c7eded291b6b68df5bc1dcb
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_camera_cut_wall.gd
@@ -0,0 +1,56 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --fixed-fps 120 --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_camera_cut_wall.gd"
+extends SceneTree
+
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+
+var tick := 0
+var sp = Space.new()
+var who := Node3D.new()
+var cam = Chase.new()
+var inside_drawn := 0
+var inside_physics := 0
+var first_inside := Vector3.ZERO
+var started := false
+
+func _initialize() -> void:
+	call_deferred("_setup")
+
+func _setup() -> void:
+	root.add_child(who)
+	root.add_child(cam)
+	sp.add_box(Transform3D(Basis(), Vector3(4, 1, 4)), Vector3(2, 2, 2))
+	cam.setup(who, {"distance": 8.0, "height": 1.0, "look_height": 1.0, "stiffness": 1.0,
+			"anchor_follow": 1.0, "avoid_space": sp.space})
+	cam.make_current()
+	cam.get_global_transform_interpolated()
+	started = true
+
+func _physics_process(_delta: float) -> bool:
+	if started:
+		tick += 1
+		if tick == 8:
+			who.rotation.y = PI / 2
+	return false
+
+func _inside(pos: Vector3) -> bool:
+	var q := PhysicsPointQueryParameters3D.new()
+	q.position = pos
+	q.collision_mask = 1
+	return not PhysicsServer3D.space_get_direct_state(sp.space).intersect_point(q).is_empty()
+
+func _process(_delta: float) -> bool:
+	if started:
+		if _inside(cam.global_position):
+			inside_physics += 1
+		var drawn: Vector3 = cam.get_global_transform_interpolated().origin
+		if _inside(drawn):
+			inside_drawn += 1
+			first_inside = drawn
+		if tick >= 16:
+			print("REPRO camera_cut_wall: %s physics poses inside=%d, interpolated frames inside=%d, last interior position=%s" % ["FAIL" if inside_drawn > 0 and inside_physics == 0 else "PASS", inside_physics, inside_drawn, first_inside])
+			cam.free()
+			who.free()
+			sp.free_all()
+			quit()
+	return false
diff --git a/docs/reports/astra-trial/d5/repro/a_camera_wall.gd b/docs/reports/astra-trial/d5/repro/a_camera_wall.gd
new file mode 100644
index 0000000000000000000000000000000000000000..3e7e3cdcf9bfee9e45719591b2ac2fd6cc1b2b8d
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_camera_wall.gd
@@ -0,0 +1,34 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_camera_wall.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var sp = Space.new()
+	# Solid wall covers z=0.2..10.2. Both look points are outside.
+	sp.add_box(Transform3D(Basis(), Vector3(0, 2, 5.2)), Vector3(20, 4, 10))
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	who.position.z = -1.0
+	cam.setup(who, {"distance": 7.0, "look_height": 1.0, "height": 1.0,
+			"avoid_margin": 0.3, "avoid_space": sp.space})
+	var st := PhysicsServer3D.space_get_direct_state(sp.space)
+	var query := PhysicsPointQueryParameters3D.new()
+	query.collision_mask = 1
+	query.position = cam.global_position
+	var control := not st.intersect_point(query).is_empty()
+	who.position.z = 0.0
+	cam.snap()
+	query.position = cam.global_position
+	var inside := not st.intersect_point(query).is_empty()
+	print("REPRO camera_wall: %s expected camera outside wall, inside at 1.2 m clearance=%s, inside at 0.2 m clearance=%s, camera z=%.2f" % ["FAIL" if inside and not control else "PASS", control, inside, cam.global_position.z])
+	cam.free()
+	who.free()
+	sp.free_all()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_capture_resize.py b/docs/reports/astra-trial/d5/repro/a_capture_resize.py
new file mode 100644
index 0000000000000000000000000000000000000000..81d2a7499e63f6a875d36d6baf1307ee4d3dc053
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_capture_resize.py
@@ -0,0 +1,28 @@
+# python -B docs/reports/astra-trial/d5/repro/a_capture_resize.py
+import json
+import subprocess
+import sys
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+
+def main():
+    with TemporaryDirectory(prefix="a_resize_", dir=Path(__file__).parent) as folder:
+        frames = Path(folder)
+        rows = []
+        for n, width in enumerate((960, 960, 800)):
+            (frames / f"f{n:05}.raw").write_bytes(bytes(width * 540 * 3))
+            rows.append({"n": n, "frame": n + 1, "size": [width, 540],
+                         "look": [0, 0, -1], "fov": 60})
+        (frames / "frames.jsonl").write_text("".join(json.dumps(row) + "\n" for row in rows))
+        result = subprocess.run([sys.executable, "-B", "engine/kernel/world/walks/blink_detect.py",
+                                 str(frames), "--json"], capture_output=True, text=True, check=False)
+        if result.stderr:
+            print(result.stderr.splitlines()[-1])
+        reported = any('"report": "blinks"' in line for line in result.stdout.splitlines())
+        print(f"REPRO capture_resize: {'PASS' if reported else 'FAIL'} 3 indexed RGB8 frames, "
+              f"exit={result.returncode}, totals printed={reported}")
+
+
+if __name__ == "__main__":
+    main()
