+for name in jump walk.jump; do
+    status=0
+    output=$(timeout 120 "$G" --headless --path engine --script res://kernel/world/walks/walk_case.gd -- "$name") || status=$?
+    trailer=$(printf '%s\n' "$output" | tr -d '\r' | sed -n '/^WALKCASE done /p')
