250:static func _check_string(key: String, v: String, rule: Dictionary, line: int, errors: Array) -> void:
251:	if rule.has("pattern"):
252:		var re: RegEx = RegEx.create_from_string(rule["pattern"])
253:		if re.search(v) == null:
254:			errors.append({"kind": "schema", "file": "pack.json", "line": line,
255:				"message": "'%s': '%s' does not match %s" % [key, v, rule["pattern"]]})
