1:class_name TLChaseCam
2:extends Camera3D
3:## Follows a target from behind and above; frame-counted smoothing (no wall clock). Capability: `camera`.
4:## Make one with `ctx.cameras.chase(target, {distance = 7.0, height = 3.0})`.
5:## N1: a deliberate lens (58 degrees instead of the engine's 75), the place follows faster than the heading turns
6:## (`follow` against `stiffness`), so the target keeps its size at speed, and the point looked at is smoothed too.
7:## Walker-feel (18 Nov 2026), both opt-in, a pack's camera is unchanged without them:
8:##   `anchor_follow` (>= 0): the camera orbits a SMOOTHED point that follows the target by this share per frame
9:##       (`anchor_follow_y` for its height, default the same): the place and the point looked at both come from it, so a
10:##       mouse turn keeps the distance exact while a jump or a step is eased. `follow` and `aim` are then not used.
11:##   `avoid_space` (a physics space RID): the camera never goes inside what that space holds (mask `avoid_mask`): a
12:##       sphere of `avoid_margin` is cast from the point looked at to the wanted place; the camera stands where it
13:##       stops (pulled in at once), and eases back out by `avoid_out` of the remaining way per frame. When that leaves
14:##       it nearer than `avoid_min` (it would look through the back of his head), the camera is first swung UP round
15:##       the point looked at (10 degree steps, at most 80 degrees above the horizon) to the lowest angle that is clear
16:##       for `avoid_min`: over an edge it looks down at him instead of into him.
17:
18:var target: Node3D
19:var distance: float = 7.0        ## metres behind the target
20:var height: float = 3.0          ## metres above the target
21:var look_height: float = 1.0     ## the point looked at, above the target's origin
22:var stiffness: float = 0.07      ## 0..1 share of the remaining heading change covered each frame
23:var follow: float = 0.18          ## 0..1 share of the remaining distance to the wanted place covered each frame
24:var aim: float = 0.3             ## 0..1 share of the remaining way to the point looked at covered each frame
25:var use_velocity: bool = false   ## true: stay behind the direction of travel instead of the target's facing
26:var anchor_follow: float = -1.0  ## >= 0: orbit a smoothed anchor (see the header); -1 off
27:var anchor_follow_y: float = -1.0  ## the anchor's height share per frame; -1: the same as anchor_follow
28:var avoid_space: RID = RID()     ## a physics space whose bodies the camera never enters; invalid: off
29:var avoid_margin: float = 0.3    ## metres kept between the camera and what it would enter
30:var avoid_mask: int = 1          ## collision layers of `avoid_space` that count
31:var avoid_out: float = 0.12      ## 0..1 share of the remaining way back out covered each frame
32:var avoid_min: float = 2.5       ## metres: a nearer camera is swung up first (see the header)
33:var avoid_pull: float = 0.0      ## read only: metres the camera stands nearer than wanted this frame (0 when free)
34:var avoid_lift: float = 0.0      ## read only: degrees the camera is swung up this frame (0 when free)
35:var _heading: Vector3 = Vector3.FORWARD
36:var _last_pos: Vector3 = Vector3.ZERO
37:var _look: Vector3 = Vector3.ZERO
38:var _anchor: Vector3 = Vector3.ZERO
39:var _free_len: float = -1.0
40:var _lift: float = 0.0
41:var _sphere: SphereShape3D = null
42:var _query: PhysicsShapeQueryParameters3D = null
43:
44:
45:func setup(target_: Node3D, opts: Dictionary = {}) -> void:
46:	target = target_
47:	fov = 58.0
48:	for k: String in opts.keys():
49:		if k in ["distance", "height", "look_height", "stiffness", "follow", "aim", "use_velocity", "fov", "anchor_follow", "anchor_follow_y",
50:				"avoid_space", "avoid_margin", "avoid_mask", "avoid_out"]:
51:			set(k, opts[k])
52:		else:
53:			push_error("TLChaseCam: unknown option '%s'" % k)
54:	far = 2000.0
55:	if is_instance_valid(target) and target.is_inside_tree():
56:		_last_pos = target.global_position
57:		_heading = _target_forward()
58:		snap()
59:
60:
61:## Puts the camera at its wanted place at once (after a teleport, or after changing `distance` / `height`).
62:func snap() -> void:
63:	if not is_instance_valid(target) or not target.is_inside_tree() or not is_inside_tree():
64:		return
65:	_anchor = target.global_position
66:	global_position = _wanted()
67:	_look = target.global_position + Vector3.UP * look_height
68:	_free_len = -1.0
69:	_lift = 0.0
70:	_avoid(true)
71:	_aim()
72:	reset_physics_interpolation()
73:
74:
75:func _target_forward() -> Vector3:
76:	var f: Vector3 = -target.global_transform.basis.z
77:	f.y = 0.0
78:	return f.normalized() if f.length() > 0.001 else _heading
79:
80:
81:func _base() -> Vector3:
82:	return _anchor if anchor_follow >= 0.0 else target.global_position
83:
84:
85:func _wanted() -> Vector3:
86:	return _base() - _heading * distance + Vector3.UP * height
87:
88:
89:func _aim() -> void:
90:	if global_position.distance_to(_look) > 0.01:
91:		look_at(_look, Vector3.UP)
92:
93:
94:## Keeps the camera out of `avoid_space` (see the header). `now`: no easing (a snap).
95:func _avoid(now: bool) -> void:
96:	avoid_pull = 0.0
97:	avoid_lift = 0.0
98:	if not avoid_space.is_valid():
99:		return
100:	var d: Vector3 = global_position - _look
101:	var want_len: float = d.length()
102:	if want_len < 0.01:
103:		return
104:	if _query == null:
105:		_sphere = SphereShape3D.new()
106:		_query = PhysicsShapeQueryParameters3D.new()
107:		_query.shape = _sphere
108:	_sphere.radius = avoid_margin
109:	_query.collision_mask = avoid_mask
110:	var st: PhysicsDirectSpaceState3D = PhysicsServer3D.space_get_direct_state(avoid_space)
111:	if st == null:
112:		return
113:	var axis: Vector3 = Vector3.UP.cross(d)
114:	axis = axis.normalized() if axis.length() > 0.001 else Vector3.RIGHT
115:	if d.rotated(axis, 0.1).y < d.y:
116:		axis = -axis
117:	var elev: float = rad_to_deg(asin(clampf(d.y / want_len, -1.0, 1.0)))
118:	# the lowest swing up that is clear for avoid_min (or the whole wanted way when that is shorter)
119:	var need: float = minf(avoid_min, want_len)
120:	var want_lift: float = 0.0
121:	var best: float = -1.0
122:	var k: int = 0
123:	while k <= 8:
124:		var ang: float = 10.0 * float(k)
125:		if k > 0 and elev + ang > 80.0:
126:			break
127:		var fl: float = _cast(st, d.rotated(axis, deg_to_rad(ang)), want_len)
128:		if fl >= need - 0.01:
129:			want_lift = ang
130:			best = -1.0
131:			break
132:		if fl > best + 0.25:
133:			best = fl
134:			want_lift = ang
135:		k += 1
136:	if now or want_lift > _lift:
137:		_lift = want_lift
138:	else:
139:		_lift = lerpf(_lift, want_lift, clampf(avoid_out, 0.01, 1.0))
140:		if absf(_lift - want_lift) < 0.05:
141:			_lift = want_lift
142:	var dir: Vector3 = d.rotated(axis, deg_to_rad(_lift)) if _lift > 0.0 else d
143:	var free_len: float = _cast(st, dir, want_len)
144:	if now or _free_len < 0.0 or free_len < _free_len:
145:		_free_len = free_len                                   # pulled in at once
146:	else:
147:		_free_len = minf(free_len, lerpf(_free_len, free_len, clampf(avoid_out, 0.01, 1.0)))
148:	var len: float = minf(_free_len, want_len)
149:	avoid_pull = want_len - len
150:	avoid_lift = _lift
151:	global_position = _look + dir / want_len * len
152:
153:
154:## How far a sphere of `avoid_margin` gets from the point looked at along `d` (length `want_len`).
155:func _cast(st: PhysicsDirectSpaceState3D, d: Vector3, want_len: float) -> float:
156:	_query.transform = Transform3D(Basis(), _look)
157:	_query.motion = d
158:	var r: PackedFloat32Array = st.cast_motion(_query)
159:	return want_len * (r[0] if r.size() > 0 else 1.0)
160:
161:
162:func _physics_process(_delta: float) -> void:
163:	if not is_instance_valid(target) or not target.is_inside_tree():
164:		return
165:	var want_heading: Vector3 = _target_forward()
166:	if use_velocity:
167:		var step: Vector3 = target.global_position - _last_pos
168:		step.y = 0.0
169:		if step.length() > 0.02:
170:			want_heading = step.normalized()
171:	_last_pos = target.global_position
172:	_heading = _heading.lerp(want_heading, stiffness).normalized() if _heading.lerp(want_heading, stiffness).length() > 0.001 else want_heading
173:	if anchor_follow >= 0.0:
174:		var tp: Vector3 = target.global_position
175:		var ky: float = anchor_follow_y if anchor_follow_y >= 0.0 else anchor_follow
176:		_anchor = Vector3(lerpf(_anchor.x, tp.x, clampf(anchor_follow, 0.01, 1.0)), lerpf(_anchor.y, tp.y, clampf(ky, 0.01, 1.0)),
177:			lerpf(_anchor.z, tp.z, clampf(anchor_follow, 0.01, 1.0)))
178:		global_position = _wanted()
179:		_look = _anchor + Vector3.UP * look_height
180:	else:
181:		global_position = global_position.lerp(_wanted(), clampf(follow, 0.01, 1.0))
182:		_look = _look.lerp(target.global_position + Vector3.UP * look_height, clampf(aim, 0.01, 1.0))
183:	_avoid(false)
184:	_aim()

