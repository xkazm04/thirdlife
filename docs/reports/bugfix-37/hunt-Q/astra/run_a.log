58:## Returns {ok: bool, manifest: Dictionary, errors: [{kind, file, line?, message}]}.
59:static func read(pack_dir: String) -> Dictionary:
60:	var errors: Array = []
61:	var path: String = pack_dir + "/pack.json"
62:	if not FileAccess.file_exists(path):
63:		errors.append({"kind": "schema", "file": "pack.json", "message": "pack.json not found in " + pack_dir})
64:		return {"ok": false, "manifest": {}, "errors": errors}
65:	var text: String = FileAccess.get_file_as_string(path)
66:	var json: JSON = JSON.new()
67:	if json.parse(text) != OK:
68:		errors.append({"kind": "schema", "file": "pack.json", "line": json.get_error_line() + 1,
69:			"message": "not valid JSON: " + json.get_error_message()})
70:		return {"ok": false, "manifest": {}, "errors": errors}
71:	if typeof(json.data) != TYPE_DICTIONARY:
72:		errors.append({"kind": "schema", "file": "pack.json", "message": "top level must be an object"})
73:		return {"ok": false, "manifest": {}, "errors": errors}
74:	var m: Dictionary = json.data
75:	for key: Variant in m.keys():
76:		if not KEYS.has(key):
77:			errors.append({"kind": "schema", "file": "pack.json", "line": _line_of(text, str(key)),
78:				"message": "unknown key '%s' (unknown keys are errors)" % str(key)})
79:	for key: String in KEYS.keys():
80:		var rule: Dictionary = KEYS[key]
81:		if not m.has(key):
82:			if rule.get("required", false):
83:				errors.append({"kind": "schema", "file": "pack.json", "message": "missing required key '%s'" % key})
84:			continue
85:		var v: Variant = m[key]
86:		var line: int = _line_of(text, key)
87:		if v == null:
88:			errors.append({"kind": "schema", "file": "pack.json", "line": line,
89:				"message": "'%s' is null (an absent value is an omitted key, never null)" % key})
90:			continue
91:		if rule["type"] == "shape":
92:			_check_shape(key, v, line, errors)
