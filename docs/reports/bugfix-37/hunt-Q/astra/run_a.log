160:func step(pos: Vector3, frame: int) -> void:
161:	ticks += 1
162:	if not _later.is_empty() and space != null and _world != null and int(_world.get("tick")) >= int((_later[0] as Dictionary)["t"]):
163:		_run_probes([_later.pop_front()], {}, Vector3.INF)
164:		space.call("place", feet)
165:	if space != null and steer:
166:		_drive_step(pos, frame)
167:		return
168:	if space != null:
169:		var want: Vector3 = Vector3(pos.x - feet.x, 0.0, pos.z - feet.z)
170:		var dist: float = want.length()
171:		if dist > catch_up_m:
172:			want = want / dist * catch_up_m
173:		var res: Dictionary = space.call("walk", feet, want)
174:		feet = res["pos"]
175:		if bool(res["blocked"]) and _logged < 6 and (ticks % 30 == 1 or _logged < 2):
176:			_logged += 1
177:			var lh: Dictionary = space.get("last_hit")
178:			print(JSON.stringify({"schema": "tl.view/1", "kind": "visitor_blocked", "world_tick": int(_world.get("tick")) if _world != null else -1,
179:				"feet": [snappedf(feet.x, 0.01), snappedf(feet.y, 0.01), snappedf(feet.z, 0.01)], "want": [snappedf(pos.x, 0.01), snappedf(pos.z, 0.01)],
180:				"hit": str(lh.get("tag", "none")), "at": str(lh.get("at", "")), "normal": str(lh.get("n", ""))}, "", false))
181:		var dev: float = Vector2(pos.x - feet.x, pos.z - feet.z).length()
182:		max_dev = maxf(max_dev, dev)
183:		end_dev = dev
184:		if _world != null and bool(_world.get("player_live")):
185:			_world.set("player_pos", Vector3(feet.x, pos.y, feet.z))        # a person walks: the body decides
186:		_report_at_end()
187:	else:
188:		feet = pos
189:	var d: Vector3 = feet - _last
190:	d.y = 0.0
191:	speed = d.length() * 60.0
192:	var local_v: Vector3 = Vector3(0.0, 0.0, -speed)
193:	if steer:
194:		_yaw = look_yaw
195:		local_v = (d * 60.0).rotated(Vector3.UP, -_yaw)
196:	elif speed > 0.2:
197:		_yaw = lerp_angle(_yaw, atan2(-d.x, -d.z), 0.18)
198:	position = feet
199:	rotation.y = _yaw
200:	_last = feet
201:	if rig != null and visible:
202:		rig.call("set_locomotion", local_v, true)
203:		rig.call("tick", frame)
204:
205:
206:## Walker-feel: one tick of a person's body (steer on, a space): the wish moves the body by velocity; the figure turns
207:## toward his travel; the rig is told the velocity in its own axes, whether he stands, and the one-shot clips.
208:func _drive_step(pos: Vector3, frame: int) -> void:
209:	if not visible:
210:		# a game is on stage: the walker stands where he entered it (as before: nothing moved him then)
211:		space.call("rest")
212:		vel = Vector3.ZERO
213:		mode = "ground"
214:		_wish_jump = false
215:		_wish_slide = false
216:		return
217:	var res: Dictionary = space.call("drive", feet, _wish, _wish_jump, _wish_slide)
218:	_wish_jump = false
219:	_wish_slide = false
220:	var was: String = mode
221:	if bool(res["blocked"]) and _logged < 6 and (ticks % 30 == 1 or _logged < 2):
222:		_logged += 1
223:		var lh: Dictionary = space.get("last_hit")
224:		print(JSON.stringify({"schema": "tl.view/1", "kind": "visitor_blocked", "world_tick": int(_world.get("tick")) if _world != null else -1,
225:			"feet": [snappedf(feet.x, 0.01), snappedf(feet.y, 0.01), snappedf(feet.z, 0.01)], "mode": str(res["mode"]),
226:			"hit": str(lh.get("tag", "none")), "at": str(lh.get("at", "")), "normal": str(lh.get("n", ""))}, "", false))
227:	feet = res["pos"]
228:	vel = res["vel"]
229:	mode = str(res["mode"])
230:	if _world != null and bool(_world.get("player_live")):
231:		_world.set("player_pos", Vector3(feet.x, pos.y, feet.z))        # a person walks: the body decides
232:	var d: Vector3 = feet - _last
233:	d.y = 0.0
234:	speed = d.length() * 60.0
235:	var hv: Vector3 = Vector3(vel.x, 0.0, vel.z)
236:	if hv.length() > 0.5 and mode != "slope":
237:		face_yaw = lerp_angle(face_yaw, atan2(-hv.x, -hv.z), FACE_EASE)
238:	elif mode == "slope" and hv.length() > 0.5:
239:		face_yaw = lerp_angle(face_yaw, atan2(-hv.x, -hv.z), FACE_EASE * 0.5)
240:	_yaw = look_yaw
241:	position = feet
242:	rotation.y = look_yaw
243:	_last = feet
244:	if rig != null and visible:
245:		rig.rotation.y = wrapf(face_yaw - look_yaw, -PI, PI)
246:		var local_v: Vector3 = vel.rotated(Vector3.UP, -face_yaw)
247:		rig.call("set_locomotion", local_v, mode == "ground" or mode == "slide")
248:		for e: Variant in res["events"]:
249:			match str(e):
250:				"jump":
251:					_clip(&"jump")
252:				"land":
253:					if mode != "slope":
254:						_clip(&"land")
255:				"slide":
256:					_clip(&"slide")
257:				"slope":
258:					_clip(&"slope_slide")
259:				"end_slide":
260:					if was == "slide" or was == "slope":
261:						_clip(&"")
262:		rig.call("tick", frame)
