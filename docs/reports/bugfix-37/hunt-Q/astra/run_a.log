361:			"end_dev_m": snappedf(end_dev, 0.01), "frame_ms_p50": _frame_ms(0.5), "frame_ms_p99": _frame_ms(0.99), "frame_ms_max": _frame_ms(1.0), "end": [snappedf(feet.x, 0.01), snappedf(feet.y, 0.01), snappedf(feet.z, 0.01)],
