5:A blink is a patch of the picture that shows sky (or anything else) for a few frames where the frames before and
6:after agree on something else. Two tests per frame t, on the picture at half size:
7:  a patch (3x3 eroded) whose colour at t is far from t-k and t+k (k = 1..4) while t-k and t+k agree:
8:  something shown for 1 to 4 frames where the frames around it agree (sky through the ground, a pop, a flash).
9:A second test needs no neighbours: sky-coloured patches below the horizon (from the camera's pitch and fov in
10:frames.jsonl) are a hole in the ground in that frame ("HOLE" lines).
11:The key line at the bottom and the build tag in the top right corner are masked. Prints one line per frame with
12:an event (the count, the box, the camera from frames.jsonl) and a last line with the totals, `"report": "blinks"`.
13:"""
14:import json
15:import math
16:import os
17:import sys
18:
19:import numpy as np
20:from PIL import Image
21:
22:
23:HORIZON_MARGIN = 8     # rows (of the half-size picture) below the horizon before sky counts as a hole
24:
25:
26:def load(path, scale):
27:    im = Image.open(path).convert("RGB")
28:    if scale != 1:
29:        im = im.resize((im.width // scale, im.height // scale), Image.BILINEAR)
30:    return np.asarray(im)
31:
32:
33:def sky(a):
34:    a = a.astype(np.int32)
35:    r, g, b = a[..., 0], a[..., 1], a[..., 2]
36:    return (b > 110) & (b * 100 > r * 62) & (b + 10 > g * 0.85)
37:
38:
39:def magenta(a):
40:    a = a.astype(np.int32)
41:    return (a[..., 0] > 190) & (a[..., 1] < 70) & (a[..., 2] > 190)
42:
43:
44:def erode(a):
45:    """a pixel stays when it and its eight neighbours are all set: single pixels and edges of moving things go"""
46:    o = a.copy()
47:    o[1:, :] &= a[:-1, :]
48:    o[:-1, :] &= a[1:, :]
49:    o[:, 1:] &= a[:, :-1]
50:    o[:, :-1] &= a[:, 1:]
51:    return o
52:
53:
54:def main():
55:    d = sys.argv[1]
56:    min_px = 12
57:    as_json = False
58:    for a in sys.argv[2:]:
59:        if a.startswith("--min="):
60:            min_px = int(a.split("=", 1)[1])
61:        elif a == "--json":
62:            as_json = True
63:    cams = {}
64:    fl = os.path.join(d, "frames.jsonl")
65:    if os.path.exists(fl):
66:        for line in open(fl):
67:            try:
68:                j = json.loads(line)
69:                cams[j.get("n", j["frame"])] = j
70:            except Exception:
71:                pass
72:    names = sorted(n for n in os.listdir(d) if n.startswith("f") and (n.endswith(".png") or n.endswith(".raw")))
73:    frames = [int(n[1:6]) for n in names]
74:    imgs = []
75:    for n, k in zip(names, frames):
76:        if n.endswith(".raw"):
77:            wh = cams[k]["size"]
78:            a = np.fromfile(os.path.join(d, n), np.uint8).reshape(wh[1], wh[0], 3)
79:            imgs.append(np.ascontiguousarray(a[::2, ::2]) if wh[0] > 500 else a)
80:        else:
81:            imgs.append(load(os.path.join(d, n), 2))
82:    if not imgs:
83:        print("no pictures in %s" % d)
84:        sys.exit(2)
85:    h, w = imgs[0].shape[:2]
86:    mask = np.ones((h, w), bool)
87:    mask[int(h * 0.90):, :] = False          # the key line
88:    mask[: int(h * 0.05), int(w * 0.85):] = False   # the build tag
89:    # boot.gd TL_EXE_SKYMASK=1 paints every pixel where nothing was drawn magenta: then "sky" is exact
90:    painted = any(int(magenta(a).sum()) > 50 for a in imgs[:: max(1, len(imgs) // 20)])
91:    skies = [(magenta(a) if painted else sky(a)) & mask for a in imgs]
92:    events = []
93:    K = 4
94:    for t in range(1, len(imgs) - 1):
95:        c = imgs[t].astype(np.int16)
96:        ev = np.zeros((h, w), bool)
97:        for k in range(1, K + 1):
98:            if t - k < 0 or t + k >= len(imgs):
99:                break
100:            if frames[t] - frames[t - k] != k or frames[t + k] - frames[t] != k:
101:                break
102:            p, n = imgs[t - k].astype(np.int16), imgs[t + k].astype(np.int16)
103:            a = (np.abs(c - p).sum(-1) > 100) & (np.abs(c - n).sum(-1) > 100) & (np.abs(n - p).sum(-1) < 45)
104:            ev |= erode(a)
105:        ev &= mask
106:        nf = int(ev.sum())
107:        if nf >= min_px:
108:            ys, xs = np.nonzero(ev)
109:            ns = int((ev & skies[t]).sum())
110:            e = {"n": frames[t], "frame": cams.get(frames[t], {}).get("frame", frames[t]), "px": nf, "sky_px": ns,
111:                 "box": [int(xs.min()) * 2, int(ys.min()) * 2, int(xs.max()) * 2, int(ys.max()) * 2]}
112:            cj = cams.get(frames[t])
113:            if cj:
114:                for k in ("cam", "look", "player", "stage"):
115:                    if k in cj:
116:                        e[k] = cj[k]
117:            events.append(e)
118:    # the second test: sky below the horizon (the camera does not roll; the horizon row follows from its pitch and fov)
119:    holes = []
120:    for t in range(len(imgs)):
121:        cj = cams.get(frames[t])
122:        if not cj or "look" not in cj or "fov" not in cj:
123:            continue
124:        pitch = math.asin(max(-1.0, min(1.0, cj["look"][1])))
125:        f = (h / 2.0) / math.tan(math.radians(cj["fov"]) / 2.0)
126:        y_h = int(h / 2.0 + math.tan(pitch) * f) + HORIZON_MARGIN
127:        if y_h >= h:
128:            continue
129:        below = skies[t].copy()
130:        below[: max(0, y_h), :] = False
131:        below = erode(below)
132:        nb = int(below.sum())
133:        if nb >= min_px:
134:            ys, xs = np.nonzero(below)
135:            holes.append({"n": frames[t], "frame": cj.get("frame"), "hole_px": nb, "horizon_row": y_h * 2,
136:                          "box": [int(xs.min()) * 2, int(ys.min()) * 2, int(xs.max()) * 2, int(ys.max()) * 2],
137:                          "cam": cj.get("cam"), "look": cj.get("look"), "stage": cj.get("stage")})
138:    # the third test (exact with the sky mask): nothing drawn at t, for 1 to 6 frames, where the frames around agree
139:    # that something was drawn: a blink of dead space
140:    blinks = []
141:    for t in range(1, len(imgs) - 1):
142:        ev = np.zeros((h, w), bool)
143:        for k in range(1, 7):
144:            if t - k < 0 or t + k >= len(imgs) or frames[t] - frames[t - k] != k or frames[t + k] - frames[t] != k:
145:                break
146:            ev |= skies[t] & ~skies[t - k] & ~skies[t + k]
147:        cj = cams.get(frames[t], {})
148:        if "look" in cj and "fov" in cj:      # below the horizon only: above it a flag or a branch uncovers real sky
149:            pitch = math.asin(max(-1.0, min(1.0, cj["look"][1])))
150:            y_h = int(h / 2.0 + math.tan(pitch) * (h / 2.0) / math.tan(math.radians(cj["fov"]) / 2.0)) + HORIZON_MARGIN
151:            ev[: max(0, min(h, y_h)), :] = False
152:        ev = erode(ev)
153:        nb = int(ev.sum())
154:        if nb >= min_px:
155:            ys, xs = np.nonzero(ev)
156:            cj = cams.get(frames[t], {})
157:            blinks.append({"n": frames[t], "frame": cj.get("frame"), "blink_px": nb,
158:                           "box": [int(xs.min()) * 2, int(ys.min()) * 2, int(xs.max()) * 2, int(ys.max()) * 2],
159:                           "cam": cj.get("cam"), "look": cj.get("look"), "stage": cj.get("stage")})
160:    for e in blinks:
161:        print(json.dumps(e) if as_json else "BLINK n %5d frame %5d px %5d box %s cam %s look %s" % (
162:            e["n"], e["frame"], e["blink_px"], e["box"], e.get("cam"), e.get("look")))
163:    for e in holes:
164:        print(json.dumps(e) if as_json else "HOLE n %5d frame %5d px %5d box %s cam %s look %s" % (
165:            e["n"], e["frame"], e["hole_px"], e["box"], e.get("cam"), e.get("look")))
166:    for e in events:
167:        print(json.dumps(e) if as_json else "n %5d frame %5d px %5d sky %5d box %s cam %s look %s" % (
168:            e["n"], e["frame"], e["px"], e["sky_px"], e["box"], e.get("cam"), e.get("look")))
169:    print(json.dumps({"report": "blinks", "dir": d, "frames": len(imgs), "first": frames[0], "last": frames[-1],
170:                      "events": len(events), "sky_mask": painted, "blink_frames": len(blinks), "blink_px_max": max([e["blink_px"] for e in blinks] or [0]), "hole_frames": len(holes), "hole_px_max": max([e["hole_px"] for e in holes] or [0]), "sky_events": sum(1 for e in events if e["sky_px"] * 2 >= e["px"])}))
