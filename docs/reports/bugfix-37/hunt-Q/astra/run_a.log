116:## Walker-feel. A person's wish for this tick (kernel/runner/visit.gd, below its sampling line): `v` the horizontal
117:## velocity he asks for (m/s, world axes), `jump` / `slide`: the key went down this tick.
118:func wish(v: Vector3, jump: bool, slide: bool) -> void:
119:	_wish = v
120:	_wish_jump = _wish_jump or jump
121:	_wish_slide = _wish_slide or slide
122:
123:
124:## Turns the view: `dx` radians to the right (the mouse moved right), `dy` radians down; the pitch stays in its limits.
125:func turn(dx: float, dy: float, pitch_min: float, pitch_max: float) -> void:
126:	look_yaw = wrapf(look_yaw - dx, -PI, PI)
127:	look_pitch = clampf(look_pitch + dy, pitch_min, pitch_max)
128:	_place_cam()
