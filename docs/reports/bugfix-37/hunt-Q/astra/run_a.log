+    if [ "$name" = walk.jump ] && [ "$status" -eq 0 ] && [ "$trailer" = 'WALKCASE done 0 0' ]; then
+        echo 'REPRO walk_filter: FAIL selected an existing case, ran zero and exited successfully'
+    fi
+done

