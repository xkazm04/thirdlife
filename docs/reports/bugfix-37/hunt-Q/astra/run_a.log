1:extends Node
2:## P11. The visitor's input is a record. A person who walks a world (kernel/world/draw/view.gd, `--live`) reaches it
3:## through ONE TLInput of the world's own, sampled once per world tick; everything below that line (where he goes,
4:## where he looks, who is on stage, when the world ends) reads only that input. So a visit can be written as a
5:## `tl.input/1` record (`--record=<file>`) and fed back (`--input=<file>`): the visitor walks the same path and every
6:## pack ends with the same hash. Later a second player's keys can arrive here from another machine.
7:##
8:##   actions  forward W, back S, left A, right D, run Shift, jump Space, slide C (while running), enter E, leave Q, quit Esc, and the pointer
9:##            (TLInput.LOOK_X / LOOK_Y: pixels the mouse moved while it was captured, this tick)
10:##   record   `pack` is the walk's name, `mode` "play", `max_frames` the walk's ticks, `length` the samples taken.
11:##            A game played on stage is a record of its own (the same schema, that pack's own frames):
12:##            `<record>.<plot>.<n>.json` for the n-th time the person was on that plot's stage.
13:##   devices  `--devices=<file>` (tests): [[tick, "key", "<Key>", 1|0], [tick, "move", dx, dy], [tick, "shot", "<name>", 0],
14:##            [tick, "mark", "<name>", 0], [tick, "trace", <frames>, 0]] (a mark prints where he is at that tick, before
15:##            its move; a trace prints, for that many DRAWN frames, where the figure and the camera are drawn: kind
16:##            `visitor_frame`, the proof that they move between ticks when frames outrun ticks)
17:##            raw events put into the engine's input path at a world tick (Input.parse_input_event), as a person makes them.
18:## Above the sampling line: `_input` (mouse motion while captured), the device script and the mouse capture.
19:
20:const Session: GDScript = preload("res://kernel/runner/session.gd")
21:const ACTIONS: Array = [[&"forward", KEY_W], [&"back", KEY_S], [&"left", KEY_A], [&"right", KEY_D], [&"run", KEY_SHIFT],
22:	[&"enter", KEY_E], [&"leave", KEY_Q], [&"quit", KEY_ESCAPE], [&"jump", KEY_SPACE], [&"slide", KEY_C]]
23:const LOOK_DEG_PER_PX: float = 0.15     # 600 px of mouse = 90 degrees
24:const PITCH_MIN_DEG: float = -10.0      # the camera's elevation above the visitor's head: he stays in the picture
25:const PITCH_MAX_DEG: float = 60.0
26:const WALK_MPS: float = 4.5
27:const RUN_MPS: float = 9.0
28:const GATE_OUT_M: float = 5.0           # after Q he stands this far outside the plot's radius, at its gate
29:const PATH_EVERY: int = 300             # a `visit_path` line every this many ticks
30:
31:var input: TLInput = null
32:var view: Node = null
33:var world: Node = null
34:var devices: bool = false               # a person's devices are read (not a replay)
35:var record_path: String = ""
36:var replay: Dictionary = {}
37:var _rec: Variant = null
38:var _mouse: Vector2 = Vector2.ZERO
39:var _script: Dictionary = {}            # tick -> [[kind, a, b], ...]
40:var _stage_rec: Array = []              # [plot index, TLInput, frames list or null, visit number]
41:var _visits: Dictionary = {}            # plot id -> times on stage
42:var _stage_feeds: Dictionary = {}       # "<plot id>.<n>" -> record (replay)
43:var _ticks: int = 0
44:var _captured: bool = false
45:var shots: Array = []                   # [tick, name] asked by the device script
46:var _held: Dictionary = {}              # walker-feel round 2: keys the device script holds down (keycode -> true)
