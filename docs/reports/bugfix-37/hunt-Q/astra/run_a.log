91:## Above the line: what the mouse did while it was captured (a game on stage reads the pointer through its own input).
92:func _input(event: InputEvent) -> void:
93:	if devices and int(view.get("stage")) < 0 and event is InputEventMouseMotion:
94:		_mouse += (event as InputEventMouseMotion).relative
95:		get_viewport().set_input_as_handled()
96:
97:
98:func _process(_delta: float) -> void:
99:	if not devices or not is_inside_tree():
100:		return
101:	var want: bool = int(view.get("stage")) < 0 and get_window().has_focus() and _script.is_empty()
102:	if want != _captured:
103:		_captured = want
104:		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED if want else Input.MOUSE_MODE_VISIBLE
105:
106:
107:func _notification(what: int) -> void:
108:	if what == NOTIFICATION_APPLICATION_FOCUS_OUT and _captured:
109:		_captured = false
110:		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
111:
112:
113:## The sampling line, once per world tick: the device script's events of this tick, the pointer, then the latch.
114:func sample(tick: int) -> void:
115:	# T-PATCHES M4: the engine lets go of every pressed key when another window takes the focus; a key the device
116:	# script still holds is pressed again here (a person's own keys are the person's: only scripted ones)
117:	for k: Variant in _held.keys():
118:		if not Input.is_physical_key_pressed(int(k)):
119:			var again: InputEventKey = InputEventKey.new()
120:			again.keycode = int(k)
121:			again.physical_keycode = int(k)
122:			again.pressed = true
123:			Input.parse_input_event(again)
124:	for e: Array in _script.get(tick, []):
125:		match str(e[0]):
126:			"key":
127:				var ev: InputEventKey = InputEventKey.new()
128:				ev.keycode = OS.find_keycode_from_string(str(e[1]))
129:				ev.physical_keycode = ev.keycode
130:				ev.pressed = int(e[2]) != 0
131:				Input.parse_input_event(ev)
132:				if ev.pressed:
133:					_held[ev.keycode] = true
134:				else:
135:					_held.erase(ev.keycode)
136:			"move":
137:				var mv: InputEventMouseMotion = InputEventMouseMotion.new()
138:				mv.relative = Vector2(float(e[1]), float(e[2]))
139:				Input.parse_input_event(mv)
140:			"mark":
141:				print_path(tick, str(e[1]))
142:			"trace":
143:				(view.get("visitor") as Node).set("trace_frames", int(e[1]))
144:	Input.flush_buffered_events()
145:	if devices and _mouse != Vector2.ZERO:
146:		input.press(TLInput.LOOK_X, _mouse.x)
147:		input.press(TLInput.LOOK_Y, _mouse.y)
148:	_mouse = Vector2.ZERO
149:	input._sample()
150:	_ticks += 1
151:
152:
153:## Below the line: where he goes and looks, enter, leave, quit. Reads `input` only.
154:func steer(tick: int) -> void:
155:	var sched: RefCounted = world.get("sched")
156:	var vis: Node3D = view.get("visitor")
157:	if int(view.get("stage")) >= 0:
158:		if vis.get("space") != null:
159:			vis.call("wish", Vector3.ZERO, false, false)     # walker-feel: on stage the walker's keys are not his
160:		# K8: on stage a key the game declared is the game's: Q leaves only a game that does not use Q; Esc always leaves
161:		if input.just_pressed(&"quit") or (input.just_pressed(&"leave") and not stage_uses_key(KEY_Q)):
162:			sched.call("request", "leave")
163:		return
164:	if input.just_pressed(&"quit"):
165:		# the walk ends at the next tick: every pack still running is finished and hashed (world.gd `_walk_tick`)
166:		print("[visit] the visitor quit at tick %d" % tick)
167:		world.set("walk_ticks", int(world.get("tick")))
168:		return
169:	if input.just_pressed(&"enter"):
170:		sched.call("request", "enter")
171:	vis.call("turn", input.strength(TLInput.LOOK_X) * deg_to_rad(LOOK_DEG_PER_PX), input.strength(TLInput.LOOK_Y) * deg_to_rad(LOOK_DEG_PER_PX),
172:		deg_to_rad(PITCH_MIN_DEG), deg_to_rad(PITCH_MAX_DEG))
173:	var yaw: float = float(vis.get("look_yaw"))
174:	var fwd: Vector3 = Vector3(-sin(yaw), 0.0, -cos(yaw))
175:	var right: Vector3 = Vector3(cos(yaw), 0.0, -sin(yaw))
176:	var move: Vector3 = fwd * input.axis(&"back", &"forward") + right * input.axis(&"left", &"right")
177:	var pace: float = RUN_MPS if input.pressed(&"run") else WALK_MPS
178:	# walker-feel: the body has weight (visitor.gd `wish`, world_space.gd `drive`): it eases toward this velocity
179:	var want: Vector3 = move.normalized() * pace if move.length() > 0.01 else Vector3.ZERO
180:	if vis.get("space") != null:
181:		vis.call("wish", want, input.just_pressed(&"jump"), input.just_pressed(&"slide"))
182:	elif move.length() > 0.01:
183:		world.set("player_pos", (world.get("player_pos") as Vector3) + want / 60.0)
184:	if tick % PATH_EVERY == 0:
185:		print_path(tick)
186:
187:
188:## K8. True while a game is on stage and it declared an action on the physical key `keycode` (its own TLInput's
189:## declarations: the host never reads the game's devices for this). Such a key is the game's, not the host's.
190:func stage_uses_key(keycode: int) -> bool:
191:	if _stage_rec.size() < 2 or not is_instance_valid(_stage_rec[1]):
192:		return false
193:	return bool((_stage_rec[1] as TLInput).call("_declares_key", keycode))
194:
195:
196:## K8. The keys hint for the game on stage: "Esc  leave the game" when the game uses Q, else "Q or Esc  leave the game".
197:func stage_hint() -> String:
198:	return "Esc  leave the game" if stage_uses_key(KEY_Q) else "Q or Esc  leave the game"
199:
200:
201:func print_path(tick: int, mark: String = "") -> void:
202:	var vis: Node3D = view.get("visitor")
203:	var f: Vector3 = vis.get("feet")
204:	var line: Dictionary = {"schema": "tl.view/1", "kind": "visit_path", "tick": tick, "feet": [snappedf(f.x, 0.01), snappedf(f.y, 0.01), snappedf(f.z, 0.01)],
205:		"yaw_deg": snappedf(rad_to_deg(float(vis.get("look_yaw"))), 0.01), "pitch_deg": snappedf(rad_to_deg(float(vis.get("look_pitch"))), 0.01),
206:		"stage": int(view.get("stage")), "mark": mark}
207:	# walker-feel: how high the camera stands over the ground under it, and the body's mode (a mark only)
208:	var sp: RefCounted = vis.get("space")
209:	var cam: Camera3D = vis.get("cam")
210:	if not mark.is_empty() and sp != null and cam != null and int(view.get("stage")) < 0:
211:		var c: Vector3 = cam.global_position
212:		var g: float = sp.call("ground_at", c.x, c.z, c.y + 60.0)
213:		if not is_nan(g):
214:			line["cam_over_ground_m"] = snappedf(c.y - g, 0.01)
215:		line["body"] = str(vis.get("mode"))
216:		var pq: PhysicsPointQueryParameters3D = PhysicsPointQueryParameters3D.new()
217:		pq.position = c
218:		pq.collision_mask = 4                          # a tree's crown (world_space CANOPY)
219:		line["cam_in_crown"] = not PhysicsServer3D.space_get_direct_state(sp.get("space")).intersect_point(pq, 1).is_empty()
220:	print(JSON.stringify(line, "", false))
221:
222:
223:## The stage changes from `was` to `now` (-1: nobody). A person plays the game on stage: its bot waits and its input
224:## comes from the devices (recorded) or from the record of that visit (replay).
225:func stage(was: int, now: int, holders: Array, plots: Array, radii: Array) -> void:
226:	if was >= 0 and was != now:
227:		var h: Node = holders[was]
228:		h.set("bot_off", false)
229:		var ctx: TLContext = h.get("ctx")
230:		if ctx != null and ctx.input != null:
231:			ctx.input.accept_devices = false
232:			ctx.input.set("_play", null)
233:		_close_stage_record(holders)
234:		if now < 0:
235:			_to_gate(was, plots, radii)
236:	if now < 0:
237:		return
238:	var hn: Node = holders[now]
239:	hn.set("bot_off", true)
240:	var c: TLContext = hn.get("ctx")
241:	if c == null or c.input == null:
242:		return
243:	if not _stage_rec.is_empty() and _stage_rec[1] == c.input:
244:		return                                   # the same game, told again (a rebuilt holder says it twice)
245:	_close_stage_record(holders)
246:	var id: String = str(((world.get("plot_defs") as Array)[now] as Dictionary)["id"])
247:	_visits[id] = int(_visits.get(id, 0)) + 1
248:	var key: String = "%s.%d" % [id, int(_visits[id])]
249:	if devices:
250:		c.input.accept_devices = true
251:		_stage_rec = [now, c.input, c.input._record() if not record_path.is_empty() else null, key]
252:	else:
253:		var fr: Array = (_stage_feeds[key] as Dictionary)["frames"] if _stage_feeds.has(key) else []
254:		c.input._feed(fr)
255:		_stage_rec = [now, c.input, null, key]
256:
257:
258:func _close_stage_record(holders: Array) -> void:
259:	if _stage_rec.is_empty():
260:		return
261:	if not is_instance_valid(_stage_rec[1]):
262:		# the game was rebuilt from its seed while on stage (its next round): its input went with it. What was
263:		# recorded of this visit is written as it is. (Walker-feel round 2: typing a freed input was a SCRIPT ERROR.)
264:		if _stage_rec[2] != null and not record_path.is_empty():
265:			var h0: Variant = holders[int(_stage_rec[0])]
266:			var m0: Dictionary = h0.get("manifest") if is_instance_valid(h0) else {}
267:			Session.call("write", record_path.trim_suffix(".json") + "." + str(_stage_rec[3]) + ".json", {"schema": Session.SCHEMA,
268:				"pack": str(m0.get("id", "")), "seed": int(h0.get("seed_value")) if is_instance_valid(h0) else 1, "mode": "play",
269:				"max_frames": int(h0.get("frames_target")) if is_instance_valid(h0) else (_stage_rec[2] as Array).size(),
270:				"length": (_stage_rec[2] as Array).size(), "end": "step", "frames": _stage_rec[2]})
271:		_stage_rec = []
272:		return
273:	var inp: TLInput = _stage_rec[1]
274:	if is_instance_valid(inp) and _stage_rec[2] != null:
275:		inp.set("_rec", null)
276:		var h: Node = holders[int(_stage_rec[0])]
277:		var m: Dictionary = h.get("manifest")
278:		var err: String = Session.call("write", record_path.trim_suffix(".json") + "." + str(_stage_rec[3]) + ".json", {"schema": Session.SCHEMA,
279:			"pack": str(m.get("id", "")), "seed": int(h.get("seed_value")), "mode": "play", "max_frames": int(h.get("frames_target")),
280:			"length": int(inp.get("_ticks")), "end": "step", "frames": _stage_rec[2]})
281:		if not err.is_empty():
282:			print("[visit] " + err)
283:	_stage_rec = []
284:
285:
286:## After Q: outside the plot at its gate (the side that faces the road), facing away from the venue.
287:func _to_gate(i: int, plots: Array, radii: Array) -> void:
288:	var o: Vector3 = (plots[i] as Transform3D).origin
289:	var g: Vector2 = _gate_dir(Vector2(o.x, o.z))
290:	var at: Vector3 = Vector3(o.x + g.x * (float(radii[i]) + GATE_OUT_M), 0.0, o.z + g.y * (float(radii[i]) + GATE_OUT_M))
291:	var vis: Node3D = view.get("visitor")
292:	vis.call("put", at, atan2(-g.x, -g.y))
293:	world.set("player_pos", Vector3(at.x, 0.0, at.z))
294:	var f: Vector3 = vis.get("feet")
295:	var gap: float = Vector2(f.x - o.x, f.z - o.z).length() - float(radii[i])
296:	print(JSON.stringify({"schema": "tl.view/1", "kind": "visit_left", "tick": int(world.get("tick")), "plot": i, "feet": [snappedf(f.x, 0.01), snappedf(f.y, 0.01), snappedf(f.z, 0.01)],
297:		"outside_edge_m": snappedf(gap, 0.01), "gate": [snappedf(g.x, 0.001), snappedf(g.y, 0.001)], "yaw_deg": snappedf(rad_to_deg(float(vis.get("look_yaw"))), 0.01)}, "", false))
298:
299:
300:## The direction from a plot's centre to the nearest point of the walk's road (the landscape puts the gate there).
301:func _gate_dir(c: Vector2) -> Vector2:
302:	var road: Array = (world.get("walk") as Dictionary).get("road", [])
303:	var best: Vector2 = Vector2.ZERO
304:	var bd: float = INF
305:	for k: int in range(road.size() - 1):
306:		var a: Vector2 = Vector2(float(road[k][0]), float(road[k][1]))
307:		var b: Vector2 = Vector2(float(road[k + 1][0]), float(road[k + 1][1]))
308:		var p: Vector2 = Geometry2D.get_closest_point_to_segment(c, a, b)
309:		if p.distance_to(c) < bd:
310:			bd = p.distance_to(c)
311:			best = p
312:	return (best - c).normalized() if bd < INF and bd > 0.01 else Vector2(0.0, 1.0)
313:
314:
315:## The world ended: the records are written.
316:func finish() -> void:
317:	_close_stage_record(world.get("packs"))
318:	if devices and _captured:
319:		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
320:	print_path(int(world.get("tick")))
321:	if record_path.is_empty() or _rec == null:
322:		return
323:	var walk: Dictionary = world.get("walk")
324:	var err: String = Session.call("write", record_path, {"schema": Session.SCHEMA, "pack": str(walk.get("name", "walk")), "seed": 1,
325:		"mode": "play", "max_frames": int(world.get("walk_ticks")), "length": _ticks, "end": "step", "frames": _rec})
326:	print(JSON.stringify({"schema": "tl.view/1", "kind": "visit_record", "out": record_path, "ok": err.is_empty(), "length": _ticks, "error": err}, "", false))

