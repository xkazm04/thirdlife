215:		if i < pad_in.size():
216:			pads.append(pad_in[i])
217:	for d: Dictionary in dropped:
218:		print("[boot] plot '%s' is left out: %s" % [str(d["id"]), str(d["why"])])
219:	if plots.is_empty():
220:		_stop("no game was found: %s holds none of the games of the village (%s). The folder 'games' must stand beside ThirdLife.exe." % [
221:			games_dir if not games_dir.is_empty() else "the engine", ", ".join(PackedStringArray(dropped.map(func(d: Dictionary) -> String: return str(d["pack"]))))], 2)
222:		return ""
223:	walk["plots"] = plots
224:	if land.has("pad_h"):
225:		land["pad_h"] = pads
226:	_site_lots(land)
227:	if not dropped.is_empty():
228:		# a scripted `enter` that names a plot which is not there would be refused; without a name it enters where he stands
229:		var evs: Array = []
230:		for ev: Variant in walk.get("events", []):
231:			var gone: bool = false
232:			for d: Dictionary in dropped:
233:				gone = gone or (typeof(ev) == TYPE_DICTIONARY and str((ev as Dictionary).get("plot", "")) == str(d["id"]))
234:			if not gone:
235:				evs.append(ev)
236:		walk["events"] = evs
237:	if opts.has("ticks") and str(opts["ticks"]).is_valid_int():
238:		walk["ticks"] = int(opts["ticks"])
239:	if opts.has("edits"):
240:		# S3: a test instrument (the walk's `edits`, kernel/world/jobs.gd): [[world tick, file, replacement file]]
241:		# from a JSON file; a file is copied over another at a tick, so a "job that grows" is a function of the ticks
242:		var ed: Variant = JSON.parse_string(FileAccess.get_file_as_string(str(opts["edits"])))
243:		if typeof(ed) == TYPE_ARRAY:
244:			walk["edits"] = ed
245:		else:
246:			print("[boot] warning: --edits=%s is not a JSON list of [tick, file, replacement]: no edits" % str(opts["edits"]))
247:	var dir_out: String = OS.get_user_data_dir().replace("\\", "/") + "/boot"
248:	DirAccess.make_dir_recursive_absolute(dir_out)
249:	_walk_tmp = "%s/village_%d.json" % [dir_out, OS.get_process_id()]
250:	var f: FileAccess = FileAccess.open(_walk_tmp, FileAccess.WRITE)
251:	if f == null:
252:		_stop("cannot write the walk to %s (error %d)" % [_walk_tmp, FileAccess.get_open_error()], 2)
253:		return ""
254:	f.store_string(JSON.stringify(walk, "", false) + "\n")
255:	f.close()
256:	return _walk_tmp
257:
258:
259:## S (engine-world-next): a lot of the village with a `job` is a construction site (kernel/world/site.gd). In the
260:## exe its job is the folder `sites/<job folder name>` beside `games/` (export.sh copies the job's job.jsonl and its
261:## last promoted game there); the editor binary with --games looks beside that folder too, without it the job
262:## directory of the walk is used as it is (relative to the repository). A job that is not found leaves a plain
263:## building site, said on the log (like a game that is not there).
264:func _site_lots(land: Dictionary) -> void:
265:	for k: int in (land.get("lots", []) as Array).size():
266:		var lot: Variant = (land["lots"] as Array)[k]
267:		if typeof(lot) != TYPE_DICTIONARY or not (lot as Dictionary).has("job"):
268:			continue
269:		var job: String = str((lot as Dictionary)["job"]).replace("\\", "/").trim_suffix("/")
270:		var dir: String = job
271:		if not games_dir.is_empty():
272:			dir = games_dir.get_base_dir() + "/sites/" + job.get_file()
273:		elif not job.is_absolute_path():
274:			dir = ProjectSettings.globalize_path("res://").replace("\\", "/").trim_suffix("/").get_base_dir() + "/" + job
275:			var wt: int = dir.find("/.claude/worktrees/")
276:			if wt >= 0 and not FileAccess.file_exists(dir + "/job.jsonl"):
277:				dir = dir.substr(0, wt) + "/" + job           # site/ (job output) is in the main checkout only
278:		if opts.has("site-job") and kept_sites.is_empty():
279:			# S2: a person points the first site lot at a job that is running now (an absolute job directory)
280:			var live: String = str(opts["site-job"]).trim_suffix("/")
281:			if live.is_absolute_path() and FileAccess.file_exists(live + "/job.jsonl"):
282:				print("[boot] lot %d follows the job %s live (--site-job)" % [k, live])
283:				dir = live
284:				job = live
285:				(lot as Dictionary).erase("replay")
286:			else:
287:				print("[boot] warning: --site-job=%s is not an absolute job directory with a job.jsonl: lot %d shows %s" % [live, k, dir])
288:		if FileAccess.file_exists(dir + "/job.jsonl"):
289:			(lot as Dictionary)["job"] = dir
290:			kept_sites.append({"lot": k, "job": job.get_file(), "dir": dir})
291:		else:
292:			(lot as Dictionary).erase("job")
293:			(lot as Dictionary).erase("replay")
294:			dropped.append({"id": "lot %d" % k, "pack": job.get_file(), "why": "no job log at %s/job.jsonl: a plain building site" % dir})
295:			print("[boot] lot %d is a plain building site: its job '%s' has no job.jsonl at %s" % [k, job, dir])
296:
297:
298:func _exit_tree() -> void:
299:	if _frames_log != null:
300:		_frames_log.flush()
301:	if not _walk_tmp.is_empty() and FileAccess.file_exists(_walk_tmp):
302:		DirAccess.remove_absolute(_walk_tmp)
303:
304:
305:func _identity() -> Dictionary:
306:	var v: Dictionary = Engine.get_version_info()
307:	var id: Dictionary = {"schema": "thirdlife.exe/1", "kind": "boot", "verb": verb if not verb.is_empty() else "visit", "exported": exported(),
308:		"godot": str(v.get("string", "")), "executable": OS.get_executable_path().replace("\\", "/"), "games": games_dir,
309:		"display": DisplayServer.get_name(), "user_dir": OS.get_user_data_dir().replace("\\", "/"), "plots": kept, "sites": kept_sites, "left_out": dropped}
310:	if not tag.is_empty():
311:		id["build"] = tag                          # absent value: the key is left out
312:	return id
313:
314:
315:# ------------------------------------------------------------------------------------------------ a person walks
316:func _visit() -> void:
317:	_capture_path = _win_path(OS.get_environment("TL_EXE_CAPTURE")) if OS.has_environment("TL_EXE_CAPTURE") else ""
318:	if OS.has_environment("TL_EXE_QUIT_AT") and OS.get_environment("TL_EXE_QUIT_AT").is_valid_int():
319:		_quit_at = int(OS.get_environment("TL_EXE_QUIT_AT"))
320:	if OS.has_environment("TL_EXE_CAPTURE_AT") and OS.get_environment("TL_EXE_CAPTURE_AT").is_valid_int():
321:		_capture_at = int(OS.get_environment("TL_EXE_CAPTURE_AT"))
322:	for part: String in OS.get_environment("TL_EXE_KEYS").split(";", false):
323:		var f: PackedStringArray = part.strip_edges().split(":")
324:		if f.size() == 2 and f[0].is_valid_int() and f[1].begins_with("~") and f[1].substr(1).split(",").size() == 2:
325:			var xy: PackedStringArray = f[1].substr(1).split(",")
326:			if not _keys.has(int(f[0])):
327:				_keys[int(f[0])] = []
328:			(_keys[int(f[0])] as Array).append(["move", Vector2(float(xy[0]), float(xy[1]))])
329:			continue
330:		var code: Key = OS.find_keycode_from_string(f[1].substr(1)) if f.size() == 2 and f[1].length() > 1 else KEY_NONE
331:		if f.size() == 2 and f[0].is_valid_int() and code != KEY_NONE and (f[1][0] == "+" or f[1][0] == "-"):
332:			if not _keys.has(int(f[0])):
333:				_keys[int(f[0])] = []
334:			(_keys[int(f[0])] as Array).append([f[1][0] == "+", code])
335:		else:
336:			print("[boot] TL_EXE_KEYS: cannot read '%s' (wanted <frame>:+<Key> or <frame>:-<Key>)" % part)
337:	_unattended = not _capture_path.is_empty() or _quit_at >= 0 or not _keys.is_empty()
338:	if DisplayServer.get_name() == "headless":
339:		_stop("the village needs a window (started headless); `-- check --out=<file>` is the run without one", 2)
340:		return
341:	if OS.has_environment("TL_EXE_WINDOW_POS"):
342:		var xy: PackedStringArray = OS.get_environment("TL_EXE_WINDOW_POS").split(",")
343:		if xy.size() == 2 and xy[0].is_valid_int() and xy[1].is_valid_int():
344:			DisplayServer.window_set_position(Vector2i(int(xy[0]), int(xy[1])))
345:	get_window().title = "Third Life"
346:	# the project runs windows without vsync (captures and benches); a person's window follows the screen
347:	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_ENABLED)
348:	var path: String = _make_walk()
349:	if path.is_empty():
350:		return
351:	print(JSON.stringify(_identity(), "", false))
352:	get_tree().auto_accept_quit = false            # closing the window ends the world cleanly (see _notification)
353:	view = (load(VIEW_SCRIPT) as GDScript).new()
354:	view.name = "WorldView"
355:	add_child(view)
356:	var vo: Dictionary = {"walk": path, "live": "true"}
357:	if OS.get_environment("TL_EXE_WARM") == "1":
358:		vo.erase("live")                           # P14: the scripted tour, to its end (export.sh fills the shipped cache)
359:	for k: String in ["record", "input"]:
360:		if opts.has(k):
361:			vo[k] = opts[k]
362:	view.call("start", vo)
363:	world = view.get("world")
364:	if view.get("draw") == null:
365:		# the viewer said why on the log and asked the tree to quit; a person gets the reason in a box
366:		var why: String = "the world did not load"
367:		if world != null:
368:			if not str(world.get("refused")).is_empty():
369:				why = str(world.get("refused"))
370:			elif not (world.get("errors") as Array).is_empty():
371:				why = "; ".join(PackedStringArray(world.get("errors")))
372:		_stop("Third Life could not start: %s. What it printed is in ThirdLife-last-run.log beside ThirdLife.exe." % why, 1)
373:		return
374:	var layer: CanvasLayer = CanvasLayer.new()
375:	layer.name = "BootHint"
376:	layer.layer = 100
377:	add_child(layer)
378:	_hint = Label.new()
379:	_hint.text = KEYS_WALK
380:	_hint.add_theme_font_size_override("font_size", 22)
381:	_hint.add_theme_color_override("font_color", Color(1, 1, 1, 0.95))
382:	_hint.add_theme_color_override("font_outline_color", Color(0.05, 0.05, 0.08, 0.9))
383:	_hint.add_theme_constant_override("outline_size", 6)
384:	_hint.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_LEFT)
385:	_hint.position = Vector2(28, get_viewport().get_visible_rect().size.y - 58)
386:	layer.add_child(_hint)
387:	if not tag.is_empty():
388:		# which build is this: small, in the top right corner, in the key line's look
389:		var tl: Label = Label.new()
390:		tl.name = "BuildTag"
391:		tl.text = tag
392:		tl.add_theme_font_size_override("font_size", 14)
393:		tl.add_theme_color_override("font_color", Color(1, 1, 1, 0.6))
394:		tl.add_theme_color_override("font_outline_color", Color(0.05, 0.05, 0.08, 0.7))
395:		tl.add_theme_constant_override("outline_size", 4)
396:		tl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
397:		tl.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT)
398:		tl.offset_left = -360
399:		tl.offset_right = -14
400:		tl.offset_top = 10
401:		layer.add_child(tl)
402:	if OS.has_environment("TL_EXE_TRACE"):
403:		_trace = FileAccess.open(_win_path(OS.get_environment("TL_EXE_TRACE")), FileAccess.WRITE)
404:	if OS.has_environment("TL_EXE_FRAMES"):
405:		_frames_dir = _win_path(OS.get_environment("TL_EXE_FRAMES"))
406:		var fr: PackedStringArray = OS.get_environment("TL_EXE_FRAMES_RANGE").split(":")
407:		if fr.size() == 2 and fr[0].is_valid_int() and fr[1].is_valid_int():
408:			_frames_range = Vector2i(int(fr[0]), int(fr[1]))
409:		DirAccess.make_dir_recursive_absolute(_frames_dir)
410:		_frames_log = FileAccess.open(_frames_dir + "/frames.jsonl", FileAccess.WRITE)
411:		RenderingServer.frame_post_draw.connect(_frame_drawn)
412:		if OS.get_environment("TL_EXE_SKYMASK") == "1":
413:			_sky_mask()
414:	process_physics_priority = 200000              # after the viewer (100000): its `stage` of this tick is known
415:	set_physics_process(true)
416:
417:
418:func _notification(what: int) -> void:
419:	if what == NOTIFICATION_WM_CLOSE_REQUEST and view != null:
420:		_end_world()
421:
422:
423:## Ends the world the way a scripted run ends: the world host stops its watchdog and its helper process, prints its
424:## lines, and the viewer quits the tree with the world's exit code.
425:func _end_world() -> void:
426:	if _ending:
427:		return
428:	_ending = true
429:	set_physics_process(false)
430:	if world != null and is_instance_valid(world) and not bool(world.get("_ended")):
431:		print("[boot] ending the world at frame %d" % _frame)
432:		world.call("_end")
433:	else:
434:		get_tree().quit(0)
435:
436:
437:func _physics_process(_delta: float) -> void:
438:	_frame += 1
439:	# M2-PATCHES 2: a key TL_EXE_KEYS holds is pressed again when the engine let go of it (another window took the focus)
440:	for k: Variant in _keys_held.keys():
441:		if not Input.is_physical_key_pressed(int(k)):
442:			var again: InputEventKey = InputEventKey.new()
443:			again.keycode = int(k)
444:			again.physical_keycode = int(k)
445:			again.pressed = true
446:			Input.parse_input_event(again)
447:	if _frame == 2:
448:		_set_aa(OS.get_environment("TL_EXE_AA") if not OS.get_environment("TL_EXE_AA").is_empty() else EXE_AA)
449:	for k: Array in _keys.get(_frame, []):
450:		if str(k[0]) == "move":
451:			var mv: InputEventMouseMotion = InputEventMouseMotion.new()
452:			mv.relative = k[1]
453:			Input.parse_input_event(mv)
454:			continue
455:		var ev: InputEventKey = InputEventKey.new()
456:		ev.keycode = k[1]
457:		ev.physical_keycode = k[1]
458:		ev.pressed = bool(k[0])
459:		Input.parse_input_event(ev)
460:		if bool(k[0]):
461:			_keys_held[int(k[1])] = true
462:		else:
463:			_keys_held.erase(int(k[1]))
464:	var stage: int = int(view.get("stage"))
465:	if _trace != null and _frame % 30 == 0:
466:		var pos: Vector3 = world.get("player_pos")
467:		var feet: Vector3 = (view.get("visitor") as Node3D).get("feet")
468:		_trace.store_line(JSON.stringify({"frame": _frame, "world_tick": int(world.get("tick")), "stage": stage,
469:			"pos": [snappedf(pos.x, 0.01), snappedf(pos.z, 0.01)], "feet": [snappedf(feet.x, 0.01), snappedf(feet.y, 0.01), snappedf(feet.z, 0.01)],
470:			"yaw_deg": snappedf(rad_to_deg(float((view.get("visitor") as Node3D).get("look_yaw"))), 0.01)}, "", false))
471:		_trace.flush()
472:	if _hint != null:
473:		_hint.text = (str(view.get("visit").call("stage_hint")) if view.get("visit") != null else KEYS_STAGE) if stage >= 0 else KEYS_WALK   # K8: Esc alone when the game uses Q
474:		_hint.position.y = get_viewport().get_visible_rect().size.y - 58
475:	if not _capture_path.is_empty() and not _capture_done and _frame >= _capture_at:
476:		_capture_done = true
477:		_capture()
478:	if _quit_at >= 0 and _frame >= _quit_at and (_capture_path.is_empty() or _captured):
479:		_end_world()
480:
481:
482:func _capture() -> void:
483:	for i: int in 3:
484:		await RenderingServer.frame_post_draw
485:	var img: Image = get_viewport().get_texture().get_image()
486:	DirAccess.make_dir_recursive_absolute(_capture_path.get_base_dir())
487:	var err: Error = img.save_png(_capture_path)
488:	print(JSON.stringify({"schema": "thirdlife.exe/1", "kind": "capture", "out": _capture_path, "saved": err == OK, "frame": _frame,
489:		"width": img.get_width(), "height": img.get_height(), "driver": RenderingServer.get_current_rendering_driver_name(),
490:		"adapter": RenderingServer.get_video_adapter_name()}, "", false))
491:	_captured = true
492:
493:
494:## Walker-feel T1 (a test instrument): TL_EXE_FRAMES=<abs dir> writes every drawn frame while the physics frame lies
495:## in TL_EXE_FRAMES_RANGE=<from>:<to>, numbered in the order drawn (<dir>/f<n>.raw: RGB8 bytes, every other pixel of
496:## the window, so 960x540 for 1920x1080; a raw copy costs a few milliseconds where a PNG costs 200, so the run keeps
497:## the wall-clock pace a person meets), and one line per picture in <dir>/frames.jsonl (the physics frame, the
498:## size, the camera's place and look, the stage). The blink detector (kernel/world/walks/blink_detect.py) reads it.
499:var _frames_dir: String = ""
500:var _frames_range: Vector2i = Vector2i(1, 1200)
501:var _frames_log: FileAccess = null
502:var _frames_n: int = 0
503:
504:
505:## Walker-feel T3: the window's antialiasing, set at physics frame 2 (after the style set its own): EXE_AA, or
506:## TL_EXE_AA="msaa=2,ss=smaa,taa=0" (a test instrument): msaa 0/2/4/8, ss off/fxaa/smaa, taa 0/1. Prints what was set.
507:func _set_aa(spec: String) -> void:
508:	var vp: Viewport = get_viewport()
509:	for part: String in spec.split(",", false):
510:		var kv: PackedStringArray = part.split("=")
511:		if kv.size() != 2:
512:			continue
513:		match kv[0]:
514:			"msaa": vp.msaa_3d = {"0": Viewport.MSAA_DISABLED, "2": Viewport.MSAA_2X, "4": Viewport.MSAA_4X, "8": Viewport.MSAA_8X}.get(kv[1], vp.msaa_3d)
515:			"ss": vp.screen_space_aa = {"off": Viewport.SCREEN_SPACE_AA_DISABLED, "fxaa": Viewport.SCREEN_SPACE_AA_FXAA, "smaa": Viewport.SCREEN_SPACE_AA_SMAA}.get(kv[1], vp.screen_space_aa)
516:			"taa": vp.use_taa = kv[1] == "1"
517:	print(JSON.stringify({"schema": "thirdlife.exe/1", "kind": "aa", "msaa_3d": vp.msaa_3d, "screen_space_aa": vp.screen_space_aa, "taa": vp.use_taa}, "", false))
518:
519:
520:## TL_EXE_SKYMASK=1 (with TL_EXE_FRAMES): every pixel where nothing was drawn (the depth buffer still holds the far
521:## plane: sky) is painted pure magenta, so the detector reads "nothing drawn here" exactly instead of guessing sky by
522:## its colour. An instrument only: the picture is otherwise the same.
523:func _sky_mask() -> void:
524:	var sh: Shader = Shader.new()
525:	sh.code = """shader_type spatial;
526:render_mode unshaded, blend_mix, depth_draw_never, depth_test_disabled, skip_vertex_transform, cull_disabled, fog_disabled;
527:uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
528:void vertex() { POSITION = vec4(VERTEX.xy, 1.0, 1.0); }
529:void fragment() {
530:	if (texture(depth_tex, SCREEN_UV).r > 0.0) { discard; }
531:	ALBEDO = vec3(1.0, 0.0, 1.0);
532:}
533:"""
534:	var mat: ShaderMaterial = ShaderMaterial.new()
535:	mat.shader = sh
536:	mat.render_priority = 127
537:	var q: QuadMesh = QuadMesh.new()
538:	q.size = Vector2(2.0, 2.0)
539:	var mi: MeshInstance3D = MeshInstance3D.new()
540:	mi.name = "SkyMask"
541:	mi.mesh = q
542:	mi.material_override = mat
543:	mi.extra_cull_margin = 16384.0
544:	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
545:	add_child(mi)
546:
547:
548:func _frame_drawn() -> void:
549:	if _frame < _frames_range.x or _frame > _frames_range.y or view == null:
550:		return
551:	var img: Image = get_viewport().get_texture().get_image()
552:	if img == null:
553:		return
554:	if img.get_format() != Image.FORMAT_RGB8:
555:		img.convert(Image.FORMAT_RGB8)
556:	if OS.get_environment("TL_EXE_FRAMES_FULL") != "1":            # T3: full size, for the antialiasing study
557:		img.resize(img.get_width() / 2, img.get_height() / 2, Image.INTERPOLATE_NEAREST)
558:	var f: FileAccess = FileAccess.open("%s/f%05d.raw" % [_frames_dir, _frames_n], FileAccess.WRITE)
559:	if f != null:
560:		f.store_buffer(img.get_data())
561:		f.close()
562:	var cam: Camera3D = get_viewport().get_camera_3d()
563:	var line: Dictionary = {"n": _frames_n, "frame": _frame, "size": [img.get_width(), img.get_height()], "stage": int(view.get("stage")),
564:		"usec": Time.get_ticks_usec()}
565:	_frames_n += 1
566:	if cam != null:
567:		var o: Vector3 = cam.global_position
568:		var fw: Vector3 = -cam.global_basis.z
569:		line["cam"] = [snappedf(o.x, 0.01), snappedf(o.y, 0.01), snappedf(o.z, 0.01)]
570:		line["look"] = [snappedf(fw.x, 0.001), snappedf(fw.y, 0.001), snappedf(fw.z, 0.001)]
571:		line["fov"] = snappedf(cam.fov, 0.01)
572:	if world != null:
573:		var pos: Vector3 = world.get("player_pos")
574:		line["player"] = [snappedf(pos.x, 0.01), snappedf(pos.z, 0.01)]
575:	_frames_log.store_line(JSON.stringify(line, "", false))
576:	if _frames_n % 60 == 0:
577:		_frames_log.flush()
578:
579:
580:# ------------------------------------------------------------------------------------------------ the check
581:## The scripted tour of the village without a window: the world host alone, as `world.sh tour <walk> --headless`
582:## runs it. Its lines (one per pack with `state_hash`) go to --out; what this build is goes to <out>.boot.json.
583:func _check() -> void:
584:	if not opts.has("out") or not str(opts["out"]).is_absolute_path():
585:		_stop("check: --out=<abs file> is required", 2)
586:		return
587:	var path: String = _make_walk()
588:	if path.is_empty():
589:		return
590:	var id_line: String = JSON.stringify(_identity(), "", false)
591:	print(id_line)
