diff --git a/docs/reports/astra-trial/d5/repro/a_camera_wall.gd b/docs/reports/astra-trial/d5/repro/a_camera_wall.gd
new file mode 100644
index 0000000000000000000000000000000000000000..3e7e3cdcf9bfee9e45719591b2ac2fd6cc1b2b8d
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_camera_wall.gd
@@ -0,0 +1,34 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_camera_wall.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var sp = Space.new()
+	# Solid wall covers z=0.2..10.2. Both look points are outside.
+	sp.add_box(Transform3D(Basis(), Vector3(0, 2, 5.2)), Vector3(20, 4, 10))
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	who.position.z = -1.0
+	cam.setup(who, {"distance": 7.0, "look_height": 1.0, "height": 1.0,
+			"avoid_margin": 0.3, "avoid_space": sp.space})
+	var st := PhysicsServer3D.space_get_direct_state(sp.space)
+	var query := PhysicsPointQueryParameters3D.new()
+	query.collision_mask = 1
+	query.position = cam.global_position
+	var control := not st.intersect_point(query).is_empty()
+	who.position.z = 0.0
+	cam.snap()
+	query.position = cam.global_position
+	var inside := not st.intersect_point(query).is_empty()
+	print("REPRO camera_wall: %s expected camera outside wall, inside at 1.2 m clearance=%s, inside at 0.2 m clearance=%s, camera z=%.2f" % ["FAIL" if inside and not control else "PASS", control, inside, cam.global_position.z])
+	cam.free()
+	who.free()
+	sp.free_all()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_on_leave.gd b/docs/reports/astra-trial/d5/repro/a_on_leave.gd
new file mode 100644
index 0000000000000000000000000000000000000000..f551cc1590fa8778db0e9bf5ceb6a2a01442b1f5
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_on_leave.gd
@@ -0,0 +1,24 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_on_leave.gd"
+extends SceneTree
+
+const Manifest = preload("res://kernel/runner/manifest.gd")
+
+func _initialize() -> void:
+	var dir := get_script().resource_path.get_base_dir().path_join("a_manifest_%d" % OS.get_process_id())
+	if DirAccess.make_dir_absolute(dir) != OK:
+		quit(2)
+		return
+	var pack: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://seeds/seed_drive/pack.json"))
+	var path := dir.path_join("pack.json")
+	for value in ["pause", "paus"]:
+		pack.on_leave = value
+		var file := FileAccess.open(path, FileAccess.WRITE)
+		file.store_string(JSON.stringify(pack))
+		file.close()
+		var result: Dictionary = Manifest.read(dir)
+		print("on_leave=%s ok=%s errors=%s" % [value, result.ok, result.errors])
+		if value == "paus":
+			print("REPRO on_leave: %s expected manifest rejection for unknown leave policy" % ["FAIL" if result.ok else "PASS"])
+	DirAccess.remove_absolute(path)
+	DirAccess.remove_absolute(dir)
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd b/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd
new file mode 100644
index 0000000000000000000000000000000000000000..d319e7cb890024723bfc60a63cd24563d754fdcf
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd
@@ -0,0 +1,22 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	cam.setup(who, {"use_velocity": true, "distance": 7.0, "follow": 1.0})
+	# Start in the setup heading (-Z), then travel the opposite way (+Z).
+	for tick in 360:
+		var direction := Vector3.FORWARD if tick < 60 else Vector3.BACK
+		who.position += direction * 0.1
+		cam._physics_process(1.0 / 60.0)
+	var ahead: float = (cam.global_position - who.global_position).dot(Vector3.BACK)
+	print("REPRO reverse_camera: %s after 300 reverse ticks, expected 7.0 m behind travel, camera %.1f m ahead" % ["PASS" if ahead < 0.0 else "FAIL", ahead])
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_snap_heading.gd b/docs/reports/astra-trial/d5/repro/a_snap_heading.gd
new file mode 100644
index 0000000000000000000000000000000000000000..ecd2951ee502e65096b8a6fdeefa970ab51e1923
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_snap_heading.gd
@@ -0,0 +1,22 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_snap_heading.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	cam.setup(who, {"distance": 8.0, "stiffness": 1.0})
+	who.position = Vector3(15, 0, 10)
+	who.rotation.y = PI / 2
+	cam.snap()
+	var behind := who.global_basis.z
+	var offset: Vector3 = cam.global_position - who.global_position
+	var back_m := offset.dot(behind)
+	print("REPRO snap_heading: %s expected 8.0 m behind the teleported target immediately, got %.1f m" % ["PASS" if is_equal_approx(back_m, 8.0) else "FAIL", absf(back_m)])
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_stage_pose.gd b/docs/reports/astra-trial/d5/repro/a_stage_pose.gd
new file mode 100644
index 0000000000000000000000000000000000000000..9740876134bdfbc2889ac106353a3c57373477d3
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_stage_pose.gd
@@ -0,0 +1,41 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_stage_pose.gd"
+extends SceneTree
+
+const Visitor = preload("res://kernel/world/visitor.gd")
+const Space = preload("res://kernel/world/terrain/world_space.gd")
+
+class View extends Node3D:
+	var world: Node
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var view := View.new()
+	root.add_child(view)
+	var land := Node3D.new()
+	view.add_child(land)
+	var sp = Space.new()
+	sp.add_box(Transform3D(Basis(), Vector3(0, -0.5, 0)), Vector3(100, 1, 100))
+	land.set_meta(&"tl_space", sp)
+	var visitor = Visitor.new()
+	land.add_child(visitor)
+	visitor.setup(Vector3.ZERO)
+	visitor.steer_on()
+	for tick in 61:
+		visitor.wish(Vector3(0, 0, -9), false, tick == 60)
+		visitor.step(visitor.feet, tick)
+	print("before stage: body=%s, rig=%s" % [visitor.mode, visitor.rig.clip])
+	# The view hides the visitor on stage. Leaving puts him at the gate and shows him.
+	visitor.visible = false
+	visitor.wish(Vector3.ZERO, false, false)
+	visitor.step(visitor.feet, 61)
+	visitor.put(Vector3(5, 0, 5), 0)
+	visitor.visible = true
+	for tick in range(62, 182):
+		visitor.wish(Vector3.ZERO, false, false)
+		visitor.step(visitor.feet, tick)
+	print("REPRO stage_pose: %s 120 idle ticks after return, body=%s, speed=%.1f, rig clip='%s'" % ["FAIL" if visitor.rig.clip == &"slide" else "PASS", visitor.mode, visitor.speed, visitor.rig.clip])
+	view.free()
+	sp.free_all()
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_stage_record.gd b/docs/reports/astra-trial/d5/repro/a_stage_record.gd
new file mode 100644
index 0000000000000000000000000000000000000000..377a1f33ef89e5d80cf72af996baab03293ee7be
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_stage_record.gd
@@ -0,0 +1,50 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_stage_record.gd"
+extends SceneTree
+
+const Visit = preload("res://kernel/runner/visit.gd")
+const Session = preload("res://kernel/runner/session.gd")
+
+class World extends Node:
+	var plot_defs := [{"id": "court"}]
+
+class Holder extends Node:
+	var ctx := TLContext.new()
+	var manifest := {"id": "example.court"}
+	var seed_value := 1
+	var frames_target := 100
+	var bot_off := false
+
+func _initialize() -> void:
+	var visit = Visit.new()
+	var holder := Holder.new()
+	var world := World.new()
+	visit.world = world
+	visit.devices = true
+	var base := get_script().resource_path.get_base_dir().path_join("a_record_%d" % OS.get_process_id())
+	visit.record_path = base + ".json"
+	holder.ctx.input = TLInput.new()
+	holder.ctx.input.declare(&"move")
+	visit.stage(-1, 0, [holder], [], [])
+	for tick in 10:
+		if tick == 9:
+			holder.ctx.input.tap(&"move")
+		holder.ctx.input._sample()
+	var entries: Array = visit._stage_rec[2]
+	print("sampled frames=%d, recorded entries=%s" % [holder.ctx.input._ticks, str(entries)])
+	# A next round replaces the holder and its input while the same plot is on stage.
+	holder.ctx.input.free()
+	holder.free()
+	var next := Holder.new()
+	next.ctx.input = TLInput.new()
+	visit.stage(0, 0, [next], [], [])
+	var sidecar := base + ".court.1.json"
+	var got: Dictionary = Session.read(sidecar)
+	var length_read: int = got.get("record", {}).get("length", -1)
+	print("REPRO stage_record: %s expected first round sidecar with length 10, file exists=%s" % ["PASS" if length_read == 10 else "FAIL", FileAccess.file_exists(sidecar)])
+	if FileAccess.file_exists(sidecar):
+		DirAccess.remove_absolute(sidecar)
+	next.ctx.input.free()
+	next.free()
+	visit.free()
+	world.free()
+	quit()

