270:
271:## Probes (a walk's `visitor_probe`): the body is put at `from`, told to walk to `to`, and the line says where it ended.
272:## `{"name", "from": [x, z], "to": [x, z], "expect": "stop" | "pass"}`; the element "auto" adds a tree, a rock and the
273:## bridge's rail from the landscape (the first of each on gentle ground). `stop`: the body must end more than 0.5 m
274:## short of `to`, `pass`: within 0.3 m. Results are printed as `tl.view/1` lines of kind `visitor_probe`; the body is put back.
275:func _run_probes(list: Array, auto: Dictionary, back_to: Vector3) -> void:
276:	var probes: Array = []
277:	for p: Variant in list:
278:		if typeof(p) == TYPE_STRING and str(p) == "auto":
279:			if auto.has("tree"):
280:				var t: Array = auto["tree"]
281:				probes.append({"name": "tree", "from": [float(t[0]) - 6.0, float(t[1])], "to": [float(t[0]) + 6.0, float(t[1])], "expect": "stop"})
282:			if auto.has("rock"):
283:				var r: Array = auto["rock"]
284:				probes.append({"name": "rock", "from": [float(r[0]) - 6.0, float(r[1])], "to": [float(r[0]) + 6.0, float(r[1])], "expect": "stop"})
285:			if auto.has("rail"):
286:				var b: Array = auto["rail"]
287:				probes.append({"name": "bridge_rail", "from": [float(b[0]), float(b[1])], "to": [float(b[0]) + float(b[2]) * 8.0, float(b[1]) + float(b[3]) * 8.0], "expect": "stop"})
288:		elif typeof(p) == TYPE_DICTIONARY and (p as Dictionary).has("t") and int((p as Dictionary)["t"]) > 0 and back_to != Vector3.INF:
289:			_later.append(p)                        # S2: at its world tick (a site's scaffold before and after its game arrives)
290:		elif typeof(p) == TYPE_DICTIONARY:
291:			probes.append(p)
292:	for pr: Dictionary in probes:
293:		var f: Array = pr["from"]
294:		var to: Array = pr["to"]
295:		var g: float = space.call("ground_at", float(f[0]), float(f[1]), 120.0)
296:		var pos: Vector3 = Vector3(float(f[0]), 0.0 if is_nan(g) else g, float(f[1]))
297:		space.call("place", pos)
298:		var settle: Dictionary = space.call("walk", pos, Vector3.ZERO)
299:		pos = settle["pos"]
300:		var target: Vector2 = Vector2(float(to[0]), float(to[1]))
301:		var still: int = 0
302:		var steps: int = 0
303:		var hit: String = "none"
304:		while steps < 900:
305:			steps += 1
306:			var want: Vector2 = target - Vector2(pos.x, pos.z)
307:			if want.length() < 0.05:
308:				break
309:			if want.length() > 0.12:
310:				want = want.normalized() * 0.12
311:			var res: Dictionary = space.call("walk", pos, Vector3(want.x, 0.0, want.y))
312:			var np: Vector3 = res["pos"]
313:			if Vector2(np.x - pos.x, np.z - pos.z).length() < 0.01:
314:				still += 1
315:			else:
316:				still = 0
317:			if bool(res["blocked"]):
318:				hit = str((space.get("last_hit") as Dictionary).get("tag", "slope"))
319:			pos = np
320:			if still > 20:
321:				break
322:		var short: float = Vector2(pos.x, pos.z).distance_to(target)
323:		var expect: String = str(pr.get("expect", "stop"))
324:		var ok: bool = short > 0.5 if expect == "stop" else short < 0.3
325:		print(JSON.stringify({"schema": "tl.view/1", "kind": "visitor_probe", "name": str(pr.get("name", "")), "expect": expect, "ok": ok, "from": f, "to": to,
326:			"end": [snappedf(pos.x, 0.01), snappedf(pos.y, 0.01), snappedf(pos.z, 0.01)], "short_of_target_m": snappedf(short, 0.01), "stopped_by": hit, "ticks": steps}, "", false))
327:	space.set("blocked_ticks", 0)
328:	if back_to != Vector3.INF:
329:		space.call("place", back_to)
