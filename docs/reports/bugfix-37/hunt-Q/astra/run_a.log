49:## `opts`: the viewer's options (record, input, devices). Returns "" or why the visit cannot start.
50:func setup(v: Node, opts: Dictionary) -> String:
51:	name = "TLVisit"
52:	view = v
53:	world = v.get("world")
54:	input = TLInput.new()
55:	input.name = "VisitorInput"
56:	add_child(input)
57:	for a: Array in ACTIONS:
58:		input.declare(a[0], [a[1]])
59:	if opts.has("input"):
60:		var r: Dictionary = Session.call("read", str(opts["input"]))
61:		if not bool(r["ok"]):
62:			return str(r["error"])
63:		replay = r["record"]
64:		input._feed(replay["frames"])
65:		var base: String = str(opts["input"]).trim_suffix(".json")
66:		for f: String in DirAccess.get_files_at(base.get_base_dir()):
67:			var full: String = base.get_base_dir() + "/" + f
68:			if full.begins_with(base + ".") and f.ends_with(".json") and full != str(opts["input"]):
69:				var sr: Dictionary = Session.call("read", full)
70:				if bool(sr["ok"]):
71:					_stage_feeds[full.trim_prefix(base + ".").trim_suffix(".json")] = sr["record"]
72:	else:
73:		devices = true
74:		input.accept_devices = true
75:	if opts.has("record"):
76:		record_path = str(opts["record"])
77:		_rec = input._record()
78:	if opts.has("devices"):
79:		var j: Variant = JSON.parse_string(FileAccess.get_file_as_string(str(opts["devices"])))
80:		for e: Variant in (j if typeof(j) == TYPE_ARRAY else []):
81:			if typeof(e) == TYPE_ARRAY and (e as Array).size() == 4:
82:				var t: int = int(e[0])
83:				if not _script.has(t):
84:					_script[t] = []
85:				(_script[t] as Array).append([str(e[1]), e[2], e[3]])
86:				if str(e[1]) == "shot":
87:					shots.append({"t": t, "e": "shot", "name": str(e[2])})
88:	return ""
