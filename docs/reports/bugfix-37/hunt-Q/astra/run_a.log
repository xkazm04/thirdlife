5:## P7: API version 1. The surface a pack may use is written down by a machine (docs/generated/API-V1.json, checked by
6:## `tl arch` rule api-v1): a signature that is removed or changed needs a new major, an addition a new minor.
7:const KERNEL_API: String = "1.6"
8:## "0.1" was the name of this same surface before it was frozen: a pack that says 0.1 is run as a 1.0 pack.
9:const LEGACY_API: Dictionary = {"0.1": "1.0"}
10:const CAPABILITIES: Array = ["physics", "input", "ui", "audio", "vfx", "camera", "rules", "ai", "spawn", "fracture",
11:	"vehicle", "biped", "ball", "kit", "style"]
12:const ID_RE: String = "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
13:const KEYS: Dictionary = {
14:	"id": {"type": "string", "pattern": ID_RE, "required": true},
15:	"version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "required": true},
16:	"kernelApi": {"type": "string", "pattern": "^\\d+\\.\\d+$", "required": true},
17:	"title": {"type": "string", "min": 1, "max": 80, "required": true},
18:	"capabilities": {"type": "array", "enum": CAPABILITIES, "unique": true, "required": true},
19:	"entry": {"type": "string", "pattern": "^scripts/[A-Za-z0-9_/]+\\.gd$", "required": true},
20:	"assets": {"type": "array", "pattern": "^gen/[A-Za-z0-9_/]+\\.gd$", "required": true},
21:	"tests": {"type": "array", "pattern": "^tests/[A-Za-z0-9_/]+\\.gd$", "min_items": 1, "required": true},
22:	"requires": {"type": "array", "pattern": ID_RE},
23:	"cameras": {"type": "array", "pattern": "^[a-z][a-z0-9_]*$"},
24:	# optional fields of 2026-11-11 (contracts/PACK.md, last section); a pack without them behaves as before
25:	"footprint": {"type": "shape"},
26:	"params": {"type": "shape"},
27:	"on_leave": {"type": "string", "pattern": "^(bot|pause|end)$"},
28:	"subject": {"type": "string", "pattern": "^[A-Za-z0-9_]+(/[A-Za-z0-9_]+)*$", "max": 120},
