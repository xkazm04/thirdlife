41:## Normalises a pack location to an absolute directory without a trailing slash ("" when it does not exist).
42:static func resolve_dir(pack: String) -> String:
43:	var p: String = pack.replace("\\", "/")
44:	if p.begins_with("res://") and not OS.has_feature("editor"):
45:		# P11 (PATCHES-P9 2): in an exported build res:// is the pack file, not a folder: a game inside it stays res://
46:		p = p.trim_suffix("/")
47:		return p if DirAccess.dir_exists_absolute(p) else ""
48:	if p.begins_with("res://") or p.begins_with("user://"):
49:		p = ProjectSettings.globalize_path(p)
50:	p = p.simplify_path()
51:	while p.ends_with("/"):
52:		p = p.substr(0, p.length() - 1)
53:	if p.is_empty() or not p.is_absolute_path() or not DirAccess.dir_exists_absolute(p):
54:		return ""
55:	return p
