180:			return
181:		var size: Variant = fp["size_m"]
182:		if typeof(size) != TYPE_ARRAY or (size as Array).size() != 2 or not _is_num(size[0]) or not _is_num(size[1]) \
183:				or float(size[0]) <= 0.0 or float(size[1]) <= 0.0:
184:			bad.call("footprint.size_m must be [x, z]: two numbers above 0, in metres")
185:		if not _is_num(fp["height_m"]) or float(fp["height_m"]) <= 0.0:
186:			bad.call("footprint.height_m must be a number above 0, in metres")
187:	elif key == "params":
