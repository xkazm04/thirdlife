		_step_t = STEP_TICKS
		_step_wish = wish
	if _step_t > 0:
		_step_t -= 1
		if wish.length() < 0.01:
			wish = _step_wish
	if jump:
		_buffer = BUFFER
	elif _buffer > 0:
		_buffer -= 1
	var can_jump: bool = mode == "ground" or mode == "slide" or (mode == "air" and not _jumped and air_ticks <= COYOTE)
	if _buffer > 0 and can_jump:
		if mode == "slide":
			ev.append("end_slide")
		_buffer = 0
		_jumped = true
		vel.y = JUMP_V
		mode = "air"
		grounded = false
		ev.append("jump")
	if slide and mode == "ground" and hv.length() >= SLIDE_MIN:
		mode = "slide"
		_slide_t = 0
