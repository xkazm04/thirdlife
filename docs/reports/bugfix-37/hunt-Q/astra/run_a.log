--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd
@@ -0,0 +1,22 @@
+# timeout 120 "C:/Users/kazda/kiro/gtai-spike/tools/godot/Godot_v4.7.2-stable_win64_console.exe" --headless --path engine --script "$PWD/docs/reports/astra-trial/d5/repro/a_reverse_camera.gd"
+extends SceneTree
+
+const Chase = preload("res://kernel/api/tl_chase_cam.gd")
+
+func _initialize() -> void:
+	call_deferred("_check")
+
+func _check() -> void:
+	var who := Node3D.new()
+	var cam = Chase.new()
+	root.add_child(who)
+	root.add_child(cam)
+	cam.setup(who, {"use_velocity": true, "distance": 7.0, "follow": 1.0})
+	# Start in the setup heading (-Z), then travel the opposite way (+Z).
+	for tick in 360:
+		var direction := Vector3.FORWARD if tick < 60 else Vector3.BACK
+		who.position += direction * 0.1
+		cam._physics_process(1.0 / 60.0)
+	var ahead: float = (cam.global_position - who.global_position).dot(Vector3.BACK)
+	print("REPRO reverse_camera: %s after 300 reverse ticks, expected 7.0 m behind travel, camera %.1f m ahead" % ["PASS" if ahead < 0.0 else "FAIL", ahead])
+	quit()
diff --git a/docs/reports/astra-trial/d5/repro/a_sky_mask.py b/docs/reports/astra-trial/d5/repro/a_sky_mask.py
new file mode 100644
index 0000000000000000000000000000000000000000..9dc124c703ea7a6602a10995c50ce4c3dcea1f91
--- /dev/null
+++ b/docs/reports/astra-trial/d5/repro/a_sky_mask.py
@@ -0,0 +1,37 @@
+# python -B docs/reports/astra-trial/d5/repro/a_sky_mask.py
+import json
+import subprocess
+import sys
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+import numpy as np
+
+
+def detect(folder, reference_sky_pixels):
+    width, height = 480, 270
+    frame = np.zeros((height, width, 3), dtype=np.uint8)
+    # No sky below the horizon. The gray court is fully rendered geometry.
+    frame[180:220, 100:180] = (190, 190, 190)
+    frame[2, :reference_sky_pixels] = (255, 0, 255)
+    frame.tofile(folder / "f00000.raw")
+    metadata = {"n": 0, "frame": 1, "look": [0, 0, -1], "fov": 60, "size": [width, height]}
+    (folder / "frames.jsonl").write_text(json.dumps(metadata) + "\n")
+    result = subprocess.run([sys.executable, "-B", "engine/kernel/world/walks/blink_detect.py",
+                             str(folder), "--json"], capture_output=True, text=True, check=True)
+    return json.loads(result.stdout.splitlines()[-1])
+
+
+def main():
+    with TemporaryDirectory(prefix="a_mask_", dir=Path(__file__).parent) as directory:
+        folder = Path(directory)
+        for reference_sky_pixels in (51, 50):
+            result = detect(folder, reference_sky_pixels)
+            print(f"magenta pixels above horizon={reference_sky_pixels}, "
+                  f"sky_mask={result['sky_mask']}, reported hole pixels={result['hole_px_max']}")
+        verdict = "FAIL" if result["hole_frames"] else "PASS"
+        print(f"REPRO sky_mask: {verdict} expected 0 holes below horizon, got {result['hole_frames']}")
+
+
+if __name__ == "__main__":
+    main()
