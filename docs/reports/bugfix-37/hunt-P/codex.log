278:func _add_pack_walk(n: Node, holder: Node3D, inv: Transform3D, plot: Transform3D, radius: float, rim: float, band: float) -> void:
279:	if n is StaticBody3D and (n as StaticBody3D).get_child_count() > 0:
280:		var sb: StaticBody3D = n
281:		for ch: Node in sb.get_children():
282:			if not (ch is CollisionShape3D) or (ch as CollisionShape3D).disabled or (ch as CollisionShape3D).shape == null:
283:				continue
284:			var cs: CollisionShape3D = ch
285:			var local: Transform3D = inv * cs.global_transform           # the shape in the pack's own coordinates
286:			var sh: Shape3D = cs.shape
287:			if sh is ConcavePolygonShape3D:
288:				var src: PackedVector3Array = (sh as ConcavePolygonShape3D).get_faces()
289:				var out: PackedVector3Array = PackedVector3Array()
290:				var r2: float = (radius + 4.0) * (radius + 4.0)
291:				var t: int = 0
292:				while t + 2 < src.size():
293:					var a: Vector3 = local * src[t]
294:					var b: Vector3 = local * src[t + 1]
295:					var c: Vector3 = local * src[t + 2]
296:					t += 3
297:					var cx: float = (a.x + b.x + c.x) / 3.0
298:					var cz: float = (a.z + b.z + c.z) / 3.0
299:					if radius > 0.0 and cx * cx + cz * cz > r2:
300:						continue
301:					out.append(plot * _bent(a, radius, rim, band))
302:					out.append(plot * _bent(b, radius, rim, band))
303:					out.append(plot * _bent(c, radius, rim, band))
304:				if out.size() > 0:
305:					var ns: ConcavePolygonShape3D = ConcavePolygonShape3D.new()
306:					ns.backface_collision = true
307:					ns.set_faces(out)
308:					_keep.append(ns)
309:					_static(ns, Transform3D.IDENTITY)
310:					stats["pack_faces"] = int(stats["pack_faces"]) + out.size() / 3
311:			else:
312:				if radius > 0.0 and Vector2(local.origin.x, local.origin.z).length() > radius + 2.0:
313:					continue
314:				var lifted: Transform3D = local
315:				if band > 0.0 and radius > 0.0:
316:					lifted.origin = _bent(local.origin, radius, rim, band)
317:				_static(sh, plot * lifted)
318:				stats["pack_shapes"] = int(stats["pack_shapes"]) + 1
319:	for c: Node in n.get_children():
320:		_add_pack_walk(c, holder, inv, plot, radius, rim, band)
