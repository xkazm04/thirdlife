extends RefCounted
## P4. The world's own physics space, and the visitor's body in it.
##
## A pack is simulated in a space of its own and must stay untouched. The visitor is not part of any game: he walks the
## land between them, so the WORLD owns a space (`PhysicsServer3D`, no nodes, no scene tree) that holds only static
## things, all of them built once:
##   * the terrain's triangles (a triangle is left out where a plot's own ground carries him instead),
##   * a wall round every plot's fence, trunks of trees, boulders, the lots' machinery, the bridge,
##   * for every plot: a COPY of the pack's static colliders (add_pack): the shapes are shared (a shape belongs to no
##     space), the bodies are new bodies in this space, clipped to the plot's circle and moved to the plot's place with
##     the same bent rim the draw layer gives the pack's ground. The pack's own bodies are never touched.
## His own body is a kinematic capsule in that space; `walk()` moves it with the engine's test_motion (slide along what
## he meets, step up small steps, follow slopes down, refuse slopes steeper than `max_slope_deg`).
##
## Nothing here is read by a pack, a scheduler or a state hash: the scripted tour still gives the scheduler the
## scripted position; the body only decides where the visitor is DRAWN (and, when a person walks, where he is).

const RADIUS: float = 0.35
const HEIGHT: float = 1.8

var space: RID = RID()
var body: RID = RID()
var stats: Dictionary = {"bodies": 0, "faces": 0, "boxes": 0, "trunks": 0, "boulders": 0, "pack_shapes": 0, "pack_faces": 0}
var max_slope_deg: float = 55.0
var step_up: float = 0.55
var blocked_ticks: int = 0
var _bodies: Array = []
var _tags: Dictionary = {}           # body RID -> what it is (for the one line that says what stopped him)
var tag: String = ""                  # set by the builder: the tag of the bodies made next
var last_hit: Dictionary = {}
var _keep: Array = []                 # Shape3D resources that must outlive their bodies
var _cap: CapsuleShape3D = null
var _params: PhysicsTestMotionParameters3D = PhysicsTestMotionParameters3D.new()
var _res: PhysicsTestMotionResult3D = PhysicsTestMotionResult3D.new()
var _cyl: Dictionary = {}             # radius key -> CylinderShape3D (shared by every trunk of that size)
var _spheres: Dictionary = {}
var _mover: RefCounted = null         # walker-feel: the body with weight (world_body.gd), made on the first drive()
const Mover: GDScript = preload("res://kernel/world/terrain/world_body.gd")


func _init() -> void:
	space = PhysicsServer3D.space_create()
	PhysicsServer3D.space_set_active(space, true)
	_cap = CapsuleShape3D.new()
	_cap.radius = RADIUS
	_cap.height = HEIGHT
	body = PhysicsServer3D.body_create()
	PhysicsServer3D.body_set_mode(body, PhysicsServer3D.BODY_MODE_KINEMATIC)
	PhysicsServer3D.body_set_space(body, space)
	PhysicsServer3D.body_add_shape(body, _cap.get_rid(), Transform3D(Basis(), Vector3(0.0, HEIGHT * 0.5, 0.0)))
	PhysicsServer3D.body_set_collision_layer(body, 2)          # the visitor is layer 2; the static things are layer 1
	PhysicsServer3D.body_set_collision_mask(body, 1)
	_params.margin = 0.03
	_params.max_collisions = 4
	_params.recovery_as_collision = false


## Called when everything static is in: the space holds no moving body, so it need not be stepped (queries still work).
func finish() -> void:
	PhysicsServer3D.space_set_active(space, false)


func free_all() -> void:
	for b: Variant in _bodies:
		PhysicsServer3D.free_rid(b as RID)
	_bodies.clear()
	if body.is_valid():
		PhysicsServer3D.free_rid(body)
		body = RID()
	if space.is_valid():
		PhysicsServer3D.free_rid(space)
		space = RID()
	_keep.clear()


func _static(shape: Shape3D, xf: Transform3D) -> void:
	var b: RID = PhysicsServer3D.body_create()
	PhysicsServer3D.body_set_mode(b, PhysicsServer3D.BODY_MODE_STATIC)
	PhysicsServer3D.body_set_space(b, space)
	PhysicsServer3D.body_add_shape(b, shape.get_rid(), xf)
	PhysicsServer3D.body_set_collision_layer(b, 1)
	PhysicsServer3D.body_set_collision_mask(b, 0)
	_bodies.append(b)
	_tags[b] = tag
	stats["bodies"] = int(stats["bodies"]) + 1


## S2: frees every body that was made under the tag `t` (a construction site's scaffold, when its game arrives: the
## only thing in this space that goes). Returns how many. Their shapes stay in `_keep` until the space is freed.
func remove_tag(t: String) -> int:
	var n: int = 0
	for b: Variant in _bodies.duplicate():
		if str(_tags.get(b, "")) == t:
			PhysicsServer3D.free_rid(b as RID)
			_bodies.erase(b)
			_tags.erase(b)
			n += 1
	stats["bodies"] = int(stats["bodies"]) - n
	return n


func add_faces(faces: PackedVector3Array) -> void:
	if faces.size() < 3:
		return
	var sh: ConcavePolygonShape3D = ConcavePolygonShape3D.new()
	sh.backface_collision = true
	sh.set_faces(faces)
	_keep.append(sh)
	_static(sh, Transform3D.IDENTITY)
	stats["faces"] = int(stats["faces"]) + faces.size() / 3


func add_box(xf: Transform3D, size: Vector3) -> void:
	var sh: BoxShape3D = BoxShape3D.new()
	sh.size = size
	_keep.append(sh)
	_static(sh, xf)
	stats["boxes"] = int(stats["boxes"]) + 1


## A trunk: a cylinder standing on `foot`.
func add_trunk(foot: Vector3, radius: float, height: float = 4.0) -> void:
	var key: String = "%.2f_%.1f" % [radius, height]
	if not _cyl.has(key):
		var c: CylinderShape3D = CylinderShape3D.new()
		c.radius = radius
		c.height = height
		_cyl[key] = c
	_static(_cyl[key] as Shape3D, Transform3D(Basis(), foot + Vector3(0.0, height * 0.5, 0.0)))
	stats["trunks"] = int(stats["trunks"]) + 1
	if tag == "tree" and height == 4.0:
		add_canopy(foot, radius / 0.46)


## Walker-feel round 2: a tree's crown, for the CAMERA only (layer CANOPY: the body, the probes and `ground_at` ask
## layer 1 and walk through it). `s` is the tree's scale (its trunk radius / 0.46: the landscape's pines have 0.42 x
## scale, its broadleaf trees 0.5 x scale). The crown's core: a cylinder of 1.9 s from 2.2 s to 8.0 s over the foot
## (kit pines: crown radius 2.1-2.7 from 0.16 h up, h 8.5-12.5; broadleaf: about 0.45 h round 0.7 h, h 6.5-7.5).
const CANOPY: int = 4
func add_canopy(foot: Vector3, s: float) -> void:
	var key: String = "crown_%.2f" % s
	if not _cyl.has(key):
		var c: CylinderShape3D = CylinderShape3D.new()
		c.radius = 1.9 * s
		c.height = 5.8 * s
		_cyl[key] = c
	_static(_cyl[key] as Shape3D, Transform3D(Basis(), foot + Vector3(0.0, 5.1 * s, 0.0)))
	PhysicsServer3D.body_set_collision_layer(_bodies[_bodies.size() - 1] as RID, CANOPY)
	stats["canopies"] = int(stats.get("canopies", 0)) + 1


func add_boulder(centre: Vector3, radius: float) -> void:
	var key: String = "%.2f" % radius
	if not _spheres.has(key):
		var s: SphereShape3D = SphereShape3D.new()
		s.radius = radius
		_spheres[key] = s
	_static(_spheres[key] as Shape3D, Transform3D(Basis(), centre))
	stats["boulders"] = int(stats["boulders"]) + 1


## A wall of thin quads along a polyline of ground points: `height` metres tall from each point's own y. `closed`: the
## last point joins the first. Gaps are made by calling this once per stretch.
func add_wall(pts: PackedVector3Array, height: float) -> void:
# Gate honesty: a gate that cannot pass by stopping

The jam's last day (HOKEJ, 15 Nov 2026) had two tool faults, both the Director's:

1. A landing was reported green on **214 of 373 tests**: a watcher stopped the test run when the disk fell under a floor, and the
   script counted what had passed.
2. A cleanup of 28 worktrees followed **directory junctions** inside them into the main checkout and emptied a 130 MB licensed
   plugin folder there.

This page is the audit of `tl check` against the first fault, and the rule for removing a worktree against the second.

## The law

- A step that has a count reports **found** (units its run found: tests, cases, rules, checks) and **completed** (units carried
  to a verdict). The engine (`devx/lib/gate/engine.mjs`) **fails** the step on `found == 0` or `completed != found`, whatever
  `ok` the step claims.
- A run **cut short** (our timeout, anyone's kill, a script without its own trailer line, a test run without its summary) is
  never a PASS. Our own timeout is a FAIL that says "timed out"; a kill from outside is **could not run**.
- **Could not run** (`notRun: true`: no Godot, no `foreman/node_modules`, no input, the machine too busy to judge, killed from
  outside) is never a pass. The gate exits **2** when nothing failed and something could not run; exit 1 when anything failed.
- Zero steps selected is a FAIL ("found 0 steps"), except under `--changed` when nothing changed that any step claims: then there
  is nothing to check and the note line says so.
- A counted step that **found fewer** units than its last green run of the same tier is a **FAIL** ("found 165, last green run
  found 169 (-4)"), whatever `ok` it claims, unless the run declares it: `tl check --expect-drop <step>[,..]` (a step not
  selected is a usage error, exit 2). The baseline is the latest row of `.tl/gate-history.jsonl` of that tier in which the step
  passed with a count; a failed or not-run row never sets it, a row without the step (`--only`, `--changed`) is skipped, a step
  that could not run is never compared. The row of a declared run carries `expected_drop`, so its count is the next baseline.
  Every passing counted step shows its delta (`(+0 vs last green)`, `(-4 vs last green, expected)`, `(no earlier count)`).
- The disk floor **says, never stops**: `tl doctor` and the first line of `tl check` print free space on the repo's drive and
  `WARN` under the floor (20 GB, `TL_DISK_FLOOR_GB` overrides). Nothing is killed or skipped for it.

The JSON line of `tl check` carries, besides `steps`: `steps_found`, `steps_completed`, `units_found`, `units_completed`,
`not_run` (the ids; omitted when none), `count_drops` (`[{id, was, now}]`; omitted when none), `expected_drop` (the declared
ids; omitted when none), `disk_free_gb`, `disk_floor_gb`, `disk_low` (only when low). Each step in `steps` carries
`found` and `completed` when it counts, `not_run: true` when it could not run. The PASS/FAIL line shows `[completed/found]`.

## The step contract

```
run(ctx) -> { ok: boolean, detail?: string, clockOnly?: boolean, found?: int, completed?: int, notRun?: boolean }
```
A step that runs units MUST return `found` and `completed`. A step that cannot run here returns `{ ok: false, notRun: true,
detail: "<what is missing>" }`. A step never returns `ok: true` for something it did not judge.

## The audit: every step

| step | tier | how it counts (after the cure) | the false-pass path found (before) | the cure | test (devx/test/gate-honesty.test.mjs) |
|---|---|---|---|---|---|
| (the gate itself) | both | steps selected vs steps that returned | zero steps selected passed (exit 0); a step's `ok:true` stood whatever it ran | zero selected = FAIL (except `--changed` with nothing to check); engine judges found/completed | "a step that says ok but completed fewer...", "found zero units", "zero steps selected", "JSON line carries found and completed" |
| (count drops) | both | each counted step's found against its last green run of the tier (`devx/lib/gate/drops.mjs`) | a run that FOUND fewer (a test file the walk misses, a suite that stops registering) passed: counts were recorded and never read back | an undeclared drop = FAIL; `--expect-drop` declares it and is recorded; `--trend` shows `last found` / `green found` and `DROP` | `devx/test/count-drop.test.mjs` |
| `arch` | both | rules evaluated (in process) | none: in-process, cannot stop part-way and still return | reports found/completed | (engine tests) |
| `assets` | both | checks evaluated (in process) | none | reports found/completed | (engine tests) |
| `cards` | both | checks evaluated (in process) | none (an empty check list read `steps[0].detail` and threw: a FAIL, not a pass) | reports found/completed; empty list says "no checks" and fails on found 0 | (engine tests) |
| `devx.test` | both | node --test summary: `tests` found, pass+fail+skipped+todo completed (cancelled is not completed) | **zero test files passed** ("no devx tests yet"); exit 0 without a summary passed; the timeout said only `NaN pass, NaN fail` | zero files = FAIL; no summary = cut short = FAIL; our timeout = FAIL "timed out"; an outside kill = could not run; whole output kept in `.tl/last/devx.test.log` on a failure | "devx.test: zero test files", "a run stopped before its summary", "our timeout ... a kill from outside" |
| `foreman.typecheck` | both | none (tsc has no units) | missing `foreman/node_modules` was a FAIL as if the code were wrong | missing deps = could not run (exit 2); timeout = FAIL; outside kill = could not run | "foreman steps without foreman/node_modules could not run" |
| `foreman.test` | full | node --test summary, as devx.test | exit 0 counted as pass with `? pass`; the one failure in six under load **named no test** (the old pattern took every âś– line, parents and the "failing tests:" header included, and dropped the place) | counts as devx.test; names each failing test **with its file and line** from the spec reporter's "failing tests:" block; the **whole output is kept on every run** in `.tl/last/foreman.test.log`; a timeout says so | "foreman.test: a failure names the failing test with its file and line, and the whole output is kept" |
| `kernel.selftest` | full | `selftest.sh` own trailer `selftest: N passed, M failed` = found; PASS/FAIL case lines seen = completed | exit 0 passed **without the trailer**: a script stopped before its end that still exited 0 counted what it had printed | no trailer = cut short = FAIL; trailer N+M != lines seen = FAIL; a cut-short run is never clock-only (no retry turns it green) | "shell selftest: exit 0 with PASS lines but no trailer", "a trailer that counts more cases than the lines we saw" |
| `seeds` | full | `seeds.sh` trailer `seeds: N passed, M failed` (24 today) | as kernel.selftest | as kernel.selftest; proven on the real script: `PASS seeds [24/24]` | same two tests |
| `kit.selftest` | full | `selftest.gd` trailer `[selftest] N passed, M failed: RESULT ...` | it counted `\bPASS\b` anywhere, so **"RESULT PASS" on a run of zero cases passed** | counts `^PASS ` case lines against the trailer; found 0 = FAIL | "kit.selftest: 'RESULT PASS' on a run of zero cases is not a PASS" |
| `item.selftest` | full | `item.sh` trailer `item selftest: N passed, M failed` | **passed as "SKIPPED, not judged"** without the marble job (every worktree) | no input = could not run (exit 2); counts against the trailer | "item.selftest without its input ... could not run" |
| `ui.selftest` | full | `ui/selftest.gd` trailer `[selftest] N passed, M failed` | as item.selftest | as item.selftest | (same path as item.selftest) |
| `perf` | full | scenarios judged against a quiet baseline | **passed** with no quiet baseline and **passed** on a busy machine, judging nothing | both = could not run (exit 2); judged scenarios are found/completed | "perf with no quiet baseline judged nothing: could not run" |
| `packs` (lane H, new) | | must return found = packs found, completed = packs carried to a verdict | (not yet written) | must follow the contract above | (lane H's) |
| `world` (K7, new) | full | found = the games of `engine/boot/games.json`, completed = games whose row of `world.sh alone` says "same" | (new step) | fewer rows than games, no trailer line, a row that differs, our timeout: FAIL; a kill from outside: could not run | `devx/test/world.test.mjs` |


