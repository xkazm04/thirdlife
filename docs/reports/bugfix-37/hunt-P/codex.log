extends RefCounted
## N7 / P4. The world's own landscape: everything between the plots. Drawn once, owned by the world, never by a pack.
##
##   var stats: Dictionary = Landscape.build(parent, plots, radii, has_ground, cfg)
##
## P4: the ground has height (terrain/village_terrain.gd: rolling land, a ring of hills, a bluff, a valley with a river
## and two ponds). Every plot stands on a flat pad of its own height (`pad_h`, the walk's plot origin y) with a bank
## round it, a kerb at its lip and a spur road that climbs to the gate; the main road follows the land and crosses the
## river on a bridge; trees, rocks and bushes follow the land (tree lines on ridges, rocks on banks, none on a road,
## none inside a plot). The visitor's collider (terrain/world_space.gd) is built from the same things and stored on
## `parent` as the meta `tl_space`.
## `plots`: Transform3D per plot (world coordinates, lift included), `radii`: metres, `has_ground`: the pack has terrain
## of its own at its edge (the world's ground is cut open for it). `cfg` (the walk script's `landscape` block, all
## optional): road, road_half_m, spurs, fence, gates, lots ([{"at": [x, z], "radius": m, "h": pad height}]; S: a lot with
## `job` and `replay` is a construction site, kernel/world/site.gd: when its log is found it is a plot, drawn by site/draw.gd), pad_h (per
## plot: the height of its pad, default the plot's own y), river ({"path": [[x, z], ...], "half_m", "pond_m"}), trees,
## broadleaf, rocks, bushes, tufts, belt, mesas, seed, ground_key, spread_m, cell_m, rim_band.
## Cost is in the returned stats (`build_ms`, `terrain_ms`, instance counts); kernel/world/WORLD.md has the figures.

const VillageTerrain: GDScript = preload("res://kernel/world/terrain/village_terrain.gd")
const WorldSpace: GDScript = preload("res://kernel/world/terrain/world_space.gd")
const Parts: GDScript = preload("res://kernel/world/terrain/village_parts.gd")
const SiteDraw: GDScript = preload("res://kernel/world/site/draw.gd")    # S: a construction site's look

const GROUND_Y: float = 0.0              # the terrain and the far plain: a pack's rim and the ground meet at the same height
const FLAT_GROUND_Y: float = -0.06      # the flat ground of single shots (`ground()`), as in N7
const PAD_EXTRA: float = 10.5            # the flat of a pad reaches this far beyond the plot's radius (ring and fence stand on it)


## The private material of the world's ground: the palette's shader and lookup, with the plots that carry a ground of
## their own cut open (toon.gdshader `tl_holes`).
static func _ground_material(plots: Array, radii: Array, has_ground: Array) -> ShaderMaterial:
	var pal: ShaderMaterial = TLStyle.material(&"white") as ShaderMaterial
	if pal == null or pal.shader == null:
		return null
	var gm: ShaderMaterial = ShaderMaterial.new()
	gm.shader = pal.shader
	gm.set_shader_parameter(&"pal_lut", pal.get_shader_parameter(&"pal_lut"))
	var holes: Array = []
	for i: int in plots.size():
		if float(radii[i]) > 0.0 and bool(has_ground[i]) and holes.size() < 32:
			holes.append(Vector4((plots[i] as Transform3D).origin.x, (plots[i] as Transform3D).origin.z, float(radii[i]) + 2.5, 0.0))
	var n: int = holes.size()
	while holes.size() < 32:
		holes.append(Vector4.ZERO)
	gm.set_shader_parameter(&"tl_holes", holes)
	gm.set_shader_parameter(&"tl_hole_n", n)
	gm.set_meta(&"tl_holes_all", holes.duplicate())      # walker-feel T: every hole as cut, for draw/view_seam.gd `close_holes`
	return gm


## The flat ground of N7 (used when the landscape is off: `--landscape=off`, single shots).
static func ground(parent: Node3D, plots: Array, radii: Array, has_ground: Array, key: String = "") -> MeshInstance3D:
	var g: MeshInstance3D = TLStyle.ground(FLAT_GROUND_Y, key, 3000.0)
	parent.add_child(g)
	var gm: ShaderMaterial = _ground_material(plots, radii, has_ground)
	if gm != null:
		g.material_override = gm
	return g


static func _multi(parent: Node3D, mk: TLMesh, xs: Array, mname: String) -> void:
	if xs.is_empty():
		return
	var mm: MultiMesh = MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = true
	mm.mesh = mk.build(mname.to_snake_case())
	mm.instance_count = xs.size()
	for i: int in xs.size():
		mm.set_instance_transform(i, xs[i])
		mm.set_instance_color(i, Color.WHITE)
	var mmi: MultiMeshInstance3D = MultiMeshInstance3D.new()
	mmi.name = mname
	mmi.multimesh = mm
	parent.add_child(mmi)


static func _v2(a: Variant) -> Vector2:
	return Vector2(float((a as Array)[0]), float((a as Array)[1]))


static func build(parent: Node3D, plots: Array, radii: Array, has_ground: Array, cfg: Dictionary) -> Dictionary:
	var t0: int = Time.get_ticks_msec()
	var stats: Dictionary = {"_lap": Time.get_ticks_usec(), "road_m": 0.0, "spurs": 0, "fence_m": 0.0, "trees": 0, "rocks": 0, "bushes": 0, "mesas": 0}
	if TLStyle.headless():
		ground(parent, plots, radii, has_ground, str(cfg.get("ground_key", "")))
		return stats
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = int(cfg.get("seed", 7))
	# ---- plots and lots: centre, radius, own ground, pad height
	var centres: Array = []
	var rad: Array = radii.duplicate()
	var own_ground: Array = has_ground.duplicate()
	var pad_h: Array = []
	var pad_cfg: Array = cfg.get("pad_h", []) if typeof(cfg.get("pad_h")) == TYPE_ARRAY else []
	var lo: Vector2 = Vector2(INF, INF)
	var hi: Vector2 = Vector2(-INF, -INF)
	for i: int in plots.size():
		var pt: Transform3D = plots[i]
		var c: Vector2 = Vector2(pt.origin.x, pt.origin.z)
		centres.append(c)
		pad_h.append(float(pad_cfg[i]) if i < pad_cfg.size() else pt.origin.y)
		lo = lo.min(c - Vector2.ONE * (float(radii[i]) + PAD_EXTRA))
		hi = hi.max(c + Vector2.ONE * (float(radii[i]) + PAD_EXTRA))
	var lots: Array = (cfg["lots"] as Array).duplicate() if typeof(cfg.get("lots")) == TYPE_ARRAY else []     # S: a copy (site lots are taken out of it)
	var site_plots: Array = SiteDraw.split_lots(parent, lots)   # S: a construction site is a plot (kernel/world/site.gd); the rest stay plain lots
	var lot_auto: Array = []
	for k: int in lots.size():
		var lot: Dictionary = lots[k]
		var lc: Vector2 = _v2(lot["at"])
		var lr: float = float(lot.get("radius", 20.0))
		centres.append(lc)
		rad.append(lr)
		own_ground.append(false)
		pad_h.append(float(lot["h"]) if lot.has("h") else NAN)
		lot_auto.append(not lot.has("h"))
		lo = lo.min(lc - Vector2.ONE * (lr + PAD_EXTRA))
class_name TLRigNode
extends Node3D
## Base of every rig (kernelApi 0.1, contracts/KIT-RIG-STYLE.md). A rig is VISUAL ONLY: the kernel's controller owns the
## physics body and parents the rig under it. Animation is procedural and frame-driven: nothing here reads a clock or
## a global random function; `tick(frame)` advances exactly one physics frame (1/60 s).
##   family, metrics(), clips(), play(clip, blend), set_locomotion(velocity_local, grounded), set_param(name, value),
##   socket(name), tick(frame)
## A clip is a pose function `fn(t: float) -> {BoneName: Vector3(degrees), "_hips": Vector3(metres)}` plus a duration
## and a loop flag. Bones have identity rest rotations, so a pose is plain per-bone euler degrees:
##   +x swings a hanging limb forward (-Z) and tips an upright bone (spine, head) BACK; -x leans the torso forward,
##   +y turns left, +z rolls the top towards -X (left). Poses are blended as quaternions.

const DT: float = 1.0 / 60.0

var family: StringName = &""
var params: Dictionary = {}          # build params (with defaults) + runtime params set through set_param
var clip: StringName = &""           # the action clip being played ("" = locomotion decides)
var clip_t: float = 0.0
var frame: int = 0
var _metrics: Dictionary = {}
var _clips: Dictionary = {}          # name -> {"dur": float, "loop": bool, "fn": Callable, "upper": bool, "hold": bool}
var _order: PackedStringArray = PackedStringArray()
var _sockets: Dictionary = {}
var _sk: Skeleton3D
var _root_bone: int = -1
var _root_rest: Vector3 = Vector3.ZERO
var _upper: Dictionary = {}          # bone index -> true: bones an "upper" action clip owns while the legs keep moving
var _last: Dictionary = {}           # last applied pose {"q": {bone index: Quaternion}, "h": Vector3}
var _from: Dictionary = {}
var _blend_n: int = 0
var _blend_i: int = 0
var _vel: Vector3 = Vector3.ZERO
var _grounded: bool = true
var _loco_on: bool = false
var _phase: float = 0.0              # locomotion stride phase, in cycles


## A Skeleton3D only schedules its skin update while it is inside the tree, and a pose set outside the tree leaves
## its dirty flag set for good (later pose changes are then never drawn). So: outside the tree every tick flushes
## the dirty bones, and on entering the tree the last pose is applied again one deferred call later (when the
## Skeleton3D child is inside the tree too). A rig can therefore be posed before it is added (spawn at a frame).
func _enter_tree() -> void:
	_reapply.call_deferred()


func _reapply() -> void:
	if _sk == null or _last.is_empty() or not _sk.is_inside_tree():
		return
	_flush()
	_apply(_last)
	_post_pose()


func _flush() -> void:
	if _sk.has_method("force_update_all_dirty_bones"):
		_sk.call("force_update_all_dirty_bones")
	else:
		_sk.get_bone_global_pose(0)


func metrics() -> Dictionary:
	return _metrics.duplicate()


func clips() -> PackedStringArray:
	return _order


func socket(sname: StringName) -> Node3D:
	return _sockets.get(String(sname), null)


func add_clip(cname: String, dur: float, loop: bool, fn: Callable, upper: bool = false, hold: bool = false) -> void:
	_clips[cname] = {"dur": dur, "loop": loop, "fn": fn, "upper": upper, "hold": hold}
	_order.append(cname)


## Starts a clip. Looping is a property of the clip. A one-shot clip returns to locomotion (or idle) when it ends,
## except a `hold` clip (fall, skate_stop), which keeps its last pose until another play(). play(&"") = back to locomotion.
func play(cname: StringName, blend: float = 0.15) -> void:
	if String(cname) != "" and not _clips.has(String(cname)):
		push_warning("TLRig %s: no clip '%s' (clips: %s)" % [family, cname, ", ".join(_order)])
		return
	clip = cname
	clip_t = 0.0
	_start_blend(_blend_of(cname, blend))


## The blend a clip really gets (override): a family may shorten it for a clip that must show at once (a landing).
func _blend_of(_cname: StringName, blend: float) -> float:
	return blend


func _start_blend(blend: float) -> void:
	_from = _last
	_blend_n = maxi(0, roundi(blend * 60.0))
	_blend_i = 0


## Called every frame by the controller. velocity_local: metres per second in the rig's own space (forward is -Z).
func set_locomotion(velocity_local: Vector3, grounded: bool) -> void:
	_locomotion_changes(velocity_local, grounded)
	_vel = velocity_local
	_grounded = grounded
	_loco_on = true


## Called by set_locomotion before the new values are stored (override): the old ones are still in _vel and _grounded.
func _locomotion_changes(_velocity_local: Vector3, _grounded_now: bool) -> void:
	pass


func set_param(pname: StringName, value: Variant) -> void:
	params[String(pname)] = value
	_param_changed(String(pname), value)


func _param_changed(_pname: String, _value: Variant) -> void:
	pass


## The pose locomotion asks for this frame (override). Returns a pose dictionary.
func _loco_pose() -> Dictionary:
	return _eval("idle", float(frame) * DT)


func _post_pose() -> void:
	pass


func _eval(cname: String, t: float) -> Dictionary:
	var c: Dictionary = _clips[cname]
	var tt: float = fposmod(t, float(c["dur"])) if bool(c["loop"]) else minf(t, float(c["dur"]))
	return (c["fn"] as Callable).call(tt)


## Advances the animation by one physics frame. `frame_no` is the kernel's frame counter (kept for frame-keyed
## details such as blinking and flame flicker); every call is one step of 1/60 s.
func tick(frame_no: int) -> void:
	frame = frame_no
	_advance()
	if _sk == null:
		return
	var target: Dictionary
	if String(clip) != "":
		var c: Dictionary = _clips[String(clip)]
		clip_t += DT
		if not bool(c["loop"]) and not bool(c["hold"]) and clip_t >= float(c["dur"]):
			clip = &""
			_start_blend(0.2)
			target = to_q(_loco_pose())
		else:
			target = to_q(_eval(String(clip), clip_t))
			if bool(c["upper"]) and _loco_on and _vel.length() > 0.8:
				var legs: Dictionary = to_q(_loco_pose())
				for bi: int in (target["q"] as Dictionary):
					if _upper.has(bi):
						legs["q"][bi] = target["q"][bi]
				target = legs
	else:
		target = to_q(_loco_pose())
	if _blend_i < _blend_n and not _from.is_empty():
		_blend_i += 1
		var k: float = float(_blend_i) / float(_blend_n)
		target = mix(_from, target, k * k * (3.0 - 2.0 * k))
	_apply(target)
	_last = target
	_post_pose()
	if not _sk.is_inside_tree():
		_flush()


func _advance() -> void:
	pass


## {BoneName: Vector3 degrees, "_hips": Vector3} -> {"q": {bone index: Quaternion}, "h": Vector3}
func to_q(pose: Dictionary) -> Dictionary:
	var q: Dictionary = {}
	var h: Vector3 = Vector3.ZERO
	for key: String in pose:
		if key == "_hips":
			h = pose[key]
			continue
		var bi: int = _sk.find_bone(key)
		if bi < 0:
			continue
		var e: Vector3 = pose[key]
		q[bi] = Quaternion.from_euler(Vector3(deg_to_rad(e.x), deg_to_rad(e.y), deg_to_rad(e.z)))
	return {"q": q, "h": h}


static func mix(a: Dictionary, b: Dictionary, k: float) -> Dictionary:
	var q: Dictionary = {}
	var aq: Dictionary = a["q"]
	var bq: Dictionary = b["q"]
	for bi: int in bq:
		q[bi] = (aq.get(bi, Quaternion.IDENTITY) as Quaternion).slerp(bq[bi], k)
	for bi: int in aq:
		if not bq.has(bi):
			q[bi] = (aq[bi] as Quaternion).slerp(Quaternion.IDENTITY, k)
	return {"q": q, "h": (a["h"] as Vector3).lerp(b["h"], k)}


func _apply(pose: Dictionary) -> void:
	var q: Dictionary = pose["q"]
	for bi: int in q:
		_sk.set_bone_pose_rotation(bi, q[bi])
	if _root_bone >= 0:
		_sk.set_bone_pose_position(_root_bone, _root_rest + (pose["h"] as Vector3))


# ------------------------------------------------------------------ helpers for the family scripts
static func make_skeleton(bones: Array) -> Skeleton3D:
	# bones: [name, parent name or "", global rest position]; identity rest rotations
	var sk: Skeleton3D = Skeleton3D.new()
	sk.name = "Skeleton3D"
	var gpos: Dictionary = {}
	for b: Array in bones:
		var i: int = sk.add_bone(String(b[0]))
		var parent: String = String(b[1])
		var p: Vector3 = b[2]
		gpos[b[0]] = p
		if parent != "":
			sk.set_bone_parent(i, sk.find_bone(parent))
			sk.set_bone_rest(i, Transform3D(Basis.IDENTITY, p - (gpos[parent] as Vector3)))
		else:
			sk.set_bone_rest(i, Transform3D(Basis.IDENTITY, p))
	sk.reset_bone_poses()
	return sk


func attach_skinned(model: Node3D, sk: Skeleton3D, mk: TLMesh, mesh_name: String) -> MeshInstance3D:
	_sk = sk
	_root_bone = sk.find_bone("Hips")
	_root_rest = sk.get_bone_rest(_root_bone).origin
	if sk.get_parent() == null:
		model.add_child(sk)
	var mi: MeshInstance3D = sk.get_node_or_null("Mesh")
	if mi == null:
		mi = MeshInstance3D.new()
		mi.name = "Mesh"
		sk.add_child(mi)
		mi.skin = sk.create_skin_from_rest_transforms()
		mi.skeleton = NodePath("..")
		mi.extra_cull_margin = 2.0
	mi.mesh = mk.build(mesh_name)
	return mi


func add_socket(sname: String, bone: String, offset: Vector3, euler_deg: Vector3 = Vector3.ZERO) -> Node3D:
	var ba: BoneAttachment3D = BoneAttachment3D.new()
	ba.name = "At_" + sname
	_sk.add_child(ba)
	ba.bone_name = bone
	var s: Node3D = Node3D.new()
	s.name = sname
	# the attachment sits at the bone's joint: `offset` is given in model space at rest, so subtract the joint position
	s.position = offset - _sk.get_bone_global_rest(_sk.find_bone(bone)).origin
	s.rotation_degrees = euler_deg
	ba.add_child(s)
	_sockets[sname] = s
	return s


func look_angles(target_world: Vector3, eye_local: Vector3) -> Vector2:
	# yaw (+ = left) and pitch (+ = up) in degrees from the rig's forward (-Z) to a world point
	var d: Vector3 = to_local(target_world) - eye_local if is_inside_tree() else target_world - eye_local
	if d.length() < 0.001:
		return Vector2.ZERO
	return Vector2(rad_to_deg(atan2(-d.x, -d.z)), rad_to_deg(atan2(d.y, Vector2(d.x, d.z).length())))


static func add_pose(a: Dictionary, b: Dictionary) -> Dictionary:
	# adds euler degrees of b onto a (for layering a small correction on a pose)
	var out: Dictionary = a.duplicate()
	for k: String in b:
		out[k] = (out.get(k, Vector3.ZERO) as Vector3) + (b[k] as Vector3)
	return out

class_name TLRigBiped
extends TLRigNode
## The standard biped: 29 bones on Godot humanoid names (+ Backpack, Hair and five face bones), rigid-weighted toy
## forms from lane B, and a procedural clip library driven by tick(frame).
## Clips: idle, walk, run, skate, skate_stop, shoot, pass, cheer, fall, carry, work, jump, land, slide, slope_slide, air.
## Params (set_param): mode (&"walk" | &"skate"), look_at (Vector3 world, or null to clear), expression (&"happy" |
## &"focus" | &"blink"), lean (-1..1, + = right), stick (bool), colors ({part: palette key}).
## Sockets: hand_r, hand_l, head, back, foot_r, foot_l.

const UPPER: PackedStringArray = ["Spine", "Chest", "UpperChest", "Neck", "Head", "LeftShoulder", "RightShoulder",
	"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "Backpack", "Hair"]
const CROUCH: float = 0.84   # two leg segments of 0.42 m: hips drop = CROUCH * (1 - cos(a)) for a knee half-angle a

var _model: Node3D
var _stick: Node3D
var _hammer: Node3D
var _helmet_built: bool = false
var _skates: Array = []
var _stick_on: bool = false
var _was_air: bool = false
var _air_w: float = 0.0     # 0 = on the ground .. 1 = the air pose (eased over 5 ticks)
var _air_vy: float = 0.0    # the last vertical speed seen in the air (m/s at scale 1)
var _impact: float = 0.0    # the fall speed of the last landing
var _crouch_x: float = 0.0  # extra crouch under the gait (the landing)
var _tri_extra: int = 0
var stride_k: float = 1.0   # cadence multiplier (review tool; 1 = shipped)
var amp_override: float = -1.0   # P3 review tool, kept for API v1: the gait has no swing amplitude any more (the stride follows the speed)
var _gait: TLRigBipedGait = TLRigBipedGait.new()
var _amp: float = 1.0   # swing amplitude of the walk and run clips played by name (their authored swing)


func setup(p: Dictionary) -> void:
	family = &"biped"
	params = p
	name = "Biped"
	_model = Node3D.new()
	_model.name = "Model"
	_model.scale = Vector3.ONE * float(p["scale"])
	add_child(_model)
	var sk: Skeleton3D = make_skeleton(TLRigBipedMesh.final_bones())
	var s: float = float(p["scale"])
	_metrics = {"height": 2.0 * s, "radius": 0.3 * s, "eye_height": 1.765 * s, "bones": sk.get_bone_count(), "triangles": 0}
	_rebuild_mesh(sk)
	for b: String in UPPER:
		_upper[sk.find_bone(b)] = true
	add_socket("hand_r", "RightHand", Vector3(0.29, 0.845, -0.03))
	add_socket("hand_l", "LeftHand", Vector3(-0.29, 0.845, -0.03))
	add_socket("head", "Head", Vector3(0, 2.0 if not _helmet() else 2.0, 0))
	add_socket("back", "UpperChest", Vector3(0, 1.35, 0.2))
	add_socket("foot_r", "RightFoot", Vector3(0.11, 0.0, 0))
	add_socket("foot_l", "LeftFoot", Vector3(-0.11, 0.0, 0))
	_build_stick()
	_build_skates()
	add_clip("idle", 4.0, true, _idle)
	add_clip("walk", 0.9, true, _walk)
	add_clip("run", 0.6, true, _run)
	add_clip("skate", 1.2, true, _skate)
	add_clip("skate_stop", 0.4, false, _skate_stop, false, true)
	add_clip("shoot", 0.85, false, _shoot, true)
	add_clip("pass", 0.55, false, _pass, true)
	add_clip("cheer", 1.2, true, _cheer)
	add_clip("fall", 1.0, false, TLRigBipedMoves.fall_down, false, true)
	add_clip("carry", 0.9, true, _carry)
	add_clip("work", 0.8, true, TLRigBipedMoves.work)
	add_clip("jump", 0.3, false, TLRigBipedMoves.jump)
	add_clip("land", 0.45, false, _land)
	add_clip("slide", 0.3, false, TLRigBipedMoves.slide, false, true)
	add_clip("slope_slide", 1.6, true, TLRigBipedMoves.slope_slide)
	add_clip("air", 1.0, true, _air)
	_build_hammer()
	_param_changed("stick", p["stick"])
	_param_changed("mode", p["mode"])
	_face(1.0, 0.0)
	tick(0)


func _rebuild_mesh(sk: Skeleton3D) -> void:
	var look: Dictionary = TLRigBipedMesh.LOOK.duplicate()
	look.merge(params.get("colors", {}), true)
	_helmet_built = _helmet()
	var mk: TLMesh = TLRigBipedMesh.build_mesh(sk, look, bool(params["backpack"]), _helmet_built)
	attach_skinned(_model, sk, mk, "biped")
	_metrics["triangles"] = mk.tri_count + _tri_extra


## headgear "auto" = a team helmet (and the hockey kit) in skate mode, nothing in walk mode.
func _helmet() -> bool:
	var h: String = String(params.get("headgear", "auto"))
	return h == "helmet" or (h == "auto" and String(params.get("mode", "walk")) == "skate")


## prop "auto" = the stick in skate mode; `stick = true` still forces it; "hammer" goes with the `work` clip.
func _prop() -> String:
	var pr: String = String(params.get("prop", "auto"))
	if bool(params.get("stick", false)) and pr in ["auto", "stick"]:
		return "stick"
	if pr == "auto":
		return "stick" if String(params.get("mode", "walk")) == "skate" else "none"
	return pr


func _build_hammer() -> void:
	_hammer = Node3D.new()
	_hammer.name = "Hammer"
	var mk: TLMesh = TLMesh.new(74)
	mk.bar(Vector3(0, 0.12, 0), Vector3(0, -0.34, 0), 0.03, 0.04, "wood_light", Color.WHITE, 0.004)
	mk.rbox(Vector3(0.09, 0.09, 0.26), "steel_dark", Color.WHITE, 0.025, Vector3(0, -0.34, -0.02))
	mk.rbox(Vector3(0.095, 0.095, 0.07), "steel_light", Color.WHITE, 0.02, Vector3(0, -0.34, -0.17))
	var mi: MeshInstance3D = MeshInstance3D.new()
	mi.name = "HammerMesh"
	mi.mesh = mk.build("hammer")
	_hammer.add_child(mi)
	_hammer.rotation_degrees = Vector3(0.0, 0.0, 0.0)
	socket(&"hand_r").add_child(_hammer)
	_hammer.visible = false
	_tri_extra += mk.tri_count
	_metrics["triangles"] = int(_metrics["triangles"]) + mk.tri_count


func _build_stick() -> void:
	_stick = Node3D.new()
	_stick.name = "Stick"
	var mk: TLMesh = TLMesh.new(72)
	var key: String = String((params.get("colors", {}) as Dictionary).get("stick", "wood_light"))
	# grip point at the origin; the shaft runs up to the butt and down to the blade, which lies across (towards -X)
	mk.bar(Vector3(0, 0.55, 0), Vector3(0, -1.02, 0), 0.05, 0.065, key, Color.WHITE, 0.008)
	mk.box(Vector3(0.07, 0.12, 0.06), "black", Color.WHITE, 0.01, Vector3(0, 0.50, 0))
	mk.hull([Vector3(0.035, -1.03, -0.02), Vector3(0.035, -0.90, -0.02), Vector3(-0.38, -1.03, -0.02), Vector3(-0.38, -0.93, -0.02),
		Vector3(0.035, -1.03, 0.02), Vector3(0.035, -0.90, 0.02), Vector3(-0.38, -1.03, 0.02), Vector3(-0.38, -0.93, 0.02)], "black")
	var mi: MeshInstance3D = MeshInstance3D.new()
	mi.name = "StickMesh"
	mi.mesh = mk.build("stick")
	_stick.add_child(mi)
	_stick.rotation_degrees = Vector3(40.0, -30.0, 0.0)   # blade end forward of the hand and out to the right; butt towards the left hip
	socket(&"hand_r").add_child(_stick)
	_tri_extra += mk.tri_count
	_metrics["triangles"] = int(_metrics["triangles"]) + mk.tri_count
	var tip: Node3D = Node3D.new()
	tip.name = "blade"
	tip.position = Vector3(-0.17, -1.0, 0)
	_stick.add_child(tip)
	_sockets["stick_blade"] = tip


func _build_skates() -> void:
	for side: Array in [["foot_l", -0.11], ["foot_r", 0.11]]:
		var mk: TLMesh = TLMesh.new(73)
		mk.box(Vector3(0.025, 0.05, 0.36), "steel_light", Color.WHITE, 0.004, Vector3(0, -0.025, -0.06))
		mk.box(Vector3(0.06, 0.03, 0.10), "steel_dark", Color.WHITE, 0.0, Vector3(0, 0.0, 0.03))
		mk.box(Vector3(0.06, 0.03, 0.10), "steel_dark", Color.WHITE, 0.0, Vector3(0, 0.0, -0.15))
		var mi: MeshInstance3D = MeshInstance3D.new()
		mi.name = "Skate"
		mi.mesh = mk.build("skate")
		socket(StringName(side[0])).add_child(mi)
		_skates.append(mi)
		_tri_extra += mk.tri_count
		_metrics["triangles"] = int(_metrics["triangles"]) + mk.tri_count


func _param_changed(pname: String, value: Variant) -> void:
	match pname:
		"stick", "prop":
			_apply_prop()
		"headgear":
			_rebuild_mesh(_sk)
		"mode":
			for s: MeshInstance3D in _skates:
				s.visible = String(value) == "skate"
			_apply_prop()
			if _helmet() != _helmet_built:
				_rebuild_mesh(_sk)
			# on blades the body stands 5 cm higher
			_model.position.y = 0.05 * float(params["scale"]) if String(value) == "skate" else 0.0
		"colors":
			_rebuild_mesh(_sk)
		"expression":
			_expr()


func _apply_prop() -> void:
	var pr: String = _prop()
	_stick_on = pr == "stick"
	_stick.visible = _stick_on
	if _hammer != null:
		_hammer.visible = pr == "hammer"


func _expr() -> void:
	match String(params.get("expression", "happy")):
		"focus": _face(0.0, 0.0)
		"blink": _face(1.0, 1.0)
		_: _face(1.0, 0.0)


## mood 0 = focused (flat mouth, low brows) .. 1 = happy; blink 0 = open .. 1 = closed. Face bones are not touched by clips.
func _face(mood: float, blink: float) -> void:
	var bl: float = clampf(blink, 0.0, 1.0)
	var open: float = lerpf(1.0, 0.07, bl) * lerpf(0.8, 1.0, mood)
	for n: String in ["LeftEye", "RightEye"]:
		_sk.set_bone_pose_scale(_sk.find_bone(n), Vector3(lerpf(1.0, 1.12, bl), open, 1.0))
	_sk.set_bone_pose_scale(_sk.find_bone("Glints"), Vector3(1.0, clampf(1.0 - bl / 0.45, 0.0, 1.0) * lerpf(0.8, 1.0, mood), 1.0))
	var bi: int = _sk.find_bone("Brows")
	_sk.set_bone_pose_position(bi, _sk.get_bone_rest(bi).origin + Vector3(0, lerpf(-0.02, 0.006, mood), 0))
	var mi: int = _sk.find_bone("MouthCorners")
	_sk.set_bone_pose_position(mi, _sk.get_bone_rest(mi).origin + Vector3(0, lerpf(-0.012, 0.004, mood), 0))
	_sk.set_bone_pose_scale(mi, Vector3(lerpf(0.6, 1.0, mood), lerpf(0.32, 1.0, mood), 1.0))


# ------------------------------------------------------------------ locomotion
func _speed() -> float:
	return Vector2(_vel.x, _vel.z).length()


func _advance() -> void:
	if String(params.get("mode", "walk")) == "skate":
		_phase = fposmod(_phase + clampf(0.55 + 0.07 * _speed(), 0.55, 1.25) * stride_k * DT, 1.0)
		return
	var vm: Vector2 = Vector2(_vel.x, _vel.z) / float(params["scale"]) if _loco_on else Vector2.ZERO
	if _grounded or not _loco_on:
		if _was_air:
			_gait.land(vm)
		_gait.step(vm, stride_k, global_transform.basis.get_euler().y if is_inside_tree() else NAN)
	_was_air = _loco_on and not _grounded
	_air_w = move_toward(_air_w, 1.0 if _was_air else 0.0, 0.2 if _was_air else 0.34)


func _loco_pose() -> Dictionary:
	var t: float = float(frame) * DT
	var v: float = _speed() if _loco_on else 0.0
	var out: Dictionary
	if String(params.get("mode", "walk")) == "skate":
		var glide: Dictionary = _skate_pose(_phase, 0.12)
		out = _mixe(glide, _skate_pose(_phase, 1.0), smoothstep(0.3, 2.5, v))
	elif _air_w >= 1.0:
