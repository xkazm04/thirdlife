162:func _physics_process(_delta: float) -> void:
163:	if not is_instance_valid(target) or not target.is_inside_tree():
164:		return
165:	var want_heading: Vector3 = _target_forward()
166:	if use_velocity:
167:		var step: Vector3 = target.global_position - _last_pos
168:		step.y = 0.0
169:		if step.length() > 0.02:
170:			want_heading = step.normalized()
171:	_last_pos = target.global_position
172:	_heading = _heading.lerp(want_heading, stiffness).normalized() if _heading.lerp(want_heading, stiffness).length() > 0.001 else want_heading
173:	if anchor_follow >= 0.0:
174:		var tp: Vector3 = target.global_position
175:		var ky: float = anchor_follow_y if anchor_follow_y >= 0.0 else anchor_follow
176:		_anchor = Vector3(lerpf(_anchor.x, tp.x, clampf(anchor_follow, 0.01, 1.0)), lerpf(_anchor.y, tp.y, clampf(ky, 0.01, 1.0)),
177:			lerpf(_anchor.z, tp.z, clampf(anchor_follow, 0.01, 1.0)))
178:		global_position = _wanted()
179:		_look = _anchor + Vector3.UP * look_height
180:	else:
181:		global_position = global_position.lerp(_wanted(), clampf(follow, 0.01, 1.0))
182:		_look = _look.lerp(target.global_position + Vector3.UP * look_height, clampf(aim, 0.01, 1.0))
183:	_avoid(false)
184:	_aim()

