## The direction from a plot's centre to the nearest point of the walk's road (the landscape puts the gate there).
func _gate_dir(c: Vector2) -> Vector2:
	var road: Array = (world.get("walk") as Dictionary).get("road", [])
	var best: Vector2 = Vector2.ZERO
	var bd: float = INF
	for k: int in range(road.size() - 1):
		var a: Vector2 = Vector2(float(road[k][0]), float(road[k][1]))
		var b: Vector2 = Vector2(float(road[k + 1][0]), float(road[k + 1][1]))
		var p: Vector2 = Geometry2D.get_closest_point_to_segment(c, a, b)
		if p.distance_to(c) < bd:
			bd = p.distance_to(c)
			best = p
	return (best - c).normalized() if bd < INF and bd > 0.01 else Vector2(0.0, 1.0)


## The world ended: the records are written.
func finish() -> void:
	_close_stage_record(world.get("packs"))
	if devices and _captured:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	print_path(int(world.get("tick")))
	if record_path.is_empty() or _rec == null:
		return
	var walk: Dictionary = world.get("walk")
	var err: String = Session.call("write", record_path, {"schema": Session.SCHEMA, "pack": str(walk.get("name", "walk")), "seed": 1,
		"mode": "play", "max_frames": int(world.get("walk_ticks")), "length": _ticks, "end": "step", "frames": _rec})
	print(JSON.stringify({"schema": "tl.view/1", "kind": "visit_record", "out": record_path, "ok": err.is_empty(), "length": _ticks, "error": err}, "", false))
func _advance() -> void:
	if String(params.get("mode", "walk")) == "skate":
		_phase = fposmod(_phase + clampf(0.55 + 0.07 * _speed(), 0.55, 1.25) * stride_k * DT, 1.0)
		return
	var vm: Vector2 = Vector2(_vel.x, _vel.z) / float(params["scale"]) if _loco_on else Vector2.ZERO
	if _grounded or not _loco_on:
		if _was_air:
			_gait.land(vm)
		_gait.step(vm, stride_k, global_transform.basis.get_euler().y if is_inside_tree() else NAN)
	_was_air = _loco_on and not _grounded
	_air_w = move_toward(_air_w, 1.0 if _was_air else 0.0, 0.2 if _was_air else 0.34)


func _loco_pose() -> Dictionary:
	var t: float = float(frame) * DT
	var v: float = _speed() if _loco_on else 0.0
	var out: Dictionary
	if String(params.get("mode", "walk")) == "skate":
		var glide: Dictionary = _skate_pose(_phase, 0.12)
		out = _mixe(glide, _skate_pose(_phase, 1.0), smoothstep(0.3, 2.5, v))
	elif _air_w >= 1.0:
		out = _air(t)
	else:      # the side lean is part of the gait: the feet stay where they stand
		return _gait_pose(t) if _air_w <= 0.0 else _mixe(_gait_pose(t), _air(t), _air_w * _air_w * (3.0 - 2.0 * _air_w))
	var lean: float = clampf(float(params.get("lean", 0.0)), -1.0, 1.0)
	if lean != 0.0:
		out = add_pose(out, {"Hips": Vector3(0, 0, -16.0 * lean), "Spine": Vector3(0, 0, -5.0 * lean)})
	return out


