45:func setup(target_: Node3D, opts: Dictionary = {}) -> void:
46:	target = target_
47:	fov = 58.0
48:	for k: String in opts.keys():
49:		if k in ["distance", "height", "look_height", "stiffness", "follow", "aim", "use_velocity", "fov", "anchor_follow", "anchor_follow_y",
50:				"avoid_space", "avoid_margin", "avoid_mask", "avoid_out"]:
51:			set(k, opts[k])
52:		else:
53:			push_error("TLChaseCam: unknown option '%s'" % k)
54:	far = 2000.0
55:	if is_instance_valid(target) and target.is_inside_tree():
56:		_last_pos = target.global_position
57:		_heading = _target_forward()
58:		snap()
