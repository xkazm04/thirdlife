1:extends RefCounted
2:## P4. The world's own physics space, and the visitor's body in it.
3:##
4:## A pack is simulated in a space of its own and must stay untouched. The visitor is not part of any game: he walks the
5:## land between them, so the WORLD owns a space (`PhysicsServer3D`, no nodes, no scene tree) that holds only static
6:## things, all of them built once:
7:##   * the terrain's triangles (a triangle is left out where a plot's own ground carries him instead),
8:##   * a wall round every plot's fence, trunks of trees, boulders, the lots' machinery, the bridge,
9:##   * for every plot: a COPY of the pack's static colliders (add_pack): the shapes are shared (a shape belongs to no
10:##     space), the bodies are new bodies in this space, clipped to the plot's circle and moved to the plot's place with
11:##     the same bent rim the draw layer gives the pack's ground. The pack's own bodies are never touched.
12:## His own body is a kinematic capsule in that space; `walk()` moves it with the engine's test_motion (slide along what
13:## he meets, step up small steps, follow slopes down, refuse slopes steeper than `max_slope_deg`).
14:##
15:## Nothing here is read by a pack, a scheduler or a state hash: the scripted tour still gives the scheduler the
16:## scripted position; the body only decides where the visitor is DRAWN (and, when a person walks, where he is).
17:
18:const RADIUS: float = 0.35
19:const HEIGHT: float = 1.8
20:
21:var space: RID = RID()
22:var body: RID = RID()
23:var stats: Dictionary = {"bodies": 0, "faces": 0, "boxes": 0, "trunks": 0, "boulders": 0, "pack_shapes": 0, "pack_faces": 0}
24:var max_slope_deg: float = 55.0
25:var step_up: float = 0.55
26:var blocked_ticks: int = 0
27:var _bodies: Array = []
28:var _tags: Dictionary = {}           # body RID -> what it is (for the one line that says what stopped him)
29:var tag: String = ""                  # set by the builder: the tag of the bodies made next
30:var last_hit: Dictionary = {}
31:var _keep: Array = []                 # Shape3D resources that must outlive their bodies
32:var _cap: CapsuleShape3D = null
33:var _params: PhysicsTestMotionParameters3D = PhysicsTestMotionParameters3D.new()
34:var _res: PhysicsTestMotionResult3D = PhysicsTestMotionResult3D.new()
35:var _cyl: Dictionary = {}             # radius key -> CylinderShape3D (shared by every trunk of that size)
36:var _spheres: Dictionary = {}
37:var _mover: RefCounted = null         # walker-feel: the body with weight (world_body.gd), made on the first drive()
38:const Mover: GDScript = preload("res://kernel/world/terrain/world_body.gd")
39:
40:
41:func _init() -> void:
42:	space = PhysicsServer3D.space_create()
43:	PhysicsServer3D.space_set_active(space, true)
44:	_cap = CapsuleShape3D.new()
45:	_cap.radius = RADIUS
46:	_cap.height = HEIGHT
47:	body = PhysicsServer3D.body_create()
48:	PhysicsServer3D.body_set_mode(body, PhysicsServer3D.BODY_MODE_KINEMATIC)
49:	PhysicsServer3D.body_set_space(body, space)
50:	PhysicsServer3D.body_add_shape(body, _cap.get_rid(), Transform3D(Basis(), Vector3(0.0, HEIGHT * 0.5, 0.0)))
51:	PhysicsServer3D.body_set_collision_layer(body, 2)          # the visitor is layer 2; the static things are layer 1
52:	PhysicsServer3D.body_set_collision_mask(body, 1)
53:	_params.margin = 0.03
54:	_params.max_collisions = 4
55:	_params.recovery_as_collision = false
56:
57:
58:## Called when everything static is in: the space holds no moving body, so it need not be stepped (queries still work).
59:func finish() -> void:
60:	PhysicsServer3D.space_set_active(space, false)
61:
62:
63:func free_all() -> void:
64:	for b: Variant in _bodies:
65:		PhysicsServer3D.free_rid(b as RID)
66:	_bodies.clear()
67:	if body.is_valid():
68:		PhysicsServer3D.free_rid(body)
69:		body = RID()
70:	if space.is_valid():
71:		PhysicsServer3D.free_rid(space)
72:		space = RID()
73:	_keep.clear()
74:
75:
76:func _static(shape: Shape3D, xf: Transform3D) -> void:
77:	var b: RID = PhysicsServer3D.body_create()
78:	PhysicsServer3D.body_set_mode(b, PhysicsServer3D.BODY_MODE_STATIC)
79:	PhysicsServer3D.body_set_space(b, space)
80:	PhysicsServer3D.body_add_shape(b, shape.get_rid(), xf)
81:	PhysicsServer3D.body_set_collision_layer(b, 1)
82:	PhysicsServer3D.body_set_collision_mask(b, 0)
83:	_bodies.append(b)
84:	_tags[b] = tag
85:	stats["bodies"] = int(stats["bodies"]) + 1
