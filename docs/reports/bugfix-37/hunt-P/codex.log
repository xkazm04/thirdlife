21:var look_height: float = 1.0     ## the point looked at, above the target's origin
22:var stiffness: float = 0.07      ## 0..1 share of the remaining heading change covered each frame
23:var follow: float = 0.18          ## 0..1 share of the remaining distance to the wanted place covered each frame
24:var aim: float = 0.3             ## 0..1 share of the remaining way to the point looked at covered each frame
25:var use_velocity: bool = false   ## true: stay behind the direction of travel instead of the target's facing
26:var anchor_follow: float = -1.0  ## >= 0: orbit a smoothed anchor (see the header); -1 off
27:var anchor_follow_y: float = -1.0  ## the anchor's height share per frame; -1: the same as anchor_follow
28:var avoid_space: RID = RID()     ## a physics space whose bodies the camera never enters; invalid: off
29:var avoid_margin: float = 0.3    ## metres kept between the camera and what it would enter
30:var avoid_mask: int = 1          ## collision layers of `avoid_space` that count
31:var avoid_out: float = 0.12      ## 0..1 share of the remaining way back out covered each frame
32:var avoid_min: float = 2.5       ## metres: a nearer camera is swung up first (see the header)
33:var avoid_pull: float = 0.0      ## read only: metres the camera stands nearer than wanted this frame (0 when free)
34:var avoid_lift: float = 0.0      ## read only: degrees the camera is swung up this frame (0 when free)
