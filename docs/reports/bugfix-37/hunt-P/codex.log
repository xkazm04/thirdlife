extends Node3D
## The draw layer of a world, layer 1 of 4 (draw_base.gd < draw_pictures.gd < draw_life.gd < draw.gd; the layers are
## one class split over four files, each extends the one before; `draw.gd` is the script a world instantiates and
## has the description). This file: every constant and variable of the layer, and the helpers that need nothing else.


const NEVER: float = 16384.0
const PLOT: StringName = &"tl_plot"
const WATCH: int = 24
const CLIP: StringName = &"tl_clip"

var mech: String = "a"
var cull: String = "auto"
var far_mode: String = "off"            # off | auto | all
var far_dist: float = 150.0
var far_margin: float = 0.15            # hysteresis: far beyond dist * (1 + m), near again inside dist * (1 - m)
var rim_band: float = 9.0                # metres inside the plot edge over which a pack's ground is bent to the world's
var grounds: Array = []                 # walker-feel T2: per plot, the pack has ground of its own (view.gd `has_ground`)
var standin_min: float = 1.2            # metres: a mesh instance whose longest side is shorter is dropped ("still")
# P6: the pictures of a far game (draw/FAR.md has the study these numbers come from)
var mid_min: float = 2.5                # "mid": instances shorter than this are clutter at 100 m and more
var far_min: float = 5.0                # "far": only the forms that make the skyline and the plan
var far_cell: float = 6.0               # "far": the pack's own ground is re-meshed on a grid of this size (0 = kept as it is)
var far_flat: float = 0.0               # "far": how far every normal leans to straight up (P6 had 0.5; P13: 0, the tone of the middle picture, so the change does not show)
var far_thin: float = 0.1               # "far": a triangle narrower than this is a thin member (rail, wire, lattice): dropped (0 = kept)
var far_small: float = 0.4              # "far": a triangle whose longest edge is shorter is small detail: dropped (0 = kept)
var picture_far_m: float = 240.0        # camera to plot edge: beyond it the far picture (tiers.json `picture_far_m` when present)
var picture_margin_m: float = 30.0      # hysteresis both ways (tiers.json `margin_m.picture` when present)
var force_picture: String = ""          # "still" | "mid" | "far": every far pack shows this picture (TL_DRAW_PICTURE)
var marks_max: int = 400                # moving bodies of one pack that get a mark
var mark_min: float = 0.45              # metres: a mark is never smaller (a ball, a puck)
var far_mark_scale: float = 1.6         # a mark in the far picture is this much larger, so it stays a visible fleck
var far_shadow_m: float = 300.0        # P13: camera to plot edge: nearer, the far picture casts a shadow (style shadow_max)
var mark_shadow_m: float = 120.0       # P13: camera to plot edge: nearer, the marks cast a shadow (a figure's is a few pixels)
var mid_lights: int = 4                 # lights of a pack kept in its "mid" picture (the strongest)
var smoke_max: int = 2                  # particle emitters of a pack copied into its far pictures
var stage: int = 0
var world: Node = null
var entries: Array = []                 # one Dictionary per pack
var scenario: RID
var sync_usec: PackedInt64Array = PackedInt64Array()
var _pending: Array = []
var _shader_ok: Dictionary = {}         # Shader -> bool (declares tl_plot)
var _pal: Material = null
var _mark: ArrayMesh = null             # P6: the unit box every mark is an instance of
const PlotFile: GDScript = preload("res://kernel/world/plotfile.gd")
const PIC_VERSION: int = 14             # P13: part of the picture cache's key; count it up when a picture's rules change (T2: 14)
var pic_worker: bool = true             # P13: pictures are merged on a worker (false: in the frame, as P6 did)
var _dir_hashes: Dictionary = {}        # P13: pack directory -> content hash (the picture cache's key)
var _cache_tasks: Array = []            # P13: picture cache writes in flight
var _figure: ArrayMesh = null          # P13: the unit figure the mark of a rig is an instance of
var _pal_cols: Dictionary = {}          # P6: palette column -> colour
var _motion: Array = []                 # P13: camera keys [[world tick, from, to], ..] (TL_DRAW_CAMERA): the motion study
var _motion_cam: Camera3D = null        # P13: the camera those keys drive; drawing only
var notes: Array = []                   # P14: what this layer did in the frame ("what ms"), drained by view.gd per frame


func _note(what: String, t0: int) -> void:
	var ms: float = float(Time.get_ticks_usec() - t0) / 1000.0
	if ms >= 1.0:
		notes.append("%s %.1f" % [what, ms])
var HIDDEN: Transform3D = Transform3D(Basis.from_scale(Vector3.ONE * 0.0001), Vector3(0.0, -20000.0, 0.0))
var stats: Dictionary = {"a_instances": 0, "mirrors": 0, "light_mirrors": 0, "foreign": 0, "foreign_names": [], "late": 0}


## The clip parameter of a pack (toon.gdshader `tl_clip`): radius, rim height, width of the bent band.
func _clip_v4(e: Dictionary, g: Node) -> Vector4:
	if not e.has("sheets"):
		var wide: Array = []
		_wide_meshes(e["holder"], maxf(30.0, float(e["radius"])), wide)
		e["sheets"] = wide
	var w: float = (1.0 if (e["sheets"] as Array).has(g) else 0.0) + (2.0 if reaches_in(e["holder"], g, float(e["radius"])) else 0.0)
	return Vector4(float(e["radius"]), float(e["rim"]), _band(e), w)


## Walker-feel T2 (ex_car's asphalt): a mesh whose origin lies outside the plot but whose box reaches into it. The
## plot cut drops an instance by its origin (a tree of the forest beyond the plot): right for small things, wrong for
## a long slab placed by its middle (ex_car's asphalt, 60 x 190 m with its origin 65 m out of a 40 m plot: the course
## was not drawn at all in a world). Such an instance gets 2 added to `tl_clip.w` (1 = a terrain sheet, so 2 or 3):
## toon.gdshader (lane L, T-PATCHES) keeps it and cuts it in fragment() like a large mesh. With the shader as it is,
## w >= 2 changes nothing: it is dropped as before, and w = 3 reads as a sheet (w > 0.5) as w = 1 did.
static func reaches_in(holder: Node, g: Node, radius: float) -> bool:
	if radius <= 0.0 or not (g is GeometryInstance3D) or not (holder is Node3D):
		return false
	var xf: Transform3D = (holder as Node3D).global_transform.affine_inverse() * (g as Node3D).global_transform
	if Vector2(xf.origin.x, xf.origin.z).length() <= radius:
		return false
	var bb: AABB = xf * (g as GeometryInstance3D).get_aabb()
	var cx: float = clampf(0.0, bb.position.x, bb.end.x)          # the box's nearest point to the plot centre
	var cz: float = clampf(0.0, bb.position.z, bb.end.z)
	return Vector2(cx, cz).length() < radius


## Walker-feel T2: the width of the bent band of plot `e`. Only a pack with ground of its own is bent at its rim (its
## ground meets the world's there); a pack without one (ex_car, the hockey arena: the world's pad lies under it) is
## drawn as it is built: before, its wide meshes (the arena's stands) were bent down toward height 0 in the last 9 m.
## TL_RIM_BEND=all: as before (before pictures).
func _band(e: Dictionary) -> float:
	return rim_band if bool(e.get("ground", true)) or OS.get_environment("TL_RIM_BEND") == "all" else 0.0


func _plot_v4(rel: Transform3D) -> Vector4:
	var yaw: float = rel.basis.get_euler().y
	var v: Vector4 = Vector4(rel.origin.x, rel.origin.y, rel.origin.z, yaw)
	if v == Vector4.ZERO:
		v.y = 0.000001          # a pack on the stage's own plot that is not the stage still takes the shifted path
	return v


## 1 = every material of the instance is a style shader that knows `tl_plot`; 0 = it carries something else (a pack's
## own StandardMaterial3D, a default material, a label); the caller mirrors it, so it still stands at its plot.
func _style_only(n: GeometryInstance3D) -> int:
	if n.material_override != null:
		return 1 if _mat_ok(n.material_override) else 0
	var mesh: Mesh = null
	if n is MeshInstance3D:
		mesh = (n as MeshInstance3D).mesh
		if mesh == null:
			return 1
		for s: int in mesh.get_surface_count():
			if not _mat_ok((n as MeshInstance3D).get_active_material(s)):
				return 0
		return 1
	if n is CPUParticles3D:
		mesh = (n as CPUParticles3D).mesh
	elif n is MultiMeshInstance3D and (n as MultiMeshInstance3D).multimesh != null:
		mesh = (n as MultiMeshInstance3D).multimesh.mesh
	else:
		return 0
	if mesh == null:
		return 0
	for s: int in mesh.get_surface_count():
		if not _mat_ok(mesh.surface_get_material(s)):
			return 0
	return 1


func _mat_ok(m: Material) -> bool:
	if not (m is ShaderMaterial) or (m as ShaderMaterial).shader == null:
		return false
	var sh: Shader = (m as ShaderMaterial).shader
	if not _shader_ok.has(sh):
		_shader_ok[sh] = sh.code.contains("instance uniform vec4 tl_plot")
	return _shader_ok[sh]


## Candidate A culling: the engine culls (camera and every shadow cascade) with the instance's box, which stands where
## the pack is simulated. `custom_aabb` is in the node's own space: T^-1 * rel * T * box. With no yaw it depends on
## the node's rotation only, so a node that only slides never needs a refresh.
func _refresh_aabb(rec: Dictionary, rel: Transform3D) -> void:
	var g: GeometryInstance3D = rec["node"]
	var t: Transform3D = g.global_transform
	rec["t"] = t
	var box: AABB = g.get_aabb()
	if box.size == Vector3.ZERO:
		box = AABB(Vector3(-0.5, -0.5, -0.5), Vector3.ONE)
	if g is CPUParticles3D:
		box = box.grow(6.0)
	g.custom_aabb = t.affine_inverse() * (rel * (t * box))


func _is_triangles(mesh: Mesh, surface: int) -> bool:
	if mesh is ArrayMesh:
		return (mesh as ArrayMesh).surface_get_primitive_type(surface) == Mesh.PRIMITIVE_TRIANGLES
	return mesh is PrimitiveMesh           # boxes, spheres, cylinders: triangles


func _under_moving_body(n: Node, top: Node) -> bool:
	var up: Node = n.get_parent()
	while up != null and up != top:
		if up is PhysicsBody3D and not (up is StaticBody3D) and not (up is RigidBody3D and (up as RigidBody3D).freeze):
			return true
		if up is Skeleton3D:
			return true
		up = up.get_parent()
	return false


## The height of a pack's own ground where its plot ends: the median height of its terrain sheets in a ring around
## `radius` (the shader bends the ring to exactly this height). The viewer lifts the plot by minus this, so the rim of the pack's ground meets the world's ground.
extends "res://kernel/world/draw/draw_life.gd"
## N5b. The draw layer of a world: every pack is SIMULATED at the origin of its own physics space (N2), and DRAWN at
## its plot. This node never touches a physics body, a transform of a pack node, or anything a state hash reads.
##
## The stage rule: the stage pack (the one the player is in) is drawn natively, at zero offset. Every other pack, the
## landscape and the far stand-ins are drawn at `rel_i = plot_stage^-1 * plot_i`. `set_stage(i)` re-bases all of it once.
##
## Two mechanisms, chosen with `mech` (see DRAW.md for the measurement that decided):
##   "a"  offset in the shaders: `instance uniform vec4 tl_plot` (xyz offset, w yaw) of every style shader, set once on
##        each GeometryInstance3D of a pack. Whatever is not style geometry (lights, a pack's own material) is mirrored.
##   "b"  mirror instances: one RenderingServer instance per visual with the SAME base (mesh, multimesh, light), at
##        `rel * node.global_transform`; the node's own instance is hidden on the server. Moved nodes are re-sent in
##        `_process` (one comparison per visual per frame).
## Culling for "a" (`cull`): the engine culls with the box of the place where the pack is simulated, so each instance
## needs help. "auto" (kept): an instance that stands still gets a `custom_aabb` around its drawn place, once; an
## instance under a moving body, a skeleton or a particle emitter is never culled (`extra_cull_margin`); a slow
## round-robin check (WATCH instances per pack per frame) moves any "still" instance that a script turned after all
## into the never-culled class. "aabb" refreshes every box every frame (exact, one comparison per instance per frame),
## "margin" never culls anything of a non-stage pack.
##
## Far packs (`far_mode` "auto" beyond `far_dist`, or "all"; in a scheduled world the tiers `backdrop` and `ledger`):
## the pack's holder is hidden and one of two merged PICTURES of it is shown instead (P6, draw/FAR.md):
##   "mid"  the venue's large forms (instances shorter than `mid_min` dropped) plus signs of life: one mark per moving
##          body (a box in the body's colour, one multimesh per pack, moved when the pack ticks), a copy of its smoke,
##          a few of its lights;
##   "far"  a silhouette: only forms of at least `far_min`, its own ground re-meshed coarsely, normals leaning up so
##          it is drawn in flat tones with one outline; the marks stay (larger), so the picture still moves.
## Which of the two is decided per frame by the camera's distance to the plot edge (`picture_far_m`, with a margin
## both ways). "still" is N5b's stand-in (everything above 1.2 m, nothing moving), kept for comparison:
## the env variable TL_DRAW_PICTURE=still|mid|far forces one picture on every far pack.
## At every distance (near too) a kit scoreboard of the pack shows the pack's REAL score (`_build_boards`).
##
## P6: the layer is one class in four files (size rule of `tl arch`): draw_base.gd (constants, variables, helpers),
## draw_pictures.gd (the merged pictures), draw_life.gd (which picture, marks, smoke, lights, score), this file (plots,
## the stage rule, both offset mechanisms, culling, the per-frame loop, the report).


func setup(world_node: Node, plots: Array, radii: Array, rims: Array, stage_index: int) -> void:
	world = world_node
	scenario = get_viewport().find_world_3d().scenario
	_pal = TLStyle.material(&"white")
	if OS.get_environment("TL_PICTURE_WORKER") == "off":
		pic_worker = false                    # P13: to measure the frame of P6's build in the frame
	if force_picture.is_empty():              # the viewer may set it (PATCHES-P6 entry 2); until then the env variable
		force_picture = OS.get_environment("TL_DRAW_PICTURE")
	var wcfg: Variant = world.get("cfg")          # tiers.json as the world host read it: the loading builder's file
	if typeof(wcfg) == TYPE_DICTIONARY:
		picture_far_m = float((wcfg as Dictionary).get("picture_far_m", picture_far_m))
		var wm: Variant = (wcfg as Dictionary).get("margin_m", {})
		if typeof(wm) == TYPE_DICTIONARY:
			picture_margin_m = float((wm as Dictionary).get("picture", picture_margin_m))
	var holders: Array = world.get("packs")
	for i: int in holders.size():
		entries.append({"holder": holders[i], "plot": plots[i], "radius": float(radii[i]) if i < radii.size() else 0.0,
			"rim": float(rims[i]) if i < rims.size() else 0.0, "ground": bool(grounds[i]) if i < grounds.size() else true,
			"clipped": [], "rel": Transform3D.IDENTITY, "a": [], "mirrors": [],
			"pics": {}, "kind": "", "life": {}, "boards": {}, "far": false, "placed": false, "standin_info": {}})
	get_tree().node_added.connect(_on_node_added)
	stage = stage_index             # the caller places the world with set_stage()
	_motion_setup()
	for e: Dictionary in entries:          # P13: the picture cache's keys are read on workers from the start
		if is_instance_valid(e["holder"]) and OS.get_environment("TL_PICTURE_CACHE") != "off":
			_hash_dir_async(str((e["holder"] as Node).get("pack_dir")))


## P13: the motion study (far_study.mjs `motion`). TL_DRAW_CAMERA names a JSON file {"keys": [[tick, [x,y,z], [x,y,z]], ..]}:
## between its first and last key a camera of this layer is the current one, moved every drawn frame along the keys
## (linear, world coordinates). Drawing only: nothing of a pack or of the world host reads it.
func _motion_setup() -> void:
	var path: String = OS.get_environment("TL_DRAW_CAMERA")
	if path.is_empty() or not FileAccess.file_exists(path):
		return
	var j: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(j) != TYPE_DICTIONARY or typeof((j as Dictionary).get("keys")) != TYPE_ARRAY:
		return
	_motion = (j as Dictionary)["keys"]
	_motion_cam = Camera3D.new()
	_motion_cam.name = "MotionStudy"
	_motion_cam.fov = 50.0
	_motion_cam.far = 4000.0
	add_child(_motion_cam)


func _motion_step() -> void:
	var t: float = float(world.get("tick")) if world != null else 0.0
	if t < float((_motion[0] as Array)[0]) or t > float((_motion[_motion.size() - 1] as Array)[0]):
		return
	var k: int = 0
	while k < _motion.size() - 2 and t > float((_motion[k + 1] as Array)[0]):
		k += 1
	var a: Array = _motion[k]
	var b: Array = _motion[mini(k + 1, _motion.size() - 1)]
	var span: float = maxf(1.0, float(b[0]) - float(a[0]))
	var f: float = clampf((t - float(a[0])) / span, 0.0, 1.0)
	var from: Vector3 = _v(a[1]).lerp(_v(b[1]), f)
	var to: Vector3 = _v(a[2]).lerp(_v(b[2]), f)
	_motion_cam.global_transform = Transform3D(Basis.looking_at(to - from, Vector3.UP), from)
	if not _motion_cam.current:
		_motion_cam.make_current()
		print("[draw] motion first tick %d frame %d" % [int(t), Engine.get_frames_drawn()])


func _v(a: Variant) -> Vector3:
	return Vector3(float((a as Array)[0]), float((a as Array)[1]), float((a as Array)[2]))


## Re-bases the world on another stage pack: once, not per tick. N7: `-1` = nobody is on stage (the visitor walks):
## every pack is drawn at its plot, in world coordinates.
func set_stage(index: int) -> void:
	stage = clampi(index, -1, entries.size() - 1)
	var inv: Transform3D = (entries[stage]["plot"] as Transform3D).affine_inverse() if stage >= 0 else Transform3D.IDENTITY
	for i: int in entries.size():
		var e: Dictionary = entries[i]
		_unplace(e)
		e["rel"] = inv * (e["plot"] as Transform3D)
		var hn: Variant = e["holder"]
		var ctx: TLContext = (hn as Node).get("ctx") if is_instance_valid(hn) else null      # M2-PATCHES 1: a freed holder
		if ctx != null:
			ctx.on_stage = i == stage
			for h: Variant in ctx.huds:
				if is_instance_valid(h):
					(h as CanvasLayer).visible = i == stage
		_place_own(e)
		if not is_instance_valid(hn):
			pass                              # its pack is being rebuilt: replace_holder places the new one
		elif i != stage:
			_place(e)
		elif float(e["radius"]) > 0.0:
			_clip_walk(e, e["holder"])        # the stage pack is cut to its plot too; nothing else of it is touched
		_set_far(e, _wants_far(e) and i != stage, true)


func _wants_far(e: Dictionary) -> bool:
	return bool(e["tier_far"]) if e.get("tier_far", null) != null else far_mode == "all"


## N7. The scheduler's tier decides how plot `i` is drawn: in full (`stage`, `sideline`) or as its stand-in
## (`backdrop`, `ledger`). Called at a tick boundary; the stand-in is built the first time it is needed.
func set_tier(i: int, tier: String) -> void:
	if i < 0 or i >= entries.size():
		return
	var e: Dictionary = entries[i]
	e["tier"] = tier
	e["tier_far"] = tier == "backdrop" or tier == "ledger"
	_set_far(e, bool(e["tier_far"]) and i != stage, false)


## N7. Plot `i` lost its pack's nodes (`ledger`): only the stand-in is left to draw.
func forget_nodes(i: int) -> void:
	if i >= 0 and i < entries.size():
		_unplace(entries[i])
		(entries[i] as Dictionary).erase("sheets")
		_drop_life(entries[i], false)         # the marks stay where they were: a still picture of a game that is not in memory



