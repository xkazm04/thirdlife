283:## The ground part of drive(): lift by the step, move `delta` (horizontal) sliding along what it meets, then put him
284:## down by at most step + SNAP_DOWN. Returns {"pos", "blocked", "state": "ground" | "air" | "slope"}. Only the
285:## vertical part of the drop's travel is kept.
286:func _ground_move(from: Vector3, delta: Vector3) -> Dictionary:
287:	var pos: Vector3 = from
288:	var rest_m: Vector3 = Vector3(delta.x, 0.0, delta.z)
289:	var hit: bool = false
290:	var up: Vector3 = Vector3(0.0, sp.step_up, 0.0)
291:	if sp._test(Transform3D(Basis(), pos), up):
292:		up = sp._res.get_travel()
293:		up.x = 0.0
294:		up.z = 0.0
295:	pos += up
296:	for it: int in 3:
297:		if rest_m.length() < 0.0005:
298:			break
299:		if sp._test(Transform3D(Basis(), pos), rest_m):
300:			hit = true
301:			sp.last_hit = {"tag": sp._tags.get(sp._res.get_collider_rid(0), "?"), "at": sp._res.get_collision_point(0), "n": sp._res.get_collision_normal(0), "from": pos}
302:			var travel: Vector3 = sp._res.get_travel()
303:			travel.y = 0.0
304:			pos += travel
305:			var rem: Vector3 = sp._res.get_remainder()
306:			var nrm: Vector3 = sp._res.get_collision_normal(0)
307:			nrm.y = 0.0
308:			rest_m = rem - nrm.normalized() * rem.dot(nrm.normalized()) if nrm.length() > 0.001 else Vector3.ZERO
309:			rest_m.y = 0.0
310:		else:
311:			pos += rest_m
312:			rest_m = Vector3.ZERO
313:	var pd: Dictionary = _probe_down(pos, up.y + SNAP_DOWN)
314:	if not bool(pd["hit"]):
315:		pos.y -= up.y                                # nothing within a step: he walked off an edge and falls from here
316:		return {"pos": pos, "blocked": hit, "state": "air"}
317:	var n: Vector3 = pd["n"]
318:	if _walkable(n):
319:		pos.y += float(pd["dy"])
320:		ground_n = n
321:		return {"pos": pos, "blocked": hit, "state": "ground"}
322:	var landed: Vector3 = pos + Vector3(0.0, float(pd["dy"]), 0.0)
323:	var sn: Vector3 = _steep_n(landed)
324:	if sn == Vector3.ZERO:
325:		pos.y -= up.y                                # the round foot met an edge, not a slope: he walks off it and falls
326:		return {"pos": pos, "blocked": hit, "state": "air"}
327:	var downhill: Vector3 = Vector3(sn.x, 0.0, sn.z)
328:	if landed.y < from.y - 0.02 or (downhill.length() > 0.001 and delta.dot(downhill) > 0.0):
329:		ground_n = sn                                # down onto steep ground: the slope slide begins
330:		return {"pos": landed, "blocked": hit, "state": "slope"}
331:	# up onto steep ground: refused, he stays where he was (a wall, as before)
332:	sp.last_hit = {"tag": "slope", "at": landed, "n": Vector3.ZERO, "from": from}
333:	return {"pos": from, "blocked": true, "state": "ground"}
