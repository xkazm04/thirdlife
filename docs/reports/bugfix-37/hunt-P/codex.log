		var tones: PackedFloat32Array = PackedFloat32Array()      # packed arrays in a Dictionary are copies: filled here
		var fences: PackedByteArray = PackedByteArray()
		var run: PackedVector3Array = PackedVector3Array()
		for k: int in seg:
