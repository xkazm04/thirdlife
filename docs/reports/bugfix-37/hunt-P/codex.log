# ---------------------------------------------------------------- walker-feel, lane L: the biped's feet and moves (rig.)
# The feet stand where they are put: six sole points; a point on the floor two frames running may not move (engine/rigs/
# review/review.gd, 400 frames, headless). Mean under 0.2 m/s at a jog, a sprint, a sidestep and backward (18 Nov: 0.06 to
# 0.10; the gait before it: 0.9 to 9.2), with a foot on the floor in at least 100 frames (a run that printed nothing fails).
if [ -z "$FILTER" ] || [[ "rig.feet_plant" == *"$FILTER"* ]] || [[ "rig.moves" == *"$FILTER"* ]]; then
  if [ -z "$FILTER" ] || [[ "rig.feet_plant" == *"$FILTER"* ]]; then
    why=""; seen=""
    for c in "4.5:0" "9.0:0" "4.5:90" "4.5:180" "1.4:0"; do
      line="$(RIG_ARGS="--dir=${c#*:}" bash "$HERE/look.sh" slip "${c%%:*}" walk 2>&1 | tr -d '
' | grep -a 'contact\|SCRIPT ERROR' | head -1)"
      mean="$(echo "$line" | grep -o 'mean_ms=[0-9.]*' | cut -d= -f2)"; onf="$(echo "$line" | grep -o ' on_floor=[0-9]*' | cut -d= -f2)"
      if [ -z "$mean" ] || [ -z "$onf" ]; then why="${why:+$why; }$c: no contact line (${line:0:80})"
      elif [ "$onf" -lt 100 ]; then why="${why:+$why; }$c: a foot on the floor in only $onf frames"
      elif ! awk -v m="$mean" 'BEGIN { exit !(m < 0.2) }'; then why="${why:+$why; }$c: soles slide $mean m/s (limit 0.2)"; fi
      seen="${seen:+$seen, }${c%%:*} m/s dir ${c#*:} = $mean"
    done
    verdict rig.feet_plant "$why" "sole slide, mean m/s: $seen"
  fi
  if [ -z "$FILTER" ] || [[ "rig.moves" == *"$FILTER"* ]]; then
    why=""
    for mv in jump land slide slope_slide air; do
      grep -q "add_clip(\"$mv\"" "$HERE/../rigs/tl_rig_biped.gd" || why="${why:+$why; }tl_rig_biped.gd adds no clip $mv"
    done
    # a jump at a run: off the floor, the air pose, the landing; no script error, and the feet are planted again after it
    line="$(RIG_ARGS="--jump-at=90 --jump-v=8.5" bash "$HERE/look.sh" slip 4.5 walk 2>&1 | tr -d '
' | grep -a 'contact\|SCRIPT ERROR' | head -1)"
    mean="$(echo "$line" | grep -o 'mean_ms=[0-9.]*' | cut -d= -f2)"
    if [ -z "$mean" ]; then why="${why:+$why; }jump run: no contact line (${line:0:80})"
    elif ! awk -v m="$mean" 'BEGIN { exit !(m < 0.6) }'; then why="${why:+$why; }jump run: soles slide $mean m/s (limit 0.6)"; fi
    verdict rig.moves "$why" "clips jump, land, slide, slope_slide, air; a run with a jump: sole slide $mean m/s"
  fi
fi

echo "selftest: $pass passed, $fail failed (reports in $OUT)"
[ $fail -eq 0 ]
extends SceneTree
## Walker-feel T selftest case `ground.no_sky_pit` (tools/selftest.sh): the world's ground is cut open only for a pack
## whose own ground covers its plot, and a hole can be shut while its plot draws nothing. Headless; prints one line
## `GROUNDCASE ok|fail <detail>`.
##   B1 (the most common blink of 18 Nov: ex_car's plot and the hockey plot showed the sky through the ground): a pack
##   whose only wide meshes are ex_car's two boxes (asphalt 60 x 1 x 40, ice 60 x 1 x 400 with its origin 200 m out,
##   which the plot cut drops whole) has no rim (NAN), while a 416 m terrain sheet has one.
##   B2: draw/view_seam.gd `close_holes` sets a shut plot's hole radius to 0 and gives it back when opened.

const DrawScript: GDScript = preload("res://kernel/world/draw/draw.gd")
const Seam: GDScript = preload("res://kernel/world/draw/view_seam.gd")


func _box(parent: Node3D, size: Vector3, at: Vector3) -> void:
	var b: BoxMesh = BoxMesh.new()
	b.size = size
	var mi: MeshInstance3D = MeshInstance3D.new()
	mi.mesh = b
	mi.position = at
	parent.add_child(mi)


var _ran: bool = false


func _process(_delta: float) -> bool:
	if not _ran:
		_ran = true
		_check()
	return false


func _initialize() -> void:
	pass


func _check() -> void:
	var why: Array = []
	var car: Node3D = Node3D.new()
	root.add_child(car)                                   # the nodes are in the tree: their global transforms are read
	_box(car, Vector3(60, 1, 40), Vector3(0, -0.5, 10))         # asphalt: x -30..30, z -10..30
	_box(car, Vector3(60, 1, 400), Vector3(0, -0.5, -210))      # ice: its origin 210 m out of a 40 m plot
	var r_car: float = float(DrawScript.call("edge_height", car, 40.0))
	if not is_nan(r_car):
		why.append("ex_car's boxes give a rim (%.2f): the world's ground would be cut open over a plot with no ground" % r_car)
	var cover: float = float(DrawScript.call("ground_cover", car, 40.0, [car.get_child(0), car.get_child(1)]))
	var sheet: Node3D = Node3D.new()
	root.add_child(sheet)
	var pm: PlaneMesh = PlaneMesh.new()
	pm.size = Vector2(416, 416)
	pm.subdivide_width = 103
	pm.subdivide_depth = 103
	var smi: MeshInstance3D = MeshInstance3D.new()
	smi.mesh = pm
	smi.position = Vector3(0, 1.5, 0)
	sheet.add_child(smi)
	var r_sheet: float = float(DrawScript.call("edge_height", sheet, 40.0))
	if is_nan(r_sheet) or absf(r_sheet - 1.5) > 0.01:
		why.append("a 416 m terrain sheet at 1.5 m gives rim %s, not 1.5" % str(r_sheet))
	# B2: shut and open a hole
	var land: Node3D = Node3D.new()
	root.add_child(land)
	var gm: ShaderMaterial = ShaderMaterial.new()        # headless: the style gives no shader; the hole list is what counts
	var all: Array = [Vector4(0, 0, 42.5, 0), Vector4(100, 0, 32.5, 0)]
	while all.size() < 32:
		all.append(Vector4.ZERO)
	gm.set_meta(&"tl_holes_all", all)
	land.set_meta(&"tl_ground_mat", gm)
	Seam.call("close_holes", land, [true, true], [40.0, 30.0], [false, true])
	var h: Array = gm.get_shader_parameter(&"tl_holes")
	if not ((h[0] as Vector4).z > 42.0 and (h[1] as Vector4).z == 0.0):
		why.append("shut plot 1: holes are %s and %s" % [str(h[0]), str(h[1])])
	Seam.call("close_holes", land, [true, true], [40.0, 30.0], [false, false])
	h = gm.get_shader_parameter(&"tl_holes")
	if not ((h[1] as Vector4).z > 32.0):
		why.append("opened again: plot 1's hole is %s" % str(h[1]))
	# round 2: a pack without ground of its own is not bent at its rim (the hockey arena's stands were)
	var dl: Node3D = DrawScript.new()
	dl.set("rim_band", 9.0)
	var b_none: float = float(dl.call("_band", {"ground": false}))
	var b_own: float = float(dl.call("_band", {"ground": true}))
	if OS.get_environment("TL_RIM_BEND") != "all" and (b_none != 0.0 or b_own != 9.0):
		why.append("rim band: %.1f m without ground (want 0), %.1f m with (want 9)" % [b_none, b_own])
	dl.free()
	print("GROUNDCASE %s %s" % ["ok" if why.is_empty() else "fail",
		("ex_car's boxes cover %d %% of the rim: no hole; a terrain sheet: rim 1.5; a hole shut and opened again; no rim bend without ground" % int(round(cover * 100.0))) if why.is_empty() else "; ".join(why)])
	car.free()
	sheet.free()
	land.free()
	quit(0 if why.is_empty() else 1)

extends RefCounted
## P14. The viewer's (view.gd) work at the seam between a world that builds packs while it is drawn and the visitor:
## the rim cache read before the first frame, and the copy of an arrived pack's colliders into the visitor's space in
## slices. Static functions on the viewer's own fields (the size rule of `tl arch` keeps view.gd under 600 lines).

const DrawScript: GDScript = preload("res://kernel/world/draw/draw.gd")
const PlotFile: GDScript = preload("res://kernel/world/plotfile.gd")
const COPY_US: int = 2000               # what the copy may take of a frame
const COPY_NEAR_M: float = 10.0         # a plot whose edge is nearer than this to the visitor is copied whole at once

static var _hashes: Dictionary = {}     # pack directory -> content hash, once per process (PATCHES-P13 entry 4)


## P5. The rim of plot `i` (draw.gd `edge_height`). A plot whose pack is not built yet takes it from the rim cache, a
## file in the user directory keyed by the pack directory's content, the radius and the scenery; when it is not there
## the pack is built now, before the first frame, and the cache learns it (the first visit of a world on a machine).
## P14: a directory's content is hashed once per process, not once per plot (thirty plots of walk30 share nine).
static func rim_of(v: Node, i: int, r: float) -> float:
	var world: Node = v.get("world")
	var h: Node = (world.get("packs") as Array)[i]
	if bool(h.get("loaded")) or world.get("jobs") == null or (h.get("manifest") as Dictionary).is_empty():
		return float(DrawScript.call("edge_height", h, r))
	var rims: Dictionary = v.get("_rims")
	if rims.is_empty() and FileAccess.file_exists(rims_path()):
		var j: Variant = JSON.parse_string(FileAccess.get_file_as_string(rims_path()))
		if typeof(j) == TYPE_DICTIONARY:
			rims.merge(j)
	var dir: String = str(h.get("pack_dir"))
	if not _hashes.has(dir):
		_hashes[dir] = str(PlotFile.call("dir_hash", dir))
	var opts: Dictionary = v.get("opts")
	var key: String = ("%s|%s|%s" if OS.get_environment("TL_GROUND_COVER") == "off" else "%s|%s|%s|cover") % [str(_hashes[dir]), str(r), str(opts.get("scenery", (world.get("walk") as Dictionary).get("scenery", "plot")))]
	if not rims.has(key) or OS.get_environment("TL_RIM_CACHE") == "off":
		(world.get("jobs") as RefCounted).call("now", i)
		var e: float = float(DrawScript.call("edge_height", (world.get("packs") as Array)[i], r))
		rims[key] = "none" if is_nan(e) else e
		v.set("_rims_new", int(v.get("_rims_new")) + 1)
	return NAN if typeof(rims[key]) == TYPE_STRING else float(rims[key])


static func rims_path() -> String:
	return str(PlotFile.call("cache_dir")) + "/rims.json"          # P14: TL_CACHE_DIR or the user directory


static func save_rims(v: Node) -> void:
	if int(v.get("_rims_new")) == 0:
		return
	DirAccess.make_dir_recursive_absolute(rims_path().get_base_dir())
	var f: FileAccess = FileAccess.open(rims_path(), FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(v.get("_rims"), "", true))
		f.close()


## The rule: before the visitor takes a step, every plot whose edge is within COPY_NEAR_M of him has all its
## colliders (copied whole now if it must); of the rest the nearest is copied for COPY_US a frame. Running (9 m/s) he
## covers 10 m in 66 ticks; a seed's copy (5 ms whole) takes three slices. Returns the microseconds it took.
static func copy_colliders(copies: Array, ws: Object, plots: Array, radii: Array, at: Vector3) -> int:
	var tc: int = Time.get_ticks_usec()
	var best: int = -1
	var best_d: float = INF
	for k: int in range(copies.size() - 1, -1, -1):
		var i: int = int((copies[k] as Dictionary)["i"])
		var o: Vector3 = (plots[i] as Transform3D).origin
		var d: float = Vector2(at.x - o.x, at.z - o.z).length() - float(radii[i])
		if d < COPY_NEAR_M:
			ws.call("step_pack", (copies[k] as Dictionary)["job"], 1 << 30)
			copies.remove_at(k)
			if best > k:
				best -= 1
		elif d < best_d:
			best_d = d
			best = k
	if best >= 0 and Time.get_ticks_usec() - tc < COPY_US:
		if bool(ws.call("step_pack", (copies[best] as Dictionary)["job"], COPY_US - (Time.get_ticks_usec() - tc))):
			copies.remove_at(best)
	return Time.get_ticks_usec() - tc


## Walker-feel T (blink B2): every 10 frames, a plot with a ground of its own whose game has not arrived and that has
## no picture to show keeps its hole in the world's ground shut (`close_holes` below): the pad shows, not the
## sky. Called from the viewer's `_process`; changes the material only when the set changes. TL_SHUT_HOLES=off: as before.
static func shut_holes(v: Node) -> void:
	var land: Node3D = v.get("landscape")
	var draw: Node = v.get("draw")
	if land == null or draw == null or not land.has_meta(&"tl_ground_mat") or OS.get_environment("TL_SHUT_HOLES") == "off":
		return
	if Engine.get_process_frames() % 10 != 0 and land.has_meta(&"tl_shut"):
		return
	var has_ground: Array = v.get("has_ground")
	var arrived: Dictionary = v.get("_arrived")
	var entries: Array = draw.get("entries")
	var shut: Array = []
	for i: int in has_ground.size():
		var empty: bool = i < entries.size() and ((entries[i] as Dictionary)["pics"] as Dictionary).is_empty()
		shut.append(bool(has_ground[i]) and not arrived.has(i) and empty)
	if shut != land.get_meta(&"tl_shut", []):
		land.set_meta(&"tl_shut", shut)
		close_holes(land, has_ground, v.get("radii"), shut)


## Walker-feel T (blink B2): a plot whose ground is cut open but that draws nothing yet (its game has not arrived and
## no picture of it is cached: the first visit on a machine) shows the sky through the world's ground. `shut[i]` true
## closes plot i's hole (the world's pad shows there) until it has something to show. Plot order as in landscape.gd `build`; the
## material is landscape.gd's, stored as the meta `tl_ground_mat` on the landscape node.
static func close_holes(parent: Node3D, has_ground: Array, radii: Array, shut: Array) -> void:
	var gm: Variant = parent.get_meta(&"tl_ground_mat", null)
	if gm == null:
		return
	var all: Array = (gm as ShaderMaterial).get_meta(&"tl_holes_all", [])
	var holes: Array = all.duplicate()
	var k: int = 0
	for i: int in has_ground.size():
		if float(radii[i]) > 0.0 and bool(has_ground[i]) and k < 32:
			if i < shut.size() and bool(shut[i]):
				holes[k] = Vector4((all[k] as Vector4).x, (all[k] as Vector4).y, 0.0, 0.0)
			k += 1
	(gm as ShaderMaterial).set_shader_parameter(&"tl_holes", holes)


