87:
88:## S2: frees every body that was made under the tag `t` (a construction site's scaffold, when its game arrives: the
89:## only thing in this space that goes). Returns how many. Their shapes stay in `_keep` until the space is freed.
90:func remove_tag(t: String) -> int:
91:	var n: int = 0
92:	for b: Variant in _bodies.duplicate():
93:		if str(_tags.get(b, "")) == t:
94:			PhysicsServer3D.free_rid(b as RID)
95:			_bodies.erase(b)
96:			_tags.erase(b)
97:			n += 1
98:	stats["bodies"] = int(stats["bodies"]) - n
99:	return n
100:
101:
102:func add_faces(faces: PackedVector3Array) -> void:
103:	if faces.size() < 3:
104:		return
105:	var sh: ConcavePolygonShape3D = ConcavePolygonShape3D.new()
106:	sh.backface_collision = true
107:	sh.set_faces(faces)
108:	_keep.append(sh)
109:	_static(sh, Transform3D.IDENTITY)
110:	stats["faces"] = int(stats["faces"]) + faces.size() / 3
111:
112:
113:func add_box(xf: Transform3D, size: Vector3) -> void:
114:	var sh: BoxShape3D = BoxShape3D.new()
115:	sh.size = size
116:	_keep.append(sh)
117:	_static(sh, xf)
118:	stats["boxes"] = int(stats["boxes"]) + 1
