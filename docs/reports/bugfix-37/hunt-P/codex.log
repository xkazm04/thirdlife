330:## Puts the body at `pos` (feet), unchecked.
331:func place(pos: Vector3) -> void:
332:	PhysicsServer3D.body_set_state(body, PhysicsServer3D.BODY_STATE_TRANSFORM, Transform3D(Basis(), pos))
333:
334:
335:## Moves the body from `from` (feet) by the horizontal `delta`. Slides along what it meets, steps up small steps,
336:## follows the ground down; a move that would end on a slope steeper than `max_slope_deg` is refused (he stays).
337:## Returns the new feet position. `blocked` says whether anything held him back this tick.
338:func walk(from: Vector3, delta: Vector3) -> Dictionary:
339:	var pos: Vector3 = from
340:	last_hit = {}
341:	var rest: Vector3 = Vector3(delta.x, 0.0, delta.z)
342:	var hit: bool = false
343:	# lift by the step height, move horizontally (slide up to three times), then drop to the ground
344:	var up: Vector3 = Vector3(0.0, step_up, 0.0)
345:	if _test(Transform3D(Basis(), pos), up):
346:		up = _res.get_travel()
347:	pos += up
348:	for it: int in 3:
349:		if rest.length() < 0.0005:
350:			break
351:		if _test(Transform3D(Basis(), pos), rest):
352:			hit = true
353:			last_hit = {"tag": _tags.get(_res.get_collider_rid(0), "?"), "at": _res.get_collision_point(0), "n": _res.get_collision_normal(0), "from": pos}
354:			var travel: Vector3 = _res.get_travel()
355:			pos += travel
356:			var rem: Vector3 = _res.get_remainder()
357:			var nrm: Vector3 = _res.get_collision_normal(0)
358:			nrm.y = 0.0
359:			rest = rem - nrm.normalized() * rem.dot(nrm.normalized()) if nrm.length() > 0.001 else Vector3.ZERO
360:		else:
361:			pos += rest
362:			rest = Vector3.ZERO
363:	var drop: float = up.y + 0.9
364:	var grounded: bool = false
365:	var ground_n: Vector3 = Vector3.UP
366:	if _test(Transform3D(Basis(), pos), Vector3(0.0, -drop, 0.0)):
367:		pos += _res.get_travel()
368:		ground_n = _res.get_collision_normal(0)
369:		grounded = true
370:	else:
371:		pos.y -= drop                               # nothing under him within reach: a ledge; he steps down by the reach
372:	var slope_ok: bool = not grounded or ground_n.y >= cos(deg_to_rad(max_slope_deg))
373:	if not slope_ok:
374:		# refuse: the move ends on something too steep to stand on; stay where he was
375:		hit = true
376:		pos = from
377:		if _test(Transform3D(Basis(), pos), Vector3(0.0, -0.6, 0.0)):
378:			pos += _res.get_travel()
379:	if hit:
380:		blocked_ticks += 1
381:	place(pos)
382:	return {"pos": pos, "blocked": hit, "grounded": grounded}
