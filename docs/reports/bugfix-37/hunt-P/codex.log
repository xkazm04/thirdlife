181:## The static colliders of a pack, copied into the world's space (see the header). `plot`: the plot's transform in
182:## world coordinates (lift included), `radius`: the drawn circle, `rim`: the pack's own height at the plot edge in its
183:## own coordinates and `band`: the width over which the draw layer bends its ground to that height. Only
184:## StaticBody3D (a frozen rigid body is not copied); a concave shape (terrain) is clipped to the circle and bent like
185:## the drawn ground, every other shape is copied whole when its body stands inside the circle and is lifted by
186:## the amount the draw layer lifts something standing there.
187:func add_pack(holder: Node3D, plot: Transform3D, radius: float, rim: float, band: float) -> void:
188:	var inv: Transform3D = holder.global_transform.affine_inverse()
189:	_add_pack_walk(holder, holder, inv, plot, radius, rim, band)
190:
191:
192:## P14: the same copy in slices, for a pack that arrives while the world is drawn. `begin_pack` only lists the pack's
193:## static shapes (in the pack's own coordinates, read now: the pack's nodes may move or go later); `step_pack` copies
194:## them until `budget_usec` is spent and returns true when the whole pack is in. The result is the one `add_pack` makes.
195:func begin_pack(holder: Node3D, plot: Transform3D, radius: float, rim: float, band: float) -> Dictionary:
196:	var items: Array = []
197:	_list_static(holder, holder.global_transform.affine_inverse(), radius, items)
198:	return {"items": items, "at": 0, "tri": 0, "out": PackedVector3Array(), "plot": plot, "radius": radius, "rim": rim,
199:		"band": band, "tag": tag, "src": PackedVector3Array()}
200:
201:
202:func _list_static(n: Node, inv: Transform3D, radius: float, items: Array) -> void:
203:	if n is StaticBody3D:
204:		for ch: Node in n.get_children():
205:			if ch is CollisionShape3D and not (ch as CollisionShape3D).disabled and (ch as CollisionShape3D).shape != null:
206:				var local: Transform3D = inv * (ch as CollisionShape3D).global_transform
207:				var sh: Shape3D = (ch as CollisionShape3D).shape
208:				if sh is ConcavePolygonShape3D or radius <= 0.0 or Vector2(local.origin.x, local.origin.z).length() <= radius + 2.0:
209:					items.append([sh, local])
210:	for c: Node in n.get_children():
211:		_list_static(c, inv, radius, items)
212:
213:
214:func step_pack(job: Dictionary, budget_usec: int) -> bool:
215:	var t0: int = Time.get_ticks_usec()
216:	var items: Array = job["items"]
217:	var plot: Transform3D = job["plot"]
218:	var radius: float = float(job["radius"])
219:	var rim: float = float(job["rim"])
220:	var band: float = float(job["band"])
221:	tag = str(job["tag"])
222:	while int(job["at"]) < items.size():
223:		var it: Array = items[int(job["at"])]
224:		var sh: Shape3D = it[0]
225:		var local: Transform3D = it[1]
226:		if sh is ConcavePolygonShape3D:
227:			if int(job["tri"]) == 0 and (job["src"] as PackedVector3Array).is_empty():
228:				job["src"] = (sh as ConcavePolygonShape3D).get_faces()
229:				job["out"] = PackedVector3Array()
230:			var src: PackedVector3Array = job["src"]
231:			var out: PackedVector3Array = job["out"]
232:			var r2: float = (radius + 4.0) * (radius + 4.0)
233:			var t: int = int(job["tri"])
234:			while t + 2 < src.size():
235:				var a: Vector3 = local * src[t]
236:				var b: Vector3 = local * src[t + 1]
237:				var c: Vector3 = local * src[t + 2]
238:				t += 3
239:				var cx: float = (a.x + b.x + c.x) / 3.0
240:				var cz: float = (a.z + b.z + c.z) / 3.0
241:				if radius <= 0.0 or cx * cx + cz * cz <= r2:
242:					out.append(plot * _bent(a, radius, rim, band))
243:					out.append(plot * _bent(b, radius, rim, band))
244:					out.append(plot * _bent(c, radius, rim, band))
245:				if t % 1536 == 0 and Time.get_ticks_usec() - t0 > budget_usec:
246:					job["tri"] = t
247:					job["out"] = out
248:					return false
249:			if out.size() > 0:
250:				var ns: ConcavePolygonShape3D = ConcavePolygonShape3D.new()
251:				ns.backface_collision = true
252:				ns.set_faces(out)
253:				_keep.append(ns)
254:				_static(ns, Transform3D.IDENTITY)
255:				stats["pack_faces"] = int(stats["pack_faces"]) + out.size() / 3
256:			job["tri"] = 0
257:			job["src"] = PackedVector3Array()
258:			job["out"] = PackedVector3Array()
259:		else:
260:			var lifted: Transform3D = local
261:			if band > 0.0 and radius > 0.0:
262:				lifted.origin = _bent(local.origin, radius, rim, band)
263:			_static(sh, plot * lifted)
264:			stats["pack_shapes"] = int(stats["pack_shapes"]) + 1
265:		job["at"] = int(job["at"]) + 1
266:		if Time.get_ticks_usec() - t0 > budget_usec:
267:			break
268:	return int(job["at"]) >= items.size()
269:
270:
271:func _bent(p: Vector3, radius: float, rim: float, band: float) -> Vector3:
272:	var r: float = Vector2(p.x, p.z).length()
273:	if band > 0.0 and radius > 0.0:
274:		p.y += (rim - p.y) * smoothstep(radius - band, radius, r)
275:	return p
