94:## Keeps the camera out of `avoid_space` (see the header). `now`: no easing (a snap).
95:func _avoid(now: bool) -> void:
96:	avoid_pull = 0.0
97:	avoid_lift = 0.0
98:	if not avoid_space.is_valid():
99:		return
100:	var d: Vector3 = global_position - _look
101:	var want_len: float = d.length()
102:	if want_len < 0.01:
103:		return
104:	if _query == null:
105:		_sphere = SphereShape3D.new()
106:		_query = PhysicsShapeQueryParameters3D.new()
107:		_query.shape = _sphere
108:	_sphere.radius = avoid_margin
109:	_query.collision_mask = avoid_mask
110:	var st: PhysicsDirectSpaceState3D = PhysicsServer3D.space_get_direct_state(avoid_space)
111:	if st == null:
112:		return
113:	var axis: Vector3 = Vector3.UP.cross(d)
114:	axis = axis.normalized() if axis.length() > 0.001 else Vector3.RIGHT
115:	if d.rotated(axis, 0.1).y < d.y:
116:		axis = -axis
117:	var elev: float = rad_to_deg(asin(clampf(d.y / want_len, -1.0, 1.0)))
118:	# the lowest swing up that is clear for avoid_min (or the whole wanted way when that is shorter)
119:	var need: float = minf(avoid_min, want_len)
120:	var want_lift: float = 0.0
121:	var best: float = -1.0
122:	var k: int = 0
123:	while k <= 8:
124:		var ang: float = 10.0 * float(k)
125:		if k > 0 and elev + ang > 80.0:
126:			break
127:		var fl: float = _cast(st, d.rotated(axis, deg_to_rad(ang)), want_len)
128:		if fl >= need - 0.01:
129:			want_lift = ang
130:			best = -1.0
131:			break
132:		if fl > best + 0.25:
133:			best = fl
134:			want_lift = ang
135:		k += 1
136:	if now or want_lift > _lift:
137:		_lift = want_lift
138:	else:
139:		_lift = lerpf(_lift, want_lift, clampf(avoid_out, 0.01, 1.0))
140:		if absf(_lift - want_lift) < 0.05:
141:			_lift = want_lift
142:	var dir: Vector3 = d.rotated(axis, deg_to_rad(_lift)) if _lift > 0.0 else d
143:	var free_len: float = _cast(st, dir, want_len)
144:	if now or _free_len < 0.0 or free_len < _free_len:
145:		_free_len = free_len                                   # pulled in at once
146:	else:
147:		_free_len = minf(free_len, lerpf(_free_len, free_len, clampf(avoid_out, 0.01, 1.0)))
148:	var len: float = minf(_free_len, want_len)
149:	avoid_pull = want_len - len
150:	avoid_lift = _lift
151:	global_position = _look + dir / want_len * len
152:
153:
154:## How far a sphere of `avoid_margin` gets from the point looked at along `d` (length `want_len`).
155:func _cast(st: PhysicsDirectSpaceState3D, d: Vector3, want_len: float) -> float:
156:	_query.transform = Transform3D(Basis(), _look)
157:	_query.motion = d
158:	var r: PackedFloat32Array = st.cast_motion(_query)
159:	return want_len * (r[0] if r.size() > 0 else 1.0)
