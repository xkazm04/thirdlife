		for n: Node in rig.find_children("*", "GeometryInstance3D", true, false):
			(n as GeometryInstance3D).set_instance_shader_parameter(&"tl_body", Vector2.ZERO)
	cam = Camera3D.new()
	cam.fov = 38.0
	cam.far = 2000.0
	add_child(cam)
	cam.make_current()
	cam_pos = Vector3(0, 1.0, 0)
	_place_cam(true)


