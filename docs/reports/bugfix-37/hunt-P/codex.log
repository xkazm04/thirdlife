61:## Puts the camera at its wanted place at once (after a teleport, or after changing `distance` / `height`).
62:func snap() -> void:
63:	if not is_instance_valid(target) or not target.is_inside_tree() or not is_inside_tree():
64:		return
65:	_anchor = target.global_position
66:	global_position = _wanted()
67:	_look = target.global_position + Vector3.UP * look_height
68:	_free_len = -1.0
69:	_lift = 0.0
70:	_avoid(true)
71:	_aim()
72:	reset_physics_interpolation()
