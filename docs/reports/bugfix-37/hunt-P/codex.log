57:## Starts the body at rest, standing (after a teleport: `put`, entering, leaving).
58:func rest() -> void:
59:	vel = Vector3.ZERO
60:	grounded = true
61:	mode = "ground"
62:	air_ticks = 0
63:	_buffer = 0
64:	_jumped = false
65:	_slide_t = 0
66:	_step_t = 0
