{
  "id": "game.ice_hockey_three_against",
  "version": "0.1.1",
  "kernelApi": "0.1",
  "title": "Ice hockey, three against three",
  "capabilities": [
    "physics",
    "input",
    "ui",
    "camera",
    "rules",
    "ball",
    "kit",
    "style",
    "biped",
    "ai",
    "audio",
    "vfx"
  ],
  "entry": "scripts/main.gd",
  "assets": [
    "gen/ai_hook.gd",
    "gen/art_hook.gd",
    "gen/fx_hook.gd"
  ],
  "tests": [
    "tests/bot_hockey.gd",
    "tests/bot_hockey_ai.gd"
  ],
  "cameras": [
    "arena"
  ],
  "params": [
    {
      "name": "score_to_win",
      "file": "data/tuning.json",
      "path": "rules.score_to_win",
      "min": 1,
      "max": 9,
      "step": 1,
      "label": "Goals to win"
    },
    {
      "name": "skate_speed",
      "file": "data/tuning.json",
      "path": "skater.skate_speed",
      "min": 4,
      "max": 12,
      "step": 0.5,
      "label": "Skater top speed"
    },
    {
      "name": "shot_speed",
      "file": "data/tuning.json",
      "path": "shoot.speed",
      "min": 8,
      "max": 28,
      "step": 1,
      "label": "Shot speed"
    },
    {
      "name": "shot_cooldown",
      "file": "data/tuning.json",
      "path": "shoot.cooldown_s",
      "min": 0.1,
      "max": 1.5,
      "step": 0.05,
      "label": "Shot cooldown"
    },
    {
      "name": "pause",
      "file": "data/tuning.json",
      "path": "pause_s",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "label": "Pause after a goal"
    }
  ],
  "on_leave": "pause",
  "subject": "skater_b0"
}
