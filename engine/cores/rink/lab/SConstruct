#!/usr/bin/env python
# Third Life rink core, LAB (lane K4 "reference", 23-24 Nov 2026): the measurement runner rinklab.exe.
#
# Compiles thirdjam's JamCore exactly as ../native/SConstruct does (the same 40 verbatim files of ../native/thirdjam, the
# same shim, the same defines, /std:c++20 /fp:precise /O2 /MT as UBT and godot-cpp's template build), plus the lab's own
# files in this folder. Nothing under ../native/ is written or patched: the lab only ADDS code around thirdjam's classes
# (an input filter on the human's slot, read-only observers, scripted gym scenes). godot-cpp is not needed.
#
#   scons -C engine/cores/rink/lab -j6        (engine/tools/rink.sh lab-build does this)
# Output: engine/cores/rink/lab/bin/rinklab.exe (gitignored; objects under <repo>/.tl/rink-lab-obj).
import os

here = Dir(".").abspath
native = os.path.normpath(os.path.join(here, "..", "native"))
tj = os.path.join(native, "thirdjam")
repo = os.path.normpath(os.path.join(here, "..", "..", "..", ".."))
objdir = os.path.join(repo, ".tl", "rink-lab-obj")

env = Environment(TARGET_ARCH="x86_64", ENV=os.environ)
jam_dirs = [os.path.join(tj, d) for d in ("Public", "Private", "AI", "Rules", "Effects")]
env.Append(CPPPATH=[os.path.join(native, "shim"), os.path.join(native, "shim", "generated")] + jam_dirs + [here])
env.Append(CPPDEFINES=["JAMCORE_API=", "WITH_DEV_AUTOMATION_TESTS=0", "WITH_EDITOR=0", "UNICODE", "_UNICODE", "_CRT_SECURE_NO_WARNINGS",
                       ("RINK_SOURCE_TREE", '\\"thirdjam\\"')])
env.Append(CCFLAGS=["/O2", "/MT", "/nologo"])
env.Append(CXXFLAGS=["/std:c++20", "/fp:precise", "/EHsc", "/bigobj", "/utf-8", "/wd4005", "/wd4244", "/wd4267", "/wd4996"])
env.Append(LINKFLAGS=["/SUBSYSTEM:CONSOLE", "/nologo"])

jam_sources = [
    "Private/JamSim.cpp", "Private/JamCartridge.cpp", "Private/JamJson.cpp", "Private/JamEventBus.cpp",
    "Rules/JamZones.cpp", "Rules/JamRuleSystem.cpp", "Effects/JamEffectSystem.cpp", "Effects/JamEffectTypes.cpp",
    "AI/JamSimAdapter.cpp", "AI/JamBotMatch.cpp", "AI/JamPlaytester.cpp", "AI/JamAICore.cpp", "AI/DifficultyProfile.cpp",
    "AI/DifficultyResolve.cpp", "AI/JamBotRefSim.cpp", "AI/JamTournamentCommandlet.cpp",
]
if os.path.exists(os.path.join(tj, "Private", "JamPassFate.cpp")):
    jam_sources.append("Private/JamPassFate.cpp")

objs = [env.Object(os.path.join(objdir, s.replace("/", "_").replace(".cpp", "")), os.path.join(tj, s)) for s in jam_sources]
objs.append(env.Object(os.path.join(objdir, "shim"), os.path.join(native, "shim", "shim.cpp")))
for s in ("lab_filter.cpp", "lab_gym.cpp", "rinklab.cpp"):
    objs.append(env.Object(os.path.join(objdir, "lab_" + s.replace(".cpp", "")), os.path.join(here, s)))
# out=<path without .exe> links the runner elsewhere (a second copy while bin/rinklab.exe is busy in a long run).
prog = env.Program(ARGUMENTS.get("out", os.path.join(here, "bin", "rinklab")), objs, LIBS=["kernel32", "user32"])
SConsignFile(os.path.join(objdir, "sconsign"))
Default(prog)
