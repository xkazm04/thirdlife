+// ---------------------------------------------------------------------------------------------------------------------
+// THIRDLIFE PATCH 0005 (FTlRules::BotAbilityShare / DiveShare, JamCartridge.h): the bots' abilities and the dive.
+// ---------------------------------------------------------------------------------------------------------------------
+
+bool UJamSim::TlBotHolds(const FJamSkaterState& S) const
+{
+	if (S.bHuman || Config.Tl.BotAbilityShare <= 0.0) return false;
+	if (Config.Tl.BotAbilityTeam == 0) return true;
+	const int32 Ht = Skaters.IsValidIndex(HumanIndex) ? Skaters[HumanIndex].Team : -1;
+	if (Ht < 0) return true;   // nobody human (a bot match): every bot
+	return Config.Tl.BotAbilityTeam == 1 ? S.Team != Ht : S.Team == Ht;
+}
+
+double UJamSim::TlCoin(int64 Salt, int32 Who) const
+{
+	// A fixed coin of the frame window (or the shot) and the skater, off the seeded stream (as NotifyPickupTaken picks a pickup ability): a cartridge whose
+	// switches are off draws exactly as before. splitmix64's finaliser, 53 bits.
+	uint64 X = static_cast<uint64>(Salt) * 0x9E3779B97F4A7C15ull ^ (static_cast<uint64>(Who) + 1ull) * 0xC2B2AE3D27D4EB4Full;
+	X ^= X >> 30; X *= 0xBF58476D1CE4E5B9ull; X ^= X >> 27; X *= 0x94D049BB133111EBull; X ^= X >> 31;
+	return static_cast<double>(X >> 11) * (1.0 / 9007199254740992.0);
+}
+
+void UJamSim::TlArmAbility(FJamSkaterState& S)
+{
+	// TryAbility's bookkeeping without its shot: the shotgun is armed on the blade and the wind-up fires it (TryAbility would fire it this frame).
+	const FJamAbilityConfig* A = HeldAbility(S.Index);
+	if (!A) return;
+	S.AbilityReadyFrame = Frame + (A->CooldownFrames > 0 ? A->CooldownFrames : AbilityDefaultCooldown(A->Kind));
+	++S.AbilitiesUsed;
+	S.bAbilityThisFrame = true;
+	if (S.AbilityCharges > 0) --S.AbilityCharges;
+	Emit(JamEvents::Ability, S.Index, S.Pos, 1.f, A->Kind);
+	S.AbilityArmed = A->Kind;
+}
+
+void UJamSim::TlStepBotAbility(FJamSkaterState& S, FJamInput& In)
+{
+	const FJamAbilityConfig* A = HeldAbility(S.Index);
+	if (!A) { S.TlWindupLeft = 0; return; }
+	const bool bCarry = CarrierIndex() == S.Index;
+	// A meteor wind-up that runs: the shot is held and nothing else is pressed until the last frame lets it go (StepCharge fires it with its charge). A bot
+	// that lost the puck stops winding; its stick stays armed and its brain's next shot is the meteor.
+	if (S.TlWindupLeft > 0)
+	{
+		if (!bCarry || S.AbilityArmed != AbShotgun) { S.TlWindupLeft = 0; return; }
+		In.bShoot = false; In.bPass = false; In.bPassHeld = false; In.bDeke = false; In.bSpin = false; In.bAbility = false;
+		In.bShootHeld = --S.TlWindupLeft > 0;
+		return;
+	}
+	if (S.AbilityCharges == 0 || Frame < S.AbilityReadyFrame || !S.AbilityArmed.IsNone() || S.ShieldFrames > 0) return;
+	if (bDrawOpen || Frame - DropFrame < TlBotAbilityDropLockFrames) return;
+	const double Skill = FMath::Clamp(Config.Tl.BotAbilitySkill, 0.0, 1.0);
+	const FName Kind = A->Kind;
+	const FVector2D Fwd = S.Forward();
+	bool bRead = false;
+	if (Kind == AbShotgun)
+	{
+		if (!bCarry) return;
+		const FVector2D ToGoalV = FVector2D(AttackGoalX(S.Team), 0.0) - S.Pos;
+		const double Dg = ToGoalV.Size();
+		if (Dg < 6.0 || Dg > 12.0 + 16.0 * Skill || Dot(Fwd, ToGoalV / Dg) < 0.7) return;   // in range, facing the net (thirdjam's playtester: 0.7)
+		int32 Crowd = 0, InLane = 0;
+		for (const FJamSkaterState& O : Skaters)
+		{
+			if (O.Team == S.Team || O.IsDown() || O.InBox()) continue;
+			const FVector2D D = O.Pos - S.Pos;
+			const double Along = Dot(D, Fwd);
+			if (Along <= 0.5 || Along >= Dg) continue;
+			const double Off = FMath::Abs(Fwd.X * D.Y - Fwd.Y * D.X);
+			if (Off <= 1.0) ++Crowd;                                // the meteor floors him on its way (StepShotgun's 1 m)
+			if (Off <= 1.2 && !InCreaseStance(O)) ++InLane;          // a standing body in the lane (the keeper in his crease does not close it)
+		}
+		bRead = Crowd > 0 || In.bShoot || (Skill >= 0.5 && InLane == 0 && Dg <= 20.0) || Skill < 0.34;   // a crowd, the brain's own shot, a clear lane; a poor bot any time
+	}
+	else if (Kind == AbHipCheck)
+	{
+		const int32 C = CarrierIndex();
+		bRead = In.bCheck || (C >= 0 && Skaters[C].Team != S.Team && FVector2D::Distance(Skaters[C].Pos, S.Pos) <= 1.2 + 0.8 * Skill);
+	}
+	else if (Kind == AbShield)
+	{
+		const int32 O = bCarry ? NearestOpponent(S) : -1;
+		bRead = O >= 0 && FVector2D::Distance(Skaters[O].Pos, S.Pos) <= 4.0;
+	}
+	else if (Kind == AbSlowPuck) bRead = bCarry && (In.bPass || In.bShoot);
+	if (!bRead || TlCoin(Frame / TlBotAbilityWindowFrames, S.Index) >= Config.Tl.BotAbilityShare) return;
+	if (Kind == AbShotgun && Config.Shot.ChargeFramesMax > 0)
+	{
+		TlArmAbility(S);
+		S.TlWindupLeft = FMath::Max(Config.Shot.TapFrames + 2, FMath::RoundToInt32(Config.Shot.ChargeFramesMax * (0.35 + 0.65 * Skill)));
+		In.bShoot = false; In.bPass = false; In.bPassHeld = false; In.bDeke = false; In.bSpin = false;
+		In.bShootHeld = true;
+		return;
+	}
+	In.bAbility = true;   // TryAbility: thirdjam's own use (a shotgun with no charge fires at once)
+}
+
+bool UJamSim::TlTryDive(FJamSkaterState& S)
+{
+	const int32 Sh = Puck.LastTouch;
+	if (!Skaters.IsValidIndex(Sh) || Sh == S.Index || Skaters[Sh].Team == S.Team || bDrawOpen) return false;
+	if (RidingCarrier() >= 0 || CarrierIndex() == S.Index || Puck.PassFrames > 0 || Puck.Z >= TlDiveBodyTopM) return false;
+	const bool bMeteor = Puck.ShotgunFrames > 0;
+	const double Share = bMeteor ? Config.Tl.DiveShare : Config.Tl.DiveShotShare;
+	const double V = Puck.Vel.Size();
+	if (Share <= 0.0 || V < ShotBlockMinMps) return false;
+	// heading inside the net he defends (EmitShotBlocked's test)
+	const double Gx = AttackGoalX(Skaters[Sh].Team);
+	if ((Gx - Puck.Pos.X) * Puck.Vel.X <= 1e-6) return false;
+	const double Tg = (Gx - Puck.Pos.X) / Puck.Vel.X;
+	if (FMath::Abs(Puck.Pos.Y + Puck.Vel.Y * Tg) > Config.Rink.GoalWidthM * 0.5 + 0.5) return false;
+	// where it passes him, and when
+	const FVector2D Dir = Puck.Vel / V;
+	const double Along = Dot(S.Pos - Puck.Pos, Dir);
+	if (Along < 0.3) return false;
+	const double T = Along / V;
+	if (T > TlDiveLookAheadS || T > Tg) return false;
+	const FVector2D Near = Puck.Pos + Dir * Along;
+	const double Miss = FVector2D::Distance(S.Pos, Near);
+	if (Miss > Config.Tl.DiveReachM + TlDiveBodyR) return false;
+	if (!bMeteor && Miss < SkaterRadius) return false;   // an ordinary shot at his body: the body takes it standing
+	// one decision a shot (the shot = the sum of every skater's Shots when it was taken)
+	int32 Serial = 0;
+	for (const FJamSkaterState& O : Skaters) Serial += O.Shots;
+	if (S.TlDiveSerial == Serial) return false;
+	S.TlDiveSerial = Serial;
+	if (TlCoin(static_cast<int64>(Serial) * 31 + 7, S.Index) >= Share) return false;
+	// the throw: towards the line, fast enough that the laid-out body is across it when the puck gets there (a downed skater slides at (1 - 2 DT) a frame)
+	const FVector2D To = Near - S.Pos;
+	const double Dn = To.Size();
+	const FVector2D DirD = Dn > 1e-6 ? To / Dn : FVector2D(-Dir.Y, Dir.X);
+	const double Need = FMath::Max(0.0, Dn - TlDiveBodyFrontM * 0.6);
+	const double Throw = FMath::Min(TlDiveMaxMps, 2.0 * Need / FMath::Max(0.15, 1.0 - FMath::Exp(-2.0 * FMath::Max(T, DT))));
+	S.Vel = S.Vel * 0.3 + DirD * Throw;
+	S.Yaw = FMath::Atan2(DirD.Y, DirD.X);
+	S.KnockFrames = FMath::Max(1, Config.Tl.DiveDownFrames);
+	S.KnockDir = DirD;
+	S.TlDiveFrames = S.KnockFrames;
+	S.ChargeFrames = 0; S.CheckWindupLeft = 0; S.LiftWindupLeft = 0; S.TlWindupLeft = 0; S.CheckWindow = 0;
+	++S.TlDives;
+	Emit(TlEvDive, S.Index, S.Pos, static_cast<float>(Miss / 4.0), bMeteor ? CauseShotgun : TlKindShot, DirD);
+	return true;
+}
+
+int32 UJamSim::TlDiveBlock(const FVector2D& Prev, double R)
+{
+	if (Puck.Z >= TlDiveBodyTopM) return -1;
+	for (FJamSkaterState& S : Skaters)
+	{
+		if (S.TlDiveFrames <= 0 || S.InBox() || Puck.LastTouch == S.Index || S.TlDiveBlocks >= S.TlDives) continue;   // one shot a dive: after it he is a body on the ice
+		if (Skaters.IsValidIndex(Puck.LastTouch) && Skaters[Puck.LastTouch].Team == S.Team) continue;   // his mates' pucks pass
+		if (RidingCarrier() >= 0 || (Puck.Vel - S.Vel).Size() < TlDiveBlockMinMps) continue;   // a shot, not a carried or a slow puck (a ring at his side would take it back and forth)
+		// the closest points of the puck's substep path and the laid-out body (both segments; the path sampled finely enough for a 0.42 m body)
+		const FVector2D A = S.Pos - S.KnockDir * TlDiveBodyBackM;
+		const FVector2D B = S.Pos + S.KnockDir * TlDiveBodyFrontM;
+		const FVector2D Ab = B - A;
+		const double Ab2 = FMath::Max(1e-9, Ab.SizeSquared());
+		double Best = 1e9;
+		FVector2D BestP = Puck.Pos, BestQ = S.Pos;
+		for (int32 k = 0; k <= 4; ++k)
+		{
+			const FVector2D P = Prev + (Puck.Pos - Prev) * (k / 4.0);
+			const FVector2D Q = A + Ab * FMath::Clamp(Dot(P - A, Ab) / Ab2, 0.0, 1.0);
+			const double D = FVector2D::Distance(P, Q);
+			if (D < Best) { Best = D; BestP = P; BestQ = Q; }
+		}
+		if (Best > TlDiveBodyR + R) continue;
+		const double SpBefore = Puck.Vel.Size();
+		EmitShotBlocked(S, SpBefore);   // thirdjam's own read-out, Variant 1: a shot on goal stopped by a skater
+		const bool bMeteor = Puck.ShotgunFrames > 0;
+		FVector2D N = BestP - BestQ;
+		N = N.SizeSquared() > 1e-12 ? N.GetSafeNormal() : (SpBefore > 1e-6 ? -Puck.Vel / SpBefore : FVector2D(1, 0));
+		const FVector2D Rel = Puck.Vel - S.Vel;
+		const double Vn = Dot(Rel, N);
+		Puck.Vel = S.Vel + (Vn < 0.0 ? Rel - N * (2.0 * Vn) : Rel) * TlDiveKeep;
+		Puck.Pos = BestQ + N * (TlDiveBodyR + R + 1e-3);
+		Puck.ShotgunFrames = 0; Puck.ShotgunBy = -1; Puck.ShotgunMul = 1.0;   // a meteor stops being one on him
+		Puck.LastTouch = S.Index;
+		S.DeflectCooldown = 10;
+		++S.TlDiveBlocks;
+		const double MaxSpeed = FMath::Max(1.0, Eff(EJamStat::PuckMaxSpeed, -1));
+		Emit(TlEvDiveBlock, S.Index, Puck.Pos, static_cast<float>(FMath::Min(1.0, SpBefore / MaxSpeed)), bMeteor ? CauseShotgun : TlKindShot);
+		return S.Index;
+	}
+	return -1;
+}
