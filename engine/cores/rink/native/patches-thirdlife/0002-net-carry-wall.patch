 // reference baseline, hash for hash).
 struct FTlRules
 {
+	// THIRDLIFE PATCH 0002 (experiments E01 and E01b, pillar 3 "goals come from shots"): the goal line is closed to a held puck, at both nets and for both
+	// sides. A puck that rides with its carrier (UJamSim::RidingCarrier), or that he has held and not yet released (FJamPuckState::TlHeldBy: he is still its
+	// last toucher and has neither shot nor passed it), meets the goal mouth as a wall, exactly as thirdjam's own game.puck.net.own_wall already does for
+	// the defending side (JamSim.cpp OwnNetWall): it must leave a blade by a shot or a pass to score. A deflection, a rebound and a puck off a defender score
+	// as before. false = thirdjam: a carry over the line is a goal (PLAY.md section 4 item 1).
+	bool bNetCarryWall = false;
 };
 // The host's one entry: sets a switch by its rules.json key. false = an unknown key (the host reports it: unknown keys are errors).
 inline bool TlSetRule(FTlRules& R, const char* Key, double Value)
