diff -ruN a/thirdjam/Public/JamCartridge.h b/thirdjam/Public/JamCartridge.h
--- a/thirdjam/Public/JamCartridge.h
+++ b/thirdjam/Public/JamCartridge.h
@@ -674,6 +674,14 @@
 	// the defending side (JamSim.cpp OwnNetWall): it must leave a blade by a shot or a pass to score. A deflection, a rebound and a puck off a defender score
 	// as before. false = thirdjam: a carry over the line is a goal (PLAY.md section 4 item 1).
 	bool bNetCarryWall = false;
+	// THIRDLIFE PATCH 0003 (experiment E03, pillar 1 "the puck is yours until someone takes it with a key"; the owner's R-0048: "a carried puck leaves its
+	// carrier only by an action ... never by an unpressed blade or a body's touch"). thirdjam means this (game.stick.passive_take false, BlockCarried) and
+	// leaks it: when another skater's body meets the carried puck, BlockCarried takes out the puck's motion into that body, the puck then moves at the
+	// closing speed against its own carrier, RidingCarrier's 4 m/s test calls it loose, and the human's ring or a bot's pickup arc takes it on the same
+	// frame (rinklab probe -which=take: head on, 6 of 6 without a key). With this switch a puck that rides with its carrier keeps his velocity through
+	// another body's touch and through his own bounce off a body: it leaves him by a shot, a pass, a poke, a lift, a check that stumbles or fells him.
+	// false = thirdjam.
+	bool bCarryHoldsBody = false;
 };
