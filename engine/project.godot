; Third Life engine (WP1): law kernel, host and runner. kernelApi 0.1.
config_version=5

[application]

config/name="Third Life Engine"
run/main_scene="res://kernel/host/host.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=0

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=false
3d/default_linear_damp=0.0

[rendering]

renderer/rendering_method="forward_plus"
; WP4: the look settings of the kit lab (lane B), and Direct3D 12 as the default backend for windowed runs
rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.9, 0.7, 0.6, 1)
