config_version=5

[application]

config/name="Third Life look-test, lane B (inked low-poly, painterly atmosphere)"
run/main_scene="res://look.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Style="*res://src/style.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=0

