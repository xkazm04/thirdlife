{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tl.pack/0.1",
  "title": "Third Life pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "kernelApi",
    "title",
    "capabilities",
    "entry",
    "assets",
    "tests"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kernelApi": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "physics",
          "input",
          "ui",
          "audio",
          "vfx",
          "camera",
          "rules",
          "ai",
          "spawn",
          "fracture",
          "vehicle",
          "biped",
          "ball",
          "kit",
          "style"
        ]
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^scripts/[A-Za-z0-9_/]+\\.gd$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^gen/[A-Za-z0-9_/]+\\.gd$"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^tests/[A-Za-z0-9_/]+\\.gd$"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_m",
        "height_m"
      ],
      "properties": {
        "size_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "params": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "path",
          "min",
          "max",
          "step",
          "label"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "file": {
            "type": "string",
            "pattern": "^data/[A-Za-z0-9_/]+\\.json$"
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "on_leave": {
      "enum": [
        "bot",
        "pause",
        "end"
      ]
    },
    "subject": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+(/[A-Za-z0-9_]+)*$",
      "maxLength": 120
    },
    "moments": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
          }
        },
        "oneOf": [
          {
            "required": [
              "frame"
            ]
          },
          {
            "required": [
              "event"
            ]
          }
        ]
      }
    }
  }
}
