{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packages"
  ],
  "properties": {
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "milestone",
          "deps",
          "scope",
          "contract",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "milestone": {
            "enum": [
              "blockout",
              "greybox",
              "art_pass",
              "tuned"
            ]
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "verb",
                "args"
              ],
              "properties": {
                "level": {
                  "enum": [
                    "V0",
                    "V1",
                    "V2",
                    "V3",
                    "V4",
                    "V5",
                    "V6"
                  ]
                },
                "verb": {
                  "enum": [
                    "lint",
                    "smoke",
                    "invariants",
                    "bot"
                  ]
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "registers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "physics",
                    "input",
                    "ui",
                    "audio",
                    "vfx",
                    "camera",
                    "rules",
                    "ai",
                    "spawn",
                    "fracture",
                    "vehicle",
                    "biped",
                    "ball",
                    "kit",
                    "style"
                  ]
                }
              },
              "assets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^gen/[A-Za-z0-9_/]+.gd$"
                }
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^tests/[A-Za-z0-9_/]+.gd$"
                }
              },
              "cameras": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
