{
  "name": "third-life-foreman",
  "version": "0.1.0",
  "private": true,
  "description": "Third Life Foreman: job log, builder transport, verifier, package loop, CLI (Phase 0 spike)",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "foreman": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=4 \"dist/test/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
